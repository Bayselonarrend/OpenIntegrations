def lua(Map opts = [:], String scriptPath) {
    def args = (opts.args ?: '').toString().trim()
    def returnStatus = opts.returnStatus == true
    def command = args ? "lua \"${scriptPath}\" ${args}" : "lua \"${scriptPath}\""
    if (isUnix()) {
        return sh(script: command, returnStatus: returnStatus)
    }
    return bat(script: command, returnStatus: returnStatus)
}
// Job name: Alpaca/AlpacaAddins
// Pipeline from SCM, branch */main, credentials gitalpaca.
// Script path: ci/pipelines/alpaca_addins.jenkinsfile
// Agent label: windows. Create the job once. The daily cron is registered when this file is on main and the job has run.

pipeline {
    agent { label 'windows' }

    options {
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
    }

    triggers {
        cron('H H * * *')
    }

    stages {
        stage('Prune add-in branches') {
            steps {
                withCredentials([gitUsernamePassword(credentialsId: 'gitalpaca', gitToolName: 'Default')]) {
                    lua('ci/alpaca/gc-addins.lua')
                }
            }
        }
    }
}
