def branchParameter() {
	return [$class: 'StringParameterValue', name: 'BRANCH', value: (params.BRANCH ?: 'main')]
}

pipeline {
	agent {
		label 'windows'
	}
	parameters {
		string(name: 'BRANCH', defaultValue: 'main', description: 'Git branch to checkout. The job loads this Jenkinsfile from main, then checks out BRANCH.')
		booleanParam(name: 'UPLOAD_ARTIFACTS', defaultValue: true, description: 'Upload release artifacts to GitHub and YD')
		booleanParam(name: 'SKIP_DB_UPDATE', defaultValue: false, description: 'Skip OpiBuild/OpiBaseUpdate. Alpaca passes true.')
	}

    stages {
        stage('Checkout branch') {
            steps {
                script {
                    def branch = (params.BRANCH ?: 'main').toString().trim()
                    if (!branch) {
                        branch = 'main'
                    }
                    if (branch.contains('..') || branch.startsWith('-') || !(branch ==~ '[A-Za-z0-9._/-]+')) {
                        error "Invalid BRANCH: ${branch}"
                    }
                    env.TARGET_BRANCH = branch
                    withCredentials([gitUsernamePassword(credentialsId: 'gitmain', gitToolName: 'Default')]) {
                        bat "git fetch origin ${branch}"
                        bat "git checkout -f -B ${branch} origin/${branch}"
                    }
                    echo "Checked out ${branch}"
                }
            }
        }

        stage('Sync add-ins') {
            steps {
                bat 'call src\\addins\\sync-addins.bat'
            }
        }

        stage('OpenIntegrations - Build') {
            steps {
                build job: 'OpiBuild/OpiMain', wait: true,
                    parameters: [branchParameter()]
            }
        }
        stage('OpenIntegrations - CLI check') {
            steps {
                build job: 'OpiBuild/OpiCliCheck', wait: false,
                    parameters: [branchParameter()]
            }
        }
        stage('OpenIntegrations - 1C DB Update') {
            when {
                expression { return params.SKIP_DB_UPDATE.toString() != 'true' }
            }
            steps {
                build job: 'OpiBuild/OpiBaseUpdate', wait: true,
                    parameters: [branchParameter()]
            }
        }
        stage('OpenIntegrations - Release') {
            steps {
                echo 'Release (OpenIntegrations)'
                build job: 'OpiBuild/OpiRelease', wait: true,
                    parameters: [
                        branchParameter(),
                        [$class: 'BooleanParameterValue', name: 'UPLOAD_ARTIFACTS', value: params.UPLOAD_ARTIFACTS]
                    ]
            }
        }

        stage('Docs - Test update') {
            steps {
                build job: 'OpiDocs/OpiDocsTestRu', wait: true,
                    parameters: [branchParameter()]
                build job: 'OpiDocs/OpiDocsTestEn', wait: true,
                    parameters: [branchParameter()]
            }
        }
    }
}
