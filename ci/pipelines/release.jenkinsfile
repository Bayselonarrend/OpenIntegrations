pipeline {
    agent {
        label 'windows'
    }
    parameters {
        string(name: 'BRANCH', defaultValue: 'main', description: 'Git branch to checkout. The job loads this Jenkinsfile from main, then checks out BRANCH.')
        booleanParam(name: 'UPLOAD_ARTIFACTS', defaultValue: true, description: 'Upload release artifacts to GitHub and YD')
    }
    stages {
        stage('Checkout branch') {
            steps {
                script {
                    def branch = (params.BRANCH ?: 'main').toString().trim()
                    if (!branch) {
                        branch = 'main'
                    }
                    if (branch.contains('..') || branch.startsWith('-') || !(branch ==~ '[A-Za-z0-9._/-]+')) {
                        error "Invalid BRANCH: ${branch}"
                    }
                    env.TARGET_BRANCH = branch
                    withCredentials([gitUsernamePassword(credentialsId: 'gitmain', gitToolName: 'Default')]) {
                        bat "git fetch origin ${branch}"
                        bat "git checkout -f -B ${branch} origin/${branch}"
                    }
                    echo "Checked out ${branch}"
                }
            }
        }

        stage('Sync add-ins') {
            steps {
                bat 'call src\\addins\\sync-addins.bat'
            }
        }

        stage('Release') {
            steps {
                withCredentials([string(credentialsId: 'gpgkey', variable: 'GPGKEY')]) {
                    bat "oscript ./ci/os/ReleaseFactory.os ${params.UPLOAD_ARTIFACTS ? '1' : '0'}"
                }
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: '2.4.0/*'
            }
        }
    }
}