pipeline {
	agent {
		label 'windows'
	}
	parameters {
		string(name: 'BRANCH', defaultValue: 'main', description: 'Git branch to checkout. The job loads this Jenkinsfile from main, then checks out BRANCH.')
		string(name: 'ADDINS_BRANCH', defaultValue: 'addins', description: 'Branch of published add-in binaries. Default addins is the set built from main.')
	}
    stages {
        stage('Checkout branch') {
            steps {
                script {
                    def branch = (params.BRANCH ?: 'main').toString().trim()
                    if (!branch) {
                        branch = 'main'
                    }
                    if (branch.contains('..') || branch.startsWith('-') || !(branch ==~ '[A-Za-z0-9._/-]+')) {
                        error "Invalid BRANCH: ${branch}"
                    }
                    env.TARGET_BRANCH = branch
                    withCredentials([gitUsernamePassword(credentialsId: 'gitmain', gitToolName: 'Default')]) {
                        bat "git fetch origin ${branch}"
                        bat "git checkout -f -B ${branch} origin/${branch}"
                    }
                    echo "Checked out ${branch}"
                }
            }
        }

        stage('Sync add-ins') {
            steps {
                bat 'git fetch origin main --depth=1 && git show origin/main:src/addins/sync-addins.bat > "%TEMP%\\opi-sync-addins.bat" && call "%TEMP%\\opi-sync-addins.bat"'
            }
        }

        stage('Build') {
            steps {
                withCredentials([string(credentialsId: 'gpgkey', variable: 'GPGKEY')]) {
                    bat encoding: 'UTF-8', script:'chcp 65001 & oscript ./ci/os/MainProcessingScript.os %GPGKEY%'
                }
            }
        }

        stage('Update GIT') {
            steps {
                script {
                    withCredentials([gitUsernamePassword(credentialsId: 'gitmain', gitToolName: 'Default')]) {
                        bat "git config user.email vitaly.alpaca@openintegrations.dev"
                        bat 'git config user.name "Альпака Виталий"'
                        bat "git config --global core.ignorecase true"
                        bat "git add ."
                        bat 'git commit -m "Main build (Jenkins)"'
                        bat "git push origin HEAD:${env.TARGET_BRANCH ?: 'main'}"
                    }
                }
            }
        }
    }
}
