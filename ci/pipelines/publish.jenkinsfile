def lua(Map opts = [:], String scriptPath) {
    def args = (opts.args ?: '').toString().trim()
    def returnStatus = opts.returnStatus == true
    def command = args ? "lua \"${scriptPath}\" ${args}" : "lua \"${scriptPath}\""
    if (isUnix()) {
        return sh(script: command, returnStatus: returnStatus)
    }
    return bat(script: command, returnStatus: returnStatus)
}
pipeline {
	agent {
		label 'windows'
	}
    stages {
        stage('Sync add-ins') {
            steps {
                bat 'git fetch origin main --depth=1 && git show origin/main:src/addins/sync-addins.bat > "%TEMP%\\opi-sync-addins.bat" && call "%TEMP%\\opi-sync-addins.bat"'
            }
        }

        stage('Git - Publish releases') {
            steps {        
                withCredentials([string(credentialsId: 'gpgkey', variable: 'GPGKEY')]) {          
                    bat encoding: 'UTF-8', script:'chcp 65001 & oscript ./ci/os/ReleasePublisher.os %GPGKEY%'
                }
            }
        }
    }
}
