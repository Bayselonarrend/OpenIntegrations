// Job name: AlpacaWork
// Pipeline from SCM, branch */main, credentials gitalpaca.
// Script path: ci/pipelines/alpaca_work.jenkinsfile
// Agent label: windows. The windows agent needs gh and the Cursor CLI (agent or cursor-agent).
// gh calls use GH_TOKEN from the gitalpaca credential, so comments are authored by VitalyTheAlpaca.

def alpacaClearSkip() {
    bat '''powershell -NoProfile -Command "if (Test-Path .git) { git ls-files -v | ForEach-Object { if ($_ -like 'S *') { git update-index --no-skip-worktree -- $_.Substring(2) } } }; exit 0"'''
}

def alpacaLog(String jobName, int number, int count) {
    def out = 'ci/alpaca/out/downstream-log.txt'
    def status = bat(script: "powershell -NoProfile -ExecutionPolicy Bypass -File ci\\alpaca\\read-log.ps1 -Job \"${jobName}\" -Number ${number} -Lines ${count} -OutFile ${out}", returnStatus: true)
    if (status != 0 || !fileExists(out)) {
        return "log unavailable: ${jobName} #${number} (${status})"
    }
    return readFile(out)
}

def alpacaGhStatus(String script) {
    def status = 1
    for (int attempt = 1; attempt <= 4; attempt++) {
        withCredentials([usernamePassword(credentialsId: 'gitalpaca', usernameVariable: 'ALPACA_GH_USER', passwordVariable: 'GH_TOKEN')]) {
            status = bat(script: script, returnStatus: true)
        }
        if (status == 0) {
            return 0
        }
        echo "gh attempt ${attempt} failed with ${status}"
        if (attempt < 4) {
            sleep(time: 15 * attempt, unit: 'SECONDS')
        }
    }
    return status
}

def alpacaGh(String script) {
    def status = alpacaGhStatus(script)
    if (status != 0) {
        error "gh step failed: ${status}"
    }
}

def alpacaPostedAnswer() {
    def answerFile = 'ci/alpaca/out/answer.md'
    if (!fileExists(answerFile)) {
        return false
    }
    def text = readFile(answerFile).replace('\uFEFF', '').trim()
    if (!text) {
        return false
    }
    def marker = fileExists('ci/alpaca/out/started.txt') ? '' : "<!-- alpaca-start -->\n\n"
    writeFile file: 'ci/alpaca/out/comment.md', text: "<!-- alpaca -->\n${marker}${text}\n"
    alpacaPost()
    currentBuild.description = 'answered'
    return true
}

def alpacaNoChanges() {
    if (alpacaPostedAnswer()) {
        return
    }
    def marker = fileExists('ci/alpaca/out/started.txt') ? '' : "<!-- alpaca-start -->\n\n"
    writeFile file: 'ci/alpaca/out/comment.md', text: "<!-- alpaca -->\n${marker}Агент не менял код. Сборка, тесты и публикация не запускались. Новый цикл не запущен.\n"
    alpacaPost()
    currentBuild.description = 'no code changes'
}

def alpacaPost() {
    def pr = 'pending'
    if (fileExists('ci/alpaca/out/pr.txt')) {
        pr = readFile('ci/alpaca/out/pr.txt').trim()
    }
    def target = (pr ==~ /[0-9]+/) ? 'pr' : 'issue'
    def status = alpacaGhStatus("powershell -NoProfile -ExecutionPolicy Bypass -File ci\\alpaca\\comment-pr.ps1 -BodyFile ci\\alpaca\\out\\comment.md -Target ${target}")
    if (status != 0) {
        error "Comment failed with ${status}"
    }
}

def alpacaReasonText(String reason) {
    if (reason == 'build') {
        return 'Сборка не прошла, возвращаюсь к коду.'
    }
    if (reason == 'tests') {
        return 'Тесты не прошли, возвращаюсь к коду.'
    }
    if (reason == 'comments') {
        return ''
    }
    return 'Начинаю обработку нового issue.'
}

def alpacaMarkStarted() {
    def reason = (env.ALPACA_REASON ?: 'new').toString()
    if (reason == 'comments') {
        def reacted = alpacaGhStatus('powershell -NoProfile -ExecutionPolicy Bypass -File ci\\alpaca\\react-eyes.ps1')
        if (reacted == 0) {
            writeFile file: 'ci/alpaca/out/started.txt', text: '1'
            return
        }
        if (reacted != 2) {
            error "Could not react to the comment: ${reacted}"
        }
    }
    def text = alpacaReasonText(reason)
    def body = "<!-- alpaca -->\n<!-- alpaca-start -->\n"
    if (text) {
        body += "\n${text}\n"
    }
    writeFile file: 'ci/alpaca/out/comment.md', text: body
    def pr = readFile('ci/alpaca/out/pr.txt').trim()
    def target = (pr ==~ /[0-9]+/) ? 'pr' : 'issue'
    def posted = alpacaGhStatus("powershell -NoProfile -ExecutionPolicy Bypass -File ci\\alpaca\\comment-pr.ps1 -BodyFile ci\\alpaca\\out\\comment.md -Target ${target}")
    if (posted != 0) {
        error "Could not post the cycle marker: ${posted}"
    }
    writeFile file: 'ci/alpaca/out/started.txt', text: '1'
}

def alpacaSay(String text) {
    writeFile file: 'ci/alpaca/out/comment.md', text: "<!-- alpaca -->\n\n${text}\n"
    alpacaPost()
    bat 'del /f /q ci\\alpaca\\out\\comment.md'
}

def alpacaRetrigger(String reason) {
    def cycle = Integer.valueOf(env.ALPACA_CYCLE ?: '1')
    def maxCycle = Integer.valueOf(env.ALPACA_MAX ?: '8')
    if (!fileExists('ci/alpaca/out/comment.md')) {
        writeFile file: 'ci/alpaca/out/comment.md', text: "<!-- alpaca -->\n\n${alpacaReasonText(reason)}\n"
    }
    if (cycle >= maxCycle) {
        def existing = readFile('ci/alpaca/out/comment.md')
        writeFile file: 'ci/alpaca/out/comment.md', text: existing + "\n\nДостигнут предел циклов (${maxCycle}). Новый цикл не запущен.\n"
        alpacaPost()
        currentBuild.description = "cycle limit after ${reason}"
        return
    }
    alpacaPost()
    def next = (cycle + 1).toString()
    build job: 'AlpacaWork', wait: false, parameters: [
        [$class: 'StringParameterValue', name: 'ISSUE', value: env.ALPACA_ISSUE],
        [$class: 'StringParameterValue', name: 'REASON', value: reason],
        [$class: 'StringParameterValue', name: 'CYCLE', value: next],
        [$class: 'StringParameterValue', name: 'MAX_CYCLE', value: env.ALPACA_MAX]
    ]
    currentBuild.description = "${reason}: started cycle ${next}"
}

def alpacaCursor(String mode) {
    def keepTree = (mode == 'edit' || mode == 'write-tests' || mode == 'translate-dict')
    if (!keepTree) {
        bat 'powershell -NoProfile -ExecutionPolicy Bypass -File ci\\alpaca\\clear-outputs.ps1'
    }
    alpacaGh("powershell -NoProfile -ExecutionPolicy Bypass -File ci\\alpaca\\prepare-task.ps1 -Mode ${mode}")
    def status = bat(script: "powershell -NoProfile -ExecutionPolicy Bypass -File ci\\alpaca\\run-cursor.ps1 -TaskFile ci\\alpaca\\out\\task.md", returnStatus: true)
    if (!keepTree) {
        bat 'powershell -NoProfile -ExecutionPolicy Bypass -File ci\\alpaca\\restore-tree.ps1'
    }
    return status
}

pipeline {
    agent { label 'windows' }

    options {
        skipDefaultCheckout()
        disableConcurrentBuilds()
        timeout(time: 240, unit: 'MINUTES')
        timestamps()
    }

    parameters {
        string(name: 'ISSUE', defaultValue: '', description: 'Open GitHub issue assigned to VitalyTheAlpaca')
        string(name: 'REASON', defaultValue: 'new', description: 'new, comments, build or tests')
        string(name: 'CYCLE', defaultValue: '1', description: 'Loop counter')
        string(name: 'MAX_CYCLE', defaultValue: '8', description: 'Last cycle that may start another run')
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    alpacaClearSkip()
                    checkout scm
                    def issue = (params.ISSUE ?: '').trim()
                    def reason = (params.REASON ?: 'new').trim()
                    if (!(issue ==~ /[0-9]+/)) {
                        error "Invalid ISSUE: ${issue}"
                    }
                    if (!(reason in ['new', 'comments', 'build', 'tests'])) {
                        error "Invalid REASON: ${reason}"
                    }
                    def cycle = 1
                    def maxCycle = 8
                    try {
                        cycle = Integer.valueOf((params.CYCLE ?: '1').trim())
                    } catch (err) {
                        cycle = 1
                    }
                    try {
                        maxCycle = Integer.valueOf((params.MAX_CYCLE ?: '8').trim())
                    } catch (err) {
                        maxCycle = 8
                    }
                    if (cycle < 1) {
                        cycle = 1
                    }
                    if (maxCycle < 1) {
                        maxCycle = 8
                    }
                    env.ALPACA_ISSUE = issue
                    env.ALPACA_REASON = reason
                    env.ALPACA_CYCLE = cycle.toString()
                    env.ALPACA_MAX = maxCycle.toString()
                    env.ALPACA_BRANCH = "alpaca/${issue}"
                    env.ALPACA_ADDINS = "addins-alpaca-${issue}"
                    env.ALPACA_COMMITTED = 'false'
                    env.ALPACA_BUILD_OK = 'false'
                    env.ALPACA_SKIP = 'false'
                    def issueState = alpacaGhStatus('powershell -NoProfile -ExecutionPolicy Bypass -File ci\\alpaca\\issue-open.ps1')
                    if (issueState == 3) {
                        echo "Issue #${issue} is closed"
                        currentBuild.description = "issue #${issue} closed"
                        env.ALPACA_SKIP = 'true'
                    } else if (issueState != 0) {
                        error "Could not read issue state: ${issueState}"
                    } else {
                        withCredentials([gitUsernamePassword(credentialsId: 'gitalpaca', gitToolName: 'Default')]) {
                            bat 'powershell -NoProfile -ExecutionPolicy Bypass -File ci\\alpaca\\checkout.ps1'
                        }
                    }
                }
            }
        }

        stage('Pull request') {
            when { expression { return env.ALPACA_SKIP != 'true' } }
            steps {
                script {
                    alpacaGh('powershell -NoProfile -ExecutionPolicy Bypass -File ci\\alpaca\\ensure-pr.ps1 -LookupOnly')
                    def pr = readFile('ci/alpaca/out/pr.txt').trim()
                    if (pr ==~ /[0-9]+/) {
                        alpacaMarkStarted()
                    }
                }
            }
        }

        stage('Code') {
            when { expression { return env.ALPACA_SKIP != 'true' } }
            steps {
                script {
                    bat 'powershell -NoProfile -Command "Remove-Item -Force -ErrorAction SilentlyContinue ci\\alpaca\\out\\answer.md; exit 0"'
                    def edited = alpacaCursor('edit')
                    if (edited != 0) {
                        def marker = fileExists('ci/alpaca/out/started.txt') ? '' : "<!-- alpaca-start -->\n\n"
                        writeFile file: 'ci/alpaca/out/comment.md', text: "<!-- alpaca -->\n${marker}Cursor CLI завершился с кодом ${edited}. Новый цикл не запущен.\n"
                        alpacaPost()
                        error "Cursor CLI failed: ${edited}"
                    }
                    def pending = bat(script: 'powershell -NoProfile -Command "if ([string]::IsNullOrWhiteSpace((git status --porcelain | Out-String))) { exit 2 } else { exit 0 }"', returnStatus: true)
                    if (pending == 2) {
                        alpacaNoChanges()
                        return
                    }
                    if (pending != 0) {
                        error "git status failed: ${pending}"
                    }
                    bat 'powershell -NoProfile -Command "Remove-Item -Force -ErrorAction SilentlyContinue ci\\alpaca\\out\\answer.md; exit 0"'
                    def tested = alpacaCursor('write-tests')
                    if (tested != 0) {
                        def marker = fileExists('ci/alpaca/out/started.txt') ? '' : "<!-- alpaca-start -->\n\n"
                        writeFile file: 'ci/alpaca/out/comment.md', text: "<!-- alpaca -->\n${marker}Шаг тестов публичного API завершился с кодом ${tested}. Коммит не сделан. Новый цикл не запущен.\n"
                        alpacaPost()
                        error "Cursor test step failed: ${tested}"
                    }
                    def pendingAfter = bat(script: 'powershell -NoProfile -Command "if ([string]::IsNullOrWhiteSpace((git status --porcelain | Out-String))) { exit 2 } else { exit 0 }"', returnStatus: true)
                    if (pendingAfter == 2) {
                        alpacaNoChanges()
                        return
                    }
                    if (pendingAfter != 0) {
                        error "git status failed: ${pendingAfter}"
                    }
                    def dict = bat(script: 'oscript ./ci/os/internal/Classes/DictionariesMethods.os', returnStatus: true)
                    if (dict == 111) {
                        def translated = alpacaCursor('translate-dict')
                        if (translated != 0) {
                            def marker = fileExists('ci/alpaca/out/started.txt') ? '' : "<!-- alpaca-start -->\n\n"
                            writeFile file: 'ci/alpaca/out/comment.md', text: "<!-- alpaca -->\n${marker}Перевод новых слов словаря завершился с кодом ${translated}. Коммит не сделан. Новый цикл не запущен.\n"
                            alpacaPost()
                            error "Dictionary translation failed: ${translated}"
                        }
                        dict = bat(script: 'oscript ./ci/os/internal/Classes/DictionariesMethods.os', returnStatus: true)
                    }
                    if (dict == 111) {
                        def marker = fileExists('ci/alpaca/out/started.txt') ? '' : "<!-- alpaca-start -->\n\n"
                        writeFile file: 'ci/alpaca/out/comment.md', text: "<!-- alpaca -->\n${marker}В словаре остались пустые переводы. Коммит не сделан. Новый цикл не запущен.\n"
                        alpacaPost()
                        error 'Dictionary still has empty translations'
                    }
                    if (dict != 0) {
                        error "Dictionary update failed: ${dict}"
                    }
                    def committed = 1
                    withCredentials([
                        gitUsernamePassword(credentialsId: 'gitalpaca', gitToolName: 'Default'),
                        usernamePassword(credentialsId: 'gitalpaca', usernameVariable: 'ALPACA_GH_USER', passwordVariable: 'GH_TOKEN')
                    ]) {
                        committed = bat(script: 'powershell -NoProfile -ExecutionPolicy Bypass -File ci\\alpaca\\commit-push.ps1', returnStatus: true)
                    }
                    if (committed == 2) {
                        alpacaNoChanges()
                        return
                    }
                    if (committed != 0) {
                        error "git commit failed: ${committed}"
                    }
                    withCredentials([gitUsernamePassword(credentialsId: 'gitalpaca', gitToolName: 'Default')]) {
                        alpacaGh('powershell -NoProfile -ExecutionPolicy Bypass -File ci\\alpaca\\ensure-pr.ps1')
                    }
                    if (!fileExists('ci/alpaca/out/started.txt')) {
                        alpacaMarkStarted()
                    }
                    env.ALPACA_COMMITTED = 'true'
                }
            }
        }

        stage('Publish addins') {
            when { expression { return env.ALPACA_COMMITTED == 'true' } }
            steps {
                script {
                    def published = 1
                    withCredentials([gitUsernamePassword(credentialsId: 'gitalpaca', gitToolName: 'Default')]) {
                        published = bat(script: "call src\\addins\\publish-addins.bat ${env.ALPACA_ADDINS}", returnStatus: true)
                    }
                    if (published != 0) {
                        writeFile file: 'ci/alpaca/out/comment.md', text: "<!-- alpaca -->\n\nПубликация компонент не прошла. Новый цикл не запущен.\n"
                        alpacaPost()
                        error "publish-addins failed: ${published}"
                    }
                }
            }
        }

        stage('BigFloppa') {
            when { expression { return env.ALPACA_COMMITTED == 'true' } }
            steps {
                script {
                    alpacaSay('Начинаю сборку.')
                    def downstream
                    try {
                        downstream = build job: 'BigFloppa', wait: true, propagate: false, parameters: [
                            [$class: 'StringParameterValue', name: 'BRANCH', value: env.ALPACA_BRANCH],
                            [$class: 'StringParameterValue', name: 'ADDINS_BRANCH', value: env.ALPACA_ADDINS],
                            [$class: 'BooleanParameterValue', name: 'UPLOAD_ARTIFACTS', value: false],
                            [$class: 'BooleanParameterValue', name: 'SKIP_DB_UPDATE', value: true]
                        ]
                    } catch (err) {
                        writeFile file: 'ci/alpaca/out/comment.md', text: "<!-- alpaca -->\n\nBigFloppa не стартовал.\n\n${err}\n\nПараметр SKIP_DB_UPDATE появляется после первого прогона BigFloppa с этим Jenkinsfile на main. Новый цикл не запущен.\n"
                        alpacaPost()
                        currentBuild.description = 'BigFloppa did not start'
                        return
                    }
                    env.DOWNSTREAM_RESULT = downstream.result ?: 'UNKNOWN'
                    env.DOWNSTREAM_URL = downstream.absoluteUrl ?: ''
                    if (env.DOWNSTREAM_RESULT == 'SUCCESS') {
                        env.ALPACA_BUILD_OK = 'true'
                        return
                    }
                    writeFile file: 'ci/alpaca/out/build-log.txt', text: alpacaLog('BigFloppa', downstream.number as int, 500)
                    try {
                        alpacaCursor('explain-build')
                    } catch (err) {
                        echo "Build explanation failed: ${err}"
                    }
                    if (!fileExists('ci/alpaca/out/comment.md')) {
                        writeFile file: 'ci/alpaca/out/comment.md', text: "<!-- alpaca -->\n\nСборка не прошла: ${env.DOWNSTREAM_RESULT}\n${env.DOWNSTREAM_URL}\n"
                    }
                    alpacaRetrigger('build')
                }
            }
        }

        stage('Tests') {
            when {
                allOf {
                    expression { return env.ALPACA_COMMITTED == 'true' }
                    expression { return env.ALPACA_BUILD_OK == 'true' }
                }
            }
            steps {
                script {
                    def picked = 1
                    try {
                        picked = alpacaCursor('pick-tests')
                    } catch (err) {
                        echo "Test pick failed: ${err}"
                        picked = 1
                    }
                    if (picked != 0 || !fileExists('ci/alpaca/out/test-job.txt')) {
                        writeFile file: 'ci/alpaca/out/comment.md', text: "<!-- alpaca -->\n\nНе удалось выбрать тестовое задание. Новый цикл не запущен.\n"
                        alpacaPost()
                        currentBuild.description = 'no test job'
                        return
                    }
                    def jobs = readFile('ci/alpaca/out/test-job.txt')
                        .replace('\uFEFF', '')
                        .split(/\r?\n/)
                        .collect { it.trim() }
                        .findAll { it && !it.startsWith('#') }
                    if (jobs.size() == 1 && jobs[0].equalsIgnoreCase('none')) {
                        writeFile file: 'ci/alpaca/out/comment.md', text: "<!-- alpaca -->\n\nИзменения не требуют прогона тестов библиотеки. Новый цикл не запущен.\n"
                        alpacaPost()
                        currentBuild.description = 'tests not required'
                        return
                    }
                    def expanded = []
                    for (int i = 0; i < jobs.size(); i++) {
                        def jobName = jobs[i]
                        if (expanded.contains(jobName)) {
                            continue
                        }
                        expanded << jobName
                        def enJob = jobName.replaceAll(/OpiOsWinRu$/, 'OpiOsWinEn')
                        if (enJob != jobName && !expanded.contains(enJob)) {
                            expanded << enJob
                        }
                    }
                    jobs = expanded
                    alpacaSay('Начинаю прогон тестов, RU и EN.')
                    def summaryFile = 'ci/alpaca/out/tests-summary.md'
                    writeFile file: summaryFile, text: ''
                    def anyFailed = false
                    def blocked = false
                    for (int i = 0; i < jobs.size(); i++) {
                        def jobName = jobs[i].replace('\uFEFF', '').trim()
                        if (!(jobName ==~ /^OPITest\/Opi(FullTest|SplitTests)\/[A-Za-z0-9_.\/]+$/)) {
                            blocked = true
                            def invalid = readFile(summaryFile) + "invalid: ${jobName}\n"
                            writeFile file: summaryFile, text: invalid
                            break
                        }
                        try {
                            def testRun = build job: jobName, wait: true, propagate: false, parameters: [
                                [$class: 'StringParameterValue', name: 'BRANCH', value: env.ALPACA_BRANCH],
                                [$class: 'StringParameterValue', name: 'ADDINS_BRANCH', value: env.ALPACA_ADDINS]
                            ]
                            def result = testRun.result ?: 'UNKNOWN'
                            def chunk = "${jobName} ${result} ${testRun.absoluteUrl}\n"
                            if (result != 'SUCCESS') {
                                anyFailed = true
                                chunk += alpacaLog(jobName, testRun.number as int, 2500) + "\n"
                            }
                            def current = readFile(summaryFile) + chunk
                            if (current.length() > 150000) {
                                current = current.substring(0, 150000) + "\n...\n"
                            }
                            writeFile file: summaryFile, text: current
                        } catch (err) {
                            blocked = true
                            def current = readFile(summaryFile) + "${jobName} did not start: ${err}\n"
                            writeFile file: summaryFile, text: current
                            break
                        }
                    }
                    if (blocked) {
                        writeFile file: 'ci/alpaca/out/comment.md', text: "<!-- alpaca -->\n\nТестовое задание не запустилось. Новый цикл не запущен.\n\n" + readFile(summaryFile)
                        alpacaPost()
                        currentBuild.description = 'tests did not start'
                        return
                    }
                    def judged = 1
                    try {
                        judged = alpacaCursor('judge-tests')
                    } catch (err) {
                        echo "Test judge failed: ${err}"
                        judged = 1
                    }
                    def rawVerdict = ''
                    if (fileExists('ci/alpaca/out/verdict.txt')) {
                        def line = readFile('ci/alpaca/out/verdict.txt').replace('\uFEFF', '').split(/\r?\n/).find { it.trim() }
                        if (line) {
                            rawVerdict = line.trim().toLowerCase()
                        }
                    }
                    def verdict = rawVerdict == 'retrigger' ? 'retrigger' : 'stop'
                    def askedRetrigger = verdict == 'retrigger'
                    if (!anyFailed) {
                        verdict = 'stop'
                    } else if (rawVerdict != 'retrigger' && rawVerdict != 'stop') {
                        verdict = 'retrigger'
                        def summary = readFile(summaryFile)
                        if (summary.length() > 12000) {
                            summary = summary.substring(summary.length() - 12000)
                        }
                        writeFile file: 'ci/alpaca/out/comment.md', text: "<!-- alpaca -->\n\nВыбранные тесты упали, разбор не завершился. Запускаю следующий цикл.\n\n${summary}\n"
                    }
                    if (!fileExists('ci/alpaca/out/comment.md')) {
                        def fallback = anyFailed
                            ? "Тесты завершились с ошибкой, связь с изменёнными методами не подтверждена. Новый цикл не запущен."
                            : "Выбранные тесты прошли. Новый цикл не запущен."
                        writeFile file: 'ci/alpaca/out/comment.md', text: "<!-- alpaca -->\n\n${fallback}\n"
                    } else if (!anyFailed && askedRetrigger) {
                        def existing = readFile('ci/alpaca/out/comment.md')
                        writeFile file: 'ci/alpaca/out/comment.md', text: existing + "\n\nВыбранные задания завершились успешно. Новый цикл не запущен.\n"
                    }
                    if (verdict == 'retrigger') {
                        alpacaRetrigger('tests')
                        return
                    }
                    currentBuild.description = anyFailed ? 'tests not related' : 'tests passed'
                    alpacaPost()
                }
            }
        }
    }
    post {
        always {
            script {
                alpacaClearSkip()
            }
        }
    }
}
