pipeline {
    agent {
        label 'windows'
    }
    stages {
        stage('Sync add-ins') {
            steps {
                bat 'git fetch origin main --depth=1 && git show origin/main:src/addins/sync-addins.bat > "%TEMP%\\opi-sync-addins.bat" && call "%TEMP%\\opi-sync-addins.bat"'
            }
        }

        stage('Deploy') {
            steps {
                bat encoding: 'UTF-8', script:'oscript ./ci/os/DocsDeployScript.os release ru'
            }
        }
    }
}