pipeline {
    agent any
    stages {

        stage('Sync add-ins') {
            steps {
                bat 'git fetch origin main --depth=1 && git show origin/main:src/addins/sync-addins.bat > "%TEMP%\\opi-sync-addins.bat" && call "%TEMP%\\opi-sync-addins.bat"'
            }
        }

        stage('Upload') {
            steps {               
                bat encoding: 'UTF-8', script:'chcp 65001 & oscript ./ci/os/internal/Classes/SourceForgeUploader.os'
            }
        }
    }
}