def lua(Map opts = [:], String scriptPath) {
    def args = (opts.args ?: '').toString().trim()
    def returnStatus = opts.returnStatus == true
    def command = args ? "lua \"${scriptPath}\" ${args}" : "lua \"${scriptPath}\""
    if (isUnix()) {
        return sh(script: command, returnStatus: returnStatus)
    }
    return bat(script: command, returnStatus: returnStatus)
}
pipeline {
    agent {
        label 'windows'
    }

    parameters {
        booleanParam(
            name: 'CONFIRM_RUN',
            defaultValue: false,
            description: 'Confirmation'
        )
    }

    stages {
        stage('Check confirmation') {
            steps {
                script {
                    if (!params.CONFIRM_RUN) {
                        error('Pipeline execution cancelled. Set CONFIRM_RUN=true to proceed.')
                    }
                }
                echo 'Confirmation received. Starting pipeline execution...'
            }
        }

        stage('Sync add-ins') {
            steps {
                bat 'git fetch origin main --depth=1 && git show origin/main:src/addins/sync-addins.bat > "%TEMP%\\opi-sync-addins.bat" && call "%TEMP%\\opi-sync-addins.bat"'
            }
        }

        stage('Docs - Primary site update') {
            steps {
                build job: 'OpiDocs/OpiDocsRu', wait: true
                build job: 'OpiDocs/OpiDocsEn', wait: true
            }
        }
        stage('Git - Publish releases') {
            steps {        
                build job: 'OpiBuild/Publish', wait: true
            }
        }
        stage('OPM - Push') {
            steps {
                build job: 'OpiBuild/OpiOpmPush', wait: true
            }
        }
        stage('SourceForge - Update') {
            steps {
                build job: 'OpiBuild/OpiSourceForge', wait: true
            }
        }
    }
}