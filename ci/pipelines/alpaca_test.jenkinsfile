def lua(Map opts = [:], String scriptPath) {
    def args = (opts.args ?: '').toString().trim()
    def returnStatus = opts.returnStatus == true
    def command = args ? "lua \"${scriptPath}\" ${args}" : "lua \"${scriptPath}\""
    if (isUnix()) {
        return sh(script: command, returnStatus: returnStatus)
    }
    return bat(script: command, returnStatus: returnStatus)
}
// Job name: Alpaca/Polina/AlpacaTest
// Folder display name: Alpaca | Полина. Jenkins rejects "|" in an item name.
// Pipeline from SCM, branch */main, credentials gitpolina.
// gh and git inside the build use credential gitpolina.
// Script path: ci/pipelines/alpaca_test.jenkinsfile
// Agent label: windows. gh and git use ci/alpaca/agents/polina/agent.json.

def alpacaClearSkip() {
    if (fileExists('ci/alpaca/clear-skip.lua')) {
        lua('ci/alpaca/clear-skip.lua')
    }
}

def alpacaCommitFeelings() {
    if (!env.ALPACA_BRANCH || !env.ALPACA_CREDENTIAL || !env.ALPACA_AGENT) {
        return
    }
    def committed = 1
    withCredentials([gitUsernamePassword(credentialsId: env.ALPACA_CREDENTIAL, gitToolName: 'Default')]) {
        committed = lua(returnStatus: true, 'ci/alpaca/commit-feelings.lua')
    }
    if (committed != 0 && committed != 2) {
        echo "feelings commit failed: ${committed}"
    }
}

def alpacaLog(String jobName, int number, int count) {
    def out = 'ci/alpaca/out/downstream-log.txt'
    def status = lua(args: "\"${jobName}\" ${number} ${count} ${out}", returnStatus: true, 'ci/alpaca/read-log.lua')
    if (status != 0 || !fileExists(out)) {
        return "log unavailable: ${jobName} #${number} (${status})"
    }
    return readFile(out)
}

def alpacaCursor(String mode) {
    def keepTree = (mode == 'translate-dict')
    if (!keepTree) {
        lua('ci/alpaca/clear-outputs.lua')
    }
    alpacaGh('ci/alpaca/prepare-task.lua', "${mode}")
    def status = lua(args: 'ci/alpaca/out/task.md', returnStatus: true, 'ci/alpaca/run-cursor.lua')
    if (!keepTree) {
        lua('ci/alpaca/restore-tree.lua')
    }
    return status
}

def alpacaGhStatus(String scriptPath, String args = '') {
    def status = 1
    for (int attempt = 1; attempt <= 4; attempt++) {
        withCredentials([usernamePassword(credentialsId: env.ALPACA_CREDENTIAL, usernameVariable: 'ALPACA_GH_USER', passwordVariable: 'GH_TOKEN')]) {
            status = lua(args: args, returnStatus: true, scriptPath)
        }
        if (status == 0 || status == 2) {
            return status
        }
        echo "gh attempt ${attempt} failed with ${status}"
        if (attempt < 4) {
            sleep(time: 15 * attempt, unit: 'SECONDS')
        }
    }
    return status
}

def alpacaGh(String scriptPath, String args = '') {
    def status = alpacaGhStatus(scriptPath, args)
    if (status != 0) {
        error "gh step failed: ${status}"
    }
}

def alpacaPost() {
    def pr = 'pending'
    if (fileExists('ci/alpaca/out/pr.txt')) {
        pr = readFile('ci/alpaca/out/pr.txt').trim()
    }
    def target = (pr ==~ /[0-9]+/) ? 'pr' : 'issue'
    def status = alpacaGhStatus('ci/alpaca/comment-pr.lua', "ci/alpaca/out/comment.md ${target}")
    if (status != 0) {
        error "Comment failed with ${status}"
    }
}

pipeline {
    agent { label 'windows' }

    options {
        skipDefaultCheckout()
        disableConcurrentBuilds()
        timeout(time: 240, unit: 'MINUTES')
        timestamps()
    }

    parameters {
        string(name: 'ISSUE', defaultValue: '', description: 'Issue or alpaca pull request where PolinaTheAlpaca was mentioned')
        string(name: 'REASON', defaultValue: 'comments', description: 'comments')
        string(name: 'CYCLE', defaultValue: '1', description: 'Unused, accepted so Watch can pass the same parameters')
        string(name: 'MAX_CYCLE', defaultValue: '8', description: 'Unused, accepted so Watch can pass the same parameters')
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    env.ALPACA_AGENT = 'polina'
                    env.ALPACA_CREDENTIAL = 'gitpolina'
                    env.ALPACA_JOB = 'Alpaca/Polina/AlpacaTest'
                    alpacaClearSkip()
                    checkout scm
                    def issue = (params.ISSUE ?: '').trim()
                    def reason = (params.REASON ?: '').trim()
                    if (!(issue ==~ /[0-9]+/)) {
                        error "Invalid ISSUE: ${issue}"
                    }
                    if (reason != 'comments') {
                        error "Invalid REASON: ${reason}"
                    }
                    env.ALPACA_ISSUE = issue
                    env.ALPACA_REASON = reason
                    env.ALPACA_CYCLE = '1'
                    env.ALPACA_MAX = '1'
                    env.ALPACA_BRANCH = "alpaca/${issue}"
                    env.ALPACA_ADDINS = "addins-alpaca-${issue}"
                    env.ALPACA_SKIP = 'false'
                    def issueState = alpacaGhStatus('ci/alpaca/issue-open.lua')
                    if (issueState == 3) {
                        echo "Issue #${issue} is closed"
                        currentBuild.description = "issue #${issue} closed"
                        env.ALPACA_SKIP = 'true'
                    } else if (issueState != 0) {
                        error "Could not read issue state: ${issueState}"
                    } else {
                        withCredentials([gitUsernamePassword(credentialsId: env.ALPACA_CREDENTIAL, gitToolName: 'Default')]) {
                            lua('ci/alpaca/checkout.lua')
                        }
                        lua('ci/alpaca/prepare-mcp.lua')
                    }
                }
            }
        }

        stage('Pull request') {
            when { expression { return env.ALPACA_SKIP != 'true' } }
            steps {
                script {
                    alpacaGh('ci/alpaca/ensure-pr.lua', '--lookup')
                    def reacted = alpacaGhStatus('ci/alpaca/react-eyes.lua')
                    if (reacted == 2) {
                        echo "Mention is already taken"
                        currentBuild.description = 'mention already taken'
                        env.ALPACA_SKIP = 'true'
                        return
                    }
                    if (reacted != 0) {
                        error "Could not react to the mention: ${reacted}"
                    }
                    alpacaGh('ci/alpaca/began.lua')
                }
            }
        }

        stage('Tests') {
            when { expression { return env.ALPACA_SKIP != 'true' } }
            steps {
                script {
                    alpacaGh('ci/alpaca/prepare-task.lua', 'confirm')
                    def tested = 1
                    withCredentials([string(credentialsId: 'gpgkey', variable: 'GPGKEY')]) {
                        tested = lua(args: 'ci/alpaca/out/task.md', returnStatus: true, 'ci/alpaca/run-cursor.lua')
                    }
                    if (tested != 0) {
                        writeFile file: 'ci/alpaca/out/comment.md', text: "<!-- alpaca -->\n\nПроверка не записалась, Cursor CLI завершился с кодом ${tested}.\n"
                        alpacaPost()
                        error "Cursor CLI failed: ${tested}"
                    }
                    def pending = lua(returnStatus: true, 'ci/alpaca/git-dirty.lua')
                    if (pending == 0) {
                        def dict = load('ci/alpaca/fill-dict.groovy').fill { alpacaCursor('translate-dict') }
                        if (dict < 0) {
                            writeFile file: 'ci/alpaca/out/comment.md', text: "<!-- alpaca -->\n\nПеревод новых слов словаря завершился с кодом ${-dict}. Коммит не сделан.\n"
                            alpacaPost()
                            error "Dictionary translation failed: ${-dict}"
                        }
                        if (dict == 111) {
                            writeFile file: 'ci/alpaca/out/comment.md', text: "<!-- alpaca -->\n\nВ словаре остались пустые переводы. Коммит не сделан.\n"
                            alpacaPost()
                            error 'Dictionary still has empty translations'
                        }
                        if (dict != 0) {
                            error "Dictionary update failed: ${dict}"
                        }
                        def committed = 1
                        withCredentials([
                            gitUsernamePassword(credentialsId: env.ALPACA_CREDENTIAL, gitToolName: 'Default'),
                            usernamePassword(credentialsId: env.ALPACA_CREDENTIAL, usernameVariable: 'ALPACA_GH_USER', passwordVariable: 'GH_TOKEN')
                        ]) {
                            committed = lua(returnStatus: true, 'ci/alpaca/commit-push.lua')
                        }
                        if (committed != 0 && committed != 2) {
                            error "git commit failed: ${committed}"
                        }
                    } else if (pending != 2) {
                        error "git status failed: ${pending}"
                    }
                    def jobs = []
                    if (fileExists('ci/alpaca/out/test-job.txt')) {
                        jobs = readFile('ci/alpaca/out/test-job.txt')
                            .replace('\uFEFF', '')
                            .split(/\r?\n/)
                            .collect { it.trim() }
                            .findAll { it && !it.startsWith('#') }
                    }
                    def skipRun = jobs.isEmpty() || (jobs.size() == 1 && jobs[0].equalsIgnoreCase('none'))
                    def buildOk = true
                    if (!skipRun) {
                        def downstream
                        try {
                            downstream = load('ci/alpaca/bsl-build.groovy').run()
                        } catch (err) {
                            buildOk = false
                            writeFile file: 'ci/alpaca/out/comment.md', text: "<!-- alpaca -->\n\nСборка зеркал не стартовала, тесты OneScript не запускались.\n\n${err}\n"
                        }
                        if (buildOk && (downstream.result ?: 'UNKNOWN') != 'SUCCESS') {
                            buildOk = false
                            def log = alpacaLog('BigFloppa', downstream.number as int, 500)
                            writeFile file: 'ci/alpaca/out/comment.md', text: "<!-- alpaca -->\n\nСборка зеркал не прошла, тесты OneScript не запускались. Правка BSL в зеркало ещё не попала.\n\n${downstream.absoluteUrl}\n\n${log}\n"
                        }
                    }
                    if (!skipRun && buildOk) {
                        def expanded = []
                        for (int i = 0; i < jobs.size(); i++) {
                            def jobName = jobs[i]
                            if (expanded.contains(jobName)) {
                                continue
                            }
                            expanded << jobName
                            def enJob = jobName.replaceAll(/OpiOsWinRu$/, 'OpiOsWinEn')
                            if (enJob != jobName && !expanded.contains(enJob)) {
                                expanded << enJob
                            }
                        }
                        def summaryFile = 'ci/alpaca/out/tests-summary.md'
                        writeFile file: summaryFile, text: ''
                        def blocked = false
                        for (int i = 0; i < expanded.size(); i++) {
                            def jobName = expanded[i].replace('\uFEFF', '').trim()
                            if (!(jobName ==~ /^OPITest\/Opi(FullTest|SplitTests)\/[A-Za-z0-9_.\/]+$/)) {
                                blocked = true
                                writeFile file: summaryFile, text: readFile(summaryFile) + "invalid: ${jobName}\n"
                                break
                            }
                            try {
                                def testRun = build job: jobName, wait: true, propagate: false, parameters: [
                                    [$class: 'StringParameterValue', name: 'BRANCH', value: env.ALPACA_BRANCH],
                                    [$class: 'StringParameterValue', name: 'ADDINS_BRANCH', value: env.ALPACA_ADDINS]
                                ]
                                def result = testRun.result ?: 'UNKNOWN'
                                def chunk = "${jobName} ${result} ${testRun.absoluteUrl}\n"
                                if (result != 'SUCCESS') {
                                    chunk += alpacaLog(jobName, testRun.number as int, 2500) + "\n"
                                }
                                def current = readFile(summaryFile) + chunk
                                if (current.length() > 150000) {
                                    current = current.substring(0, 150000) + "\n...\n"
                                }
                                writeFile file: summaryFile, text: current
                            } catch (err) {
                                blocked = true
                                writeFile file: summaryFile, text: readFile(summaryFile) + "${jobName} did not start: ${err}\n"
                                break
                            }
                        }
                        if (blocked) {
                            writeFile file: 'ci/alpaca/out/comment.md', text: "<!-- alpaca -->\n\nТестовое задание не запустилось.\n\n" + readFile(summaryFile)
                        } else {
                            def judged = alpacaCursor('judge-tests')
                            if (judged != 0 || !fileExists('ci/alpaca/out/comment.md')) {
                                def summary = readFile(summaryFile)
                                if (summary.length() > 12000) {
                                    summary = summary.substring(summary.length() - 12000)
                                }
                                writeFile file: 'ci/alpaca/out/comment.md', text: "<!-- alpaca -->\n\nПрогон завершился, разбор не записался.\n\n${summary}\n"
                            }
                        }
                    }
                    if (!fileExists('ci/alpaca/out/comment.md')) {
                        error 'Comment is missing'
                    }
                    def newer = alpacaGhStatus('ci/alpaca/newer-mention.lua')
                    if (newer == 0) {
                        lua('ci/alpaca/strip-mentions.lua')
                    } else if (newer != 2) {
                        error "Could not read mentions: ${newer}"
                    }
                    alpacaPost()
                    currentBuild.description = 'answered'
                }
            }
        }
    }

    post {
        always {
            script {
                alpacaCommitFeelings()
                alpacaClearSkip()
            }
        }
    }
}
