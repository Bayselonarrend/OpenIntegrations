def lua(Map opts = [:], String scriptPath) {
    def args = (opts.args ?: '').toString().trim()
    def returnStatus = opts.returnStatus == true
    def command = args ? "lua \"${scriptPath}\" ${args}" : "lua \"${scriptPath}\""
    if (isUnix()) {
        return sh(script: command, returnStatus: returnStatus)
    }
    return bat(script: command, returnStatus: returnStatus)
}
// Job name: Alpaca/AlpacaWatch
// Folder display name: Alpaca | Агентская разработка. Jenkins rejects "|" in an item name.
// Pipeline from SCM, branch */main, credentials gitalpaca.
// Script path: ci/pipelines/alpaca_watch.jenkinsfile
// Agent label: windows. The windows agent needs gh. Issue and PR calls use GH_TOKEN from gitalpaca.

@NonCPS
void enqueueQuietWatchDeletion(String jobName, int number) {
    def left = new java.util.concurrent.atomic.AtomicInteger(4)
    def task = null
    task = {
        def job = jenkins.model.Jenkins.instance.getItemByFullName(jobName)
        def finished = job == null ? null : job.getBuildByNumber(number)
        if (finished == null) {
            return
        }
        if (finished.isBuilding() && left.decrementAndGet() > 0) {
            jenkins.util.Timer.get().schedule(task, 20, java.util.concurrent.TimeUnit.SECONDS)
            return
        }
        if (!finished.isBuilding()) {
            finished.delete()
        }
    } as Runnable
    jenkins.util.Timer.get().schedule(task, 20, java.util.concurrent.TimeUnit.SECONDS)
}

pipeline {
    agent { label 'windows' }

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '1'))
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
    }

    triggers {
        cron('H/7 * * * *')
    }

    stages {
        stage('Watch') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'gitalpaca', usernameVariable: 'ALPACA_GH_USER', passwordVariable: 'GH_TOKEN')]) {
                        lua('ci/alpaca/watch.lua')
                    }
                    if (!fileExists('ci/alpaca/out/triggers.txt')) {
                        echo 'Nothing to run'
                        return
                    }
                    def started = []
                    readFile('ci/alpaca/out/triggers.txt').split(/\r?\n/).each { agentId ->
                        def id = agentId.trim()
                        if (!id) {
                            return
                        }
                        def issue = ''
                        def reason = ''
                        def job = ''
                        readFile("ci/alpaca/out/trigger-${id}.properties").split(/\r?\n/).each { line ->
                            def parts = line.split('=', 2)
                            if (parts.length != 2) {
                                return
                            }
                            if (parts[0].trim() == 'issue') {
                                issue = parts[1].trim()
                            }
                            if (parts[0].trim() == 'reason') {
                                reason = parts[1].trim()
                            }
                            if (parts[0].trim() == 'job') {
                                job = parts[1].trim()
                            }
                        }
                        if (!(issue ==~ /[0-9]+/)) {
                            error "No issue in trigger for ${id}"
                        }
                        if (!(reason in ['new', 'comments', 'review'])) {
                            error "Invalid trigger reason: ${reason}"
                        }
                        if (!job) {
                            error "No job in trigger for ${id}"
                        }
                        build job: job, wait: false, parameters: [
                            [$class: 'StringParameterValue', name: 'ISSUE', value: issue],
                            [$class: 'StringParameterValue', name: 'REASON', value: reason],
                            [$class: 'StringParameterValue', name: 'CYCLE', value: '1'],
                            [$class: 'StringParameterValue', name: 'MAX_CYCLE', value: '8']
                        ]
                        started << "${id} ${reason} #${issue}"
                    }
                    if (started) {
                        currentBuild.description = 'started ' + started.join(', ')
                    }
                }
            }
        }
    }

    post {
        cleanup {
            script {
                def note = currentBuild.description ?: ''
                if (currentBuild.currentResult == 'SUCCESS' && !note.trim()) {
                    try {
                        enqueueQuietWatchDeletion(env.JOB_NAME, env.BUILD_NUMBER as int)
                    } catch (err) {
                        echo "Quiet build kept: ${err}"
                    }
                }
            }
        }
    }
}
