    Таймаут = 30;

    Опции = Новый Структура;
    Опции.Вставить("url", URL);
    Опции.Вставить("bind", BindDN);
    Опции.Вставить("pass", Пароль);
    Опции.Вставить("tout", Таймаут);

    ПараметрыСоединения = OPI_ПолучениеДанныхТестов.ВыполнитьТестCLI("ldap", "СформироватьПараметрыСоединения", Опции);
    Результат           = OPI_LDAP.ОткрытьСоединение(ПараметрыСоединения);

    // END

    OPI_ПолучениеДанныхТестов.ОбработатьCLI(Результат, "LDAP", "ОткрытьСоединение");

КонецПроцедуры

