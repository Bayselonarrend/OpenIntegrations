Процедура GRPC_ПолучитьНастройкиTls(ПараметрыФункции)

    Результат = OPI_GRPC.ПолучитьНастройкиTls(Истина, "ca.pem", "client.key", "client.crt");

    // END

    OPI_ПолучениеДанныхТестов.Обработать(Результат
        , "GRPC"
        , "ПолучитьНастройкиTls"
        ,
        "ca.pem"
        , "client.key"
        , "client.crt");

    Результат = OPI_GRPC.ПолучитьНастройкиTls(Истина);

    OPI_ПолучениеДанныхТестов.Обработать(Результат, "GRPC", "ПолучитьНастройкиTls", "БезКлиента");

КонецПроцедуры

Процедура GRPC_УстановитьМетаданные(ПараметрыФункции)

    Адрес = ПараметрыФункции["GRPC_Address"];

    Proto1 = ПараметрыФункции["GRPC_ProtoImport"]; // Строка, путь к файлу или URL
    Proto2 = ПараметрыФункции["GRPC_ProtoTS"];     // Строка, путь к файлу или URL

    Схемы = Новый Соответствие;
    Схемы.Вставить("main.proto"    , Proto1); // Основной
    Схемы.Вставить("my_types.proto", Proto2); // Для импорта в основной

    Параметры = OPI_GRPC.ПолучитьПараметрыСоединения(Адрес, Схемы);
    Tls       = OPI_GRPC.ПолучитьНастройкиTls(Истина);

    Соединение = OPI_GRPC.ОткрытьСоединение(Параметры, Tls);

    Мета      = Новый Структура("somekey", "somevalue");
    Результат = OPI_GRPC.УстановитьМетаданные(Соединение, Мета);

    // END

    OPI_ПолучениеДанныхТестов.Обработать(Результат, "GRPC", "УстановитьМетаданные");

    Если Не OPI_ПолучениеДанныхТестов.ЭтоТестCLI() Тогда

        Сервис = "grpcbin.GRPCBin";
        Метод  = "HeadersUnary";

        Результат = OPI_GRPC.ВызватьМетод(Соединение, Сервис, Метод, Неопределено, , Tls);

        OPI_ПолучениеДанныхТестов.Обработать(Результат, "GRPC", "УстановитьМетаданные", "Проверка");

     КонецЕсли;

КонецПроцедуры

Процедура GRPC_ВызватьМетод(ПараметрыФункции)

    Адрес = ПараметрыФункции["GRPC_Address"];

    Proto1 = ПараметрыФункции["GRPC_ProtoImport"]; // Строка, путь к файлу или URL
    Proto2 = ПараметрыФункции["GRPC_ProtoTS"];     // Строка, путь к файлу или URL

    Схемы = Новый Соответствие;
    Схемы.Вставить("main.proto"    , Proto1); // Основной
    Схемы.Вставить("my_types.proto", Proto2); // Для импорта в основной

    Мета      = Новый Структура("somekey", "somevalue");
    Параметры = OPI_GRPC.ПолучитьПараметрыСоединения(Адрес, Схемы, Мета);
    Tls       = OPI_GRPC.ПолучитьНастройкиTls(Истина);

    Сервис = "grpcbin.GRPCBin";
    Метод  = "DummyUnary";

    МассивСтрок = Новый Массив;
    МассивСтрок.Добавить("one");
    МассивСтрок.Добавить("two");
    МассивСтрок.Добавить("three");

    МассивЧисел = Новый Массив;
    МассивЧисел.Добавить(1);
    МассивЧисел.Добавить(10);
    МассивЧисел.Добавить(100);

    МассивСтруктур = Новый Массив;
    МассивСтруктур.Добавить(Новый Структура("f_string", "Nested value 1"));
    МассивСтруктур.Добавить(Новый Структура("f_string", "Nested value 2"));

    МассивБулево = Новый Массив;
    МассивБулево.Добавить(Истина);
    МассивБулево.Добавить(Ложь);

    Файл = ПараметрыФункции["Document"];
    OPI_ПреобразованиеТипов.ПолучитьДвоичныеДанные(Файл);

    ИВФ = ПолучитьИмяВременногоФайла();
    Файл.Записать(ИВФ);

    МассивДвоичныхДанных = Новый Массив;
    МассивДвоичныхДанных.Добавить(Файл); // Как данные
    МассивДвоичныхДанных.Добавить(ИВФ);  // Как путь к файлу

    Данные = Новый Соответствие;
    Данные.Вставить("f_string" , "Test message");
    Данные.Вставить("f_int32"  , 123);
    Данные.Вставить("f_int64"  , 123);
    Данные.Вставить("f_float"  , 123.22000122070312);
    Данные.Вставить("f_bool"   , Истина);
    Данные.Вставить("f_enum"   , "ENUM_1");
    Данные.Вставить("f_bytes"  , Файл);
    Данные.Вставить("f_sub"    , Новый Структура("f_string"  , "Nested value"));
    Данные.Вставить("f_strings", МассивСтрок);
    Данные.Вставить("f_int32s" , МассивЧисел);
    Данные.Вставить("f_int64s" , МассивЧисел);
    Данные.Вставить("f_floats" , МассивЧисел);
    Данные.Вставить("f_bytess" , МассивДвоичныхДанных);
    Данные.Вставить("f_subs"   , МассивСтруктур);
    Данные.Вставить("f_bools"  , МассивБулево);
    Данные.Вставить("f_enums"  , СтрРазделить("ENUM_1,ENUM_2", ","));

    Результат = OPI_GRPC.ВызватьМетод(Параметры, Сервис, Метод, Данные, , Tls);

    // END

    OPI_ПолучениеДанныхТестов.Обработать(Результат, "GRPC", "ВызватьМетод", , Данные);

    Результат = OPI_GRPC.ВызватьМетод(Параметры, Сервис, Метод, Неопределено, , Tls);

    OPI_ПолучениеДанныхТестов.Обработать(Результат, "GRPC", "ВызватьМетод", "Пустой");

    Метод     = "HeadersUnary";
    Результат = OPI_GRPC.ВызватьМетод(Параметры, Сервис, Метод, Неопределено, , Tls);

    OPI_ПолучениеДанныхТестов.Обработать(Результат, "GRPC", "ВызватьМетод", "Мета");

КонецПроцедуры

Процедура GRPC_ПолучитьНастройкиЛогирования(ПараметрыФункции)

    Результат = OPI_GRPC.ПолучитьНастройкиЛогирования(Истина, 100, ПолучитьИмяВременногоФайла());

    // END

    OPI_ПолучениеДанныхТестов.Обработать(Результат, "GRPC", "ПолучитьНастройкиЛогирования");

    Результат = OPI_GRPC.ПолучитьНастройкиЛогирования(Ложь, , ПолучитьИмяВременногоФайла());

    OPI_ПолучениеДанныхТестов.Обработать(Результат, "GRPC", "ПолучитьНастройкиЛогирования", "Файл");

    Результат = OPI_GRPC.ПолучитьНастройкиЛогирования(Истина);

    OPI_ПолучениеДанныхТестов.Обработать(Результат, "GRPC", "ПолучитьНастройкиЛогирования", "Память");

КонецПроцедуры

Процедура GRPC_ПолучитьЛог(ПараметрыФункции)

    ФайлЛога             = ПолучитьИмяВременногоФайла("txt");
    НастройкиЛогирования = OPI_GRPC.ПолучитьНастройкиЛогирования(Истина, 100, ФайлЛога);

    Адрес = ПараметрыФункции["GRPC_Address"];

    Proto1 = ПараметрыФункции["GRPC_ProtoImport"];
    Proto2 = ПараметрыФункции["GRPC_ProtoTS"];

    Схемы = Новый Соответствие;
    Схемы.Вставить("main.proto"    , Proto1);
    Схемы.Вставить("my_types.proto", Proto2);

    Параметры = OPI_GRPC.ПолучитьПараметрыСоединения(Адрес, Схемы);
    Tls       = OPI_GRPC.ПолучитьНастройкиTls(Истина);

    Соединение = OPI_GRPC.ОткрытьСоединение(Параметры, Tls, НастройкиЛогирования);

    Если Не OPI_GRPC.ЭтоКоннектор(Соединение) Тогда
        ВызватьИсключение OPI_Инструменты.JSONСтрокой(Соединение);
    КонецЕсли;

    Сервис = "grpcbin.GRPCBin";
    Метод  = "DummyUnary";

    Результат = OPI_GRPC.ВызватьМетод(Соединение, Сервис, Метод);

    OPI_ПолучениеДанныхТестов.Обработать(Результат, "GRPC", "ВызватьМетод", "Select"); // SKIP

    Результат = OPI_GRPC.ПолучитьЛог(Соединение);

    // END

    OPI_ПолучениеДанныхТестов.Обработать(Результат, "GRPC", "ПолучитьЛог", , ФайлЛога);

    Результат = OPI_GRPC.ПолучитьЛог(Соединение, Истина);

    OPI_ПолучениеДанныхТестов.Обработать(Результат, "GRPC", "ПолучитьЛог", "КакСтрока", ФайлЛога);

КонецПроцедуры

#Область РасширеннаяПроверка

Процедура GRPC_Расширенная_ВызватьМетодБезПодключения(ПараметрыФункции)

    Коннектор = OPI_Компоненты.ПолучитьКомпоненту("GRPC");
    Запрос    = OPI_Компоненты.СериализоватьJanx(Новый Структура);
    Результат = OPI_Компоненты.ДесериализоватьJanx(Коннектор.Call(Запрос));

    // END

    OPI_ПолучениеДанныхТестов.Обработать(Результат, "GRPC", "Расширенная_ВызватьМетодБезПодключения");

КонецПроцедуры

Процедура GRPC_Расширенная_ПодключениеБезАдреса(ПараметрыФункции)

    Коннектор = OPI_Компоненты.ПолучитьКомпоненту("GRPC");
    Результат = OPI_Компоненты.ДесериализоватьJanx(Коннектор.Connect());

    // END

    OPI_ПолучениеДанныхТестов.Обработать(Результат, "GRPC", "Расширенная_ПодключениеБезАдреса");

КонецПроцедуры

Процедура GRPC_Расширенная_ПовторноеПодключение(ПараметрыФункции)

    Адрес = ПараметрыФункции["GRPC_Address"];

    Proto1 = ПараметрыФункции["GRPC_ProtoImport"];
    Proto2 = ПараметрыФункции["GRPC_ProtoTS"];

    Схемы = Новый Соответствие;
    Схемы.Вставить("main.proto"    , Proto1);
    Схемы.Вставить("my_types.proto", Proto2);

    Параметры = OPI_GRPC.ПолучитьПараметрыСоединения(Адрес, Схемы);
    Tls       = OPI_GRPC.ПолучитьНастройкиTls(Истина);

    Соединение = OPI_GRPC.ОткрытьСоединение(Параметры, Tls);

    Если Не OPI_GRPC.ЭтоКоннектор(Соединение) Тогда
        ВызватьИсключение OPI_Инструменты.JSONСтрокой(Соединение);
    КонецЕсли;

    Результат = OPI_Компоненты.ДесериализоватьJanx(Соединение.Connect());

    // END

    OPI_ПолучениеДанныхТестов.Обработать(Результат, "GRPC", "Расширенная_ПовторноеПодключение");
    OPI_GRPC.ЗакрытьСоединение(Соединение);

КонецПроцедуры

Процедура GRPC_Расширенная_ПолучитьЛогПриПодключении(ПараметрыФункции)

    ФайлЛога             = ПолучитьИмяВременногоФайла("txt");
    НастройкиЛогирования = OPI_GRPC.ПолучитьНастройкиЛогирования(Истина, 100, ФайлЛога);

    Адрес = ПараметрыФункции["GRPC_Address"];

    Proto1 = ПараметрыФункции["GRPC_ProtoImport"];
    Proto2 = ПараметрыФункции["GRPC_ProtoTS"];

    Схемы = Новый Соответствие;
    Схемы.Вставить("main.proto"    , Proto1);
    Схемы.Вставить("my_types.proto", Proto2);

    Параметры = OPI_GRPC.ПолучитьПараметрыСоединения(Адрес, Схемы);
    Tls       = OPI_GRPC.ПолучитьНастройкиTls(Истина);

    Соединение = OPI_GRPC.ОткрытьСоединение(Параметры, Tls, НастройкиЛогирования);

    Если Не OPI_GRPC.ЭтоКоннектор(Соединение) Тогда
        ВызватьИсключение OPI_Инструменты.JSONСтрокой(Соединение);
    КонецЕсли;

    OPI_GRPC.ВызватьМетод(Соединение, "grpcbin.GRPCBin", "DummyUnary");

    Результат = OPI_GRPC.ПолучитьЛог(Соединение);

    // END

    OPI_ПолучениеДанныхТестов.Обработать(Результат, "GRPC", "Расширенная_ПолучитьЛогПриПодключении", , ФайлЛога);
    OPI_GRPC.ЗакрытьСоединение(Соединение);

КонецПроцедуры

Процедура GRPC_Расширенная_ВызватьМетодНесколькоБинарныхПолей(ПараметрыФункции)

    Адрес = ПараметрыФункции["GRPC_Address"];

    Proto1 = ПараметрыФункции["GRPC_ProtoImport"];
    Proto2 = ПараметрыФункции["GRPC_ProtoTS"];

    Схемы = Новый Соответствие;
    Схемы.Вставить("main.proto"    , Proto1);
    Схемы.Вставить("my_types.proto", Proto2);

    Параметры = OPI_GRPC.ПолучитьПараметрыСоединения(Адрес, Схемы);
    Tls       = OPI_GRPC.ПолучитьНастройкиTls(Истина);

    БинарныеДанные = OPI_ПолучениеДанныхТестов.ПолучитьТестовуюКоллекциюJanx("МассивДвоичников");

    Данные = Новый Соответствие;
    Данные.Вставить("f_string", "janx multi-bin");
    Данные.Вставить("f_int32" , 7);
    Данные.Вставить("f_bool"  , Истина);
    Данные.Вставить("f_bytes" , БинарныеДанные["chunks"][0]);
    Данные.Вставить("f_bytess", БинарныеДанные["chunks"]);

    Результат = OPI_GRPC.ВызватьМетод(Параметры, "grpcbin.GRPCBin", "DummyUnary", Данные, , Tls);

    // END

    OPI_ПолучениеДанныхТестов.Обработать(Результат, "GRPC", "Расширенная_ВызватьМетодНесколькоБинарныхПолей", , Данные);

КонецПроцедуры

Процедура GRPC_Расширенная_ПараметрыСоединения(ПараметрыФункции)

    Адрес = ПараметрыФункции["GRPC_Address"];

    Proto1 = ПараметрыФункции["GRPC_ProtoImport"];
    Proto2 = ПараметрыФункции["GRPC_ProtoTS"];

    Схемы = Новый Соответствие;
    Схемы.Вставить("main.proto"    , Proto1);
    Схемы.Вставить("my_types.proto", Proto2);

    Результат = OPI_GRPC.ПолучитьПараметрыСоединения(Адрес
        , Схемы
        , Неопределено
        , "OpenIntegrations"
        , "gzip"
        , 1048576
        , 2097152
        , 2500);

    // END

    OPI_ПолучениеДанныхТестов.Обработать(Результат, "GRPC", "Расширенная_ПараметрыСоединения");

    Tls = OPI_GRPC.ПолучитьНастройкиTls(Истина);

    Параметры = OPI_GRPC.ПолучитьПараметрыСоединения(Адрес, Схемы, , , "br");
    Результат = OPI_GRPC.ОткрытьСоединение(Параметры, Tls);

    OPI_ПолучениеДанныхТестов.Обработать(Результат, "GRPC", "Расширенная_ПараметрыСоединения", "Сжатие");

    НекорректныйUserAgent = "bad" + Символы.ПС + "agent";
    Параметры             = OPI_GRPC.ПолучитьПараметрыСоединения(Адрес, Схемы, , НекорректныйUserAgent);
    Результат             = OPI_GRPC.ОткрытьСоединение(Параметры, Tls);

    OPI_ПолучениеДанныхТестов.Обработать(Результат, "GRPC", "Расширенная_ПараметрыСоединения", "UserAgent");

КонецПроцедуры

Процедура GRPC_Расширенная_UserAgent(ПараметрыФункции)

    Адрес = ПараметрыФункции["GRPC_Address"];

    Proto1 = ПараметрыФункции["GRPC_ProtoImport"];
    Proto2 = ПараметрыФункции["GRPC_ProtoTS"];

    Схемы = Новый Соответствие;
    Схемы.Вставить("main.proto"    , Proto1);
    Схемы.Вставить("my_types.proto", Proto2);

    Параметры = OPI_GRPC.ПолучитьПараметрыСоединения(Адрес, Схемы, , "OpenIntegrationsTest");
    Tls       = OPI_GRPC.ПолучитьНастройкиTls(Истина);

    Результат = OPI_GRPC.ВызватьМетод(Параметры, "grpcbin.GRPCBin", "HeadersUnary", , , Tls);

    // END

    OPI_ПолучениеДанныхТестов.Обработать(Результат, "GRPC", "Расширенная_UserAgent", , "OpenIntegrationsTest");

    Метаданные = Новый Соответствие;
    Метаданные.Вставить("user-agent", "FromMetadataToken");

    Параметры = OPI_GRPC.ПолучитьПараметрыСоединения(Адрес, Схемы, Метаданные);
    Результат = OPI_GRPC.ВызватьМетод(Параметры, "grpcbin.GRPCBin", "HeadersUnary", , , Tls);

    OPI_ПолучениеДанныхТестов.Обработать(Результат, "GRPC", "Расширенная_UserAgent", "Метаданные", "FromMetadataToken");

КонецПроцедуры

