#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_LDAP
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_LDAP(Исполнитель)
    
;

@Локально
структура OPI_LDAP
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "ldap"
    
    @Глобально
    // Метод СформироватьПараметрыСоединения
    // Формирует коллекцию параметров LDAP-соединения
    //
    // URL     - Строка: URL сервера (ldap: или ldaps:)
    // BindDN  - Строка: DN для bind (необяз. по ум. - Пустое значение)
    // Пароль  - Строка: Пароль для bind (необяз. по ум. - Пустое значение)
    // Таймаут - Число: Таймаут операций в секундах (необяз. по ум. - 30)
    метод СформироватьПараметрыСоединения(URL: Объект?, BindDN: Объект? = Неопределено, Пароль: Объект? = Неопределено, Таймаут: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-b", BindDN)
        Опции.Вставить("-p", Пароль)
        Опции.Вставить("-t", Таймаут)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СформироватьПараметрыСоединения", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьКонфигурациюСоединения
    // Возвращает текущие настройки открытого соединения
    //
    // Соединение - Произвольный: Объект компоненты с открытым соединением
    метод ПолучитьКонфигурациюСоединения(Соединение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьКонфигурациюСоединения", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьНастройкиTls
    // Формирует структуру настроек TLS для LDAP-соединения
    //
    // ОтключитьПроверкуСертификатов - Булево: Позволяет работать с некорректными сертификатами, в т.ч. самоподписанными
    // ПутьКСертификату              - Строка: Путь к корневому PEM файлу сертификата, если его нет в системном хранилище (необяз. по ум. - Пустое значение)
    метод ПолучитьНастройкиTls(ОтключитьПроверкуСертификатов: Объект?, ПутьКСертификату: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", ОтключитьПроверкуСертификатов)
        Опции.Вставить("-c", ПутьКСертификату)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиTls", Опции)
        
    ;

    @Глобально
    // Метод ВыполнитьПоиск
    // Выполняет LDAP-поиск
    //
    // Соединение - Произвольный, Структура Из КлючИЗначение: Соединение или параметры соединения
    // База       - Строка: Базовый DN поиска
    // Фильтр     - Строка: LDAP (необяз. по ум. - (objectClass=*))
    // Атрибуты   - Массив Из Строка, Неопределено: Список атрибутов для выборки (необяз. по ум. - Пустое значение)
    // Область    - Строка: Область: base, one, subtree (необяз. по ум. - subtree)
    метод ВыполнитьПоиск(Соединение: Объект?, База: Объект?, Фильтр: Объект? = Неопределено, Атрибуты: Объект? = Неопределено, Область: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-b", База)
        Опции.Вставить("-ф", Фильтр)
        Опции.Вставить("-a", Атрибуты)
        Опции.Вставить("-s", Область)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВыполнитьПоиск", Опции)
        
    ;

    @Глобально
    // Метод Добавить
    // Добавляет запись в каталог LDAP
    //
    // Соединение - Произвольный, Структура Из КлючИЗначение: Соединение или параметры соединения
    // DN         - Строка: DN добавляемой записи
    // Атрибуты   - Структура Из КлючИЗначение: Атрибуты записи
    метод Добавить(Соединение: Объект?, DN: Объект?, Атрибуты: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-d", DN)
        Опции.Вставить("-a", Атрибуты)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "Добавить", Опции)
        
    ;

    @Глобально
    // Метод Изменить
    // Изменяет запись в каталоге LDAP
    //
    // Соединение - Произвольный, Структура Из КлючИЗначение: Соединение или параметры соединения
    // DN         - Строка: DN изменяемой записи
    // Изменения  - Массив Из Структура: Список изменений атрибутов
    метод Изменить(Соединение: Объект?, DN: Объект?, Изменения: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-d", DN)
        Опции.Вставить("-h", Изменения)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "Изменить", Опции)
        
    ;

    @Глобально
    // Метод Удалить
    // Удаляет запись из каталога LDAP
    //
    // Соединение - Произвольный, Структура Из КлючИЗначение: Соединение или параметры соединения
    // DN         - Строка: DN удаляемой записи
    метод Удалить(Соединение: Объект?, DN: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-d", DN)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "Удалить", Опции)
        
    ;

    @Глобально
    // Метод Сравнить
    // Сравнивает значение атрибута записи LDAP
    //
    // Соединение - Произвольный, Структура Из КлючИЗначение: Соединение или параметры соединения
    // DN         - Строка: DN записи
    // Атрибут    - Строка: Имя атрибута
    // Значение   - Строка: Ожидаемое значение
    метод Сравнить(Соединение: Объект?, DN: Объект?, Атрибут: Объект?, Значение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-d", DN)
        Опции.Вставить("-a", Атрибут)
        Опции.Вставить("-v", Значение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "Сравнить", Опции)
        
    ;
    
;