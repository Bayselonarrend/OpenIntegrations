#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_MessagePack
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_MessagePack(Исполнитель)
    
;

@Локально
структура OPI_MessagePack
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "msgpack"
    
    @Глобально
    // Метод СериализоватьДанные
    // Сериализует данные в формат MessagePack
    //
    // Данные      - Произвольный: Коллекция для сериализации
    // ИзИсточника - Булево: Данные являются JSON строкой или файлом на диске (необяз. по ум. - false)
    метод СериализоватьДанные(Данные: Объект?, ИзИсточника: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-v", Данные)
        Опции.Вставить("-r", ИзИсточника)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СериализоватьДанные", Опции)
        
    ;

    @Глобально
    // Метод ДесериализоватьДанные
    // Десериализует данные из формата MessagePack
    //
    // Данные - ДвоичныеДанные: Сериализованное значение
    метод ДесериализоватьДанные(Данные: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Данные)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ДесериализоватьДанные", Опции)
        
    ;
    
;