#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_Dropbox
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_Dropbox(Исполнитель)
    
;

@Локально
структура OPI_Dropbox
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "dropbox"
    
    @Глобально
    // Метод ПолучитьСсылкуАвторизации
    // Генерирует ссылку авторизации для перехода в браузере
    //
    // КлючПриложения - Строка: Ключ приложения
    метод ПолучитьСсылкуАвторизации(КлючПриложения: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", КлючПриложения)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСсылкуАвторизации", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьТокен
    // Получает токен на основе кода со страницы ПолучитьСсылкуАвторизации
    //
    // КлючПриложения   - Строка: Ключ приложения
    // СекретПриложения - Строка: Секрет приложения
    // Код              - Строка: Код со страницы авторизации
    метод ПолучитьТокен(КлючПриложения: Объект?, СекретПриложения: Объект?, Код: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", КлючПриложения)
        Опции.Вставить("-p", СекретПриложения)
        Опции.Вставить("-c", Код)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьТокен", Опции)
        
    ;

    @Глобально
    // Метод ОбновитьТокен
    // Получает новый токен на основе рефреш токена
    //
    // КлючПриложения   - Строка: Ключ приложения
    // СекретПриложения - Строка: Секрет приложения
    // РефрешТокен      - Строка: Рефреш токен
    метод ОбновитьТокен(КлючПриложения: Объект?, СекретПриложения: Объект?, РефрешТокен: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", КлючПриложения)
        Опции.Вставить("-p", СекретПриложения)
        Опции.Вставить("-r", РефрешТокен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОбновитьТокен", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьИнформациюОбАккаунте
    // Получает информацию об аккаунте
    //
    // Токен   - Строка: Токен
    // Аккаунт - Строка: ID аккаунта. Текущий аккаунт токена, если не заполнено (необяз. по ум. - Пустое значение)
    метод ПолучитьИнформациюОбАккаунте(Токен: Объект?, Аккаунт: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-a", Аккаунт)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьИнформациюОбАккаунте", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьДанныеИспользованияПространства
    // Получает информацию о количестве использованного дискового пространства
    //
    // Токен - Строка: Токен
    метод ПолучитьДанныеИспользованияПространства(Токен: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьДанныеИспользованияПространства", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьИнформациюОбОбъекте
    // Получает информацию о файле или каталоге
    //
    // Токен    - Строка: Токен
    // Путь     - Строка: Путь к объекту
    // Подробно - Булево: Добавляет дополнительные поля информации для медиафайлов (необяз. по ум. - false)
    метод ПолучитьИнформациюОбОбъекте(Токен: Объект?, Путь: Объект?, Подробно: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        Опции.Вставить("-d", Подробно)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьИнформациюОбОбъекте", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокФайловПапки
    // Получает список первых файлов каталога или продолжает получение следующих при указании курсора
    //
    // Токен    - Строка: Токен
    // Путь     - Строка: Путь к каталогу. Необязателен, если указан курсор (необяз. по ум. - Пустое значение)
    // Подробно - Булево: Добавляет дополнительные поля информации для медиафайлов (необяз. по ум. - false)
    // Курсор   - Строка: Курсор из предыдущего запроса для получения следующего набора файлов (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокФайловПапки(Токен: Объект?, Путь: Объект? = Неопределено, Подробно: Объект? = Неопределено, Курсор: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        Опции.Вставить("-d", Подробно)
        Опции.Вставить("-c", Курсор)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокФайловПапки", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьПревью
    // Получает PDF или HTML превью объекта (только для документов)
    //
    // Токен - Строка: Токен
    // Путь  - Строка: Путь к объекту
    метод ПолучитьПревью(Токен: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПревью", Опции)
        
    ;

    @Глобально
    // Метод ЗагрузитьФайл
    // Загружает файл на облачный диск
    //
    // Токен          - Строка: Токен
    // Файл           - Строка, ДвоичныеДанные: Данные файл для загрузки
    // Путь           - Строка: Путь сохранения на Dropbox
    // Перезаписывать - Булево: Перезаписывать файл при конфликте путей (необяз. по ум. - false)
    метод ЗагрузитьФайл(Токен: Объект?, Файл: Объект?, Путь: Объект?, Перезаписывать: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", Файл)
        Опции.Вставить("-p", Путь)
        Опции.Вставить("-o", Перезаписывать)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗагрузитьФайл", Опции)
        
    ;

    @Глобально
    // Метод ЗагрузитьФайлПоURL
    // Загружает файл на облачный диск, получая его по указанному URL
    //
    // Токен    - Строка: Токен
    // URLФайла - Строка: URL источник файла
    // Путь     - Строка: Путь сохранения на Dropbox
    метод ЗагрузитьФайлПоURL(Токен: Объект?, URLФайла: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-u", URLФайла)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗагрузитьФайлПоURL", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтатусЗагрузкиПоURL
    // Получает статус загрузки файла по URL
    //
    // Токен    - Строка: Токен
    // IDРаботы - Строка: ID асинхронной работы из ответа ЗагрузитьФайлПоURL
    метод ПолучитьСтатусЗагрузкиПоURL(Токен: Объект?, IDРаботы: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-j", IDРаботы)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтатусЗагрузкиПоURL", Опции)
        
    ;

    @Глобально
    // Метод УдалитьОбъект
    // Удаляет объект с облачного диска
    //
    // Токен        - Строка: Токен
    // Путь         - Строка: Путь к объекту удаления
    // БезВозвратно - Строка: Удалить объект без возможности восстановления
    метод УдалитьОбъект(Токен: Объект?, Путь: Объект?, БезВозвратно: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        Опции.Вставить("-r", БезВозвратно)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьОбъект", Опции)
        
    ;

    @Глобально
    // Метод КопироватьОбъект
    // Копирует файл или каталог по выбранному пути
    //
    // Токен  - Строка: Токен
    // Откуда - Строка: Путь к объекту оригинала
    // Куда   - Строка: Целевой путь для нового объекта
    метод КопироватьОбъект(Токен: Объект?, Откуда: Объект?, Куда: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", Откуда)
        Опции.Вставить("-o", Куда)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "КопироватьОбъект", Опции)
        
    ;

    @Глобально
    // Метод ПереместитьОбъект
    // Перемещает объект по выбранному пути
    //
    // Токен  - Строка: Токен
    // Откуда - Строка: Путь к объекту оригинала
    // Куда   - Строка: Целевой путь для нового объекта
    метод ПереместитьОбъект(Токен: Объект?, Откуда: Объект?, Куда: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", Откуда)
        Опции.Вставить("-o", Куда)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПереместитьОбъект", Опции)
        
    ;

    @Глобально
    // Метод СоздатьПапку
    // Создает пустой каталог по выбранному пути
    //
    // Токен - Строка: Токен
    // Путь  - Строка: Целевой путь создания каталога
    метод СоздатьПапку(Токен: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьПапку", Опции)
        
    ;

    @Глобально
    // Метод СкачатьФайл
    // Скачивает файл по указанному пути или ID
    //
    // Токен - Строка: Токен
    // Путь  - Строка: Путь или ID файла
    метод СкачатьФайл(Токен: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СкачатьФайл", Опции)
        
    ;

    @Глобально
    // Метод СкачатьПапку
    // Скачивает zip архив с содержимым указанного каталога
    //
    // Токен - Строка: Токен
    // Путь  - Строка: Путь или ID каталога
    метод СкачатьПапку(Токен: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СкачатьПапку", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокВерсийОбъекта
    // Получает список версий (ревизий) объекта
    //
    // Токен      - Строка: Токен
    // Путь       - Строка: Путь к объекту
    // Количество - Строка, Число: Число последних версий объекта для отображения (необяз. по ум. - 10)
    метод ПолучитьСписокВерсийОбъекта(Токен: Объект?, Путь: Объект?, Количество: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        Опции.Вставить("-a", Количество)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокВерсийОбъекта", Опции)
        
    ;

    @Глобально
    // Метод ВосстановитьОбъектКВерсии
    // Восстанавливает состояние объекта к необходимой версии (ревизии)
    //
    // Токен  - Строка: Токен
    // Путь   - Строка: Путь к объекту
    // Версия - Строка: ID версии (ревизии) для восстановления
    метод ВосстановитьОбъектКВерсии(Токен: Объект?, Путь: Объект?, Версия: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        Опции.Вставить("-r", Версия)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВосстановитьОбъектКВерсии", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокТегов
    // Получает список тегов выбранных файлов
    //
    // Токен - Строка: Токен
    // Пути  - Строка, Массив Из Строка: Путь или набору путей к файлам
    метод ПолучитьСписокТегов(Токен: Объект?, Пути: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Пути)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокТегов", Опции)
        
    ;

    @Глобально
    // Метод ДобавитьТег
    // Добавляет новый текстовый тег к файлу или каталогу
    //
    // Токен - Строка: Токен
    // Путь  - Строка: Путь к объекту, для которого необходимо создать тег
    // Тег   - Строка: Текст тега
    метод ДобавитьТег(Токен: Объект?, Путь: Объект?, Тег: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        Опции.Вставить("-g", Тег)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ДобавитьТег", Опции)
        
    ;

    @Глобально
    // Метод УдалитьТег
    // Удаляет текстовый тег файла или каталога
    //
    // Токен - Строка: Токен
    // Путь  - Строка: Путь к объекту, тег которого необходимо удалить
    // Тег   - Строка: Текст тега
    метод УдалитьТег(Токен: Объект?, Путь: Объект?, Тег: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        Опции.Вставить("-g", Тег)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьТег", Опции)
        
    ;

    @Глобально
    // Метод ОпубликоватьПапку
    // Переводит каталог в режим публичного доступа
    //
    // Токен - Строка: Токен
    // Путь  - Строка: Путь к целевому каталогу
    метод ОпубликоватьПапку(Токен: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОпубликоватьПапку", Опции)
        
    ;

    @Глобально
    // Метод ОтменитьПубликациюПапки
    // Отменяет режим общего доступа для каталога
    //
    // Токен   - Строка: Токен
    // IDПапки - Строка: ID публичного каталога (shared folder ID)
    метод ОтменитьПубликациюПапки(Токен: Объект?, IDПапки: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", IDПапки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтменитьПубликациюПапки", Опции)
        
    ;

    @Глобально
    // Метод ДобавитьПользователейКФайлу
    // Определяет доступ к файлу для сторонних пользователей
    //
    // Токен          - Строка: Токен
    // IDФайла        - Строка: ID файла, к которому предоставляется доступ
    // АдресаПочты    - Строка, Массив Из Строка: Список адресов почты добавляемых пользователей
    // ТолькоПросмотр - Булево: Запрещает редактирование файла для стороннего пользователя (необяз. по ум. - true)
    метод ДобавитьПользователейКФайлу(Токен: Объект?, IDФайла: Объект?, АдресаПочты: Объект?, ТолькоПросмотр: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", IDФайла)
        Опции.Вставить("-e", АдресаПочты)
        Опции.Вставить("-r", ТолькоПросмотр)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ДобавитьПользователейКФайлу", Опции)
        
    ;

    @Глобально
    // Метод ДобавитьПользователейКПапке
    // Предоставляет стороннии пользователям доступ к каталогу
    //
    // Токен          - Строка: Токен
    // IDПапки        - Строка: ID публичного каталога (shared folder ID)
    // АдресаПочты    - Строка, Массив Из Строка: Список адресов почты добавляемых пользователей
    // ТолькоПросмотр - Булево: Запрещает редактирование файла для стороннего пользователя (необяз. по ум. - true)
    метод ДобавитьПользователейКПапке(Токен: Объект?, IDПапки: Объект?, АдресаПочты: Объект?, ТолькоПросмотр: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", IDПапки)
        Опции.Вставить("-e", АдресаПочты)
        Опции.Вставить("-r", ТолькоПросмотр)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ДобавитьПользователейКПапке", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтатусАсинхронногоИзменения
    // Получает статус асинхронной работы по изменению доступов
    //
    // Токен    - Строка: Токен
    // IDРаботы - Строка: ID асинхронной работы
    метод ПолучитьСтатусАсинхронногоИзменения(Токен: Объект?, IDРаботы: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-j", IDРаботы)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтатусАсинхронногоИзменения", Опции)
        
    ;

    @Глобально
    // Метод ОтменитьПубликациюФайла
    // Запрещает доступ к файлу для внешних пользователей
    //
    // Токен   - Строка: Токен
    // IDФайла - Строка: ID файла, к которому предоставляется доступ
    метод ОтменитьПубликациюФайла(Токен: Объект?, IDФайла: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", IDФайла)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтменитьПубликациюФайла", Опции)
        
    ;
    
;