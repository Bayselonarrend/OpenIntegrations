    ;

    @Глобально
    метод ПолучитьСписокФайловПапки(Токен: Объект?, Путь: Объект? = Неопределено, Подробно: Объект? = Неопределено, Курсор: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        Опции.Вставить("-d", Подробно)
        Опции.Вставить("-c", Курсор)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокФайловПапки", Опции)
        
    ;

