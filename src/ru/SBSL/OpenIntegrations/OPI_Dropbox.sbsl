#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Строка?|Executor.НастройкиИнтеграции): OPI_Dropbox
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_Dropbox(Исполнитель)
    
;

@Локально
структура OPI_Dropbox
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "dropbox"
    
    @Глобально
    метод ПолучитьСсылкуАвторизации(КлючПриложения: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", КлючПриложения)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСсылкуАвторизации", Опции)
        
    ;

    @Глобально
    метод ПолучитьТокен(КлючПриложения: Объект?, СекретПриложения: Объект?, Код: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", КлючПриложения)
        Опции.Вставить("-p", СекретПриложения)
        Опции.Вставить("-c", Код)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьТокен", Опции)
        
    ;

    @Глобально
    метод ОбновитьТокен(КлючПриложения: Объект?, СекретПриложения: Объект?, РефрешТокен: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", КлючПриложения)
        Опции.Вставить("-p", СекретПриложения)
        Опции.Вставить("-r", РефрешТокен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОбновитьТокен", Опции)
        
    ;

    @Глобально
    метод ПолучитьИнформациюОбАккаунте(Токен: Объект?, Аккаунт: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-a", Аккаунт)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьИнформациюОбАккаунте", Опции)
        
    ;

