        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьДанныеИспользованияПространства", Опции)
        
    ;

    @Глобально
    метод ПолучитьИнформациюОбОбъекте(Токен: Объект?, Путь: Объект?, Подробно: Объект? = Неопределено): Объект?
        
