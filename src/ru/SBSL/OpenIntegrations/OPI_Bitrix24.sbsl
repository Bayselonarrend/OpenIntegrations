    @Глобально
    // Метод ПолучитьСтруктуруФильтраЗадач
    // Возвращает структуру полей для фильтрации задач в методе ПолучитьСписокЗадач
    //
    // Пустая          - Булево: Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей (необяз. по ум. - false)
    // КакСоответствие - Булево: Истина > возвращает поля фильтра как соответствие (необяз. по ум. - false)
    метод ПолучитьСтруктуруФильтраЗадач(Пустая: Объект? = Неопределено, КакСоответствие: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        Опции.Вставить("-m", КакСоответствие)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруФильтраЗадач", Опции)
        
    ;

