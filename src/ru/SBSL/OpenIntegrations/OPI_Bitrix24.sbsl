#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_Bitrix24
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_Bitrix24(Исполнитель)
    
;

@Локально
структура OPI_Bitrix24
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "bitrix24"
    
    @Глобально
    // Метод ПолучитьСсылкуАвторизацииПриложения
    // Формирует ссылку для авторизации через браузер
    //
    // Домен    - Строка: Адрес битрикс вида portal.bitrix24.com
    // ClientID - Строка: Client ID из настроек приложения
    метод ПолучитьСсылкуАвторизацииПриложения(Домен: Объект?, ClientID: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Домен)
        Опции.Вставить("-c", ClientID)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСсылкуАвторизацииПриложения", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьТокен
    // Получает токен по коду авторизации
    //
    // ClientID     - Строка: Client ID из настроек приложения
    // ClientSecret - Строка: Client secret из настроек приложения
    // Code         - Строка: Code из авторизации через браузер
    метод ПолучитьТокен(ClientID: Объект?, ClientSecret: Объект?, Code: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", ClientID)
        Опции.Вставить("-l", ClientSecret)
        Опции.Вставить("-d", Code)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьТокен", Опции)
        
    ;

    @Глобально
    // Метод ОбновитьТокен
    // Обновляет токен по Refresh токену
    //
    // ClientID     - Строка: Client ID из настроек приложения
    // ClientSecret - Строка: Client secret из настроек приложения
    // Refresh      - Строка: Refresh токен
    метод ОбновитьТокен(ClientID: Объект?, ClientSecret: Объект?, Refresh: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", ClientID)
        Опции.Вставить("-l", ClientSecret)
        Опции.Вставить("-r", Refresh)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОбновитьТокен", Опции)
        
    ;

    @Глобально
    // Метод СерверноеВремя
    // Получает текущее серверное время
    //
    // URL   - Строка: URL внешнего вебхука или адрес Bitrix24 при использовании токена
    // Токен - Строка: Токен авторизации, если используется не вебхук (необяз. по ум. - Пустое значение)
    метод СерверноеВремя(URL: Объект?, Токен: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СерверноеВремя", Опции)
        
    ;

    @Глобально
    // Метод СоздатьНовость
    // Создает новую новость в ленте
    //
    // URL       - Строка: URL внешнего вебхука или адрес Bitrix24 при использовании токена
    // Текст     - Строка: Текст новости
    // Видимость - Строка: Массив или 1 получатель: UA все, SGn р. группа, Un пользователь, DRn отдел, Gn группа (необяз. по ум. - UA)
    // Файлы     - Соответствие Из КлючИЗначение: Ключ > имя файла, значение > путь или двоичные данные (необяз. по ум. - Пустое значение)
    // Заголовок - Строка: Заголовок новости (необяз. по ум. - Пустое значение)
    // Важное    - Булево: Помечает новость как важную (необяз. по ум. - false)
    // Токен     - Строка: Токен авторизации, если используется не вебхук (необяз. по ум. - Пустое значение)
    метод СоздатьНовость(URL: Объект?, Текст: Объект?, Видимость: Объект? = Неопределено, Файлы: Объект? = Неопределено, Заголовок: Объект? = Неопределено, Важное: Объект? = Неопределено, Токен: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Текст)
        Опции.Вставить("-v", Видимость)
        Опции.Вставить("-f", Файлы)
        Опции.Вставить("-l", Заголовок)
        Опции.Вставить("-i", Важное)
        Опции.Вставить("-k", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьНовость", Опции)
        
    ;

    @Глобально
    // Метод ИзменитьНовость
    // Изменяет новость в ленте
    //
    // URL       - Строка: URL внешнего вебхука или адрес Bitrix24 при использовании токена
    // IDНовости - Строка, Число: ID новости
    // Текст     - Строка: Текст новости
    // Видимость - Строка: Массив или 1 получатель: UA все, SGn р. группа, Un пользователь, DRn отдел, Gn группа (необяз. по ум. - UA)
    // Файлы     - Соответствие Из КлючИЗначение: Ключ > имя файла, значение > путь или двоичные данные (необяз. по ум. - Пустое значение)
    // Заголовок - Строка: Заголовок новости (необяз. по ум. - Пустое значение)
    // Токен     - Строка: Токен авторизации, если используется не вебхук (необяз. по ум. - Пустое значение)
    метод ИзменитьНовость(URL: Объект?, IDНовости: Объект?, Текст: Объект?, Видимость: Объект? = Неопределено, Файлы: Объект? = Неопределено, Заголовок: Объект? = Неопределено, Токен: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-p", IDНовости)
        Опции.Вставить("-t", Текст)
        Опции.Вставить("-v", Видимость)
        Опции.Вставить("-f", Файлы)
        Опции.Вставить("-l", Заголовок)
        Опции.Вставить("-k", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьНовость", Опции)
        
    ;

    @Глобально
    // Метод УдалитьНовость
    // Удаляет новость из ленты по выбранному ID
    //
    // URL       - Строка: URL внешнего вебхука или адрес Bitrix24 при использовании токена
    // IDНовости - Строка, Число: ID новости для удаления
    // Токен     - Строка: Токен авторизации, если используется не вебхук (необяз. по ум. - Пустое значение)
    метод УдалитьНовость(URL: Объект?, IDНовости: Объект?, Токен: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-p", IDНовости)
        Опции.Вставить("-t", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьНовость", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокПросмотревшихВажное
    // Возвращает список пользователей, просмотревших выбранное важное сообщение
    //
    // URL       - Строка: URL внешнего вебхука или адрес Bitrix24 при использовании токена
    // IDНовости - Строка, Число: ID важной новости
    // Токен     - Строка: Токен авторизации, если используется не вебхук (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокПросмотревшихВажное(URL: Объект?, IDНовости: Объект?, Токен: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-p", IDНовости)
        Опции.Вставить("-t", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокПросмотревшихВажное", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьНовости
    // Получает новости или одну новость с отбором по ID или доступности
    //
    // URL       - Строка: URL внешнего вебхука или адрес Bitrix24 при использовании токена
    // IDНовости - Строка, Число: ID важной новости (необяз. по ум. - Пустое значение)
    // Отбор     - Строка: Отбор новостей по доступу: UA все, SGn раб. группа, Un пользователь, DRn отдел, Gn группа (необяз. по ум. - UA)
    // Токен     - Строка: Токен авторизации, если используется не вебхук (необяз. по ум. - Пустое значение)
    метод ПолучитьНовости(URL: Объект?, IDНовости: Объект? = Неопределено, Отбор: Объект? = Неопределено, Токен: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-p", IDНовости)
        Опции.Вставить("-s", Отбор)
        Опции.Вставить("-t", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНовости", Опции)
        
    ;

    @Глобально
    // Метод ДобавитьКомментарийНовости
    // Добавляет комментарий к новости
    //
    // URL       - Строка: URL внешнего вебхука или адрес Bitrix24 при использовании токена
    // IDНовости - Строка, Число: ID новости
    // Текст     - Строка: Текст комментария
    // Токен     - Строка: Токен авторизации, если используется не вебхук (необяз. по ум. - Пустое значение)
    метод ДобавитьКомментарийНовости(URL: Объект?, IDНовости: Объект?, Текст: Объект?, Токен: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-p", IDНовости)
        Опции.Вставить("-t", Текст)
        Опции.Вставить("-k", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ДобавитьКомментарийНовости", Опции)
        
    ;

    @Глобально
    // Метод ДобавитьПолучателейКНовости
    // Добавляет новые группы или пользователей в получатели
    //
    // URL       - Строка: URL внешнего вебхука или адрес Bitrix24 при использовании токена
    // IDНовости - Строка, Число: ID новости
    // Видимость - Строка: Массив или 1 получатель: UA все, SGn р. группа, Un пользователь, DRn отдел, Gn группа
    // Токен     - Строка: Токен авторизации, если используется не вебхук (необяз. по ум. - Пустое значение)
    метод ДобавитьПолучателейКНовости(URL: Объект?, IDНовости: Объект?, Видимость: Объект?, Токен: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-p", IDНовости)
        Опции.Вставить("-v", Видимость)
        Опции.Вставить("-t", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ДобавитьПолучателейКНовости", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьЗадачу
    // Получает задачу по ID
    //
    // URL      - Строка: URL внешнего вебхука или адрес Bitrix24 при использовании токена
    // IDЗадачи - Число, Строка: ID задачи
    // Токен    - Строка: Токен авторизации, если используется не вебхук (необяз. по ум. - Пустое значение)
    метод ПолучитьЗадачу(URL: Объект?, IDЗадачи: Объект?, Токен: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", IDЗадачи)
        Опции.Вставить("-k", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьЗадачу", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокЗадач
    // Получает список задач (50 шт. за запрос максимум) с фильтром или без
    //
    // URL    - Строка: URL внешнего вебхука или адрес Bitrix24 при использовании токена
    // Фильтр - Структура из КлючИЗначение: Структура отбора задач. См. ПолучитьСтруктуруФильтраЗадач (необяз. по ум. - Пустое значение)
    // Отступ - Число, Строка: Отступ от начала списка для получения задач > 50 шт. рекурсивно (необяз. по ум. - Пустое значение)
    // Токен  - Строка: Токен авторизации, если используется не вебхук (необяз. по ум. - Пустое значение)
    // Поля   - Строка, Массив Из Строка: Список полей задачи в ответе. Все невычисляемые по умолчанию (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокЗадач(URL: Объект?, Фильтр: Объект? = Неопределено, Отступ: Объект? = Неопределено, Токен: Объект? = Неопределено, Поля: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-f", Фильтр)
        Опции.Вставить("-o", Отступ)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-s", Поля)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокЗадач", Опции)
        
    ;

    @Глобально
    // Метод СоздатьЗадачу
    // Создает новую задачу по структуре полей
    //
    // URL            - Строка: URL внешнего вебхука или адрес Bitrix24 при использовании токена
    // СтруктураПолей - Структура Из КлючИЗначение: Структура полей задачи. См. ПолучитьСтруктуруЗадачи
    // Токен          - Строка: Токен авторизации, если используется не вебхук (необяз. по ум. - Пустое значение)
    метод СоздатьЗадачу(URL: Объект?, СтруктураПолей: Объект?, Токен: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-f", СтруктураПолей)
        Опции.Вставить("-t", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьЗадачу", Опции)
        
    ;

    @Глобально
    // Метод ИзменитьЗадачу
    // Изменяет существующую задачу
    //
    // URL            - Строка: URL внешнего вебхука или адрес Bitrix24 при использовании токена
    // IDЗадачи       - Число, Строка: ID задачи
    // СтруктураПолей - Структура Из КлючИЗначение: Структура полей задачи
    // Токен          - Строка: Токен авторизации, если используется не вебхук (необяз. по ум. - Пустое значение)
    метод ИзменитьЗадачу(URL: Объект?, IDЗадачи: Объект?, СтруктураПолей: Объект?, Токен: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", IDЗадачи)
        Опции.Вставить("-f", СтруктураПолей)
        Опции.Вставить("-k", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьЗадачу", Опции)
        
    ;

    @Глобально
    // Метод УдалитьЗадачу
    // Удаляет задачу по ID
    //
    // URL      - Строка: URL внешнего вебхука или адрес Bitrix24 при использовании токена
    // IDЗадачи - Число, Строка: ID задачи
    // Токен    - Строка: Токен авторизации, если используется не вебхук (необяз. по ум. - Пустое значение)
    метод УдалитьЗадачу(URL: Объект?, IDЗадачи: Объект?, Токен: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", IDЗадачи)
        Опции.Вставить("-k", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьЗадачу", Опции)
        
    ;

    @Глобально
    // Метод ДобавитьФайлВЗадачу
    // Прикрепляет файл к выбранной задаче
    //
    // URL      - Строка: URL внешнего вебхука или адрес Bitrix24 при использовании токена
    // IDЗадачи - Число, Строка: ID задачи
    // IDФайла  - Число, Строка: ID Файла
    // Токен    - Строка: Токен авторизации, если используется не вебхук (необяз. по ум. - Пустое значение)
    метод ДобавитьФайлВЗадачу(URL: Объект?, IDЗадачи: Объект?, IDФайла: Объект?, Токен: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", IDЗадачи)
        Опции.Вставить("-f", IDФайла)
        Опции.Вставить("-k", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ДобавитьФайлВЗадачу", Опции)
        
    ;

    @Глобально
    // Метод ПринятьЗадачу
    // Принимает задачу по ID
    //
    // URL      - Строка: URL внешнего вебхука или адрес Bitrix24 при использовании токена
    // IDЗадачи - Число, Строка: ID задачи
    // Токен    - Строка: Токен авторизации, если используется не вебхук (необяз. по ум. - Пустое значение)
    метод ПринятьЗадачу(URL: Объект?, IDЗадачи: Объект?, Токен: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", IDЗадачи)
        Опции.Вставить("-k", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПринятьЗадачу", Опции)
        
