#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_RSS
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_RSS(Исполнитель)
    
;

@Локально
структура OPI_RSS
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "rss"
    
    @Глобально
    // Метод СоздатьФидRSS
    // Создает текст RSS фида
    //
    // НазваниеКанала - Строка: Название канала
    // ОписаниеКанала - Строка: Описание канала
    // СсылкаКанала   - Строка: Ссылка канала
    // Элементы       - Массив Из Структура: Элементы фида. См. ПолучитьСтруктуруЭлементаФидаRSS
    // ДатаОбновления - Дата, Неопределено: Дата обновления. Текущая, если не заполнено (необяз. по ум. - Пустое значение)
    метод СоздатьФидRSS(НазваниеКанала: Объект?, ОписаниеКанала: Объект?, СсылкаКанала: Объект?, Элементы: Объект?, ДатаОбновления: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-n", НазваниеКанала)
        Опции.Вставить("-d", ОписаниеКанала)
        Опции.Вставить("-l", СсылкаКанала)
        Опции.Вставить("-i", Элементы)
        Опции.Вставить("-t", ДатаОбновления)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьФидRSS", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтруктуруЭлементаФидаRSS
    // Получает структуру параметров элемента RSS фида
    //
    // Пустая          - Булево: Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей (необяз. по ум. - false)
    // КакСоответствие - Булево: Истина > возвращает поля как соответствие (необяз. по ум. - false)
    метод ПолучитьСтруктуруЭлементаФидаRSS(Пустая: Объект? = Неопределено, КакСоответствие: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        Опции.Вставить("-m", КакСоответствие)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруЭлементаФидаRSS", Опции)
        
    ;

    @Глобально
    // Метод РазобратьФидRSS
    // Разбирает XML RSS фида и возвращает структуру с данными канала и элементами
    //
    // ТекстXML - Строка: XML содержимое RSS фида
    метод РазобратьФидRSS(ТекстXML: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-x", ТекстXML)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "РазобратьФидRSS", Опции)
        
    ;

    @Глобально
    // Метод СоздатьФидAtom
    // Создает текст Atom фида
    //
    // НазваниеФида   - Строка: Название фида
    // СсылкаФида     - Строка: URL фида
    // IDФида         - Строка: Уникальный идентификатор фида (обычно URL)
    // Элементы       - Массив Из Структура: Элементы фида. См. ПолучитьСтруктуруЭлементаФидаAtom
    // ДатаОбновления - Дата, Неопределено: Дата обновления. Текущая, если не заполнено (необяз. по ум. - Пустое значение)
    метод СоздатьФидAtom(НазваниеФида: Объект?, СсылкаФида: Объект?, IDФида: Объект?, Элементы: Объект?, ДатаОбновления: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-n", НазваниеФида)
        Опции.Вставить("-l", СсылкаФида)
        Опции.Вставить("-i", IDФида)
        Опции.Вставить("-t", Элементы)
        Опции.Вставить("-d", ДатаОбновления)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьФидAtom", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтруктуруЭлементаФидаAtom
    // Получает структуру параметров элемента Atom фида
    //
    // Пустая          - Булево: Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей (необяз. по ум. - false)
    // КакСоответствие - Булево: Истина > возвращает поля как соответствие (необяз. по ум. - false)
    метод ПолучитьСтруктуруЭлементаФидаAtom(Пустая: Объект? = Неопределено, КакСоответствие: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        Опции.Вставить("-m", КакСоответствие)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруЭлементаФидаAtom", Опции)
        
    ;

    @Глобально
    // Метод РазобратьФидAtom
    // Разбирает XML Atom фида и возвращает структуру с данными фида и элементами
    //
    // ТекстXML - Строка: XML содержимое Atom фида
    метод РазобратьФидAtom(ТекстXML: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-x", ТекстXML)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "РазобратьФидAtom", Опции)
        
    ;
    
;