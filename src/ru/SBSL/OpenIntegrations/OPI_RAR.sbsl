#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_RAR
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_RAR(Исполнитель)
    
;

@Локально
структура OPI_RAR
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "rar"
    
    @Глобально
    // Метод РазархивироватьКаталог
    // Распаковывает RAR-архив в указанный каталог
    //
    // Архив             - Строка, ДвоичныеДанные: Путь к архиву на диске или двоичные данные
    // КаталогНазначения - Строка: Путь каталога для распаковки. В соответствие, если не заполнено (необяз. по ум. - Пустое значение)
    // Пароль            - Строка: Пароль архива, если требуется (необяз. по ум. - Пустое значение)
    метод РазархивироватьКаталог(Архив: Объект?, КаталогНазначения: Объект? = Неопределено, Пароль: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Архив)
        Опции.Вставить("-d", КаталогНазначения)
        Опции.Вставить("-p", Пароль)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "РазархивироватьКаталог", Опции)
        
    ;

    @Глобально
    // Метод РазархивироватьФайлы
    // Распаковывает выбранные файлы из RAR-архива по списку путей
    //
    // Архив             - Строка, ДвоичныеДанные: Путь к архиву на диске или двоичные данные
    // Пути              - Массив Из Строка: Полные пути файлов внутри архива
    // КаталогНазначения - Строка: Путь каталога для распаковки. В соответствие, если не заполнено (необяз. по ум. - Пустое значение)
    // Пароль            - Строка: Пароль архива, если требуется (необяз. по ум. - Пустое значение)
    метод РазархивироватьФайлы(Архив: Объект?, Пути: Объект?, КаталогНазначения: Объект? = Неопределено, Пароль: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Архив)
        Опции.Вставить("-p", Пути)
        Опции.Вставить("-d", КаталогНазначения)
        Опции.Вставить("-w", Пароль)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "РазархивироватьФайлы", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокФайлов
    // Получает иерархический список файлов и каталогов архива
    //
    // Архив  - Строка, ДвоичныеДанные: Путь к архиву на диске или двоичные данные
    // Пароль - Строка: Пароль архива, если требуется (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокФайлов(Архив: Объект?, Пароль: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Архив)
        Опции.Вставить("-p", Пароль)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокФайлов", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьМетаданные
    // Получает метаданные и плоский список файлов архива
    //
    // Архив  - Строка, ДвоичныеДанные: Путь к архиву на диске или двоичные данные
    // Пароль - Строка: Пароль архива, если требуется (необяз. по ум. - Пустое значение)
    метод ПолучитьМетаданные(Архив: Объект?, Пароль: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Архив)
        Опции.Вставить("-p", Пароль)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьМетаданные", Опции)
        
    ;
    
;