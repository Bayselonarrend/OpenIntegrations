    // Метод ПолучитьСтруктуруНастроекИнстанса
    // Получает шаблон структуры для установки настроек инстанса
    //
    // Пустая - Булево: Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей (необяз. по ум. - false)
    метод ПолучитьСтруктуруНастроекИнстанса(Пустая: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруНастроекИнстанса", Опции)
        
    ;

    @Глобально
    // Метод СоздатьГруппу
    // Создает новый групповой чат с указанным именем
    //
    // ПараметрыДоступа - Структура Из КлючИЗначение: Параметры доступа. См. СформироватьПараметрыДоступа
    // Наименование     - Строка: Наименование группы
    // Участники        - Массив Из Строка, Строка: Массив ID участников группы или один ID
    метод СоздатьГруппу(ПараметрыДоступа: Объект?, Наименование: Объект?, Участники: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ПараметрыДоступа)
        Опции.Вставить("-n", Наименование)
        Опции.Вставить("-m", Участники)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьГруппу", Опции)
        
    ;

