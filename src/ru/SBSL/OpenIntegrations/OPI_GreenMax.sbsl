#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Строка?|Executor.НастройкиИнтеграции): OPI_GreenMax
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_GreenMax(Исполнитель)
    
;

@Локально
структура OPI_GreenMax
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "greenmax"
    
    @Глобально
    метод СформироватьПараметрыДоступа(ApiUrl: Объект?, MediaUrl: Объект?, IdInstance: Объект?, ApiTokenInstance: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ApiUrl)
        Опции.Вставить("-m", MediaUrl)
        Опции.Вставить("-i", IdInstance)
        Опции.Вставить("-t", ApiTokenInstance)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СформироватьПараметрыДоступа", Опции)
        
    ;

