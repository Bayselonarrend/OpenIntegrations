    @Глобально
    // Метод ПолучитьСтруктуруНастроекГруппы
    // Возвращает структуру полей настроек группового чата
    //
    // Пустая          - Булево: Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей (необяз. по ум. - false)
    // КакСоответствие - Булево: Истина > возвращает поля настроек как соответствие (необяз. по ум. - false)
    метод ПолучитьСтруктуруНастроекГруппы(Пустая: Объект? = Неопределено, КакСоответствие: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        Опции.Вставить("-m", КакСоответствие)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруНастроекГруппы", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьТекстовоеСообщение
