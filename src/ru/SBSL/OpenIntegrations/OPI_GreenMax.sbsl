    // IDУчастника      - Строка: ID участника
    метод НазначитьПраваАдминистратора(ПараметрыДоступа: Объект?, IDЧата: Объект?, IDУчастника: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ПараметрыДоступа)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-m", IDУчастника)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "НазначитьПраваАдминистратора", Опции)
        
    ;

