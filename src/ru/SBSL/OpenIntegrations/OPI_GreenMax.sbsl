    @Глобально
    // Метод ПроверитьАккаунт
    // Проверяет существование аккаунта Max по номеру телефона
    //
    // ПараметрыДоступа - Структура Из КлючИЗначение: Параметры доступа. См. СформироватьПараметрыДоступа
    // НомерТелефона    - Строка, Число: Номер телефона для проверки без знака +
    // ИгнорироватьКэш  - Булево: Игнорировать кэш при повторном запросе проверки (необяз. по ум. - false)
    метод ПроверитьАккаунт(ПараметрыДоступа: Объект?, НомерТелефона: Объект?, ИгнорироватьКэш: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ПараметрыДоступа)
        Опции.Вставить("-p", НомерТелефона)
        Опции.Вставить("-f", ИгнорироватьКэш)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПроверитьАккаунт", Опции)
        
    ;

    @Глобально
