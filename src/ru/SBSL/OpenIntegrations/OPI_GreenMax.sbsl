    // ВремяНабора      - Число: Время показа признака набора текста перед отправкой (в мс.) (необяз. по ум. - Пустое значение)
    метод ОтправитьТекстовоеСообщение(ПараметрыДоступа: Объект?, IDЧата: Объект?, Текст: Объект?, ВремяНабора: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ПараметрыДоступа)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-t", Текст)
        Опции.Вставить("-p", ВремяНабора)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьТекстовоеСообщение", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьФайл
    // Отправляет файл в выбранный чат
    //
    // ПараметрыДоступа - Структура Из КлючИЗначение: Параметры доступа. См. СформироватьПараметрыДоступа
    // IDЧата           - Строка: Идентификатор чата
    // Файл             - Строка, ДвоичныеДанные: Данные или путь к файлу
    // ИмяФайла         - Строка: Имя загружаемого файла с расширением
    // Описание         - Строка: Текст сообщения под файлом (необяз. по ум. - Пустое значение)
    // ВремяНабора      - Число: Время показа признака набора перед отправкой (в мс.) (необяз. по ум. - Пустое значение)
    // ТипНабора        - Строка: Тип набора: text, recording, video, image, file (необяз. по ум. - file)
    метод ОтправитьФайл(ПараметрыДоступа: Объект?, IDЧата: Объект?, Файл: Объект?, ИмяФайла: Объект?, Описание: Объект? = Неопределено, ВремяНабора: Объект? = Неопределено, ТипНабора: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ПараметрыДоступа)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-f", Файл)
        Опции.Вставить("-l", ИмяФайла)
        Опции.Вставить("-p", Описание)
        Опции.Вставить("-t", ВремяНабора)
        Опции.Вставить("-y", ТипНабора)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьФайл", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьФайлПоURL
    // Отправляет файл по URL в выбранный чат
    //
    // ПараметрыДоступа - Структура Из КлючИЗначение: Параметры доступа. См. СформироватьПараметрыДоступа
