#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Строка?|Executor.НастройкиИнтеграции): OPI_OpenAI
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_OpenAI(Исполнитель)
    
;

@Локально
структура OPI_OpenAI
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "openai"
    
    @Глобально
    метод ПолучитьОтвет(URL: Объект?, Токен: Объект?, Модель: Объект?, Сообщения: Объект?, ДопПараметры: Объект? = Неопределено, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-m", Модель)
        Опции.Вставить("-s", Сообщения)
        Опции.Вставить("-o", ДопПараметры)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьОтвет", Опции)
        
    ;

    @Глобально
    метод ПолучитьКартинки(URL: Объект?, Токен: Объект?, Модель: Объект?, Описание: Объект?, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-m", Модель)
        Опции.Вставить("-d", Описание)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьКартинки", Опции)
        
    ;

