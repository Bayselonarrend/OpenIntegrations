#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_OpenAI
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_OpenAI(Исполнитель)
    
;

@Локально
структура OPI_OpenAI
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "openai"
    
    @Глобально
    // Метод ПолучитьОтвет
    // Генерирует ответ по заданному текстовому запросу
    //
    // URL          - Строка: URL сервера OpenAI
    // Токен        - Строка: Токен авторизации OpenAI
    // Модель       - Строка: Имя модели
    // Сообщения    - Структура, Массив Из Структура: Сообщения разговора. См. ПолучитьСтруктуруСообщения
    // ДопПараметры - Структура Из КлючИЗначение: Доп. параметры запроса, если необходимо (необяз. по ум. - Пустое значение)
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп. заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод ПолучитьОтвет(URL: Объект?, Токен: Объект?, Модель: Объект?, Сообщения: Объект?, ДопПараметры: Объект? = Неопределено, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-m", Модель)
        Опции.Вставить("-s", Сообщения)
        Опции.Вставить("-o", ДопПараметры)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьОтвет", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьКартинки
    // Генерирует картинки по указанному описанию
    //
    // URL          - Строка: URL сервера OpenAI
    // Токен        - Строка: Токен авторизации OpenAI
    // Модель       - Строка: Имя модели
    // Описание     - Структура Из КлючИЗначение: Параметры генерации. См. ПолучитьСтруктуруОписанияКартинок
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп. заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод ПолучитьКартинки(URL: Объект?, Токен: Объект?, Модель: Объект?, Описание: Объект?, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-m", Модель)
        Опции.Вставить("-d", Описание)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьКартинки", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьПредставления
    // Получает представления (embeddings) для заданных вводных
    //
    // URL          - Строка: URL сервера OpenAI
    // Токен        - Строка: Токен авторизации OpenAI
    // Модель       - Строка: Имя модели
    // Текст        - Массив Из Строка: Строка или массив строк запросов
    // ДопПараметры - Структура Из КлючИЗначение: Доп. параметры запроса, если необходимо (необяз. по ум. - Пустое значение)
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп. заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод ПолучитьПредставления(URL: Объект?, Токен: Объект?, Модель: Объект?, Текст: Объект?, ДопПараметры: Объект? = Неопределено, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-m", Модель)
        Опции.Вставить("-i", Текст)
        Опции.Вставить("-o", ДопПараметры)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПредставления", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтруктуруСообщения
    // Получает структуру произвольного сообщения для списка сообщений запроса
    //
    // Роль  - Строка: Источник сообщения: system, user, assistant и др.
    // Текст - Строка: Текст сообщения
    // Имя   - Строка: Имя участника разговора (необяз. по ум. - Пустое значение)
    метод ПолучитьСтруктуруСообщения(Роль: Объект?, Текст: Объект?, Имя: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-r", Роль)
        Опции.Вставить("-t", Текст)
        Опции.Вставить("-n", Имя)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруСообщения", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСообщениеПользователя
    // Получает структуру сообщения от лица пользователя для использования в запросе
    //
    // Текст - Строка: Текст сообщения
    // Имя   - Строка: Имя участника разговора (необяз. по ум. - Пустое значение)
    метод ПолучитьСообщениеПользователя(Текст: Объект?, Имя: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Текст)
        Опции.Вставить("-n", Имя)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСообщениеПользователя", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСообщениеАссистента
    // Получает структуру сообщения от лица ассистента для использования в запросе
    //
    // Текст - Строка: Текст сообщения
    метод ПолучитьСообщениеАссистента(Текст: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Текст)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСообщениеАссистента", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСообщениеСистемы
    // Получает структуру системного сообщения для использования в запросе
    //
    // Текст - Строка: Текст сообщения
    метод ПолучитьСообщениеСистемы(Текст: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Текст)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСообщениеСистемы", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтруктуруСообщенияКартинки
    // Получает структура сообщения на основе изображения для списка сообщений запроса
    //
    // Роль    - Строка: Источник сообщения: system, user, developer
    // IDФайла - Строка: ID файла картинки. См. ЗагрузитьФайл
    // Текст   - Строка: Вводный текст запроса для обработки картинки (необяз. по ум. - Пустое значение)
    метод ПолучитьСтруктуруСообщенияКартинки(Роль: Объект?, IDФайла: Объект?, Текст: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-r", Роль)
        Опции.Вставить("-f", IDФайла)
        Опции.Вставить("-p", Текст)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруСообщенияКартинки", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтруктуруОписанияКартинок
    // Получить структуру описания картинок для генерации
    //
    // Промпт       - Строка: Текстовое описание картинки для генерации
    // Количество   - Число: Количество изображений для генерации
    // Фон          - Строка: Вариант генерации фона: transparent, opaque, auto (необяз. по ум. - Пустое значение)
    // Размер       - Строка: Вариант размера сгенерированных изображений (необяз. по ум. - Пустое значение)
    // ДопПараметры - Структура Из КлючИЗначение: Доп. параметры запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод ПолучитьСтруктуруОписанияКартинок(Промпт: Объект?, Количество: Объект?, Фон: Объект? = Неопределено, Размер: Объект? = Неопределено, ДопПараметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-p", Промпт)
        Опции.Вставить("-a", Количество)
        Опции.Вставить("-b", Фон)
        Опции.Вставить("-s", Размер)
        Опции.Вставить("-o", ДопПараметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруОписанияКартинок", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокАссистентов
    // Получает список ассистентов с отбором или без
    //
    // URL          - Строка: URL сервера OpenAI
    // Токен        - Строка: Токен авторизации OpenAI
    // Количество   - Число: Максимальное число возвращаемых ассистентов (необяз. по ум. - 20)
    // ДопПараметры - Структура Из КлючИЗначение: Доп. параметры запроса, если необходимо (необяз. по ум. - Пустое значение)
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп. заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокАссистентов(URL: Объект?, Токен: Объект?, Количество: Объект? = Неопределено, ДопПараметры: Объект? = Неопределено, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-l", Количество)
        Опции.Вставить("-o", ДопПараметры)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокАссистентов", Опции)
        
    ;

    @Глобально
    // Метод СоздатьАссистента
    // Создает ассистента по модели и инструкции
    //
    // URL          - Строка: URL сервера OpenAI
    // Токен        - Строка: Токен авторизации OpenAI
    // Модель       - Строка: Имя модели
    // Имя          - Строка: Имя ассистента (необяз. по ум. - Пустое значение)
    // Инструкция   - Строка: Системная инструкция для ассистента (необяз. по ум. - Пустое значение)
    // ДопПараметры - Структура Из КлючИЗначение: Доп. параметры запроса, если необходимо (необяз. по ум. - Пустое значение)
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп. заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод СоздатьАссистента(URL: Объект?, Токен: Объект?, Модель: Объект?, Имя: Объект? = Неопределено, Инструкция: Объект? = Неопределено, ДопПараметры: Объект? = Неопределено, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-m", Модель)
        Опции.Вставить("-n", Имя)
        Опции.Вставить("-i", Инструкция)
        Опции.Вставить("-o", ДопПараметры)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьАссистента", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьАссистента
    // Получает информацию об ассистенте по ID
    //
    // URL          - Строка: URL сервера OpenAI
    // Токен        - Строка: Токен авторизации OpenAI
    // IDАссистента - Строка: ID ассистента
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп. заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод ПолучитьАссистента(URL: Объект?, Токен: Объект?, IDАссистента: Объект?, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-i", IDАссистента)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьАссистента", Опции)
        
    ;

    @Глобально
    // Метод УдалитьАссистента
    // Удаляет ранее созданного ассистента
    //
    // URL          - Строка: URL сервера OpenAI
    // Токен        - Строка: Токен авторизации OpenAI
    // IDАссистента - Строка: ID ассистента
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп. заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод УдалитьАссистента(URL: Объект?, Токен: Объект?, IDАссистента: Объект?, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-i", IDАссистента)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьАссистента", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокФайлов
    // Получает список файлов с отбором или без
    //
    // URL          - Строка: URL сервера OpenAI
    // Токен        - Строка: Токен авторизации OpenAI
    // Количество   - Число: Максимальное число возвращаемых ассистентов (необяз. по ум. - 10000)
    // ДопПараметры - Структура Из КлючИЗначение: Доп. параметры запроса, если необходимо (необяз. по ум. - Пустое значение)
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп. заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокФайлов(URL: Объект?, Токен: Объект?, Количество: Объект? = Неопределено, ДопПараметры: Объект? = Неопределено, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-l", Количество)
        Опции.Вставить("-o", ДопПараметры)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокФайлов", Опции)
        
    ;

    @Глобально
    // Метод ЗагрузитьФайл
    // Загружает файл для дальнейшего использования в других запросах
    //
    // URL          - Строка: URL сервера OpenAI
    // Токен        - Строка: Токен авторизации OpenAI
    // ИмяФайла     - Строка: Имя файла с расширением
    // Данные       - Строка, ДвоичныеДанные: Путь к файлу или данные
    // Назначение   - Строка: Назначение файла: assistants, batch, vision, user_data, evals
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп. заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод ЗагрузитьФайл(URL: Объект?, Токен: Объект?, ИмяФайла: Объект?, Данные: Объект?, Назначение: Объект?, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-n", ИмяФайла)
        Опции.Вставить("-d", Данные)
        Опции.Вставить("-p", Назначение)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗагрузитьФайл", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьИнформациюОФайле
    // Получает информацию о файле
    //
    // URL          - Строка: URL сервера OpenAI
    // Токен        - Строка: Токен авторизации OpenAI
    // IDФайла      - Строка: ID файла
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп. заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод ПолучитьИнформациюОФайле(URL: Объект?, Токен: Объект?, IDФайла: Объект?, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-i", IDФайла)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьИнформациюОФайле", Опции)
        
    ;

    @Глобально
    // Метод СкачатьФайл
    // Получает данные файла с сервера
    //
    // URL          - Строка: URL сервера OpenAI
    // Токен        - Строка: Токен авторизации OpenAI
    // IDФайла      - Строка: ID файла
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп. заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод СкачатьФайл(URL: Объект?, Токен: Объект?, IDФайла: Объект?, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-i", IDФайла)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СкачатьФайл", Опции)
        
    ;

    @Глобально
    // Метод УдалитьФайл
    // Удаляет ранее загруженный файл
    //
    // URL          - Строка: URL сервера OpenAI
    // Токен        - Строка: Токен авторизации OpenAI
    // IDФайла      - Строка: ID файла
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп. заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод УдалитьФайл(URL: Объект?, Токен: Объект?, IDФайла: Объект?, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-i", IDФайла)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьФайл", Опции)
        
    ;

    @Глобально
    // Метод СгенерироватьРечь
    // Генерирует аудио с озвучиванием указанного текста
    //
    // URL          - Строка: URL сервера OpenAI
    // Токен        - Строка: Токен авторизации OpenAI
    // Модель       - Строка: Имя модели
    // Текст        - Строка: Текст для озвучивания
    // Голос        - Строка: Вид голоса: alloy, ash, ballad, coral, echo и др. (необяз. по ум. - alloy)
    // ДопПараметры - Структура Из КлючИЗначение: Доп. параметры запроса, если необходимо (необяз. по ум. - Пустое значение)
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп. заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод СгенерироватьРечь(URL: Объект?, Токен: Объект?, Модель: Объект?, Текст: Объект?, Голос: Объект? = Неопределено, ДопПараметры: Объект? = Неопределено, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-m", Модель)
        Опции.Вставить("-i", Текст)
        Опции.Вставить("-v", Голос)
        Опции.Вставить("-o", ДопПараметры)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СгенерироватьРечь", Опции)
        
    ;

    @Глобально
    // Метод СоздатьТранскрипцию
    // Создает текстовую транскрипцию для выбранного аудио файла
    //
    // URL          - Строка: URL сервера OpenAI
    // Токен        - Строка: Токен авторизации OpenAI
    // Модель       - Строка: Имя модели
    // Аудио        - Строка, ДвоичныеДанные: Аудио файл
    // MIME         - Строка: MIME тип аудио файла (необяз. по ум. - audio/mpeg)
    // ДопПараметры - Структура Из КлючИЗначение: Доп. параметры запроса, если необходимо (необяз. по ум. - Пустое значение)
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп. заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод СоздатьТранскрипцию(URL: Объект?, Токен: Объект?, Модель: Объект?, Аудио: Объект?, MIME: Объект? = Неопределено, ДопПараметры: Объект? = Неопределено, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-m", Модель)
        Опции.Вставить("-a", Аудио)
        Опции.Вставить("-p", MIME)
        Опции.Вставить("-o", ДопПараметры)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьТранскрипцию", Опции)
        
    ;

    @Глобально
