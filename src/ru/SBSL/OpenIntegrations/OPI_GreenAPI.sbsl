#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_GreenAPI
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_GreenAPI(Исполнитель)
    
;

@Локально
структура OPI_GreenAPI
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "greenapi"
    
    @Глобально
    // Метод СформироватьПараметрыДоступа
    // Формирует структуру основных авторизационных данных
    //
    // ApiUrl           - Строка: Ссылка на хост API
    // MediaUrl         - Строка: Ссылка на хост API для отправки файлов
    // IdInstance       - Строка: Уникальный номер инстанса
    // ApiTokenInstance - Строка: Ключ доступа инстанса
    метод СформироватьПараметрыДоступа(ApiUrl: Объект?, MediaUrl: Объект?, IdInstance: Объект?, ApiTokenInstance: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ApiUrl)
        Опции.Вставить("-m", MediaUrl)
        Опции.Вставить("-i", IdInstance)
        Опции.Вставить("-t", ApiTokenInstance)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СформироватьПараметрыДоступа", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьИнформациюОбАккаунте
    // Получает информацию об аккаунте
    //
    // ПараметрыДоступа - Структура Из КлючИЗначение: Параметры доступа. См. СформироватьПараметрыДоступа
    метод ПолучитьИнформациюОбАккаунте(ПараметрыДоступа: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ПараметрыДоступа)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьИнформациюОбАккаунте", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьНастройкиИнстанса
    // Получает текущие настройки инстанса
    //
    // ПараметрыДоступа - Структура Из КлючИЗначение: Параметры доступа. См. СформироватьПараметрыДоступа
    метод ПолучитьНастройкиИнстанса(ПараметрыДоступа: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ПараметрыДоступа)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиИнстанса", Опции)
        
    ;

    @Глобально
    // Метод УстановитьНастройкиИнстанса
    // Устанавливает настройки инстанса
    //
    // Настройки        - Структура Из КлючИЗначение: Настройки инстанса. См. ПолучитьСтруктуруНастроекИнстанса
    // ПараметрыДоступа - Структура Из КлючИЗначение: Параметры доступа. См. СформироватьПараметрыДоступа
    метод УстановитьНастройкиИнстанса(Настройки: Объект?, ПараметрыДоступа: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Настройки)
        Опции.Вставить("-a", ПараметрыДоступа)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УстановитьНастройкиИнстанса", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСостояниеИнстанса
    // Получает состояние инстанса
    //
    // ПараметрыДоступа - Структура Из КлючИЗначение: Параметры доступа. См. СформироватьПараметрыДоступа
    метод ПолучитьСостояниеИнстанса(ПараметрыДоступа: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ПараметрыДоступа)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСостояниеИнстанса", Опции)
        
    ;

    @Глобально
    // Метод ПерезапуститьИнстанс
    // Перезапускает инстанс
    //
    // ПараметрыДоступа - Структура Из КлючИЗначение: Параметры доступа. См. СформироватьПараметрыДоступа
    метод ПерезапуститьИнстанс(ПараметрыДоступа: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ПараметрыДоступа)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПерезапуститьИнстанс", Опции)
        
    ;

    @Глобально
    // Метод РазлогинитьИнстанс
    // Разлогинивает инстанс
    //
    // ПараметрыДоступа - Структура Из КлючИЗначение: Параметры доступа. См. СформироватьПараметрыДоступа
    метод РазлогинитьИнстанс(ПараметрыДоступа: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ПараметрыДоступа)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "РазлогинитьИнстанс", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьQR
    // Получает QR-код авторизации
    //
    // ПараметрыДоступа - Структура Из КлючИЗначение: Параметры доступа. См. СформироватьПараметрыДоступа
    метод ПолучитьQR(ПараметрыДоступа: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
