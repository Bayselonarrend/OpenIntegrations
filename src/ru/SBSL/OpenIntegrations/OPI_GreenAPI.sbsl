        Опции.Вставить("-g", IDГруппы)
        Опции.Вставить("-u", IDПользователя)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИсключитьУчастникаГруппы", Опции)
        
    ;

    @Глобально
    // Метод НазначитьПраваАдминистратора
    // Назначает пользователя администратором группы
    //
    // ПараметрыДоступа - Структура Из КлючИЗначение: Параметры доступа. См. СформироватьПараметрыДоступа
