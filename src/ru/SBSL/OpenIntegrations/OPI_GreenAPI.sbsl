        Опции.Вставить("-m", IDСообщения)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСообщение", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьЖурналВходящихСообщений
    // Получает список входящих сообщений инстанса за указанный интервал
    //
    // ПараметрыДоступа - Структура Из КлючИЗначение: Параметры доступа. См. СформироватьПараметрыДоступа
    // Период           - Число: Время в минутах, за которое требуется показать сообщения (необяз. по ум. - 1440)
    метод ПолучитьЖурналВходящихСообщений(ПараметрыДоступа: Объект?, Период: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ПараметрыДоступа)
        Опции.Вставить("-p", Период)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьЖурналВходящихСообщений", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьЖурналИсходящихСообщений
    // Получает список исходящих сообщений инстанса за указанный интервал
    //
    // ПараметрыДоступа - Структура Из КлючИЗначение: Параметры доступа. См. СформироватьПараметрыДоступа
    // Период           - Число: Время в минутах, за которое требуется показать сообщения (необяз. по ум. - 1440)
    метод ПолучитьЖурналИсходящихСообщений(ПараметрыДоступа: Объект?, Период: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ПараметрыДоступа)
        Опции.Вставить("-p", Период)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьЖурналИсходящихСообщений", Опции)
        
    ;
    
;