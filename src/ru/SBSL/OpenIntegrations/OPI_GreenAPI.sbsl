    ;

    @Глобально
    // Метод ПолучитьКодАвторизации
    // Получает код авторизации для связи по номеру телефона
    //
    // ПараметрыДоступа - Структура Из КлючИЗначение: Параметры доступа. См. СформироватьПараметрыДоступа
    // НомерТелефона    - Строка, Число: Номер телефона в международном формате без + и 00
    метод ПолучитьКодАвторизации(ПараметрыДоступа: Объект?, НомерТелефона: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ПараметрыДоступа)
        Опции.Вставить("-p", НомерТелефона)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьКодАвторизации", Опции)
        
    ;

    @Глобально
    // Метод УстановитьКартинкуПрофиля
    // Устанавливает новую картинку профиля
    //
    // ПараметрыДоступа - Структура Из КлючИЗначение: Параметры доступа. См. СформироватьПараметрыДоступа
    // Картинка         - ДвоичныеДанные, Строка: Картинка профиля
    метод УстановитьКартинкуПрофиля(ПараметрыДоступа: Объект?, Картинка: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ПараметрыДоступа)
        Опции.Вставить("-p", Картинка)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УстановитьКартинкуПрофиля", Опции)
        
    ;

    @Глобально
    // Метод АрхивироватьЧат
    // Архивирует выбранный чат
    //
    // ПараметрыДоступа - Структура Из КлючИЗначение: Параметры доступа. См. СформироватьПараметрыДоступа
    // IDЧата           - Строка: ID чата для архивации
    метод АрхивироватьЧат(ПараметрыДоступа: Объект?, IDЧата: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ПараметрыДоступа)
        Опции.Вставить("-c", IDЧата)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "АрхивироватьЧат", Опции)
        
    ;

    @Глобально
    // Метод РазархивироватьЧат
    // Разархивирует выбранный чат
    //
    // ПараметрыДоступа - Структура Из КлючИЗначение: Параметры доступа. См. СформироватьПараметрыДоступа
    // IDЧата           - Строка: ID чата для разархивации
    метод РазархивироватьЧат(ПараметрыДоступа: Объект?, IDЧата: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ПараметрыДоступа)
        Опции.Вставить("-c", IDЧата)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "РазархивироватьЧат", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтруктуруНастроекИнстанса
    // Получает шаблон структуры для установки настроек инстанса
    //
    // Пустая - Булево: Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей (необяз. по ум. - false)
    метод ПолучитьСтруктуруНастроекИнстанса(Пустая: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруНастроекИнстанса", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьИнформациюОГруппе
    // Получает данные группового чата
    //
    // ПараметрыДоступа - Структура Из КлючИЗначение: Параметры доступа. См. СформироватьПараметрыДоступа
    // IDГруппы         - Строка: Идентификатор группового чата
    метод ПолучитьИнформациюОГруппе(ПараметрыДоступа: Объект?, IDГруппы: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ПараметрыДоступа)
        Опции.Вставить("-g", IDГруппы)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьИнформациюОГруппе", Опции)
        
    ;

    @Глобально
    // Метод СоздатьГруппу
    // Создает новый групповой чат
    //
    // ПараметрыДоступа - Структура Из КлючИЗначение: Параметры доступа. См. СформироватьПараметрыДоступа
    // Имя              - Строка: Наименование группового чата
    // Участники        - Массив Из Строка: Массив участников чата (необяз. по ум. - Пустое значение)
    метод СоздатьГруппу(ПараметрыДоступа: Объект?, Имя: Объект?, Участники: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ПараметрыДоступа)
        Опции.Вставить("-n", Имя)
        Опции.Вставить("-m", Участники)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьГруппу", Опции)
        
    ;

    @Глобально
    // Метод ИзменитьИмяГруппы
    // Изменяет имя существующей группы
    //
    // ПараметрыДоступа - Структура Из КлючИЗначение: Параметры доступа. См. СформироватьПараметрыДоступа
    // IDГруппы         - Строка: Идентификатор группового чата
    // Имя              - Строка: Новое наименование группового чата
    метод ИзменитьИмяГруппы(ПараметрыДоступа: Объект?, IDГруппы: Объект?, Имя: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ПараметрыДоступа)
        Опции.Вставить("-g", IDГруппы)
        Опции.Вставить("-n", Имя)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьИмяГруппы", Опции)
        
    ;

    @Глобально
    // Метод ДобавитьУчастникаВГруппу
    // Добавляет участника в групповой чат
    //
    // ПараметрыДоступа - Структура Из КлючИЗначение: Параметры доступа. См. СформироватьПараметрыДоступа
    // IDГруппы         - Строка: Идентификатор группового чата
    // IDПользователя   - Строка: ID пользователя для добавления
    метод ДобавитьУчастникаВГруппу(ПараметрыДоступа: Объект?, IDГруппы: Объект?, IDПользователя: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ПараметрыДоступа)
        Опции.Вставить("-g", IDГруппы)
        Опции.Вставить("-u", IDПользователя)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ДобавитьУчастникаВГруппу", Опции)
        
    ;

    @Глобально
    // Метод ИсключитьУчастникаГруппы
    // Исключает участника из группы
    //
    // ПараметрыДоступа - Структура Из КлючИЗначение: Параметры доступа. См. СформироватьПараметрыДоступа
    // IDГруппы         - Строка: Идентификатор группового чата
    // IDПользователя   - Строка: ID пользователя для добавления
    метод ИсключитьУчастникаГруппы(ПараметрыДоступа: Объект?, IDГруппы: Объект?, IDПользователя: Объект?): Объект?
        
