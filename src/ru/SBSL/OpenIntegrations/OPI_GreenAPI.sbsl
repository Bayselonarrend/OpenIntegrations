    ;

    @Глобально
    // Метод ОтправитьТекстовоеСообщение
    // Отправляет текстовое сообщение в выбранный чат
    //
    // ПараметрыДоступа - Структура Из КлючИЗначение: Параметры доступа. См. СформироватьПараметрыДоступа
    // IDЧата           - Строка: Идентификатор чата
    // Текст            - Строка: Текст сообщения
    // IDЦитируемого    - Строка: ID цитируемого сообщения, если необходимо (необяз. по ум. - Пустое значение)
    метод ОтправитьТекстовоеСообщение(ПараметрыДоступа: Объект?, IDЧата: Объект?, Текст: Объект?, IDЦитируемого: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ПараметрыДоступа)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-t", Текст)
        Опции.Вставить("-q", IDЦитируемого)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьТекстовоеСообщение", Опции)
        
