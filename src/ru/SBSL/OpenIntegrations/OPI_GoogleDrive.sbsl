    ;

    @Глобально
    метод ЗагрузитьФайл(Токен: Объект?, Файл: Объект?, Описание: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", Файл)
        Опции.Вставить("-p", Описание)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗагрузитьФайл", Опции)
        
    ;

    @Глобально
    метод СоздатьПапку(Токен: Объект?, Имя: Объект?, Родитель: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-l", Имя)
