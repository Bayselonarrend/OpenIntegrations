#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_GoogleDrive
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_GoogleDrive(Исполнитель)
    
;

@Локально
структура OPI_GoogleDrive
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "gdrive"
    
    @Глобально
    // Метод СформироватьСсылкуПолученияКода
    // Возвращает URL для авторизации в браузере
    //
    // ClientID - Строка: Client ID
    // Calendar - Булево: разрешение на методы Calendar (необяз. по ум. - true)
    // Drive    - Булево: разрешение на методы Drive (необяз. по ум. - true)
    // Sheets   - Булево: разрешение на методы Sheets (необяз. по ум. - true)
    метод СформироватьСсылкуПолученияКода(ClientID: Объект?, Calendar: Объект? = Неопределено, Drive: Объект? = Неопределено, Sheets: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-i", ClientID)
        Опции.Вставить("-c", Calendar)
        Опции.Вставить("-d", Drive)
        Опции.Вставить("-s", Sheets)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СформироватьСсылкуПолученияКода", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьТокенПоКоду
    // Получает токен по коду из авторизации в браузере
    //
    // ClientID     - Строка: Client ID
    // ClientSecret - Строка: Client secret
    // Code         - Строка: Code из браузера
    метод ПолучитьТокенПоКоду(ClientID: Объект?, ClientSecret: Объект?, Code: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-i", ClientID)
        Опции.Вставить("-s", ClientSecret)
        Опции.Вставить("-c", Code)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьТокенПоКоду", Опции)
        
    ;

    @Глобально
    // Метод ОбновитьТокен
    // Обновляет токен по Refresh token
    //
    // ClientID     - Строка: Client ID
    // ClientSecret - Строка: Client secret
    // RefreshToken - Строка: Refresh token
    метод ОбновитьТокен(ClientID: Объект?, ClientSecret: Объект?, RefreshToken: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-i", ClientID)
        Опции.Вставить("-s", ClientSecret)
        Опции.Вставить("-r", RefreshToken)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОбновитьТокен", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьТокенServiceАккаунта
    // Получает токен авторизации по данным service аккаунта
    //
    // Данные          - Произвольный: JSON данные авторизации как файл, коллекция или двоичные данные
    // ОбластиДействия - Массив Из Строка: Область действия (scope) или массив областей
    // ВремяЖизни      - Число: Время жизни токена в секундах (необяз. по ум. - 3600)
    метод ПолучитьТокенServiceАккаунта(Данные: Объект?, ОбластиДействия: Объект?, ВремяЖизни: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Данные)
        Опции.Вставить("-s", ОбластиДействия)
        Опции.Вставить("-e", ВремяЖизни)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьТокенServiceАккаунта", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьИнформациюОбОбъекте
    // Получает информацию о папке или файле по ID
    //
    // Токен         - Строка: Токен
    // Идентификатор - Строка: Идентификатор файла или каталога
    метод ПолучитьИнформациюОбОбъекте(Токен: Объект?, Идентификатор: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-o", Идентификатор)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьИнформациюОбОбъекте", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокКаталогов
    // Получает список каталогов диска
    //
    // Токен       - Строка: Токен
    // ИмяСодержит - Строка: Отбор по имени (необяз. по ум. - Пустое значение)
    // Подробно    - Булево: Добавляет список файлов к полям каталога (необяз. по ум. - false)
    метод ПолучитьСписокКаталогов(Токен: Объект?, ИмяСодержит: Объект? = Неопределено, Подробно: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-q", ИмяСодержит)
        Опции.Вставить("-d", Подробно)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокКаталогов", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокФайлов
    // Получает список файлов
    //
    // Токен       - Строка: Токен
    // ИмяСодержит - Строка: Отбор по имени (необяз. по ум. - Пустое значение)
    // Каталог     - Строка: Отбор по ID каталога родителя (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокФайлов(Токен: Объект?, ИмяСодержит: Объект? = Неопределено, Каталог: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-q", ИмяСодержит)
        Опции.Вставить("-c", Каталог)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокФайлов", Опции)
        
    ;

    @Глобально
    // Метод ЗагрузитьФайл
    // Загружает файл на диск
    //
    // Токен    - Строка: Токен
    // Файл     - ДвоичныеДанные, Строка: Загружаемый файл
    // Описание - Соответствие Из КлючИЗначение: См. ПолучитьОписаниеФайла
    метод ЗагрузитьФайл(Токен: Объект?, Файл: Объект?, Описание: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", Файл)
        Опции.Вставить("-p", Описание)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗагрузитьФайл", Опции)
        
    ;

    @Глобально
    // Метод СоздатьПапку
    // Создает пустой каталог на диске
    //
    // Токен    - Строка: Токен
    // Имя      - Строка: Имя папки
    // Родитель - Строка: Родитель (необяз. по ум. - Пустое значение)
    метод СоздатьПапку(Токен: Объект?, Имя: Объект?, Родитель: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-l", Имя)
        Опции.Вставить("-c", Родитель)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьПапку", Опции)
        
    ;

    @Глобально
    // Метод СкачатьФайл
    // Получает файл по ID
    //
    // Токен          - Строка: Токен
    // Идентификатор  - Строка: Идентификатор файла
    // ПутьСохранения - Строка: Путь сохранения файла (необяз. по ум. - Пустое значение)
    метод СкачатьФайл(Токен: Объект?, Идентификатор: Объект?, ПутьСохранения: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-o", Идентификатор)
        Опции.Вставить("", ПутьСохранения)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СкачатьФайл", Опции)
        
    ;

    @Глобально
    // Метод СкопироватьОбъект
    // Копирует файл или каталог
    //
    // Токен         - Строка: Токен
    // Идентификатор - Строка: Идентификатор объекта
    // НовоеИмя      - Строка: Новое имя объекта (необяз. по ум. - Пустое значение)
    // НовыйРодитель - Строка: Новый каталог размещения (необяз. по ум. - Пустое значение)
    метод СкопироватьОбъект(Токен: Объект?, Идентификатор: Объект?, НовоеИмя: Объект? = Неопределено, НовыйРодитель: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-o", Идентификатор)
        Опции.Вставить("-l", НовоеИмя)
        Опции.Вставить("-c", НовыйРодитель)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СкопироватьОбъект", Опции)
        
    ;

    @Глобально
    // Метод ОбновитьФайл
    // Обновляет двоичные данные файла
    //
    // Токен         - Строка: Токен
    // Идентификатор - Строка: Идентификатор обновляемого объекта
    // Файл          - ДвоичныеДанные, Строка: Файл источник обновления
    // НовоеИмя      - Строка: Новое имя файла (если необходимо) (необяз. по ум. - Пустое значение)
    метод ОбновитьФайл(Токен: Объект?, Идентификатор: Объект?, Файл: Объект?, НовоеИмя: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-o", Идентификатор)
        Опции.Вставить("-f", Файл)
        Опции.Вставить("-l", НовоеИмя)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОбновитьФайл", Опции)
        
    ;

    @Глобально
    // Метод УдалитьОбъект
    // Удаляет файл или каталог по ID
    //
    // Токен         - Строка: Токен
    // Идентификатор - Строка: Идентификатор объекта для удаления
    метод УдалитьОбъект(Токен: Объект?, Идентификатор: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-o", Идентификатор)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьОбъект", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьОписаниеФайла
    // Получает шаблон пустого описания для загрузки файла
    //
    // Пустая - Булево: Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей (необяз. по ум. - false)
    метод ПолучитьОписаниеФайла(Пустая: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьОписаниеФайла", Опции)
        
    ;

    @Глобально
    // Метод СоздатьКомментарий
    // Создает комментарий к файлу или каталогу
    //
    // Токен         - Строка: Токен
    // Идентификатор - Строка: Идентификатор объекта, для которого необходим комментарий
    // Комментарий   - Строка: Текст комментария
    метод СоздатьКомментарий(Токен: Объект?, Идентификатор: Объект?, Комментарий: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-o", Идентификатор)
        Опции.Вставить("-x", Комментарий)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьКомментарий", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьКомментарий
    // Получает комментарий по ID
    //
    // Токен         - Строка: Токен
    // ИДОбъекта     - Строка: Идентификатор файла или каталога размещения комментария
    // ИДКомментария - Строка: Идентификатор комментария
    метод ПолучитьКомментарий(Токен: Объект?, ИДОбъекта: Объект?, ИДКомментария: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-o", ИДОбъекта)
        Опции.Вставить("-c", ИДКомментария)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьКомментарий", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокКомментариев
    // Получает список всех комментариев объекта
    //
    // Токен     - Строка: Токен
    // ИДОбъекта - Строка: Идентификатор объекта
    метод ПолучитьСписокКомментариев(Токен: Объект?, ИДОбъекта: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-o", ИДОбъекта)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокКомментариев", Опции)
        
    ;

    @Глобально
    // Метод УдалитьКомментарий
    // Удаляет комментарий по ID
    //
    // Токен         - Строка: Токен
    // ИДОбъекта     - Строка: Идентификатор файла или каталога размещения комментария
    // ИДКомментария - Строка: Идентификатор комментария
    метод УдалитьКомментарий(Токен: Объект?, ИДОбъекта: Объект?, ИДКомментария: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-o", ИДОбъекта)
        Опции.Вставить("-c", ИДКомментария)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьКомментарий", Опции)
        
    ;
    
;