#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_YandexMetrika
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_YandexMetrika(Исполнитель)
    
;

@Локально
структура OPI_YandexMetrika
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "metrika"
    
    @Глобально
    // Метод СоздатьМетку
    // Создает метку с указанным именем
    //
    // Токен        - Строка: Токен авторизации
    // Наименование - Строка: Наименование метки
    метод СоздатьМетку(Токен: Объект?, Наименование: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-l", Наименование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьМетку", Опции)
        
    ;

    @Глобально
    // Метод ИзменитьМетку
    // Изменяет имя метки по ID
    //
    // Токен        - Строка: Токен авторизации
    // IDМетки      - Строка: ID метки для изменения
    // Наименование - Строка: Новое наименование
    метод ИзменитьМетку(Токен: Объект?, IDМетки: Объект?, Наименование: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-l", IDМетки)
        Опции.Вставить("-i", Наименование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьМетку", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьМетку
    // Получает метку по ID
    //
    // Токен   - Строка: Токен авторизации
    // IDМетки - Строка: ID метки
    метод ПолучитьМетку(Токен: Объект?, IDМетки: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-l", IDМетки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьМетку", Опции)
        
    ;

    @Глобально
    // Метод УдалитьМетку
    // Удаляет метку по ID
    //
    // Токен   - Строка: Токен авторизации
    // IDМетки - Строка: ID метки для удаления
    метод УдалитьМетку(Токен: Объект?, IDМетки: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-l", IDМетки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьМетку", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокМеток
    // Получает список меток пользователя
    //
    // Токен - Строка: Токен авторизации
    метод ПолучитьСписокМеток(Токен: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокМеток", Опции)
        
    ;

    @Глобально
    // Метод СоздатьСчетчик
    // Создает счетчик по описанию полей
    //
    // Токен             - Строка: Токен авторизации
    // СтруктураСчетчика - Структура Из КлючИЗначение: Структура счетчика. См. ПолучитьСтруктуруСчетчика
    метод СоздатьСчетчик(Токен: Объект?, СтруктураСчетчика: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", СтруктураСчетчика)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьСчетчик", Опции)
        
    ;

    @Глобально
    // Метод ИзменитьСчетчик
    // Изменяет значения полей счетчика по ID
    //
    // Токен             - Строка: Токен авторизации
    // IDСчетчика        - Строка, Число: ID счетчика для изменения
    // СтруктураСчетчика - Структура Из КлючИЗначение: Структура изменяемых полей. См. ПолучитьСтруктуруСчетчика
    метод ИзменитьСчетчик(Токен: Объект?, IDСчетчика: Объект?, СтруктураСчетчика: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDСчетчика)
        Опции.Вставить("-f", СтруктураСчетчика)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьСчетчик", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСчетчик
    // Получает информацию о счетчике по ID
    //
    // Токен      - Строка: Токен авторизации
    // IDСчетчика - Строка, Число: ID счетчика
    метод ПолучитьСчетчик(Токен: Объект?, IDСчетчика: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDСчетчика)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСчетчик", Опции)
        
    ;

    @Глобально
    // Метод УдалитьСчетчик
    // Удаляет счетчик по ID
    //
    // Токен      - Строка: Токен авторизации
    // IDСчетчика - Число, Строка: ID счетчика для удаления
    метод УдалитьСчетчик(Токен: Объект?, IDСчетчика: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDСчетчика)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьСчетчик", Опции)
        
    ;

    @Глобально
    // Метод ВосстановитьСчетчик
    // Восстанавливает ранее удаленный счетчик по ID
    //
    // Токен      - Строка: Токен авторизации
    // IDСчетчика - Строка, Число: ID счетчика для восстановления
    метод ВосстановитьСчетчик(Токен: Объект?, IDСчетчика: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDСчетчика)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВосстановитьСчетчик", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокСчетчиков
    // Получает список доступных счетчиков с фильтром или без
    //
    // Токен  - Строка: Токен авторизации
    // Фильтр - Структура Из КлючИЗначение: Фильтр списка. См. ПолучитьСтруктуруФильтраСчетчиков (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокСчетчиков(Токен: Объект?, Фильтр: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", Фильтр)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокСчетчиков", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтруктуруСчетчика
    // Получает структуру стандартных полей для создания счетчика
    //
    // Пустая - Булево: Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей (необяз. по ум. - false)
    метод ПолучитьСтруктуруСчетчика(Пустая: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруСчетчика", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтруктуруФильтраСчетчиков
    // Получает структуру полей фильтра для получения списка счетчиков
    //
    // Пустая - Булево: Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей (необяз. по ум. - false)
    метод ПолучитьСтруктуруФильтраСчетчиков(Пустая: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруФильтраСчетчиков", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокОпераций
    // Получает список операций выбранного счетчика
    //
    // Токен      - Строка: Токен авторизации
    // IDСчетчика - Строка, Число: ID счетчика
    метод ПолучитьСписокОпераций(Токен: Объект?, IDСчетчика: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDСчетчика)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокОпераций", Опции)
        
    ;
    
;