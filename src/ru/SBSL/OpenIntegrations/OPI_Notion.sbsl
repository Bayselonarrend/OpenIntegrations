#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Executor.НастройкиИнтеграции? = Неопределено): OPI_Notion
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(Конфигурация)
    возврат новый OPI_Notion(Исполнитель)
    
;

@Локально
структура OPI_Notion
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "notion"
    
    @Глобально
    метод СоздатьСтраницу(Токен: Объект?, Родитель: Объект?, Заголовок: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Родитель)
        Опции.Вставить("-l", Заголовок)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьСтраницу", Опции)
        
    ;

    @Глобально
    метод СоздатьСтраницуВБазу(Токен: Объект?, Родитель: Объект?, Данные: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", Родитель)
        Опции.Вставить("-d", Данные)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьСтраницуВБазу", Опции)
        
    ;

    @Глобально
    метод ПолучитьСтраницу(Токен: Объект?, Страница: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Страница)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтраницу", Опции)
        
    ;

    @Глобально
    метод ИзменитьСвойстваСтраницы(Токен: Объект?, Страница: Объект?, Данные: Объект? = Неопределено, Иконка: Объект? = Неопределено, Обложка: Объект? = Неопределено, Архивирована: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Страница)
        Опции.Вставить("-d", Данные)
        Опции.Вставить("-i", Иконка)
        Опции.Вставить("-c", Обложка)
        Опции.Вставить("-a", Архивирована)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьСвойстваСтраницы", Опции)
        
    ;

    @Глобально
    метод СоздатьБазуДанных(Токен: Объект?, Родитель: Объект?, Заголовок: Объект?, Свойства: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Родитель)
        Опции.Вставить("-l", Заголовок)
        Опции.Вставить("-r", Свойства)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьБазуДанных", Опции)
        
    ;

    @Глобально
    метод ПолучитьБазуДанных(Токен: Объект?, База: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", База)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьБазуДанных", Опции)
        
    ;

    @Глобально
    метод ИзменитьСвойстваБазы(Токен: Объект?, База: Объект?, Свойства: Объект? = Неопределено, Заголовок: Объект? = Неопределено, Описание: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", База)
        Опции.Вставить("-p", Свойства)
        Опции.Вставить("-l", Заголовок)
        Опции.Вставить("-d", Описание)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьСвойстваБазы", Опции)
        
    ;

    @Глобально
    метод СоздатьБлок(Токен: Объект?, Родитель: Объект?, Блок: Объект?, ВставитьПосле: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Родитель)
        Опции.Вставить("-b", Блок)
        Опции.Вставить("-r", ВставитьПосле)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьБлок", Опции)
        
    ;

    @Глобально
    метод ВернутьБлок(Токен: Объект?, ИДБлока: Объект?, ТолькоОснова: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", ИДБлока)
        Опции.Вставить("-c", ТолькоОснова)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВернутьБлок", Опции)
        
    ;

    @Глобально
    метод ВернутьДочерниеБлоки(Токен: Объект?, ИДБлока: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", ИДБлока)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВернутьДочерниеБлоки", Опции)
        
    ;

    @Глобально
    метод УдалитьБлок(Токен: Объект?, ИДБлока: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", ИДБлока)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьБлок", Опции)
        
    ;

    @Глобально
    метод СписокПользователей(Токен: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СписокПользователей", Опции)
        
    ;

    @Глобально
    метод ПолучитьДанныеПользователя(Токен: Объект?, ИДПользователя: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-u", ИДПользователя)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьДанныеПользователя", Опции)
        
    ;
    
;