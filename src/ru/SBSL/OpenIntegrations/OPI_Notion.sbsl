#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_Notion
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_Notion(Исполнитель)
    
;

@Локально
структура OPI_Notion
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "notion"
    
    @Глобально
    // Метод СоздатьСтраницу
    // Создает дочернюю страницу над другой страницей-родителем
    //
    // Токен     - Строка: Токен
    // Родитель  - Строка: ID Родителя
    // Заголовок - Строка: Заголовок страницы
    метод СоздатьСтраницу(Токен: Объект?, Родитель: Объект?, Заголовок: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Родитель)
        Опции.Вставить("-l", Заголовок)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьСтраницу", Опции)
        
    ;

    @Глобально
    // Метод СоздатьСтраницуВБазу
    // Создает страницу в базе-родителе
    //
    // Токен    - Строка: Токен
    // Родитель - Строка: ID родительской базы
    // Данные   - Соответствие Из КлючИЗначение: Соответствие свойств
    метод СоздатьСтраницуВБазу(Токен: Объект?, Родитель: Объект?, Данные: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", Родитель)
        Опции.Вставить("-d", Данные)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьСтраницуВБазу", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтраницу
    // Получает информацию о странице по ID
    //
    // Токен    - Строка: Токен
    // Страница - Строка: ID страницы
    метод ПолучитьСтраницу(Токен: Объект?, Страница: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Страница)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтраницу", Опции)
        
    ;

    @Глобально
    // Метод ИзменитьСвойстваСтраницы
    // Изменяет свойства существующей страницы
    //
    // Токен        - Строка: Токен
    // Страница     - Строка: ID изменяемой страницы
    // Данные       - Соответствие Из КлючИЗначение: Соответствие изменяемых параметров (необяз. по ум. - Пустое значение)
    // Иконка       - Строка: URL картинки иконки страницы (необяз. по ум. - Пустое значение)
    // Обложка      - Строка: URL картинки обложки страницы (необяз. по ум. - Пустое значение)
    // Архивирована - Булево: Архивировать страницу или нет (булево) (необяз. по ум. - false)
    метод ИзменитьСвойстваСтраницы(Токен: Объект?, Страница: Объект?, Данные: Объект? = Неопределено, Иконка: Объект? = Неопределено, Обложка: Объект? = Неопределено, Архивирована: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Страница)
        Опции.Вставить("-d", Данные)
        Опции.Вставить("-i", Иконка)
        Опции.Вставить("-c", Обложка)
        Опции.Вставить("-a", Архивирована)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьСвойстваСтраницы", Опции)
        
    ;

    @Глобально
    // Метод СоздатьБазуДанных
    // Создает базу данных
    //
    // Токен     - Строка: Токен
    // Родитель  - Строка: ID страницы родителя
    // Заголовок - Строка: Заголовок базы данных
    // Свойства  - Структура Из Строка: Свойства базы данных (необяз. по ум. - Пустое значение)
    метод СоздатьБазуДанных(Токен: Объект?, Родитель: Объект?, Заголовок: Объект?, Свойства: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Родитель)
        Опции.Вставить("-l", Заголовок)
        Опции.Вставить("-r", Свойства)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьБазуДанных", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьБазуДанных
    // Получить данные о базе данных
    //
    // Токен - Строка: Токен
    // База  - Строка: ID базы данных
    метод ПолучитьБазуДанных(Токен: Объект?, База: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", База)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьБазуДанных", Опции)
        
    ;

    @Глобально
    // Метод ИзменитьСвойстваБазы
    // Изменяет свойства существующей базы
    //
    // Токен     - Строка: Токен
    // База      - Строка: ID целевой базы
    // Свойства  - Соответствие из КлючИЗначение: Новые или изменяемые свойства базы данных (необяз. по ум. - Пустое значение)
    // Заголовок - Строка: Новый заголовок базы (необяз. по ум. - Пустое значение)
    // Описание  - Строка: Новое описание базы (необяз. по ум. - Пустое значение)
    метод ИзменитьСвойстваБазы(Токен: Объект?, База: Объект?, Свойства: Объект? = Неопределено, Заголовок: Объект? = Неопределено, Описание: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", База)
        Опции.Вставить("-p", Свойства)
        Опции.Вставить("-l", Заголовок)
        Опции.Вставить("-d", Описание)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьСвойстваБазы", Опции)
        
    ;

    @Глобально
    // Метод СоздатьБлок
    // Создает новый блок на основе существующего блока
    //
    // Токен         - Строка: Токен
    // Родитель      - Строка: ID родительского блока или страницы
    // Блок          - Строка, Соответствие Из КлючИЗначение: ID блока или сам блок образец
    // ВставитьПосле - Строка: ID блока, после которого необходимо вставить новый (необяз. по ум. - Пустое значение)
    метод СоздатьБлок(Токен: Объект?, Родитель: Объект?, Блок: Объект?, ВставитьПосле: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Родитель)
        Опции.Вставить("-b", Блок)
        Опции.Вставить("-r", ВставитьПосле)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьБлок", Опции)
        
    ;

    @Глобально
    // Метод ВернутьБлок
    // Возвращает структуру блока по ID
    //
    // Токен        - Строка: Токен
    // ИДБлока      - Строка: ID блока
    // ТолькоОснова - Булево: Истина > служебные поля удаляются, остается только сам блок (необяз. по ум. - true)
    метод ВернутьБлок(Токен: Объект?, ИДБлока: Объект?, ТолькоОснова: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", ИДБлока)
        Опции.Вставить("-c", ТолькоОснова)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВернутьБлок", Опции)
        
    ;

    @Глобально
    // Метод ВернутьДочерниеБлоки
    // Возвращает список дочерних блоков блока-родителя
    //
    // Токен   - Строка: Токен
    // ИДБлока - Строка: ID блока родителя
    метод ВернутьДочерниеБлоки(Токен: Объект?, ИДБлока: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", ИДБлока)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВернутьДочерниеБлоки", Опции)
        
    ;

    @Глобально
    // Метод УдалитьБлок
    // Удаляет блок по ID
    //
    // Токен   - Строка: Токен
    // ИДБлока - Строка: ID блока
    метод УдалитьБлок(Токен: Объект?, ИДБлока: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", ИДБлока)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьБлок", Опции)
        
    ;

    @Глобально
    // Метод СписокПользователей
    // Возвращает список пользователей рабочего пространства
    //
    // Токен - Строка: Токен
    метод СписокПользователей(Токен: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СписокПользователей", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьДанныеПользователя
    // Получает данные пользователя по ID
    //
    // Токен          - Строка: Токен
    // ИДПользователя - Строка: ID целевого пользователя
    метод ПолучитьДанныеПользователя(Токен: Объект?, ИДПользователя: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-u", ИДПользователя)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьДанныеПользователя", Опции)
        
    ;
    
;