#требуется ./internal/OPI.sbsl

@Глобально
метод Инициализировать(Конфигурация: OPI.НастройкиИнтеграцииStdio | OPI.НастройкиИнтеграцииHttp? = Неопределено): OPI_Tar
    
    пер Исполнитель = OPI.АбстрактныйИсполнитель.Инициализировать(Конфигурация)
    возврат новый OPI_Tar(Исполнитель)
    
;

@Глобально
метод ЧерезStdio(ПутьOint: Строка): OPI_Tar

    пер Исполнитель = OPI.АбстрактныйИсполнитель.ЧерезStdio(ПутьOint)
    возврат новый OPI_Tar(Исполнитель)
    
;

@Глобально
метод ЧерезHttp(HttpКлиент: КлиентHttp): OPI_Tar

    пер Исполнитель = OPI.АбстрактныйИсполнитель.ЧерезHttp(HttpКлиент)
    возврат новый OPI_Tar(Исполнитель)

;

@Локально
структура OPI_Tar
    
    обз знч Исполнитель: OPI.АбстрактныйИсполнитель
    
    знч КомандаCLI: Строка = "tar"
    
    @Глобально
    метод АрхивироватьКаталог(Каталог: Объект?, ПутьАрхива: Объект? = Неопределено, Настройки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Каталог)
        Опции.Вставить("-d", ПутьАрхива)
        Опции.Вставить("-t", Настройки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "АрхивироватьКаталог", Опции)
        
    ;

    @Глобально
    метод РазархивироватьКаталог(Архив: Объект?, КаталогНазначения: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Архив)
        Опции.Вставить("-d", КаталогНазначения)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "РазархивироватьКаталог", Опции)
        
    ;

    @Глобально
    метод РазархивироватьФайлы(Архив: Объект?, Пути: Объект?, КаталогНазначения: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Архив)
        Опции.Вставить("-p", Пути)
        Опции.Вставить("-d", КаталогНазначения)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "РазархивироватьФайлы", Опции)
        
    ;

    @Глобально
    метод ИзменитьАрхив(Архив: Объект?, ДобавляемыеФайлы: Объект? = Неопределено, УдаляемыеПути: Объект? = Неопределено, Настройки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Архив)
        Опции.Вставить("-a", ДобавляемыеФайлы)
        Опции.Вставить("-d", УдаляемыеПути)
        Опции.Вставить("-t", Настройки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьАрхив", Опции)
        
    ;

    @Глобально
    метод ПолучитьСтруктуруНастроекАрхивации(Пустая: Объект? = Неопределено, КакСоответствие: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        Опции.Вставить("-m", КакСоответствие)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруНастроекАрхивации", Опции)
        
    ;

    @Глобально
    метод ПолучитьСтруктуруОписанияАрхива(Пустая: Объект? = Неопределено, КакСоответствие: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        Опции.Вставить("-m", КакСоответствие)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруОписанияАрхива", Опции)
        
    ;

    @Глобально
    метод ПолучитьСписокФайлов(Архив: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Архив)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокФайлов", Опции)
        
    ;

    @Глобально
    метод ПолучитьМетаданные(Архив: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Архив)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьМетаданные", Опции)
        
    ;
    
;