        Опции.Вставить("-u", UUID)
        Опции.Вставить("-s", ТестовыйAPI)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьЗаказ", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьЗаказПоНомеру
    // Получает заказ по номеру СДЭК или внутреннему номеру клиента
    //
    // Токен       - Строка: Токен авторизации
    // НомерЗаказа - Строка: Номер заказа
    // Внутренний  - Булево: Вид номера заказа. Истина > номер в базе клиента, Ложь > номер СДЭК (необяз. по ум. - false)
    // ТестовыйAPI - Булево: Флаг использования API для тестовых запросов (необяз. по ум. - false)
    метод ПолучитьЗаказПоНомеру(Токен: Объект?, НомерЗаказа: Объект?, Внутренний: Объект? = Неопределено, ТестовыйAPI: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-n", НомерЗаказа)
        Опции.Вставить("-i", Внутренний)
        Опции.Вставить("-s", ТестовыйAPI)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьЗаказПоНомеру", Опции)
        
    ;

    @Глобально
    // Метод ОформитьКлиентскийВозврат
    // Оформляет клиентский возврат для заказа интернет магазина
    //
    // Токен       - Строка: Токен авторизации
