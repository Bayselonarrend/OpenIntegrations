    @Глобально
    // Метод СформироватьКвитанцию
    // Формирует квитанции в формате pdf к заказам
    //
    // Токен        - Строка: Токен авторизации
    // МассивUUID   - Строка, Массив Из Строка: Один или массив UUID заказов
    // Тип          - Строка: Тип (язык) квитанции (необяз. по ум. - tpl_russia)
    // КопийНаЛисте - Число: Число копий одной квитанции на листе (необяз. по ум. - 2)
    // ТестовыйAPI  - Булево: Флаг использования API для тестовых запросов (необяз. по ум. - false)
    метод СформироватьКвитанцию(Токен: Объект?, МассивUUID: Объект?, Тип: Объект? = Неопределено, КопийНаЛисте: Объект? = Неопределено, ТестовыйAPI: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-u", МассивUUID)
        Опции.Вставить("-p", Тип)
        Опции.Вставить("-c", КопийНаЛисте)
        Опции.Вставить("-s", ТестовыйAPI)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СформироватьКвитанцию", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьКвитанцию
    // Получает квитанцию к заказу
    //
    // Токен        - Строка: Токен авторизации
    // UUID         - Строка: UUID квитанции, полученный при ее формировании
    // ПолучитьФайл - Булево: Истина > будут получены сразу данные PDF файла, Ложь > ответ сервера CDEK (необяз. по ум. - false)
    // ТестовыйAPI  - Булево: Флаг использования API для тестовых запросов (необяз. по ум. - false)
    метод ПолучитьКвитанцию(Токен: Объект?, UUID: Объект?, ПолучитьФайл: Объект? = Неопределено, ТестовыйAPI: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-u", UUID)
        Опции.Вставить("-g", ПолучитьФайл)
        Опции.Вставить("-s", ТестовыйAPI)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьКвитанцию", Опции)
        
    ;

    @Глобально
    // Метод СформироватьШтрихкод
    // Формирует штрихкод места в формате PDF для заказов
    //
    // Токен       - Строка: Токен авторизации
    // МассивUUID  - Строка, Массив Из Строка: Один или массив UUID заказов
    // Копий       - Число: Число копий (необяз. по ум. - 1)
    // Формат      - Строка: Формат печати: A4, A5, A6, A7 (необяз. по ум. - A4)
    // Язык        - Строка: Язык штрихкода: RUS, ENG (необяз. по ум. - RUS)
    // ТестовыйAPI - Булево: Флаг использования API для тестовых запросов (необяз. по ум. - false)
    метод СформироватьШтрихкод(Токен: Объект?, МассивUUID: Объект?, Копий: Объект? = Неопределено, Формат: Объект? = Неопределено, Язык: Объект? = Неопределено, ТестовыйAPI: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-u", МассивUUID)
        Опции.Вставить("-c", Копий)
        Опции.Вставить("-f", Формат)
        Опции.Вставить("-l", Язык)
        Опции.Вставить("-s", ТестовыйAPI)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СформироватьШтрихкод", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьШтрихкод
    // Получает штрихкод места к заказу
    //
    // Токен        - Строка: Токен авторизации
    // UUID         - Строка: UUID штрихкода, полученный при его формировании
    // ПолучитьФайл - Булево: Истина > будут получены сразу данные PDF файла, Ложь > ответ сервера CDEK (необяз. по ум. - false)
    // ТестовыйAPI  - Булево: Флаг использования API для тестовых запросов (необяз. по ум. - false)
    метод ПолучитьШтрихкод(Токен: Объект?, UUID: Объект?, ПолучитьФайл: Объект? = Неопределено, ТестовыйAPI: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-u", UUID)
        Опции.Вставить("-g", ПолучитьФайл)
        Опции.Вставить("-s", ТестовыйAPI)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьШтрихкод", Опции)
        
    ;

    @Глобально
    // Метод СоздатьПреалерт
    // Создает преалерт для списка заказов
    //
    // Токен        - Строка: Токен авторизации
    // МассивUUID   - Строка, Массив Из Строка: Один или массив UUID заказов
    // ДатаПередачи - Дата: Планируемая дата передачи заказов в СДЭК
    // ПВЗ          - Строка: Код ПВЗ, в который планируется передать заказы
    // ТестовыйAPI  - Булево: Флаг использования API для тестовых запросов (необяз. по ум. - false)
    метод СоздатьПреалерт(Токен: Объект?, МассивUUID: Объект?, ДатаПередачи: Объект?, ПВЗ: Объект?, ТестовыйAPI: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-u", МассивUUID)
        Опции.Вставить("-d", ДатаПередачи)
        Опции.Вставить("-p", ПВЗ)
        Опции.Вставить("-s", ТестовыйAPI)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьПреалерт", Опции)
        
    ;

