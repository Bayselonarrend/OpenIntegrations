        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-u", UUID)
        Опции.Вставить("-r", Тариф)
        Опции.Вставить("-s", ТестовыйAPI)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОформитьКлиентскийВозврат", Опции)
        
    ;

    @Глобально
    // Метод СоздатьОтказ
