    // ТестовыйAPI - Булево: Флаг использования API для тестовых запросов (необяз. по ум. - false)
    метод УдалитьЗаказ(Токен: Объект?, UUID: Объект?, ТестовыйAPI: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-u", UUID)
        Опции.Вставить("-s", ТестовыйAPI)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьЗаказ", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьЗаказ
    // Получает заказ по UUID
    //
    // Токен       - Строка: Токен авторизации
    // UUID        - Строка: UUID заказа
    // ТестовыйAPI - Булево: Флаг использования API для тестовых запросов (необяз. по ум. - false)
    метод ПолучитьЗаказ(Токен: Объект?, UUID: Объект?, ТестовыйAPI: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
