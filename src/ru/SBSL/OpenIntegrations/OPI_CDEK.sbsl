#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_CDEK
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_CDEK(Исполнитель)
    
;

@Локально
структура OPI_CDEK
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "cdek"
    
    @Глобально
    // Метод ПолучитьТокен
    // Получает токен на основе идентификатора аккаунта и пароля
    //
    // Аккаунт     - Строка: Идентификатор клиента (Account)
    // Пароль      - Строка: Секретный ключ (Password)
    // ТестовыйAPI - Булево: Флаг использования API для тестовых запросов (необяз. по ум. - false)
    метод ПолучитьТокен(Аккаунт: Объект?, Пароль: Объект?, ТестовыйAPI: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Аккаунт)
        Опции.Вставить("-p", Пароль)
        Опции.Вставить("-t", ТестовыйAPI)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьТокен", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьЧекиНаДату
    // Получает информацию о чеках за указанную дату
    //
    // Токен         - Строка: Токен авторизации
    // ДатаПолучения - Дата: Дата, за которую необходимо получить данные
    // ТестовыйAPI   - Булево: Флаг использования API для тестовых запросов (необяз. по ум. - false)
    метод ПолучитьЧекиНаДату(Токен: Объект?, ДатаПолучения: Объект?, ТестовыйAPI: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-d", ДатаПолучения)
        Опции.Вставить("-s", ТестовыйAPI)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьЧекиНаДату", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьРеестрыПлатежейНаДату
    // Получает реестры наложенных платежей, по которым клиенту был переведен платеж
    //
    // Токен         - Строка: Токен авторизации
    // ДатаПолучения - Дата: Дата, за которую необходимо получить данные
    // ТестовыйAPI   - Булево: Флаг использования API для тестовых запросов (необяз. по ум. - false)
    метод ПолучитьРеестрыПлатежейНаДату(Токен: Объект?, ДатаПолучения: Объект?, ТестовыйAPI: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-d", ДатаПолучения)
        Опции.Вставить("-s", ТестовыйAPI)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьРеестрыПлатежейНаДату", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьПереводыПлатежейНаДату
    // Получает информацию о заказах, по которым был переведен наложенный платеж интернет магазину
    //
    // Токен         - Строка: Токен авторизации
    // ДатаПолучения - Дата: Дата, за которую необходимо получить данные
    // ТестовыйAPI   - Булево: Флаг использования API для тестовых запросов (необяз. по ум. - false)
    метод ПолучитьПереводыПлатежейНаДату(Токен: Объект?, ДатаПолучения: Объект?, ТестовыйAPI: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-d", ДатаПолучения)
        Опции.Вставить("-s", ТестовыйAPI)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПереводыПлатежейНаДату", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокОфисов
    // Получает список офисов с фильтром или без
    //
    // Токен       - Строка: Токен авторизации
    // Фильтр      - Структура Из КлючИЗначение: Фильтр офисов. См. ПолучитьОписаниеФильтраОфисов (необяз. по ум. - Пустое значение)
    // ТестовыйAPI - Булево: Флаг использования API для тестовых запросов (необяз. по ум. - false)
    метод ПолучитьСписокОфисов(Токен: Объект?, Фильтр: Объект? = Неопределено, ТестовыйAPI: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", Фильтр)
        Опции.Вставить("-s", ТестовыйAPI)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокОфисов", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокРегионов
    // Получает список доступных регионов
    //
    // Токен       - Строка: Токен авторизации
    // Страны      - Массив Из Строка: Массив кодов стран в формате ISO_31661_alpha2 для отбора (необяз. по ум. - Пустое значение)
    // Страница    - Число: Страница выборки результата (необяз. по ум. - Пустое значение)
    // Язык        - Строка: Язык: rus, eng, zho (необяз. по ум. - rus)
    // ТестовыйAPI - Булево: Флаг использования API для тестовых запросов (необяз. по ум. - false)
    метод ПолучитьСписокРегионов(Токен: Объект?, Страны: Объект? = Неопределено, Страница: Объект? = Неопределено, Язык: Объект? = Неопределено, ТестовыйAPI: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Страны)
        Опции.Вставить("-p", Страница)
        Опции.Вставить("-l", Язык)
        Опции.Вставить("-s", ТестовыйAPI)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокРегионов", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьОписаниеФильтраОфисов
    // Получает пустой макет фильтра получения списка офисов в функции ПолучитьСписокОфисов
    //
    // Пустая - Булево: Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей (необяз. по ум. - false)
    метод ПолучитьОписаниеФильтраОфисов(Пустая: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьОписаниеФильтраОфисов", Опции)
        
    ;

    @Глобально
    // Метод СоздатьЗаказ
    // Создает заказ по описанию полей
    //
    // Токен           - Строка: Токен авторизации
    // ОписаниеЗаказа  - Структура Из КлючИЗначение: Набор полей заказа. См. ПолучитьОписаниеЗаказа
    // ИнтернетМагазин - Булево: Признак типа заказа Интернет магазин (необяз. по ум. - false)
    // ТестовыйAPI     - Булево: Флаг использования API для тестовых запросов (необяз. по ум. - false)
    метод СоздатьЗаказ(Токен: Объект?, ОписаниеЗаказа: Объект?, ИнтернетМагазин: Объект? = Неопределено, ТестовыйAPI: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-o", ОписаниеЗаказа)
        Опции.Вставить("-s", ИнтернетМагазин)
        Опции.Вставить("-p", ТестовыйAPI)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьЗаказ", Опции)
        
    ;

    @Глобально
    // Метод ИзменитьЗаказ
    // Изменяет значения полей выбранного заказа
    //
    // Токен          - Строка: Токен авторизации
    // UUID           - Строка: UUID заказа для изменение
    // ОписаниеЗаказа - Структура Из КлючИЗначение: Набор изменяемых полей заказа
    // ТестовыйAPI    - Булево: Флаг использования API для тестовых запросов (необяз. по ум. - false)
    метод ИзменитьЗаказ(Токен: Объект?, UUID: Объект?, ОписаниеЗаказа: Объект?, ТестовыйAPI: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-u", UUID)
        Опции.Вставить("-o", ОписаниеЗаказа)
        Опции.Вставить("-s", ТестовыйAPI)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьЗаказ", Опции)
        
    ;

    @Глобально
    // Метод УдалитьЗаказ
    // Удаляет заказ по UUID
    //
    // Токен       - Строка: Токен авторизации
