#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_GoogleCalendar
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_GoogleCalendar(Исполнитель)
    
;

@Локально
структура OPI_GoogleCalendar
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "gcalendar"
    
    @Глобально
    // Метод СформироватьСсылкуПолученияКода
    // Возвращает URL для авторизации в браузере
    //
    // ClientID - Строка: Client ID
    // Calendar - Булево: разрешение на методы Calendar (необяз. по ум. - true)
    // Drive    - Булево: разрешение на методы Drive (необяз. по ум. - true)
    // Sheets   - Булево: разрешение на методы Sheets (необяз. по ум. - true)
    метод СформироватьСсылкуПолученияКода(ClientID: Объект?, Calendar: Объект? = Неопределено, Drive: Объект? = Неопределено, Sheets: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-i", ClientID)
        Опции.Вставить("-c", Calendar)
        Опции.Вставить("-d", Drive)
        Опции.Вставить("-s", Sheets)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СформироватьСсылкуПолученияКода", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьТокенПоКоду
    // Получает токен по коду из авторизации в браузере
    //
    // ClientID     - Строка: Client ID
    // ClientSecret - Строка: Client secret
    // Code         - Строка: Code из браузера
    метод ПолучитьТокенПоКоду(ClientID: Объект?, ClientSecret: Объект?, Code: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-i", ClientID)
        Опции.Вставить("-s", ClientSecret)
        Опции.Вставить("-c", Code)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьТокенПоКоду", Опции)
        
    ;

    @Глобально
    // Метод ОбновитьТокен
    // Обновляет токен по Refresh token
    //
    // ClientID     - Строка: Client ID
    // ClientSecret - Строка: Client secret
    // RefreshToken - Строка: Refresh token
    метод ОбновитьТокен(ClientID: Объект?, ClientSecret: Объект?, RefreshToken: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-i", ClientID)
        Опции.Вставить("-s", ClientSecret)
        Опции.Вставить("-r", RefreshToken)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОбновитьТокен", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьТокенServiceАккаунта
    // Получает токен авторизации по данным service аккаунта
    //
    // Данные          - Произвольный: JSON данные авторизации как файл, коллекция или двоичные данные
    // ОбластиДействия - Массив Из Строка: Область действия (scope) или массив областей
    // ВремяЖизни      - Число: Время жизни токена в секундах (необяз. по ум. - 3600)
    метод ПолучитьТокенServiceАккаунта(Данные: Объект?, ОбластиДействия: Объект?, ВремяЖизни: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Данные)
        Опции.Вставить("-s", ОбластиДействия)
        Опции.Вставить("-e", ВремяЖизни)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьТокенServiceАккаунта", Опции)
        
    ;

    @Глобально
    // Метод СоздатьКалендарь
    // Создает пустой календарь
    //
    // Токен        - Строка: Токен
    // Наименование - Строка: Наименование создаваемого календаря
    метод СоздатьКалендарь(Токен: Объект?, Наименование: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-l", Наименование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьКалендарь", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьМетаданныеКалендаря
    // Получает информацию о календаре по ID
    //
    // Токен     - Строка: Токен
    // Календарь - Строка: ID календаря
    метод ПолучитьМетаданныеКалендаря(Токен: Объект?, Календарь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Календарь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьМетаданныеКалендаря", Опции)
        
    ;

    @Глобально
    // Метод ИзменитьМетаданныеКалендаря
    // Изменяет свойства существующего календаря
    //
    // Токен        - Строка: Токен
    // Календарь    - Строка: ID календаря
    // Наименование - Строка: Новое наименование (необяз. по ум. - Пустое значение)
    // Описание     - Строка: Новое описание календаря (необяз. по ум. - Пустое значение)
    метод ИзменитьМетаданныеКалендаря(Токен: Объект?, Календарь: Объект?, Наименование: Объект? = Неопределено, Описание: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Календарь)
        Опции.Вставить("-l", Наименование)
        Опции.Вставить("-d", Описание)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьМетаданныеКалендаря", Опции)
        
    ;

    @Глобально
    // Метод ОчиститьОсновнойКалендарь
    // Очищает список событий основного календаря
    //
    // Токен - Строка: Токен
    метод ОчиститьОсновнойКалендарь(Токен: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОчиститьОсновнойКалендарь", Опции)
        
    ;

    @Глобально
    // Метод УдалитьКалендарь
    // Удаляет календарь по ID
    //
    // Токен     - Строка: Токен
    // Календарь - Строка: ID календаря
    метод УдалитьКалендарь(Токен: Объект?, Календарь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Календарь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьКалендарь", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокКалендарей
    // Получает массив календарей аккаунта
    //
    // Токен - Строка: Токен
    метод ПолучитьСписокКалендарей(Токен: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокКалендарей", Опции)
        
    ;

    @Глобально
    // Метод ДобавитьКалендарьВСписок
    // Добавляет существующий календарь в список пользователя
    //
    // Токен     - Строка: Токен
    // Календарь - Строка: ID календаря
    метод ДобавитьКалендарьВСписок(Токен: Объект?, Календарь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Календарь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ДобавитьКалендарьВСписок", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьКалендарьСписка
    // Получает календарь из списка пользователя по ID
    //
    // Токен     - Строка: Токен
    // Календарь - Строка: ID календаря
    метод ПолучитьКалендарьСписка(Токен: Объект?, Календарь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Календарь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьКалендарьСписка", Опции)
        
    ;

    @Глобально
    // Метод УдалитьКалендарьИзСписка
    // Удаляет календарь из списка пользователя
    //
    // Токен     - Строка: Токен
    // Календарь - Строка: ID календаря
    метод УдалитьКалендарьИзСписка(Токен: Объект?, Календарь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Календарь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьКалендарьИзСписка", Опции)
        
    ;

    @Глобально
    // Метод ИзменитьКалендарьСписка
    // Изменяет свойства календаря из списка пользователей
    //
    // Токен              - Строка: Токен
    // Календарь          - Строка: ID календаря
    // ОсновнойЦвет       - Строка: HEX основного цвета (#ffffff)
    // ДополнительныйЦвет - Строка: HEX дополнительного цвета (#ffffff)
    // Скрытый            - Булево: Скрытый календарь (необяз. по ум. - false)
    метод ИзменитьКалендарьСписка(Токен: Объект?, Календарь: Объект?, ОсновнойЦвет: Объект?, ДополнительныйЦвет: Объект?, Скрытый: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Календарь)
        Опции.Вставить("-p", ОсновнойЦвет)
        Опции.Вставить("-s", ДополнительныйЦвет)
        Опции.Вставить("-h", Скрытый)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьКалендарьСписка", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьОписаниеСобытия
    // Получает пустой макет для создания события
    //
    // Пустая - Булево: Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей (необяз. по ум. - false)
    метод ПолучитьОписаниеСобытия(Пустая: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьОписаниеСобытия", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокСобытий
    // Получает список всех событий календаря
    //
    // Токен     - Строка: Токен
    // Календарь - Строка: ID календаря
    метод ПолучитьСписокСобытий(Токен: Объект?, Календарь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Календарь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокСобытий", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСобытие
    // Получает событие по ID
    //
    // Токен     - Строка: Токен
    // Календарь - Строка: ID календаря
    // Событие   - Строка: ID события
    метод ПолучитьСобытие(Токен: Объект?, Календарь: Объект?, Событие: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Календарь)
        Опции.Вставить("-e", Событие)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСобытие", Опции)
        
    ;

    @Глобально
    // Метод СоздатьСобытие
    // Создает новое событие
    //
    // Токен           - Строка: Токен
    // Календарь       - Строка: ID календаря
    // ОписаниеСобытия - Соответствие Из КлючИЗначение: Описание события
    метод СоздатьСобытие(Токен: Объект?, Календарь: Объект?, ОписаниеСобытия: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Календарь)
        Опции.Вставить("-p", ОписаниеСобытия)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьСобытие", Опции)
        
    ;

    @Глобально
    // Метод ПереместитьСобытие
    // Перемещает событие в другой календарь
    //
    // Токен             - Строка: Токен
    // КалендарьИсточник - Строка: ID календаря источника
    // КалендарьПриемник - Строка: ID календаря приемника
    // Событие           - Строка: ID события календаря источника
    метод ПереместитьСобытие(Токен: Объект?, КалендарьИсточник: Объект?, КалендарьПриемник: Объект?, Событие: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", КалендарьИсточник)
        Опции.Вставить("-o", КалендарьПриемник)
        Опции.Вставить("-e", Событие)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПереместитьСобытие", Опции)
        
    ;

    @Глобально
    // Метод ИзменитьСобытие
    // Изменяет существующее событие
    //
    // Токен           - Строка: Токен
    // Календарь       - Строка: ID календаря
    // ОписаниеСобытия - Строка: Новое описание события
    // Событие         - Строка: ID события
    метод ИзменитьСобытие(Токен: Объект?, Календарь: Объект?, ОписаниеСобытия: Объект?, Событие: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Календарь)
        Опции.Вставить("-p", ОписаниеСобытия)
        Опции.Вставить("-e", Событие)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьСобытие", Опции)
        
    ;

    @Глобально
    // Метод УдалитьСобытие
    // Удаляет событие по ID
    //
    // Токен     - Строка: Токен
    // Календарь - Строка: ID календаря
    // Событие   - Строка: ID события
    метод УдалитьСобытие(Токен: Объект?, Календарь: Объект?, Событие: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Календарь)
        Опции.Вставить("-e", Событие)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьСобытие", Опции)
        
    ;
    
;