#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_Viber
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_Viber(Исполнитель)
    
;

@Локально
структура OPI_Viber
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "viber"
    
    @Глобально
    // Метод УстановитьWebhook
    // Устанавливает Webhook для приема сообщений
    //
    // Токен - Строка: Токен Viber
    // URL   - Строка: URL для установки Webhook
    метод УстановитьWebhook(Токен: Объект?, URL: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-u", URL)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УстановитьWebhook", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьИнформациюОКанале
    // Тут можно получить ID пользователей канала. ID для бота необходимо получать из прилетов на Webhook
    //
    // Токен - Строка: Токен
    метод ПолучитьИнформациюОКанале(Токен: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьИнформациюОКанале", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьДанныеПользователя
    // Получает информацию о пользователе по ID
    //
    // Токен          - Строка: Токен
    // IDПользователя - Строка, Число: ID пользователя Viber
    метод ПолучитьДанныеПользователя(Токен: Объект?, IDПользователя: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-u", IDПользователя)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьДанныеПользователя", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьОнлайнПользователей
    // Получает статус пользователя или нескольких пользователей по ID
    //
    // Токен           - Строка: Токен Viber
    // IDПользователей - Строка, Число, Массив из Строка, Число: ID пользователей(я) Viber
    метод ПолучитьОнлайнПользователей(Токен: Объект?, IDПользователей: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-u", IDПользователей)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьОнлайнПользователей", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьТекстовоеСообщение
    // Отправляет текстовое сообщение в чат или канал
    //
    // Токен          - Строка: Токен
    // Текст          - Строка: Текст сообщения
    // IDПользователя - Строка, Число: ID пользователя. Для канала > администратора, для бота > получателя
    // ОтправкаВКанал - Булево: Отправка в канал или в чат бота
    // Клавиатура     - Структура из Строка: См. СформироватьКлавиатуруИзМассиваКнопок (необяз. по ум. - Пустое значение)
    метод ОтправитьТекстовоеСообщение(Токен: Объект?, Текст: Объект?, IDПользователя: Объект?, ОтправкаВКанал: Объект?, Клавиатура: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-x", Текст)
        Опции.Вставить("-u", IDПользователя)
        Опции.Вставить("-i", ОтправкаВКанал)
        Опции.Вставить("-k", Клавиатура)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьТекстовоеСообщение", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьКартинку
    // Отправляет картинку в чат или канал
    //
    // Токен          - Строка: Токен
    // URL            - Строка: URL картинки
    // IDПользователя - Строка, Число: ID пользователя. Для канала > администратора, для бота > получателя
    // ОтправкаВКанал - булево: Отправка в канал или в чат бота
    // Описание       - Строка: Аннотация к картинке (необяз. по ум. - Пустое значение)
    метод ОтправитьКартинку(Токен: Объект?, URL: Объект?, IDПользователя: Объект?, ОтправкаВКанал: Объект?, Описание: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", URL)
        Опции.Вставить("-u", IDПользователя)
        Опции.Вставить("-i", ОтправкаВКанал)
        Опции.Вставить("-d", Описание)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьКартинку", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьФайл
    // Отправляет файл (документ) в чат или канал
    //
    // Токен          - Строка: Токен
    // URL            - Строка: URL файла
    // IDПользователя - Строка, Число: ID пользователя. Для канала > администратора, для бота > получателя
    // ОтправкаВКанал - Булево: Отправка в канал или в чат бота
    // Расширение     - Строка: Расширение файла
    // Размер         - Число: Размер файла. Если не заполнен > определяется автоматически скачиванием файла (необяз. по ум. - Пустое значение)
    метод ОтправитьФайл(Токен: Объект?, URL: Объект?, IDПользователя: Объект?, ОтправкаВКанал: Объект?, Расширение: Объект?, Размер: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", URL)
        Опции.Вставить("-u", IDПользователя)
        Опции.Вставить("-i", ОтправкаВКанал)
        Опции.Вставить("-e", Расширение)
        Опции.Вставить("-s", Размер)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьФайл", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьКонтакт
    // Отправляет контакт с номером телефона в чат или канал
    //
    // Токен          - Строка: Токен
    // ИмяКонтакта    - Строка: Имя контакта
    // НомерТелефона  - Строка: Номер телефона
    // IDПользователя - Строка, Число: ID пользователя. Для канала > администратора, для бота > получателя
    // ОтправкаВКанал - Булево: Отправка в канал или в чат бота
    метод ОтправитьКонтакт(Токен: Объект?, ИмяКонтакта: Объект?, НомерТелефона: Объект?, IDПользователя: Объект?, ОтправкаВКанал: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-n", ИмяКонтакта)
        Опции.Вставить("-p", НомерТелефона)
        Опции.Вставить("-u", IDПользователя)
        Опции.Вставить("-i", ОтправкаВКанал)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьКонтакт", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьЛокацию
    // Отправляет географические координаты в чат или канал
    //
    // Токен          - Строка: Токен
    // Широта         - Строка, Число: Географическая широта
    // Долгота        - Строка, Число: Географическая долгота
    // IDПользователя - Строка, Число: ID пользователя. Для канала > администратора, для бота > получателя
    // ОтправкаВКанал - Булево: Отправка в канал или в чат бота
    метод ОтправитьЛокацию(Токен: Объект?, Широта: Объект?, Долгота: Объект?, IDПользователя: Объект?, ОтправкаВКанал: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-l", Широта)
        Опции.Вставить("-n", Долгота)
        Опции.Вставить("-u", IDПользователя)
        Опции.Вставить("-i", ОтправкаВКанал)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьЛокацию", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьСсылку
    // Отправляет URL с предпросмотром в чат или канал
    //
    // Токен          - Строка: Токен
    // URL            - Строка: Отправляемая ссылка
    // IDПользователя - Строка, Число: ID пользователя. Для канала > администратора, для бота > получателя
    // ОтправкаВКанал - Булево: Отправка в канал или в чат бота
    метод ОтправитьСсылку(Токен: Объект?, URL: Объект?, IDПользователя: Объект?, ОтправкаВКанал: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-u", URL)
        Опции.Вставить("-s", IDПользователя)
        Опции.Вставить("-i", ОтправкаВКанал)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьСсылку", Опции)
        
    ;

    @Глобально
    // Метод СформироватьКлавиатуруИзМассиваКнопок
    // Возвращает структура клавиатуры для сообщений
    //
    // МассивКнопок - Массив из Строка: Массив кнопок
    // ЦветКнопок   - Строка: HEX цвет кнопок с # в начале (необяз. по ум. - #2db9b9)
    метод СформироватьКлавиатуруИзМассиваКнопок(МассивКнопок: Объект?, ЦветКнопок: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-b", МассивКнопок)
        Опции.Вставить("-c", ЦветКнопок)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СформироватьКлавиатуруИзМассиваКнопок", Опции)
        
    ;
    
;