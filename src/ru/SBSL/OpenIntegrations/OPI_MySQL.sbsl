        Опции.Вставить("-o", Сортировка)
        Опции.Вставить("-m", Количество)
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-s", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьЗаписи", Опции)
        
    ;

