    @Глобально
    метод ПолучитьСтруктуруФильтраЗаписей(Пустая: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        
