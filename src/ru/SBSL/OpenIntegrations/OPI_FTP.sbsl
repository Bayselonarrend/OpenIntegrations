#требуется ./internal/OPI.sbsl

@Глобально
метод Инициализировать(Конфигурация: OPI.НастройкиИнтеграцииStdio | OPI.НастройкиИнтеграцииHttp? = Неопределено): OPI_FTP
    
    пер Исполнитель = OPI.АбстрактныйИсполнитель.Инициализировать(Конфигурация)
    возврат новый OPI_FTP(Исполнитель)
    
;

@Глобально
метод ЧерезStdio(ПутьOint: Строка): OPI_FTP

    пер Исполнитель = OPI.АбстрактныйИсполнитель.ЧерезStdio(ПутьOint)
    возврат новый OPI_FTP(Исполнитель)
    
;

@Глобально
метод ЧерезHttp(HttpКлиент: КлиентHttp): OPI_FTP

    пер Исполнитель = OPI.АбстрактныйИсполнитель.ЧерезHttp(HttpКлиент)
    возврат новый OPI_FTP(Исполнитель)

;

@Локально
структура OPI_FTP
    
    обз знч Исполнитель: OPI.АбстрактныйИсполнитель
    
    знч КомандаCLI: Строка = "ftp"
    
    @Глобально
    метод ОткрытьСоединение(НастройкиFTP: Объект?, Прокси: Объект? = Неопределено, Tls: Объект? = Неопределено, Логирование: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", НастройкиFTP)
        Опции.Вставить("-p", Прокси)
        Опции.Вставить("-t", Tls)
        Опции.Вставить("-l", Логирование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОткрытьСоединение", Опции)
        
    ;

    @Глобально
    метод ПолучитьКонфигурациюСоединения(НастройкиFTP: Объект?, Прокси: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", НастройкиFTP)
        Опции.Вставить("-p", Прокси)
        Опции.Вставить("-t", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьКонфигурациюСоединения", Опции)
        
    ;

    @Глобально
    метод ЗакрытьСоединение(Соединение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗакрытьСоединение", Опции)
        
    ;

    @Глобально
    метод ПолучитьПриветственноеСообщение(Соединение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПриветственноеСообщение", Опции)
        
    ;

    @Глобально
    метод ПолучитьСписокРасширенийПротокола(Соединение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокРасширенийПротокола", Опции)
        
    ;

    @Глобально
    метод Пинг(Соединение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "Пинг", Опции)
        
    ;

    @Глобально
    метод ВыполнитьНестандартнуюКоманду(Соединение: Объект?, ТекстКоманды: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-m", ТекстКоманды)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВыполнитьНестандартнуюКоманду", Опции)
        
    ;

    @Глобально
    метод ВыполнитьПроизвольнуюКоманду(Соединение: Объект?, ТекстКоманды: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-m", ТекстКоманды)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВыполнитьПроизвольнуюКоманду", Опции)
        
    ;

    @Глобально
    метод ПолучитьРазмерОбъекта(Соединение: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьРазмерОбъекта", Опции)
        
    ;

    @Глобально
    метод ИзменитьПуть(Соединение: Объект?, Путь: Объект?, НовыйПуть: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-o", Путь)
        Опции.Вставить("-n", НовыйПуть)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьПуть", Опции)
        
    ;

    @Глобально
    метод ЭтоКоннектор(Значение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-v", Значение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЭтоКоннектор", Опции)
        
    ;

    @Глобально
    метод ПолучитьНастройкиСоединения(Хост: Объект?, Порт: Объект? = Неопределено, Логин: Объект? = Неопределено, Пароль: Объект? = Неопределено, Пассивный: Объект? = Неопределено, ТаймаутЧтения: Объект? = Неопределено, ТаймаутЗаписи: Объект? = Неопределено, РазрешениеIP: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-h", Хост)
        Опции.Вставить("-p", Порт)
        Опции.Вставить("-l", Логин)
        Опции.Вставить("-s", Пароль)
        Опции.Вставить("-v", Пассивный)
        Опции.Вставить("-r", ТаймаутЧтения)
        Опции.Вставить("-w", ТаймаутЗаписи)
        Опции.Вставить("-i", РазрешениеIP)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиСоединения", Опции)
        
    ;

    @Глобально
    метод ПолучитьНастройкиПрокси(Адрес: Объект?, Порт: Объект?, Вид: Объект? = Неопределено, Логин: Объект? = Неопределено, Пароль: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Адрес)
        Опции.Вставить("-p", Порт)
        Опции.Вставить("-t", Вид)
        Опции.Вставить("-l", Логин)
        Опции.Вставить("-s", Пароль)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиПрокси", Опции)
        
    ;

    @Глобально
    метод ПолучитьНастройкиTls(ОтключитьПроверкуСертификатов: Объект?, ПутьКСертификату: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", ОтключитьПроверкуСертификатов)
        Опции.Вставить("-c", ПутьКСертификату)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиTls", Опции)
        
    ;

    @Глобально
    метод ПолучитьНастройкиЛогирования(ЗаписьВПамять: Объект? = Неопределено, МаксимумСобытий: Объект? = Неопределено, ПутьКФайлу: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-m", ЗаписьВПамять)
        Опции.Вставить("-c", МаксимумСобытий)
        Опции.Вставить("-p", ПутьКФайлу)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиЛогирования", Опции)
        
    ;

    @Глобально
    метод ПолучитьЛог(Соединение: Объект?, КакСтрока: Объект? = Неопределено, ЧислоСобытий: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-s", КакСтрока)
        Опции.Вставить("-n", ЧислоСобытий)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьЛог", Опции)
        
    ;

    @Глобально
    метод ПолучитьСписокОбъектов(Соединение: Объект?, Путь: Объект? = Неопределено, Рекурсивно: Объект? = Неопределено): Объект?
        
