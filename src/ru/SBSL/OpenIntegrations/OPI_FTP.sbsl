#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_FTP
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_FTP(Исполнитель)
    
;

@Локально
структура OPI_FTP
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "ftp"
    
    @Глобально
    // Метод ПолучитьКонфигурациюСоединения
    // Формирует полную структуру настроек соединения, которая может быть использована вместо самого соединения при вызове других функций
    //
    // НастройкиFTP - Структура Из КлючИЗначение: Настройки FTP. См. ПолучитьНастройкиСоединения
    // Прокси       - Структура Из КлючИЗначение: Настройки прокси, если необходимо. См. ПолучитьНастройкиПрокси (необяз. по ум. - Пустое значение)
    // Tls          - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    метод ПолучитьКонфигурациюСоединения(НастройкиFTP: Объект?, Прокси: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", НастройкиFTP)
        Опции.Вставить("-p", Прокси)
        Опции.Вставить("-t", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьКонфигурациюСоединения", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьПриветственноеСообщение
    // Получает приветственное сообщение сервера FTP
    //
    // Соединение - Произвольный: Существующее соединение или конфигурация соединения
    метод ПолучитьПриветственноеСообщение(Соединение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПриветственноеСообщение", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокРасширенийПротокола
    // Получает список расширений протокола FTP, поддерживаемых сервером
    //
    // Соединение - Произвольный: Существующее соединение или конфигурация соединения
    метод ПолучитьСписокРасширенийПротокола(Соединение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокРасширенийПротокола", Опции)
        
    ;

    @Глобально
    // Метод Пинг
    // Проверяет активность соединения и сбрасывает таймаут до его автоматического закрытия
    //
    // Соединение - Произвольный: Существующее соединение или конфигурация соединения
    метод Пинг(Соединение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "Пинг", Опции)
        
    ;

    @Глобально
    // Метод ВыполнитьНестандартнуюКоманду
    // Выполняет специфическую (SITE) команду сервера и возвращает ответ
    //
    // Соединение   - Произвольный: Существующее соединение или конфигурация соединения
    // ТекстКоманды - Строка: Текст выполняемой команды
    метод ВыполнитьНестандартнуюКоманду(Соединение: Объект?, ТекстКоманды: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-m", ТекстКоманды)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВыполнитьНестандартнуюКоманду", Опции)
        
    ;

    @Глобально
    // Метод ВыполнитьПроизвольнуюКоманду
    // Отправляет произвольный текстовый запрос на сервер для обработки
    //
    // Соединение   - Произвольный: Существующее соединение или конфигурация соединения
    // ТекстКоманды - Строка: Текст выполняемой команды
    метод ВыполнитьПроизвольнуюКоманду(Соединение: Объект?, ТекстКоманды: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-m", ТекстКоманды)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВыполнитьПроизвольнуюКоманду", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьРазмерОбъекта
    // Получает размер файла или директории, если она существуют
    //
    // Соединение - Произвольный: Существующее соединение или конфигурация соединения
    // Путь       - Строка: Путь к объекту
    метод ПолучитьРазмерОбъекта(Соединение: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьРазмерОбъекта", Опции)
        
    ;

    @Глобально
    // Метод ИзменитьПуть
    // Изменяет путь объекта на указанный
    //
    // Соединение - Произвольный: Существующее соединение или конфигурация соединения
    // Путь       - Строка: Текущий путь к объекту
    // НовыйПуть  - Строка: Новый путь к объекту
    метод ИзменитьПуть(Соединение: Объект?, Путь: Объект?, НовыйПуть: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-o", Путь)
        Опции.Вставить("-n", НовыйПуть)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьПуть", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьНастройкиСоединения
    // Формирует структуру настроек подключения FTP
    //
    // Хост          - Строка: Адрес сервера
    // Порт          - Число: Порт сервера (необяз. по ум. - 21)
    // Логин         - Строка, Неопределено: Имя пользователя авторизации, если необходимо (необяз. по ум. - Пустое значение)
    // Пароль        - Строка, Неопределено: Пароль пользователя для авторизации, если необходимо (необяз. по ум. - Пустое значение)
    // Пассивный     - Булево: Пассивный режим соединения (необяз. по ум. - true)
    // ТаймаутЧтения - Число: Таймаут чтения (необяз. по ум. - 120)
    // ТаймаутЗаписи - Число: Таймаут записи (необяз. по ум. - 120)
    // РазрешениеIP  - Булево: Расширенное определение адресов в пассивном режиме (необяз. по ум. - true)
    метод ПолучитьНастройкиСоединения(Хост: Объект?, Порт: Объект? = Неопределено, Логин: Объект? = Неопределено, Пароль: Объект? = Неопределено, Пассивный: Объект? = Неопределено, ТаймаутЧтения: Объект? = Неопределено, ТаймаутЗаписи: Объект? = Неопределено, РазрешениеIP: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-h", Хост)
        Опции.Вставить("-p", Порт)
        Опции.Вставить("-l", Логин)
        Опции.Вставить("-s", Пароль)
        Опции.Вставить("-v", Пассивный)
        Опции.Вставить("-r", ТаймаутЧтения)
        Опции.Вставить("-w", ТаймаутЗаписи)
        Опции.Вставить("-i", РазрешениеIP)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиСоединения", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьНастройкиПрокси
    // Формирует структуру настроек прокси-сервера для соединения
    //
    // Адрес  - Строка: Адрес прокси
    // Порт   - Число: Порт прокси
    // Вид    - Строка: Вид прокси: socks5, socks4, http (необяз. по ум. - socks5)
    // Логин  - Строка, Неопределено: Логин авторизации, если необходимо (необяз. по ум. - Пустое значение)
    // Пароль - Строка, Неопределено: Пароль для авторизации, если необходимо (необяз. по ум. - Пустое значение)
    метод ПолучитьНастройкиПрокси(Адрес: Объект?, Порт: Объект?, Вид: Объект? = Неопределено, Логин: Объект? = Неопределено, Пароль: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Адрес)
        Опции.Вставить("-p", Порт)
        Опции.Вставить("-t", Вид)
        Опции.Вставить("-l", Логин)
        Опции.Вставить("-s", Пароль)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиПрокси", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьНастройкиTls
    // Формирует настройки для использования TLS при выполнении запросов
    //
    // ОтключитьПроверкуСертификатов - Булево: Позволяет работать с некорректными сертификатами, в т.ч. самоподписанными
    // ПутьКСертификату              - Строка: Путь к корневому PEM файлу сертификата, если его нет в системном хранилище (необяз. по ум. - Пустое значение)
    метод ПолучитьНастройкиTls(ОтключитьПроверкуСертификатов: Объект?, ПутьКСертификату: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", ОтключитьПроверкуСертификатов)
        Опции.Вставить("-c", ПутьКСертификату)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиTls", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокОбъектов
    // Получает информацию о содержимом директории по выбранному пути
    //
    // Соединение - Произвольный: Существующее соединение или конфигурация соединения
    // Путь       - Строка: Путь к директории поиска (необяз. по ум. - Пустое значение)
    // Рекурсивно - Булево: Получать информацию об объектах во вложенных директориях (необяз. по ум. - false)
    метод ПолучитьСписокОбъектов(Соединение: Объект?, Путь: Объект? = Неопределено, Рекурсивно: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-p", Путь)
        Опции.Вставить("-r", Рекурсивно)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокОбъектов", Опции)
        
    ;

    @Глобально
    // Метод СоздатьНовуюДиректорию
    // Создает директорию по указанному пути
    //
    // Соединение - Произвольный: Существующее соединение или конфигурация соединения
    // Путь       - Строка: Путь к новой директории
    метод СоздатьНовуюДиректорию(Соединение: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьНовуюДиректорию", Опции)
        
    ;

    @Глобально
    // Метод УдалитьДиректорию
    // Удаляет существующую директорию
    //
    // Соединение - Произвольный: Существующее соединение или конфигурация соединения
    // Путь       - Строка: Путь к удаляемой директории
    метод УдалитьДиректорию(Соединение: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьДиректорию", Опции)
        
    ;

    @Глобально
    // Метод ОчиститьДиректорию
    // Очищает выбранную директорию
    //
    // Соединение - Произвольный: Существующее соединение или конфигурация соединения
    // Путь       - Строка: Путь к очищаемой директории
    метод ОчиститьДиректорию(Соединение: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОчиститьДиректорию", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьТекущийКаталог
    // Получает текущий каталог, от которого вычисляются относительные пути
    //
    // Соединение - Произвольный: Существующее соединение или конфигурация соединения
    метод ПолучитьТекущийКаталог(Соединение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьТекущийКаталог", Опции)
        
    ;

    @Глобально
    // Метод ЗагрузитьФайл
    // Загружает файл с диска или двоичные данные на сервер FTP
    //
    // Соединение - Произвольный: Существующее соединение или конфигурация соединения
    // Файл       - Строка, ДвоичныеДанные: Файл на диске или данные файла
    // Путь       - Строка: Путь сохранения файла на сервере
    метод ЗагрузитьФайл(Соединение: Объект?, Файл: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-f", Файл)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗагрузитьФайл", Опции)
        
    ;

    @Глобально
    // Метод УдалитьФайл
    // Удаляет файл с сервера
    //
    // Соединение - Произвольный: Существующее соединение или конфигурация соединения
    // Путь       - Строка: Путь файла на сервере
    метод УдалитьФайл(Соединение: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьФайл", Опции)
        
    ;

    @Глобально
    // Метод СохранитьФайл
    // Сохраняет файл с сервера по указанному пути
    //
    // Соединение - Произвольный: Существующее соединение или конфигурация соединения
    // Путь       - Строка: Путь файла на сервере
    // ИмяФайла   - Строка: Путь для сохранения файла на диске
    метод СохранитьФайл(Соединение: Объект?, Путь: Объект?, ИмяФайла: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-p", Путь)
        Опции.Вставить("-f", ИмяФайла)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СохранитьФайл", Опции)
        
    ;
    
;