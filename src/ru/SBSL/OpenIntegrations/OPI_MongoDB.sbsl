#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_MongoDB
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_MongoDB(Исполнитель)
    
;

@Локально
структура OPI_MongoDB
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "mongodb"
    
    @Глобально
    // Метод СформироватьСтрокуПодключения
    // Формирует строку для подключения к серверу MongoDB
    //
    // Адрес     - Строка: IP адрес с портом или доменное имя для подключения
    // База      - Строка: База для подключения, если необходимо (необяз. по ум. - Пустое значение)
    // Логин     - Строка: Имя пользователя авторизации (необяз. по ум. - Пустое значение)
    // Пароль    - Строка: Пароль пользователя для авторизации (необяз. по ум. - Пустое значение)
    // Параметры - Структура Из КлючИЗначение, Неопределено: Дополнительные параметры подключения (необяз. по ум. - Пустое значение)
    метод СформироватьСтрокуПодключения(Адрес: Объект?, База: Объект? = Неопределено, Логин: Объект? = Неопределено, Пароль: Объект? = Неопределено, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Адрес)
        Опции.Вставить("-d", База)
        Опции.Вставить("-u", Логин)
        Опции.Вставить("-p", Пароль)
        Опции.Вставить("-r", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СформироватьСтрокуПодключения", Опции)
        
    ;

    @Глобально
    // Метод ВыполнитьКоманду
    // Выполняет команду по ее описанию
    //
    // Соединение - Строка, Произвольный: Соединение или строка подключения
    // Команда    - Строка: Имя команды для выполнения
    // Аргумент   - Произвольный: Аргумент команды (необяз. по ум. - 1)
    // База       - Строка: База данных, в которой необходимо провести операцию (необяз. по ум. - Пустое значение)
    // Данные     - Структура Из КлючИЗначение: Основные поля данных для выполнения операции (необяз. по ум. - Пустое значение)
    метод ВыполнитьКоманду(Соединение: Объект?, Команда: Объект?, Аргумент: Объект? = Неопределено, База: Объект? = Неопределено, Данные: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-c", Команда)
        Опции.Вставить("-a", Аргумент)
        Опции.Вставить("-b", База)
        Опции.Вставить("-t", Данные)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВыполнитьКоманду", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокБаз
    // Получает список баз данных
    //
    // Соединение - Строка, Произвольный: Соединение или строка подключения
    метод ПолучитьСписокБаз(Соединение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Соединение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокБаз", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьБазуДанных
    // Получает информацию о базе данных
    //
    // Соединение - Строка, Произвольный: Соединение или строка подключения
    // База       - Строка: Имя базы. Текущая база, если не указано (необяз. по ум. - Пустое значение)
    метод ПолучитьБазуДанных(Соединение: Объект?, База: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-b", База)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьБазуДанных", Опции)
        
    ;

    @Глобально
    // Метод УдалитьБазуДанных
    // Удаляет базу данных
    //
    // Соединение - Строка, Произвольный: Соединение или строка подключения
    // База       - Строка: Имя базы. Текущая база, если не указано (необяз. по ум. - Пустое значение)
    метод УдалитьБазуДанных(Соединение: Объект?, База: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-b", База)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьБазуДанных", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокКоллекций
    // Получает список коллекций базы данных
    //
    // Соединение - Строка, Произвольный: Соединение или строка подключения
    // База       - Строка: Имя базы. Текущая база, если не указано (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокКоллекций(Соединение: Объект?, База: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-b", База)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокКоллекций", Опции)
        
    ;

    @Глобально
    // Метод СоздатьКоллекцию
    // Создает новую коллекцию с указанными параметрами
    //
    // Соединение   - Строка, Произвольный: Соединение или строка подключения
    // Наименование - Строка: Имя новой коллекции
    // База         - Строка: Имя базы. Текущая база, если не указано (необяз. по ум. - Пустое значение)
    // Параметры    - Структура Из КлючИЗначение: Дополнительные параметры создания (необяз. по ум. - Пустое значение)
    метод СоздатьКоллекцию(Соединение: Объект?, Наименование: Объект?, База: Объект? = Неопределено, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-n", Наименование)
        Опции.Вставить("-b", База)
        Опции.Вставить("-p", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьКоллекцию", Опции)
        
    ;

    @Глобально
    // Метод УдалитьКоллекцию
    // Удаляет выбранную коллекцию базы
    //
    // Соединение - Строка, Произвольный: Соединение или строка подключения
    // Коллекция  - Строка: Имя коллекции
    // База       - Строка: Имя базы. Текущая база, если не указано (необяз. по ум. - Пустое значение)
    метод УдалитьКоллекцию(Соединение: Объект?, Коллекция: Объект?, База: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-c", Коллекция)
        Опции.Вставить("-b", База)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьКоллекцию", Опции)
        
    ;

    @Глобально
    // Метод ВставитьДокументы
    // Вставляет новые документы в коллекцию
    //
    // Соединение - Строка, Произвольный: Соединение или строка подключения
    // Коллекция  - Строка: Имя коллекции
    // Значения   - Массив Из Произвольный: Массив объектов документов
    // База       - Строка: Имя базы. Текущая база, если не указано (необяз. по ум. - Пустое значение)
    // Параметры  - Структура Из КлючИЗначение: Дополнительные параметры вставки (необяз. по ум. - Пустое значение)
    метод ВставитьДокументы(Соединение: Объект?, Коллекция: Объект?, Значения: Объект?, База: Объект? = Неопределено, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-c", Коллекция)
        Опции.Вставить("-s", Значения)
        Опции.Вставить("-b", База)
        Опции.Вставить("-p", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВставитьДокументы", Опции)
        
    ;

    @Глобально
    // Метод ОбновитьДокументы
    // Обновляет данные документов в коллекции
    //
    // Соединение - Строка, Произвольный: Соединение или строка подключения
    // Коллекция  - Строка: Имя коллекции
    // Обновления - Массив Из Структура: Массив обновлений. См. ПолучитьСтруктуруОбновленияДокументов
    // База       - Строка: Имя базы. Текущая база, если не указано (необяз. по ум. - Пустое значение)
    // Параметры  - Структура Из КлючИЗначение: Дополнительные параметры вставки (необяз. по ум. - Пустое значение)
    метод ОбновитьДокументы(Соединение: Объект?, Коллекция: Объект?, Обновления: Объект?, База: Объект? = Неопределено, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-c", Коллекция)
        Опции.Вставить("-u", Обновления)
        Опции.Вставить("-b", База)
        Опции.Вставить("-p", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОбновитьДокументы", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьДокументы
    // Получает документы коллекции
    //
    // Соединение - Строка, Произвольный: Соединение или строка подключения
    // Коллекция  - Строка: Имя коллекции
    // База       - Строка: Имя базы. Текущая база, если не указано (необяз. по ум. - Пустое значение)
    // Фильтр     - Структура Из КлючИЗначение: Фильтр документов (необяз. по ум. - Пустое значение)
    // Сортировка - Структура Из КлючИЗначение: Сортировка выборки (необяз. по ум. - Пустое значение)
    // Параметры  - Структура Из КлючИЗначение: Дополнительные параметры получения (необяз. по ум. - Пустое значение)
    метод ПолучитьДокументы(Соединение: Объект?, Коллекция: Объект?, База: Объект? = Неопределено, Фильтр: Объект? = Неопределено, Сортировка: Объект? = Неопределено, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-c", Коллекция)
        Опции.Вставить("-b", База)
        Опции.Вставить("-q", Фильтр)
        Опции.Вставить("-s", Сортировка)
        Опции.Вставить("-p", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьДокументы", Опции)
        
    ;

    @Глобально
    // Метод УдалитьДокументы
    // Удаляет документы коллекции
    //
    // Соединение - Строка, Произвольный: Соединение или строка подключения
    // Коллекция  - Строка: Имя коллекции
    // Удаления   - Массив Из Структура: Массив удаления. См. ПолучитьСтруктуруУдаленияДокументов
    // База       - Строка: Имя базы. Текущая база, если не указано (необяз. по ум. - Пустое значение)
    // Параметры  - Структура Из КлючИЗначение: Дополнительные параметры вставки (необяз. по ум. - Пустое значение)
    метод УдалитьДокументы(Соединение: Объект?, Коллекция: Объект?, Удаления: Объект?, База: Объект? = Неопределено, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-c", Коллекция)
        Опции.Вставить("-l", Удаления)
        Опции.Вставить("-b", База)
        Опции.Вставить("-p", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьДокументы", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтруктуруОбновленияДокументов
    // Формирует структуру данных для обновления документов
    //
    // Фильтр        - Структура Из КлючИЗначение: Фильтр документов
    // Данные        - Структура Из КлючИЗначение: Новые данные документов для обновления
    // ОбновитьВсе   - Булево: Истина > обновляет все документы по фильтру, Ложь > только один (необяз. по ум. - true)
    // Вставлять     - Булево: Вставить новый документ, если ни один документ не был найден (необяз. по ум. - false)
    // Сопоставление - Структура Из КлючИЗначение: Особые настройки правил сравнения полей при поиске (необяз. по ум. - Пустое значение)
    метод ПолучитьСтруктуруОбновленияДокументов(Фильтр: Объект?, Данные: Объект?, ОбновитьВсе: Объект? = Неопределено, Вставлять: Объект? = Неопределено, Сопоставление: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-q", Фильтр)
        Опции.Вставить("-d", Данные)
        Опции.Вставить("-m", ОбновитьВсе)
        Опции.Вставить("-u", Вставлять)
        Опции.Вставить("-c", Сопоставление)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруОбновленияДокументов", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтруктуруУдаленияДокументов
    // Формирует структуру данных для обновления
    //
    // Фильтр        - Структура Из КлючИЗначение: Фильтр документов
    // Количество    - Число: Лимит удаления: 1 > первый документ, 0 > все документы (необяз. по ум. - Пустое значение)
    // Сопоставление - Структура Из КлючИЗначение: Особые настройки правил сравнения полей при поиске (необяз. по ум. - Пустое значение)
    метод ПолучитьСтруктуруУдаленияДокументов(Фильтр: Объект?, Количество: Объект? = Неопределено, Сопоставление: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-q", Фильтр)
        Опции.Вставить("-l", Количество)
        Опции.Вставить("-c", Сопоставление)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруУдаленияДокументов", Опции)
        
    ;

    @Глобально
    // Метод СоздатьПользователя
    // Создает нового пользователя
    //
    // Соединение       - Строка, Произвольный: Соединение или строка подключения
    // Имя              - Строка: Имя пользователя
    // РолиПользователя - Массив Из Произвольный: Массив ролей в виде строк или структур с указанием БД
    // База             - Строка: Имя базы. Текущая база, если не указано (необяз. по ум. - Пустое значение)
    // Пароль           - Строка: Пароль пользователя (необяз. по ум. - Пустое значение)
    // Параметры        - Структура Из КлючИЗначение: Дополнительные параметры создания (необяз. по ум. - Пустое значение)
    метод СоздатьПользователя(Соединение: Объект?, Имя: Объект?, РолиПользователя: Объект?, База: Объект? = Неопределено, Пароль: Объект? = Неопределено, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-n", Имя)
        Опции.Вставить("-r", РолиПользователя)
        Опции.Вставить("-b", База)
        Опции.Вставить("-p", Пароль)
        Опции.Вставить("-m", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьПользователя", Опции)
        
    ;

    @Глобально
    // Метод ИзменитьПользователя
    // Изменяет данные существующего пользователя
    //
    // Соединение       - Строка, Произвольный: Соединение или строка подключения
    // Имя              - Строка: Имя пользователя
    // РолиПользователя - Массив Из Произвольный: Массив ролей в виде строк или структур с указанием БД (необяз. по ум. - Пустое значение)
    // База             - Строка: Имя базы. Текущая база, если не указано (необяз. по ум. - Пустое значение)
    // Пароль           - Строка: Пароль пользователя (необяз. по ум. - Пустое значение)
    // Параметры        - Структура Из КлючИЗначение: Дополнительные параметры (необяз. по ум. - Пустое значение)
    метод ИзменитьПользователя(Соединение: Объект?, Имя: Объект?, РолиПользователя: Объект? = Неопределено, База: Объект? = Неопределено, Пароль: Объект? = Неопределено, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-n", Имя)
        Опции.Вставить("-r", РолиПользователя)
        Опции.Вставить("-b", База)
        Опции.Вставить("-p", Пароль)
        Опции.Вставить("-m", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьПользователя", Опции)
        
    ;

