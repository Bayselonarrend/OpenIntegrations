    @Глобально
    метод НазначитьРоли(Соединение: Объект?, Пользователь: Объект?, МассивРолей: Объект?, База: Объект? = Неопределено, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-u", Пользователь)
        Опции.Вставить("-r", МассивРолей)
        Опции.Вставить("-b", База)
        Опции.Вставить("-p", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "НазначитьРоли", Опции)
        
    ;

    @Глобально
    метод СнятьРоли(Соединение: Объект?, Пользователь: Объект?, МассивРолей: Объект?, База: Объект? = Неопределено, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-u", Пользователь)
        Опции.Вставить("-r", МассивРолей)
        Опции.Вставить("-b", База)
        Опции.Вставить("-p", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СнятьРоли", Опции)
        
    ;

    @Глобально
    метод ПолучитьСтруктуруПривилегииРоли(Ресурс: Объект?, МассивДействий: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-r", Ресурс)
        Опции.Вставить("-a", МассивДействий)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруПривилегииРоли", Опции)
        
    ;
    
;