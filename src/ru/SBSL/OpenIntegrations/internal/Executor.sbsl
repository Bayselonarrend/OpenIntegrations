#совместимость 9.0

перечисление ТипыИнтеграций
    stdio,
    tcp
;

структура НастройкиИнтеграции
    @JsonСвойство(Имя = "type")
    обз знч ТипИнтеграции: ТипыИнтеграций
    @JsonСвойство(Имя = "source")
    обз знч Источник: Строка
;

@Глобально
структура ИсполнительОПИ
    
    обз знч КонкретныйИсполнитель: ИсполнительStdio|ИсполнительTcp
    обз знч Настройки: НастройкиИнтеграции
    
    @Глобально
    статический метод Инициализировать(ФайлКонфигурации: Строка): ИсполнительОПИ
        
        пер ФайлНастроек: Файл = новый Файл(ФайлКонфигурации)

        если не ФайлНастроек.Существует()
            выбросить новый ИсключениеНедопустимыйАргумент("ОПИ: Файл конфигурации не найден!")
        ;

        пер Настройки = СериализацияJson.ПрочитатьОбъект(ФайлНастроек.ОткрытьПотокЧтения(), Тип<НастройкиИнтеграции>)

        пер КонкретныйИсполнитель: ИсполнительStdio|ИсполнительTcp?        
        
        выбор Настройки.ТипИнтеграции
        когда ТипыИнтеграций.stdio
            КонкретныйИсполнитель = ИсполнительStdio.Инициализировать(Настройки.Источник)
        когда ТипыИнтеграций.tcp
            КонкретныйИсполнитель = ИсполнительTcp.Инициализировать(Настройки.Источник)
        иначе
            выбросить новый ИсключениеНедопустимоеСостояние("ОПИ: Недопустимый тип интеграции")    
        ;
        
        возврат новый ИсполнительОПИ(КонкретныйИсполнитель, Настройки)
        
    ;
    
    @Глобально
    метод Выполнить(ИмяМодуля: Строка, ИмяМетода: Строка, Опции: Соответствие<Строка, Объект?>): Объект?
        
        пер ОпцииНормализованные = НормализоватьОпции(Опции)
        
        выбор КонкретныйИсполнитель.ПолучитьТип()
        когда Тип<ИсполнительStdio>
           возврат (КонкретныйИсполнитель как ИсполнительStdio).Выполнить(ИмяМодуля, ИмяМетода, ОпцииНормализованные)
        когда Тип<ИсполнительTcp>
           возврат (КонкретныйИсполнитель как ИсполнительTcp).Выполнить(ИмяМодуля, ИмяМетода, ОпцииНормализованные)  
        иначе
            выбросить новый ИсключениеНедопустимоеСостояние("ОПИ: Исполнитель не инициализирован")    
        ;
         
    ;
    
    метод НормализоватьОпции(Опции: Соответствие<Строка, Объект?>): Соответствие<Строка, Строка>
        
        пер НормализованныеОпции: Соответствие<Строка, Строка>
        
        для Элемент из Опции
            
            пер НормализованныйКлюч = Элемент.Ключ.ВСтроку()
            пер НормализованноеЗначение: Строка
            
            пер ТекущееЗначение = Элемент.Значение
            
            выбор ТекущееЗначение.ПолучитьТип()
            когда Тип<Дата>
                НормализованноеЗначение = (ТекущееЗначение как Дата).Представление()
            когда Тип<ДатаВремя>
                НормализованноеЗначение = (ТекущееЗначение как ДатаВремя).Представление("гггг.ММ.ддTЧЧ:мм:ссZ")
            когда Тип<Неопределено>
                продолжить
            иначе
                НормализованноеЗначение = ТекущееЗначение.ВСтроку()
            ;
            
            если не НормализованноеЗначение.Пусто()
                НормализованныеОпции.Вставить(НормализованныйКлюч, НормализованноеЗначение)    
            ;
            
        ;
        
        возврат НормализованныеОпции
    ;
    
;

структура ИсполнительStdio
    
    обз пер Процесс: ПроцессОс
    обз пер ПотокВвода: ПотокЗаписи 
    обз пер ПотокВывода: ПотокЧтения
    обз пер РазделительСообщений: Строка
    обз знч Источник: Строка
    
    статический метод Инициализировать(Источник: Строка): ИсполнительStdio
        
        пер РазделительСообщений = "OINT-MSG-" + новый Ууид()
        пер ИмяИсполняемогоФайла: Строка
        пер МассивАргументов: ЧитаемыйМассив<Строка> = []
        пер СтрокаЗапуска = "%Источник server STDIO --enc UTF-8 -s %РазделительСообщений -b true"
                        
            ИмяИсполняемогоФайла = "cmd.exe"
        если СредаИсполнения.ПолучитьСвойство("os.name").Содержит("Windows", Истина)
            МассивАргументов = ["/c", СтрокаЗапуска]
        иначе
            ИмяИсполняемогоФайла = "/bin/sh"
            МассивАргументов = ["-c", СтрокаЗапуска]
        ;
        
        пер Процесс = новый ПроцессОс(ИмяИсполняемогоФайла, МассивАргументов, Истина)
        Процесс.Запустить()
        
        пер ПотокВвода = Процесс.ПолучитьПотокВвода()
        пер ПотокВывода = Процесс.ПолучитьПотокВывода()
        
        возврат новый ИсполнительStdio(Процесс, ПотокВвода, ПотокВывода, РазделительСообщений, Источник)
    ;
    
    метод Выполнить(Команда: Строка, ИмяМетода: Строка, Опции: Соответствие<Строка, Строка>): Объект?
        
        ПроверитьПерезапуститьПроцесс()
        
        пер СтрокаВызова: Строка = "%Команда %ИмяМетода"
        
        для Элемент из Опции
            
            СтрокаВызова = "%СтрокаВызова %{Элемент.Ключ} %{Элемент.Значение}"
            
        ;
               
        ПотокВвода.Записать(СтрокаВызова, Кодировка.Utf8) 
        ПотокВвода.Закрыть()
        
        пер Результат: Строка
        
        пер СчетчикПустых = 1
        
        пока Процесс.Живой() 
            и не Результат.Содержит(РазделительСообщений) 
            и (СчетчикПустых < 20 или не Результат.Пусто()) 
            
            пер ТекущийРезультат = ПотокВывода.ПрочитатьКакСтроку()
            
            если не ТекущийРезультат.Пусто()
                Результат = Результат + ТекущийРезультат
                СчетчикПустых = 1
            иначе
                Пауза(Длительность.ИзМиллисекунд(100 * СчетчикПустых))
                СчетчикПустых = СчетчикПустых + 1
            ;
        ;
        
        возврат Результат.Удалить(РазделительСообщений)
           
    ;
    
    метод ПроверитьПерезапуститьПроцесс()
        
        если не Процесс.Живой()
         
            пер НовыйИсполнитель = ИсполнительStdio.Инициализировать(Источник)
            
            если не НовыйИсполнитель.Процесс.Живой()
                
                пер ИнформацияОбОшибке: Строка
                
                попытка 
                    ИнформацияОбОшибке = НовыйИсполнитель.Процесс.ПолучитьПотокВывода().ПрочитатьКакСтроку()
                поймать Исключение: неизвестно
                    ИнформацияОбОшибке = "<отсутствует>"
                ;
                
                выбросить новый ИсключениеНедопустимоеСостояние("ОПИ: Не удалось перезапустить исполнитель команд после падения. Доп. информация: %ИнформацияОбОшибке") 
                
            ;
            
            ПотокВвода = НовыйИсполнитель.ПотокВвода
            ПотокВывода = НовыйИсполнитель.ПотокВывода
            Процесс = НовыйИсполнитель.Процесс
            РазделительСообщений = НовыйИсполнитель.РазделительСообщений
               
        ;    
    ;
;

структура ИсполнительTcp
    
    статический метод Инициализировать(Источник: Строка): ИсполнительTcp
        возврат новый ИсполнительTcp()
    ;
    
    метод Выполнить(ИмяМодуля: Строка, ИмяМетода: Строка, Опции: Соответствие<Строка, Строка>): Объект?
        возврат Неопределено    
    ;
    
;
