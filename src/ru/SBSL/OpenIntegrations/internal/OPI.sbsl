@Глобально
структура НастройкиИнтеграцииStdio
    обз пер ПутьOint: Строка
;

@Глобально
структура НастройкиИнтеграцииHttp
    обз пер HttpКлиент: КлиентHttp
;

@Глобально
структура АбстрактныйИсполнитель
    
    обз знч КонкретныйИсполнитель: ИсполнительStdio|ИсполнительHttp
    обз знч Настройки: НастройкиИнтеграцииStdio | НастройкиИнтеграцииHttp
    
    @Глобально
    статический метод ЧерезStdio(ПутьOint: Строка) : АбстрактныйИсполнитель
        возврат АбстрактныйИсполнитель.Инициализировать(новый НастройкиИнтеграцииStdio(ПутьOint))
    ;
    
    @Глобально
    статический метод ЧерезHttp(HttpКлиент: КлиентHttp) : АбстрактныйИсполнитель
        возврат АбстрактныйИсполнитель.Инициализировать(новый НастройкиИнтеграцииHttp(HttpКлиент))
    ;

    @Глобально
    статический метод Инициализировать(Конфигурация: НастройкиИнтеграцииStdio | НастройкиИнтеграцииHttp? = Неопределено): АбстрактныйИсполнитель
        
        пер Настройки: НастройкиИнтеграцииStdio | НастройкиИнтеграцииHttp? = Конфигурация

        если Настройки.ПолучитьТип() == Тип<Неопределено>
            Настройки = новый НастройкиИнтеграцииStdio("oint")
        ;

        пер КонкретныйИсполнитель: ИсполнительStdio|ИсполнительHttp?

        выбор Конфигурация.ПолучитьТип()
        когда Тип<НастройкиИнтеграцииStdio>
            КонкретныйИсполнитель = ИсполнительStdio.Инициализировать(Настройки как НастройкиИнтеграцииStdio)
        когда Тип<НастройкиИнтеграцииHttp>
            КонкретныйИсполнитель = ИсполнительHttp.Инициализировать(Настройки как НастройкиИнтеграцииHttp)
        иначе
            выбросить новый ИсключениеНедопустимоеСостояние("ОПИ - Недопустимый тип интеграции")
        ;

        возврат новый АбстрактныйИсполнитель(КонкретныйИсполнитель, Настройки)
    ;

    @Глобально
    метод Выполнить(ИмяМодуля: Строка, ИмяМетода: Строка, Опции: Соответствие<Строка, Объект?>): Объект?
        
        пер ОпцииНормализованные = НормализоватьОпции(Опции)

        выбор КонкретныйИсполнитель.ПолучитьТип()
        когда Тип<ИсполнительStdio>
            возврат (КонкретныйИсполнитель как ИсполнительStdio).Выполнить(ИмяМодуля, ИмяМетода, ОпцииНормализованные)
        когда Тип<ИсполнительHttp>
            возврат (КонкретныйИсполнитель как ИсполнительHttp).Выполнить(ИмяМодуля, ИмяМетода, ОпцииНормализованные)
        иначе
            выбросить новый ИсключениеНедопустимоеСостояние("ОПИ - Исполнитель не инициализирован")
        ;
    ;

    метод НормализоватьОпции(Опции: Соответствие<Строка, Объект?>): Соответствие<Строка, Строка>
        пер НормализованныеОпции: Соответствие<Строка, Строка>

        для Элемент из Опции
            пер НормализованныйКлюч = Элемент.Ключ.ВСтроку()
            пер НормализованноеЗначение: Строка

            пер ТекущееЗначение = Элемент.Значение

            выбор ТекущееЗначение.ПолучитьТип()
            когда Тип<Дата>
                НормализованноеЗначение = (ТекущееЗначение как Дата).Представление()
            когда Тип<ДатаВремя>
                НормализованноеЗначение = (ТекущееЗначение как ДатаВремя).Представление("гггг.ММ.ддTЧЧ:мм:ссZ")
            когда Тип<Байты>
                пер ВременныйФайл = Файлы.СоздатьВременныйФайл()
                ВременныйФайл.ОткрытьПотокЗаписи().Записать(НормализованноеЗначение)
                НормализованноеЗначение = ВременныйФайл.Путь

            когда Тип<Неопределено>
                продолжить
            иначе
                НормализованноеЗначение = ТекущееЗначение.ВСтроку()
            ;

            НормализованноеЗначение = НормализованноеЗначение.Заменить(Символы.НОВАЯ_СТРОКА, "\\n")
            НормализованноеЗначение = НормализованноеЗначение.Заменить(Символы.ВОЗВРАТ_КАРЕТКИ, "\\r")

            если не НормализованноеЗначение.Пусто()
                НормализованныеОпции.Вставить(НормализованныйКлюч, НормализованноеЗначение)
            ;
        ;

        возврат НормализованныеОпции
    ;
;

структура ИсполнительStdio
    
    обз пер Процесс: ПроцессОс
    обз пер ПотокВвода: ПотокЗаписи
    обз пер ПотокВывода: ПотокЧтения
    обз пер РазделительСообщений: Строка
    
    обз знч Настройки: НастройкиИнтеграцииStdio

    статический метод Инициализировать(Настройки: НастройкиИнтеграцииStdio): ИсполнительStdio
    
        пер Источник: Строка = Настройки.ПутьOint
        
        пер РазделительСообщений = "OINT-MSG-" + новый Ууид()
        пер ИмяИсполняемогоФайла: Строка
        пер МассивАргументов: ЧитаемыйМассив<Строка> = []
        пер СтрокаЗапуска = "%Источник server STDIO --enc UTF-8 -s %РазделительСообщений -b true"

        ИмяИсполняемогоФайла = "cmd.exe"
        если СредаИсполнения.ПолучитьСвойство("os.name").Содержит("Windows", Истина)
            МассивАргументов = ["/c", СтрокаЗапуска]
        иначе
            ИмяИсполняемогоФайла = "/bin/sh"
            МассивАргументов = ["-c", СтрокаЗапуска]
        ;

        пер Процесс = новый ПроцессОс(ИмяИсполняемогоФайла, МассивАргументов, Истина)
        Процесс.Запустить()

        пер ПотокВвода = Процесс.ПолучитьПотокВвода()
        пер ПотокВывода = Процесс.ПолучитьПотокВывода()

        возврат новый ИсполнительStdio(Процесс, ПотокВвода, ПотокВывода, РазделительСообщений, Настройки)
    ;

    метод Выполнить(Команда: Строка, ИмяМетода: Строка, Опции: Соответствие<Строка, Строка>): Объект?
        ПроверитьПерезапуститьПроцесс()

        пер СтрокаВызова: Строка = "%Команда %ИмяМетода"

        для Элемент из Опции
            СтрокаВызова = "%СтрокаВызова %{Элемент.Ключ} %{Элемент.Значение}"
        ;

        ПотокВвода.Записать(СтрокаВызова, Кодировка.Utf8)
        ПотокВвода.Закрыть()

        пер Результат: Строка

        пер СчетчикПустых = 1

        пока Процесс.Живой() и не Результат.Содержит(РазделительСообщений) и (СчетчикПустых < 20 или не Результат
                .Пусто())
            пер ТекущийРезультат = ПотокВывода.ПрочитатьКакСтроку()

            если не ТекущийРезультат.Пусто()
                Результат = Результат + ТекущийРезультат
                СчетчикПустых = 1
            иначе
                Пауза(Длительность.ИзМиллисекунд(100 * СчетчикПустых))
                СчетчикПустых = СчетчикПустых + 1
            ;
        ;

        возврат Результат.Удалить(РазделительСообщений).Сократить()
    ;

    метод ПроверитьПерезапуститьПроцесс()
        если не Процесс.Живой()
            пер НовыйИсполнитель = ИсполнительStdio.Инициализировать(Настройки)

            если не НовыйИсполнитель.Процесс.Живой()
                пер ИнформацияОбОшибке: Строка

                попытка
                    ИнформацияОбОшибке = НовыйИсполнитель.Процесс.ПолучитьПотокВывода().ПрочитатьКакСтроку()
                поймать Исключение: неизвестно
                    ИнформацияОбОшибке = "<отсутствует>"
                ;

                выбросить новый ИсключениеНедопустимоеСостояние(
                    "ОПИ - Не удалось перезапустить исполнитель команд после падения. Доп. информация: %ИнформацияОбОшибке")
            ;

            ПотокВвода = НовыйИсполнитель.ПотокВвода
            ПотокВывода = НовыйИсполнитель.ПотокВывода
            Процесс = НовыйИсполнитель.Процесс
            РазделительСообщений = НовыйИсполнитель.РазделительСообщений
        ;
    ;
;

структура ИсполнительHttp
    
    обз знч Клиент: КлиентHttp
    
    статический метод Инициализировать(Настройки: НастройкиИнтеграцииHttp): ИсполнительHttp
    
        возврат новый ИсполнительHttp(Настройки.HttpКлиент)
    ;

    метод Выполнить(Команда: Строка, ИмяМетода: Строка, Опции: Соответствие<Строка, Строка>): Объект?
        
        пер НовыйЗапрос = КлиентHttp.ЗапросPost("%Команда/%ИмяМетода")
        пер Ответ = НовыйЗапрос.УстановитьТипСодержимого("multipart/form-data").Выполнить()
        
        пер Результат: Объект?
        
        попытка
            Результат = СериализацияJson.ПрочитатьОбъект(Ответ.Тело, Тип<Объект>)
        поймать
            Результат = Ответ.Тело.ПрочитатьКакБайты()
        ;
        
        возврат Результат;
        
    ;
;