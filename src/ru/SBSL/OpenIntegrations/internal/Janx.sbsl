
@Глобально
метод СериализоватьДанные(Данные: ЧитаемаяКоллекция<Объект>): Байты
    
    пер МассивДвоичных: Массив<Байты>
    пер Смещение: Число = 0
        
    пер ДанныеНормализованные = НормализоватьОбъектJanx(Данные, МассивДвоичных, Смещение)
    пер JSONДД = СериализацияJson.ЗаписатьОбъект(ДанныеНормализованные).ВБайты()
    пер РазмерJSON = JSONДД.Длина()
    
    пер ПотокДанных = новый ВременныйПотокЗаписи()
    пер Запись = новый ЗаписьДанных(ПотокДанных)
    
    Запись.ЗаписатьЦелое16(ВерсияФорматаJanx(), ПорядокБайтов.ОтСтаршегоКМладшему)
    Запись.ЗаписатьЦелое32(РазмерJSON, ПорядокБайтов.ОтСтаршегоКМладшему)
    Запись.ЗаписатьЦелое32(МассивДвоичных.Размер(), ПорядокБайтов.ОтСтаршегоКМладшему)
    Запись.Записать(JSONДД)
    
    для Блок из МассивДвоичных
        Запись.Записать(Блок)    
    ;
    
    ПотокДанных.Закрыть()
    
    возврат ПотокДанных.ОткрытьПотокЧтения().ПрочитатьКакБайты()
    
;

метод НормализоватьОбъектJanx(Данные: Объект, МассивДвоичных: Массив<Байты>, Смещение: Число): Объект
    
    если Данные это ЧитаемаяКоллекция<КлючИЗначение<Объект, Объект?>>
        
        для Элемент из (Данные как ЧитаемаяКоллекция<КлючИЗначение<Объект, Объект?>>)
            НормализоватьОбъектJanx(Элемент.Значение, МассивДвоичных, Смещение)    
        ;
        
    иначе если Данные это ЧитаемаяКоллекция<Объект?>

        для Элемент из (Данные как ЧитаемаяКоллекция<Объект?>)
            НормализоватьОбъектJanx(Элемент, МассивДвоичных, Смещение)    
        ;
                
    иначе если Данные это Байты
        
        Данные = СоздатьМаркерБинарныхJanx(Данные как Байты, МассивДвоичных, Смещение) 
        
    ;
    
    возврат Данные
    
;

метод СоздатьМаркерБинарныхJanx(ДвоичныеДанные: Байты, МассивДвоичных: Массив<Байты>, Смещение: Число): Объект

    пер Длина  = ДвоичныеДанные.Длина()
    пер Начало = Смещение
    пер КлючМаркера = КлючМаркераБинарныхJanx()
    
    МассивДвоичных.Добавить(ДвоичныеДанные)
    Смещение = Смещение + Длина
    
    пер Маркер = {"%КлючМаркера": {"s": Начало, "l": Длина}} 
    возврат Маркер
    
;

метод КлючМаркераБинарныхJanx(): Строка
    возврат "__JANXB__"        
;

метод ВерсияФорматаJanx(): Число
    возврат 1
;

метод РазмерПрефиксаJanx(): Число
    возврат 2
;

метод РазмерЗаголовкаJanx(): Число
    пер Постфикс = 8
    возврат РазмерПрефиксаJanx() + Постфикс;
;