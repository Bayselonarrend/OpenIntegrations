
структура КонтекстДесериализации  
    пер БуферПриложения: Байты
    пер МаркеровВсего: Число
    пер МаркеровВосстановлено: Число = 0
;

@Глобально
метод СериализоватьДанные(Данные: Объект): Байты
    
    пер МассивДвоичных: Массив<Байты>
    пер Смещение: Число = 0
        
    пер ДанныеНормализованные = НормализоватьОбъектJanx(Данные, МассивДвоичных, Смещение)
    пер JSONДД = СериализацияJson.ЗаписатьОбъект(ДанныеНормализованные).ВБайты()
    пер РазмерJSON = JSONДД.Длина()
    
    пер ПотокДанных = новый ВременныйПотокЗаписи()
    пер Запись = новый ЗаписьДанных(ПотокДанных)
    
    Запись.ЗаписатьЦелое16(ВерсияФорматаJanx(), ПорядокБайтов.ОтСтаршегоКМладшему)
    Запись.ЗаписатьЦелое32(РазмерJSON, ПорядокБайтов.ОтСтаршегоКМладшему)
    Запись.ЗаписатьЦелое32(МассивДвоичных.Размер(), ПорядокБайтов.ОтСтаршегоКМладшему)
    Запись.Записать(JSONДД)
    
    для Блок из МассивДвоичных
        Запись.Записать(Блок)    
    ;
    
    ПотокДанных.Закрыть()
    
    возврат ПотокДанных.ОткрытьПотокЧтения().ПрочитатьКакБайты()
    
;

@Глобально
метод ДесериализоватьДанные(Данные: Байты|ПотокЧтения): Объект
        
    пер Чтение: ЧтениеДанных?
    
    выбор Данные.ПолучитьТип()
    когда Тип<Байты>
                    
        пер Поток = новый ВременныйПотокЗаписи()
        Поток.Записать(Данные как Байты)
        
        Чтение = новый ЧтениеДанных(Поток.ОткрытьПотокЧтения())
        
    когда Тип<ПотокЧтения>
        Чтение = новый ЧтениеДанных(Данные как ПотокЧтения)
    ;
        
    пер Версия = Чтение.ПрочитатьЦелое16(ПорядокБайтов.ОтСтаршегоКМладшему)
    
    если Версия != ВерсияФорматаJanx()
        выбросить новый ИсключениеНедопустимоеСостояние("Некорректный формат Janx: неподдерживаемая версия %Версия")    
    ;
    
    пер РазмерJSON = Чтение.ПрочитатьЦелое32(ПорядокБайтов.BigEndian)
    пер ЧислоМаркеров = Чтение.ПрочитатьЦелое32(ПорядокБайтов.BigEndian)
        
    пер JSONДанные = Чтение.Прочитать(РазмерJSON)
    пер БуферПриложения = Чтение.Прочитать().ПолучитьБайты()
    пер ДеревоJSON = СериализацияJson.ПрочитатьОбъект(JSONДанные.ОткрытьПотокЧтения())

    пер Контекст = новый КонтекстДесериализации(БуферПриложения, ЧислоМаркеров)
    возврат ВосстановитьЗначениеИзJSONJanx(ДеревоJSON, Контекст)
    
;

метод НормализоватьОбъектJanx(Данные: Объект, МассивДвоичных: Массив<Байты>, Смещение: Число): Объект
    
    если Данные это ЧитаемаяКоллекция<КлючИЗначение<Объект, Объект?>>
        
        для Элемент из (Данные как ЧитаемаяКоллекция<КлючИЗначение<Объект, Объект?>>)
            НормализоватьОбъектJanx(Элемент.Значение, МассивДвоичных, Смещение)    
        ;
        
    иначе если Данные это ЧитаемаяКоллекция<Объект?>

        для Элемент из (Данные как ЧитаемаяКоллекция<Объект?>)
            НормализоватьОбъектJanx(Элемент, МассивДвоичных, Смещение)    
        ;
                
    иначе если Данные это Байты
        
        Данные = СоздатьМаркерБинарныхJanx(Данные как Байты, МассивДвоичных, Смещение) 
        
    ;
    
    возврат Данные
    
;

метод СоздатьМаркерБинарныхJanx(ДвоичныеДанные: Байты, МассивДвоичных: Массив<Байты>, Смещение: Число): Объект

    пер Длина  = ДвоичныеДанные.Длина()
    пер Начало = Смещение
    пер КлючМаркера = КлючМаркераБинарныхJanx()
    
    МассивДвоичных.Добавить(ДвоичныеДанные)
    Смещение = Смещение + Длина
    
    пер Маркер = {"%КлючМаркера": {"s": Начало, "l": Длина}} 
    возврат Маркер
    
;

метод ВосстановитьЗначениеИзJSONJanx(Данные: Объект, Контекст: КонтекстДесериализации): Объект

    если НужноИскатьМаркерJanx(Данные, Контекст)

        пер ЗначениеМаркера = ПопытатьсяПолучитьМаркерJanx(Данные)
        
        если ЗначениеМаркера != Неопределено
            возврат ИзвлечьБинарныеПоМаркеруJanx(ЗначениеМаркера, Контекст)
        ;

    ;
            
    если Данные это ЧитаемаяКоллекция<Объект?>

        пер Результат: Массив<Объект?>
        
        для Элемент из (Данные как ЧитаемаяКоллекция<Объект?>)
            Результат.Добавить(ВосстановитьЗначениеИзJSONJanx(Элемент, Контекст))
        ;
        
        возврат Результат
                
    иначе если Данные это ЧитаемаяКоллекция<КлючИЗначение<Объект, Объект?>>
        
        пер Результат: Соответствие<Объект, Объект?>
        
        для Пара из (Данные как ЧитаемаяКоллекция<КлючИЗначение<Объект, Объект?>>)
            пер ВосстановленноеЗначение = ВосстановитьЗначениеИзJSONJanx(Пара.Значение, Контекст)
            Результат.Вставить(Пара.Ключ, ВосстановленноеЗначение)
        ;
        
        возврат Результат
        
    иначе
        возврат Данные
    ;
    
;

метод НужноИскатьМаркерJanx(Данные: Объект, Контекст: КонтекстДесериализации): Булево

    если Контекст.МаркеровВосстановлено == Контекст.МаркеровВсего
        возврат Ложь
    ;

    возврат Данные это ЧитаемаяКоллекция<КлючИЗначение<Объект, Объект?>>
        
;

метод ПопытатьсяПолучитьМаркерJanx(Данные: Объект): Объект?
    пер ЗначениеМаркера: Объект? = (Данные как Соответствие<Объект, Объект?>).Получить(КлючМаркераБинарныхJanx())
    возврат ЗначениеМаркера 
;

метод ИзвлечьБинарныеПоМаркеруJanx(Описание: Объект, Контекст: КонтекстДесериализации): Байты

    пер Начало = (Описание как Соответствие<Объект, Объект?>)["s"] как Число
    пер Длина  = (Описание как Соответствие<Объект, Объект?>)["l"] как Число
    пер Результат: Байты

    если Длина == 0
        Результат = Байты{}
    иначе
        Результат = Контекст.БуферПриложения.ПолучитьДиапазон(Начало, Начало + Длина)
    ;

    Контекст.МаркеровВосстановлено = Контекст.МаркеровВосстановлено + 1

    возврат Результат

;

метод КлючМаркераБинарныхJanx(): Строка
    возврат "__JANXB__"        
;

метод ВерсияФорматаJanx(): Число
    возврат 1
;

метод РазмерПрефиксаJanx(): Число
    возврат 2
;

метод РазмерЗаголовкаJanx(): Число
    пер Постфикс = 8
    возврат РазмерПрефиксаJanx() + Постфикс
;