    @Глобально
    // Метод ПолучитьСписокВнешнихФайлов
    // Получает список внешних файлов пользователя или канала
    //
    // Токен  - Строка: Токен бота
    // Канал  - Строка: Канал для отбора (необяз. по ум. - Пустое значение)
    // Курсор - Строка: Указатель из предыдущего запроса, если строк результата > 100 (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокВнешнихФайлов(Токен: Объект?, Канал: Объект? = Неопределено, Курсор: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Канал)
        Опции.Вставить("-r", Курсор)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокВнешнихФайлов", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьВнешнийФайл
    // Получает информацию о внешнем файле
