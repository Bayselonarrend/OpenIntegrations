    ;

    @Глобально
    // Метод СформироватьБлокКартинку
    // Формирует блок с картинкой для добавления в массив блоков сообщения
    //
    // URL                 - Строка: URL картинки
    // АльтернативныйТекст - Строка: Альтернативный текст картинки (необяз. по ум. - Пустое значение)
    метод СформироватьБлокКартинку(URL: Объект?, АльтернативныйТекст: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-p", URL)
        Опции.Вставить("-a", АльтернативныйТекст)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СформироватьБлокКартинку", Опции)
        
    ;
    
;