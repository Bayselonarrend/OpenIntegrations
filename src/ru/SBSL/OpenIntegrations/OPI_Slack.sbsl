#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_Slack
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_Slack(Исполнитель)
    
;

@Локально
структура OPI_Slack
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "slack"
    
    @Глобально
    // Метод ПолучитьИнформациюОБоте
    // Получает основную информацию о боте
    //
    // Токен - Строка: Токен бота
    метод ПолучитьИнформациюОБоте(Токен: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьИнформациюОБоте", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокРабочихОбластей
    // Получает список рабочих областей, в которых подключен бот
    //
    // Токен  - Строка: Токен бота
    // Курсор - Строка: Указатель из предыдущего запроса, если строк результата > 100 (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокРабочихОбластей(Токен: Объект?, Курсор: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Курсор)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокРабочихОбластей", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокПользователей
    // Получает список пользователей рабочей области
    //
    // Токен  - Строка: Токен бота
    // Курсор - Строка: Указатель из предыдущего запроса, если строк результата > 100 (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокПользователей(Токен: Объект?, Курсор: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Курсор)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокПользователей", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьСообщение
    // Отправляет сообщение в выбранный час
    //
    // Токен        - Строка: Токен бота
    // Канал        - Строка: Идентификатор канала
    // Текст        - Строка: Текст сообщения (необяз. по ум. - Пустое значение)
    // ДатаОтправки - Дата: Дата отправки для отложенного сообщения (необяз. по ум. - Пустое значение)
    // Блоки        - Массив Из Структура: Массив описаний блоков (необяз. по ум. - Пустое значение)
    метод ОтправитьСообщение(Токен: Объект?, Канал: Объект?, Текст: Объект? = Неопределено, ДатаОтправки: Объект? = Неопределено, Блоки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Канал)
        Опции.Вставить("-x", Текст)
        Опции.Вставить("-d", ДатаОтправки)
        Опции.Вставить("-b", Блоки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьСообщение", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьЭфемерноеСообщение
    // Отправляет сообщение, которое приходит в канал, но видно
    //
    // Токен        - Строка: Токен бота
    // Канал        - Строка: Идентификатор канала
    // Текст        - Строка: Текст сообщения (необяз. по ум. - Пустое значение)
    // Пользователь - Строка: ID пользователя (необяз. по ум. - Пустое значение)
    // Блоки        - Массив Из Структура: Массив описаний блоков (необяз. по ум. - Пустое значение)
    метод ОтправитьЭфемерноеСообщение(Токен: Объект?, Канал: Объект?, Текст: Объект? = Неопределено, Пользователь: Объект? = Неопределено, Блоки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Канал)
        Опции.Вставить("-x", Текст)
        Опции.Вставить("-u", Пользователь)
        Опции.Вставить("-b", Блоки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьЭфемерноеСообщение", Опции)
        
    ;

    @Глобально
    // Метод ИзменитьСообщение
    // Изменяет состав существующего сообщения
    //
    // Токен        - Строка: Токен бота
    // Канал        - Строка: Идентификатор канала
    // Отметка      - Строка: Временная отметка сообщения
    // Текст        - Строка: Новый текст сообщения (необяз. по ум. - Пустое значение)
    // МассивБлоков - Массив Из Структура: Массив описаний блоков (необяз. по ум. - Пустое значение)
    метод ИзменитьСообщение(Токен: Объект?, Канал: Объект?, Отметка: Объект?, Текст: Объект? = Неопределено, МассивБлоков: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Канал)
        Опции.Вставить("-s", Отметка)
        Опции.Вставить("-x", Текст)
        Опции.Вставить("-b", МассивБлоков)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьСообщение", Опции)
        
    ;

    @Глобально
    // Метод УдалитьСообщение
    // Удаляет сообщение канала по timestamp
    //
    // Токен         - Строка: Токен бота
    // Канал         - Строка: Идентификатор канала
    // Отметка       - Строка: Временная отметка или ID сообщения
    // ЭтоОтложенное - Булево: Признак удаления отложенного сообщения (необяз. по ум. - false)
    метод УдалитьСообщение(Токен: Объект?, Канал: Объект?, Отметка: Объект?, ЭтоОтложенное: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Канал)
        Опции.Вставить("-s", Отметка)
        Опции.Вставить("-i", ЭтоОтложенное)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьСообщение", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокОтложенныхСообщений
    // Получает список отложенных сообщений канала
    //
    // Токен  - Строка: Токен бота
    // Канал  - Строка: Идентификатор канала
    // Курсор - Строка: Указатель из предыдущего запроса, если строк результата > 100 (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокОтложенныхСообщений(Токен: Объект?, Канал: Объект?, Курсор: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Канал)
        Опции.Вставить("-r", Курсор)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокОтложенныхСообщений", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСсылкуНаСообщение
    // Получает постоянный UTL к сообщению канала
    //
    // Токен   - Строка: Токен бота
    // Канал   - Строка: Идентификатор канала
    // Отметка - Строка: Временная отметка или ID сообщения
    метод ПолучитьСсылкуНаСообщение(Токен: Объект?, Канал: Объект?, Отметка: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Канал)
        Опции.Вставить("-s", Отметка)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСсылкуНаСообщение", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокОтветовНаСообщение
    // Получает массив сообщений, которые являются ответом на указанное
    //
    // Токен   - Строка: Токен бота
    // Канал   - Строка: Идентификатор канала
    // Отметка - Строка: Временная отметка или ID сообщения
    // Курсор  - Строка: Указатель из предыдущего запроса, если строк результата > 100 (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокОтветовНаСообщение(Токен: Объект?, Канал: Объект?, Отметка: Объект?, Курсор: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Канал)
        Опции.Вставить("-s", Отметка)
        Опции.Вставить("-r", Курсор)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокОтветовНаСообщение", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокКаналов
    // Получает список доступных каналов
    //
    // Токен                   - Строка: Токен бота
    // ИсключатьАрхивированные - Булево: Признак исключения архивированных каналов (необяз. по ум. - false)
    // Курсор                  - Строка: Указатель из предыдущего запроса, если строк результата > 100 (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокКаналов(Токен: Объект?, ИсключатьАрхивированные: Объект? = Неопределено, Курсор: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-n", ИсключатьАрхивированные)
        Опции.Вставить("-c", Курсор)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокКаналов", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокПользователейКанала
    // Получает список пользователей указанного канала
    //
    // Токен  - Строка: Токен бота
    // Канал  - Строка: Идентификатор канала
    // Курсор - Строка: Указатель из предыдущего запроса, если строк результата > 100 (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокПользователейКанала(Токен: Объект?, Канал: Объект?, Курсор: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Канал)
        Опции.Вставить("-r", Курсор)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокПользователейКанала", Опции)
        
    ;

    @Глобально
    // Метод СоздатьКанал
    // Создает новый канал
    //
    // Токен     - Строка: Токен бота
    // Название  - Строка: Наименование канала
    // Приватный - Булево: Создать канал приватным (необяз. по ум. - false)
    метод СоздатьКанал(Токен: Объект?, Название: Объект?, Приватный: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-l", Название)
        Опции.Вставить("-p", Приватный)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьКанал", Опции)
        
    ;

    @Глобально
    // Метод АрхивироватьКанал
    // Архивирует активный канал
    //
    // Токен - Строка: Токен бота
    // Канал - Строка: ID канала
    метод АрхивироватьКанал(Токен: Объект?, Канал: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Канал)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "АрхивироватьКанал", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьКанал
    // Получает информацию о канале
    //
    // Токен - Строка: Токен бота
    // Канал - Строка: ID канала
    метод ПолучитьКанал(Токен: Объект?, Канал: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Канал)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьКанал", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьИсториюКанала
    // Получает информацию событиях канала
    //
    // Токен - Строка: Токен бота
    // Канал - Строка: ID канала
    метод ПолучитьИсториюКанала(Токен: Объект?, Канал: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Канал)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьИсториюКанала", Опции)
        
    ;

    @Глобально
    // Метод ПригласитьПользователейВКанал
    // Добавляет указанных пользователей в канал
    //
    // Токен               - Строка: Токен бота
    // Канал               - Строка: ID канала
    // МассивПользователей - Массив Из Строка: Массив ID пользователей
    метод ПригласитьПользователейВКанал(Токен: Объект?, Канал: Объект?, МассивПользователей: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Канал)
        Опции.Вставить("-u", МассивПользователей)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПригласитьПользователейВКанал", Опции)
        
    ;

    @Глобально
    // Метод ВыгнатьПользователяИзКанала
    // Удаляет указанного пользователя из канала
    //
    // Токен        - Строка: Токен бота
    // Канал        - Строка: ID канала
    // Пользователь - Строка: ID пользователя
    метод ВыгнатьПользователяИзКанала(Токен: Объект?, Канал: Объект?, Пользователь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Канал)
        Опции.Вставить("-u", Пользователь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВыгнатьПользователяИзКанала", Опции)
        
    ;

    @Глобально
    // Метод ВступитьВКанал
    // Добавляет текущего бота в канал
    //
    // Токен - Строка: Токен бота
    // Канал - Строка: ID канала
    метод ВступитьВКанал(Токен: Объект?, Канал: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Канал)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВступитьВКанал", Опции)
        
    ;

    @Глобально
    // Метод ПокинутьКанал
    // Удаляет текущего бота из канала
    //
    // Токен - Строка: Токен бота
    // Канал - Строка: ID канала
    метод ПокинутьКанал(Токен: Объект?, Канал: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Канал)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПокинутьКанал", Опции)
        
    ;

    @Глобально
    // Метод УстановитьТемуКанала
    // Устанавливает тему канала
    //
    // Токен - Строка: Токен бота
    // Канал - Строка: ID канала
    // Тема  - Строка: Тема канала
    метод УстановитьТемуКанала(Токен: Объект?, Канал: Объект?, Тема: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Канал)
        Опции.Вставить("-h", Тема)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УстановитьТемуКанала", Опции)
        
    ;

    @Глобально
    // Метод УстановитьЦельКанала
    // Устанавливает цель (описание) канала
    //
    // Токен - Строка: Токен бота
    // Канал - Строка: ID канала
    // Цель  - Строка: Цель канала
    метод УстановитьЦельКанала(Токен: Объект?, Канал: Объект?, Цель: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Канал)
        Опции.Вставить("-p", Цель)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УстановитьЦельКанала", Опции)
        
    ;

    @Глобально
    // Метод ПереименоватьКанал
    // Изменяет название канала
    //
    // Токен    - Строка: Токен бота
    // Канал    - Строка: ID канала
    // Название - Строка: Новое название канала
    метод ПереименоватьКанал(Токен: Объект?, Канал: Объект?, Название: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Канал)
        Опции.Вставить("-l", Название)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПереименоватьКанал", Опции)
        
    ;

    @Глобально
    // Метод ОткрытьДиалог
    // Открывает новый диалог с одним или несколькими пользователями
    //
    // Токен               - Строка: Токен бота
    // МассивПользователей - Массив из Строка: Массив ID пользователей
    метод ОткрытьДиалог(Токен: Объект?, МассивПользователей: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-u", МассивПользователей)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОткрытьДиалог", Опции)
        
    ;

    @Глобально
    // Метод ЗакрытьДиалог
    // Закрывает существующий диалог
    //
    // Токен  - Строка: Токен бота
    // Диалог - Строка: ID диалога
    метод ЗакрытьДиалог(Токен: Объект?, Диалог: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Диалог)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗакрытьДиалог", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокФайлов
    // Получает список файлов бота или канала
    //
    // Токен         - Строка: Токен бота
    // Канал         - Строка: Канал для отбора (необяз. по ум. - Пустое значение)
    // НомерСтраницы - Число, Строка: Номер страницы (необяз. по ум. - 1)
    метод ПолучитьСписокФайлов(Токен: Объект?, Канал: Объект? = Неопределено, НомерСтраницы: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", Канал)
        Опции.Вставить("-p", НомерСтраницы)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокФайлов", Опции)
        
    ;

    @Глобально
    // Метод ЗагрузитьФайл
    // Загружает файл на сервера Slack
    //
    // Токен     - Строка: Токен бота
    // Файл      - Строка, ДвоичныеДанные: Файл для загрузки
    // ИмяФайла  - Строка: Имя файла с расширением
    // Заголовок - Строка: Имя файла в Slack
    // Канал     - Строка: ID канала (необяз. по ум. - Пустое значение)
    метод ЗагрузитьФайл(Токен: Объект?, Файл: Объект?, ИмяФайла: Объект?, Заголовок: Объект?, Канал: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", Файл)
        Опции.Вставить("-l", ИмяФайла)
        Опции.Вставить("-i", Заголовок)
        Опции.Вставить("-c", Канал)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗагрузитьФайл", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьДанныеФайла
    // Получает информацию о файле
