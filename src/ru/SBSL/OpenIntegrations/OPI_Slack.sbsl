        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", ИдентификаторФайла)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьВнешнийФайл", Опции)
        
    ;

    @Глобально
    // Метод ДобавитьВнешнийФайл
    // Добавляет новый внешний файл
    //
    // Токен     - Строка: Токен бота
    // URL       - Строка: URL к внешнему файлу
    // Заголовок - Строка: Заголовок файла для Slack
    метод ДобавитьВнешнийФайл(Токен: Объект?, URL: Объект?, Заголовок: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-u", URL)
        Опции.Вставить("-l", Заголовок)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ДобавитьВнешнийФайл", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьВнешнийФайл
    // Отправляет внешний файл по списку каналов
    //
    // Токен              - Строка: Токен бота
    // ИдентификаторФайла - Строка: Идентификатор файла
    // МассивКаналов      - Массив Из Строка: Массив каналов для отправки
    метод ОтправитьВнешнийФайл(Токен: Объект?, ИдентификаторФайла: Объект?, МассивКаналов: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", ИдентификаторФайла)
        Опции.Вставить("-c", МассивКаналов)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьВнешнийФайл", Опции)
        
    ;

