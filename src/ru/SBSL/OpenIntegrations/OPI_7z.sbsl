#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_7z
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_7z(Исполнитель)
    
;

@Локально
структура OPI_7z
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "7z"
    
    @Глобально
    // Метод АрхивироватьКаталог
    // Запаковывает файлы указанного каталога в архив
    //
    // Каталог    - Строка, Соответствие Из КлючИЗначение: Путь к каталогу или описание. См. ПолучитьСтруктуруОписанияАрхива
    // ПутьАрхива - Строка: Путь сохранения архива. В двоичные данные, если не заполнено (необяз. по ум. - Пустое значение)
    // Настройки  - Соответствие Из КлючИЗначение: Доп. настройки. См. ПолучитьСтруктуруНастроекАрхивации (необяз. по ум. - Пустое значение)
    метод АрхивироватьКаталог(Каталог: Объект?, ПутьАрхива: Объект? = Неопределено, Настройки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Каталог)
        Опции.Вставить("-d", ПутьАрхива)
        Опции.Вставить("-t", Настройки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "АрхивироватьКаталог", Опции)
        
    ;

    @Глобально
    // Метод РазархивироватьКаталог
    // Распаковывает 7z-архив в указанный каталог
    //
    // Архив             - Строка, ДвоичныеДанные: Путь к архиву на диске или двоичные данные
    // КаталогНазначения - Строка: Путь каталога для распаковки. В соответствие, если не заполнено (необяз. по ум. - Пустое значение)
    // Пароль            - Строка: Пароль архива, если требуется (необяз. по ум. - Пустое значение)
    метод РазархивироватьКаталог(Архив: Объект?, КаталогНазначения: Объект? = Неопределено, Пароль: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Архив)
        Опции.Вставить("-d", КаталогНазначения)
        Опции.Вставить("-p", Пароль)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "РазархивироватьКаталог", Опции)
        
    ;

    @Глобально
    // Метод РазархивироватьФайлы
    // Распаковывает выбранные файлы из 7z-архива по списку путей
    //
    // Архив             - Строка, ДвоичныеДанные: Путь к архиву на диске или двоичные данные
    // Пути              - Массив Из Строка: Полные пути файлов внутри архива
    // КаталогНазначения - Строка: Путь каталога для распаковки. В соответствие, если не заполнено (необяз. по ум. - Пустое значение)
    // Пароль            - Строка: Пароль архива, если требуется (необяз. по ум. - Пустое значение)
    метод РазархивироватьФайлы(Архив: Объект?, Пути: Объект?, КаталогНазначения: Объект? = Неопределено, Пароль: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Архив)
        Опции.Вставить("-p", Пути)
        Опции.Вставить("-d", КаталогНазначения)
        Опции.Вставить("-w", Пароль)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "РазархивироватьФайлы", Опции)
        
    ;

    @Глобально
    // Метод ИзменитьАрхив
    // Добавляет, заменяет и удаляет файлы в существующем 7z-архиве
    //
    // Архив            - Строка, ДвоичныеДанные: Путь к архиву на диске или двоичные данные
    // ДобавляемыеФайлы - Соответствие Из КлючИЗначение: Ключ: путь в архиве; значение: путь к файлу или двоичные данные (необяз. по ум. - Пустое значение)
    // УдаляемыеПути    - Массив Из Строка: Пути файлов в архиве для удаления (необяз. по ум. - Пустое значение)
    // Настройки        - Соответствие Из КлючИЗначение: Настройки изменения. См. ПолучитьСтруктуруИзмененияАрхива (необяз. по ум. - Пустое значение)
    метод ИзменитьАрхив(Архив: Объект?, ДобавляемыеФайлы: Объект? = Неопределено, УдаляемыеПути: Объект? = Неопределено, Настройки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Архив)
        Опции.Вставить("-a", ДобавляемыеФайлы)
        Опции.Вставить("-d", УдаляемыеПути)
        Опции.Вставить("-t", Настройки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьАрхив", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтруктуруИзмененияАрхива
    // Получает структуру настроек изменения архива: пароли распаковки и запаковки и параметры сжатия
    //
    // Пустая          - Булево: Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей (необяз. по ум. - false)
    // КакСоответствие - Булево: Истина > возвращает поля как соответствие (необяз. по ум. - false)
    метод ПолучитьСтруктуруИзмененияАрхива(Пустая: Объект? = Неопределено, КакСоответствие: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        Опции.Вставить("-m", КакСоответствие)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруИзмененияАрхива", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтруктуруНастроекАрхивации
    // Получает структуру с дополнительными настройками архивации данных
    //
    // Пустая          - Булево: Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей (необяз. по ум. - false)
    // КакСоответствие - Булево: Истина > возвращает поля фильтра как соответствие (необяз. по ум. - false)
    метод ПолучитьСтруктуруНастроекАрхивации(Пустая: Объект? = Неопределено, КакСоответствие: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        Опции.Вставить("-m", КакСоответствие)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруНастроекАрхивации", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтруктуруОписанияАрхива
    // Получает пример структуры описания данных для запаковки без каталога на диске
    //
    // Пустая          - Булево: Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей (необяз. по ум. - false)
    // КакСоответствие - Булево: Истина > возвращает поля как соответствие (необяз. по ум. - false)
    метод ПолучитьСтруктуруОписанияАрхива(Пустая: Объект? = Неопределено, КакСоответствие: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        Опции.Вставить("-m", КакСоответствие)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруОписанияАрхива", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокФайлов
    // Получает иерархический список файлов и каталогов архива
    //
    // Архив  - Строка, ДвоичныеДанные: Путь к архиву на диске или двоичные данные
    // Пароль - Строка: Пароль архива, если требуется (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокФайлов(Архив: Объект?, Пароль: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Архив)
        Опции.Вставить("-p", Пароль)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокФайлов", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьМетаданные
    // Получает метаданные и плоский список файлов архива
    //
    // Архив  - Строка, ДвоичныеДанные: Путь к архиву на диске или двоичные данные
    // Пароль - Строка: Пароль архива, если требуется (необяз. по ум. - Пустое значение)
    метод ПолучитьМетаданные(Архив: Объект?, Пароль: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Архив)
        Опции.Вставить("-p", Пароль)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьМетаданные", Опции)
        
    ;
    
;