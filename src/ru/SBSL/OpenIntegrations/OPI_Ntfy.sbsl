#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Строка?|Executor.НастройкиИнтеграции): OPI_Ntfy
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(Конфигурация)
    возврат новый OPI_Ntfy(Исполнитель)
    
;

@Локально
структура OPI_Ntfy
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "ntfy"
    
    @Глобально
    метод ПолучитьСтруктуруПараметровСообщения(Пустая: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруПараметровСообщения", Опции)
        
    ;

    @Глобально
    метод ОтправитьСообщение(URL: Объект?, Топик: Объект?, Сообщение: Объект?, Токен: Объект? = Неопределено, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Топик)
        Опции.Вставить("-m", Сообщение)
        Опции.Вставить("-k", Токен)
        Опции.Вставить("-o", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьСообщение", Опции)
        
    ;

    @Глобально
    метод ПолучитьСтруктуруПараметровФильтра(Пустая: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруПараметровФильтра", Опции)
        
    ;

    @Глобально
    метод ПолучитьСообщения(URL: Объект?, Топик: Объект?, Токен: Объект? = Неопределено, Фильтр: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Топик)
        Опции.Вставить("-k", Токен)
        Опции.Вставить("-f", Фильтр)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСообщения", Опции)
        
    ;

    @Глобально
    метод УдалитьСообщение(URL: Объект?, Топик: Объект?, IDСообщения: Объект?, Токен: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Топик)
        Опции.Вставить("-i", IDСообщения)
        Опции.Вставить("-k", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьСообщение", Опции)
        
    ;
    
;