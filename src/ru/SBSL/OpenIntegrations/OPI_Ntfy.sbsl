#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_Ntfy
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_Ntfy(Исполнитель)
    
;

@Локально
структура OPI_Ntfy
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "ntfy"
    
    @Глобально
    // Метод ПолучитьСтруктуруПараметровСообщения
    // Получает структуру дополнительных параметров для отправки уведомления
    //
    // Пустая - Булево: Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей (необяз. по ум. - false)
    метод ПолучитьСтруктуруПараметровСообщения(Пустая: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруПараметровСообщения", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьСообщение
    // Публикует уведомление в указанный топик
    //
    // URL       - Строка: URL сервера Ntfy. `ntfy.sh`, если не заполнено
    // Топик     - Строка: Имя топика
    // Сообщение - Строка: Текст уведомления
    // Токен     - Строка: Токен доступа к топику, если требуется (необяз. по ум. - Пустое значение)
    // Параметры - Структура Из КлючИЗначение: Доп. параметры. См. ПолучитьСтруктуруПараметровСообщения (необяз. по ум. - Пустое значение)
    метод ОтправитьСообщение(URL: Объект?, Топик: Объект?, Сообщение: Объект?, Токен: Объект? = Неопределено, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Топик)
        Опции.Вставить("-m", Сообщение)
        Опции.Вставить("-k", Токен)
        Опции.Вставить("-o", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьСообщение", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтруктуруПараметровФильтра
    // Получает структуру параметров для получения сообщений из топика
    //
    // Пустая - Булево: Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей (необяз. по ум. - false)
    метод ПолучитьСтруктуруПараметровФильтра(Пустая: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруПараметровФильтра", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСообщения
    // Получает сообщения из топика в формате JSON
    //
    // URL    - Строка: URL сервера Ntfy. `ntfy.sh`, если не заполнено
    // Топик  - Строка: Имя топика
    // Токен  - Строка: Токен доступа к топику, если требуется (необяз. по ум. - Пустое значение)
    // Фильтр - Структура Из КлючИЗначение: Параметры отбора. См. ПолучитьСтруктуруПараметровФильтра (необяз. по ум. - Пустое значение)
    метод ПолучитьСообщения(URL: Объект?, Топик: Объект?, Токен: Объект? = Неопределено, Фильтр: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Топик)
        Опции.Вставить("-k", Токен)
        Опции.Вставить("-f", Фильтр)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСообщения", Опции)
        
    ;

    @Глобально
    // Метод УдалитьСообщение
    // Удаляет сообщение из топика по ID
    //
    // URL         - Строка: URL сервера Ntfy. `ntfy.sh`, если не заполнено
    // Топик       - Строка: Имя топика
    // IDСообщения - Строка: ID удаляемого сообщения
    // Токен       - Строка: Токен доступа к топику (необяз. по ум. - Пустое значение)
    метод УдалитьСообщение(URL: Объект?, Топик: Объект?, IDСообщения: Объект?, Токен: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Топик)
        Опции.Вставить("-i", IDСообщения)
        Опции.Вставить("-k", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьСообщение", Опции)
        
    ;
    
;