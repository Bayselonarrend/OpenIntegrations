#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_YandexDisk
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_YandexDisk(Исполнитель)
    
;

@Локально
структура OPI_YandexDisk
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "yadisk"
    
    @Глобально
    // Метод ПолучитьКодПодтверждения
    // Получает код подтверждения и адрес страницы, на которой его необходимо ввести
    //
    // ClientId - Строка: Client id
    метод ПолучитьКодПодтверждения(ClientId: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-i", ClientId)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьКодПодтверждения", Опции)
        
    ;

    @Глобально
    // Метод ПреобразоватьКодВТокен
    // Преобразовывает код в токен после ввода кода при выполнении ПолучитьКодПодтверждения
    //
    // ClientId      - Строка: Client id
    // ClientSecret  - Строка: Client secret
    // КодУстройства - Строка: device_code из ПолучитьКодПодтверждения
    метод ПреобразоватьКодВТокен(ClientId: Объект?, ClientSecret: Объект?, КодУстройства: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-i", ClientId)
        Опции.Вставить("-s", ClientSecret)
        Опции.Вставить("-d", КодУстройства)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПреобразоватьКодВТокен", Опции)
        
    ;

    @Глобально
    // Метод ОбновитьТокен
    // Обновляет токен по Refresh token
    //
    // ClientId     - Строка: Client id
    // ClientSecret - Строка: Client secret
    // RefreshToken - Строка: Refresh token
    метод ОбновитьТокен(ClientId: Объект?, ClientSecret: Объект?, RefreshToken: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-i", ClientId)
        Опции.Вставить("-s", ClientSecret)
        Опции.Вставить("-r", RefreshToken)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОбновитьТокен", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьИнформациюОДиске
    // Получает информацию о текущем диске
    //
    // Токен - Строка: Токен
    метод ПолучитьИнформациюОДиске(Токен: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьИнформациюОДиске", Опции)
        
    ;

    @Глобально
    // Метод СоздатьПапку
    // Создает каталог на диске
    //
    // Токен - Строка: Токен
    // Путь  - Строка: Путь к создаваемой папке
    метод СоздатьПапку(Токен: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьПапку", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьОбъект
    // Получает информацию об объекте диска по заданному пути
    //
    // Токен - Строка: Токен
    // Путь  - Строка: Путь к папке или файлу
    метод ПолучитьОбъект(Токен: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьОбъект", Опции)
        
    ;

    @Глобально
    // Метод УдалитьОбъект
    // Удаляет объект по заданному пути
    //
    // Токен    - Строка: Токен
    // Путь     - Строка: Путь к удаляемой папке или файлу
    // ВКорзину - Булево: В корзину (необяз. по ум. - true)
    метод УдалитьОбъект(Токен: Объект?, Путь: Объект?, ВКорзину: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        Опции.Вставить("-c", ВКорзину)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьОбъект", Опции)
        
    ;

    @Глобально
    // Метод СоздатьКопиюОбъекта
    // Создает копию объекта по заданному пути и пути к оригиналу
    //
    // Токен          - Строка: Токен
    // Оригинал       - Строка: Путь к оригинальному файлу или каталогу
    // Путь           - Строка: Путь назначения для копии
    // Перезаписывать - Булево: Перезаписывать если файл с таким именем уже существует (необяз. по ум. - false)
    метод СоздатьКопиюОбъекта(Токен: Объект?, Оригинал: Объект?, Путь: Объект?, Перезаписывать: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", Оригинал)
        Опции.Вставить("-o", Путь)
        Опции.Вставить("-r", Перезаписывать)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьКопиюОбъекта", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСсылкуДляСкачивания
    // Получает ссылку для скачивания файла
    //
    // Токен - Строка: Токен
    // Путь  - Строка: Путь к файлу для скачивания
    метод ПолучитьСсылкуДляСкачивания(Токен: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСсылкуДляСкачивания", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСсылкуЗагрузкиФайла
    // Получает ссылку для ручной загрузки файла на Диск
    //
    // Токен          - Строка: Токен
    // Путь           - Строка: Путь для сохранение файла на Диске
    // Перезаписывать - Булево: Перезаписывать если файл с таким именем уже существует (необяз. по ум. - false)
    метод ПолучитьСсылкуЗагрузкиФайла(Токен: Объект?, Путь: Объект?, Перезаписывать: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        Опции.Вставить("-r", Перезаписывать)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСсылкуЗагрузкиФайла", Опции)
        
    ;

    @Глобально
    // Метод СкачатьФайл
    // Скачивает файл по указанному пути
    //
    // Токен          - Строка: Токен
    // Путь           - Строка: Путь к файлу для скачивания
    // ПутьСохранения - Строка: Путь сохранения файла (необяз. по ум. - Пустое значение)
    метод СкачатьФайл(Токен: Объект?, Путь: Объект?, ПутьСохранения: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        Опции.Вставить("", ПутьСохранения)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СкачатьФайл", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокФайлов
    // Получает список файлов с или без отбора по типу
    //
    // Токен             - Строка: Токен
    // Количество        - Число, Строка: Количество возвращаемых объектов (необяз. по ум. - Пустое значение)
    // СмещениеОтНачала  - Число: Смещение для получение объектов не из начала списка (необяз. по ум. - Пустое значение)
    // ОтборПоТипу       - Строка: Отбор по типу файла (необяз. по ум. - Пустое значение)
    // СортироватьПоДате - Булево: Истина > сортировать по дате, Ложь > по алфавиту (необяз. по ум. - false)
    метод ПолучитьСписокФайлов(Токен: Объект?, Количество: Объект? = Неопределено, СмещениеОтНачала: Объект? = Неопределено, ОтборПоТипу: Объект? = Неопределено, СортироватьПоДате: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-a", Количество)
        Опции.Вставить("-o", СмещениеОтНачала)
        Опции.Вставить("-p", ОтборПоТипу)
        Опции.Вставить("-d", СортироватьПоДате)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокФайлов", Опции)
        
    ;

    @Глобально
    // Метод ПереместитьОбъект
    // Перемещает объект по заданному пути и пути к оригиналу
    //
    // Токен          - Строка: Токен
    // Оригинал       - Строка: Путь к оригинальному файлу или папке
    // Путь           - Строка: Путь назначение для перемещения
    // Перезаписывать - Булево: Перезаписывать если файл с таким именем уже существует (необяз. по ум. - false)
    метод ПереместитьОбъект(Токен: Объект?, Оригинал: Объект?, Путь: Объект?, Перезаписывать: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", Оригинал)
        Опции.Вставить("-o", Путь)
        Опции.Вставить("-r", Перезаписывать)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПереместитьОбъект", Опции)
        
    ;

    @Глобально
    // Метод ЗагрузитьФайл
    // Загружает файл на диск по заданному пути
    //
    // Токен          - Строка: Токен
    // Путь           - Строка: Путь для сохранение файла на Диске
    // Файл           - Строка, ДвоичныеДанные: Файл для загрузки
    // Перезаписывать - Булево: Перезаписывать, если файл с таким именем уже существует (необяз. по ум. - false)
    метод ЗагрузитьФайл(Токен: Объект?, Путь: Объект?, Файл: Объект?, Перезаписывать: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        Опции.Вставить("-f", Файл)
        Опции.Вставить("-r", Перезаписывать)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗагрузитьФайл", Опции)
        
    ;

    @Глобально
    // Метод ЗагрузитьФайлЧастями
    // Загружает файл на диск по заданному пути частями
    //
    // Токен          - Строка: Токен
    // Путь           - Строка: Путь для сохранение файла на Диске
    // Файл           - Строка, ДвоичныеДанные: Файл для загрузки
    // РазмерЧасти    - Число: Размер одной части при загрузке (необяз. по ум. - 33554432)
    // Перезаписывать - Булево: Перезаписывать, если файл с таким именем уже существует (необяз. по ум. - false)
    метод ЗагрузитьФайлЧастями(Токен: Объект?, Путь: Объект?, Файл: Объект?, РазмерЧасти: Объект? = Неопределено, Перезаписывать: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        Опции.Вставить("-f", Файл)
        Опции.Вставить("-s", РазмерЧасти)
        Опции.Вставить("-r", Перезаписывать)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗагрузитьФайлЧастями", Опции)
        
    ;

    @Глобально
    // Метод ЗагрузитьФайлПоURL
    // Загружает файл на диск, забирая его по заданному URL
    //
    // Токен - Строка: Токен
    // Путь  - Строка: Путь помещения загруженного файла
    // Адрес - Строка: URL файла
    метод ЗагрузитьФайлПоURL(Токен: Объект?, Путь: Объект?, Адрес: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        Опции.Вставить("-u", Адрес)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗагрузитьФайлПоURL", Опции)
        
    ;

    @Глобально
    // Метод ОпубликоватьОбъект
    // Публикует объект диска в публичный доступ
    //
    // Токен - Строка: Токен
    // Путь  - Строка: Путь к публикуемому объекту
    метод ОпубликоватьОбъект(Токен: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОпубликоватьОбъект", Опции)
        
    ;

    @Глобально
    // Метод ОтменитьПубликациюОбъекта
    // Отменяет публикацию ранее опубликованного объекта
    //
    // Токен - Строка: Токен
    // Путь  - Строка: Путь к опубликованному ранее объекту
    метод ОтменитьПубликациюОбъекта(Токен: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтменитьПубликациюОбъекта", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокОпубликованныхОбъектов
    // Получает список опубликованных объектов
    //
    // Токен            - Строка: Токен
    // Количество       - Число: Количество возвращаемых объектов (необяз. по ум. - Пустое значение)
    // СмещениеОтНачала - Число: Смещение для получение объектов не из начала списка (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокОпубликованныхОбъектов(Токен: Объект?, Количество: Объект? = Неопределено, СмещениеОтНачала: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-a", Количество)
        Опции.Вставить("-o", СмещениеОтНачала)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокОпубликованныхОбъектов", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьПубличныйОбъект
    // Получает информацию об опубликованном объекте по его URL
    //
    // Токен            - Строка: Токен
    // URL              - Строка: Адрес объекта
    // Количество       - Число: Количество возвращаемых вложенных объектов (для каталога) (необяз. по ум. - Пустое значение)
    // СмещениеОтНачала - Число: Смещение для получение вложенных объектов не из начала списка (необяз. по ум. - Пустое значение)
    метод ПолучитьПубличныйОбъект(Токен: Объект?, URL: Объект?, Количество: Объект? = Неопределено, СмещениеОтНачала: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-u", URL)
        Опции.Вставить("-a", Количество)
        Опции.Вставить("-o", СмещениеОтНачала)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПубличныйОбъект", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСсылкуСкачиванияПубличногоОбъекта
    // Получает прямую ссылку для скачивания публичного объекта
    //
    // Токен - Строка: Токен
    // URL   - Строка: Адрес объекта
    // Путь  - Строка: Путь внутри объекта (необяз. по ум. - Пустое значение)
    метод ПолучитьСсылкуСкачиванияПубличногоОбъекта(Токен: Объект?, URL: Объект?, Путь: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-u", URL)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСсылкуСкачиванияПубличногоОбъекта", Опции)
        
    ;

    @Глобально
    // Метод СохранитьПубличныйОбъектНаДиск
    // Сохраняет публичный объект на ваш диск
    //
    // Токен  - Строка: Токен
    // URL    - Строка: Адрес объекта
    // Откуда - Строка: Путь внутри публичного каталога (только для папок) (необяз. по ум. - Пустое значение)
    // Куда   - Строка: Путь сохранения файла (необяз. по ум. - Пустое значение)
    метод СохранитьПубличныйОбъектНаДиск(Токен: Объект?, URL: Объект?, Откуда: Объект? = Неопределено, Куда: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-u", URL)
        Опции.Вставить("-f", Откуда)
        Опции.Вставить("-o", Куда)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СохранитьПубличныйОбъектНаДиск", Опции)
        
    ;
    
;