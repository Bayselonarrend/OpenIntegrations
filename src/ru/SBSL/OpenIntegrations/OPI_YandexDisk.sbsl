#совместимость 8.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Строка?|Executor.НастройкиИнтеграции): OPI_YandexDisk
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(Конфигурация)
    возврат новый OPI_YandexDisk(Исполнитель)
    
;

@Локально
структура OPI_YandexDisk
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "yadisk"
    
    @Глобально
    метод ПолучитьКодПодтверждения(ClientId: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-i", ClientId)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьКодПодтверждения", Опции)
        
    ;

    @Глобально
    метод ПреобразоватьКодВТокен(ClientId: Объект?, ClientSecret: Объект?, КодУстройства: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-i", ClientId)
        Опции.Вставить("-s", ClientSecret)
        Опции.Вставить("-d", КодУстройства)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПреобразоватьКодВТокен", Опции)
        
    ;

    @Глобально
    метод ОбновитьТокен(ClientId: Объект?, ClientSecret: Объект?, RefreshToken: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-i", ClientId)
        Опции.Вставить("-s", ClientSecret)
        Опции.Вставить("-r", RefreshToken)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОбновитьТокен", Опции)
        
    ;

    @Глобально
    метод ПолучитьИнформациюОДиске(Токен: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьИнформациюОДиске", Опции)
        
    ;

    @Глобально
    метод СоздатьПапку(Токен: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьПапку", Опции)
        
    ;

    @Глобально
    метод ПолучитьОбъект(Токен: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
