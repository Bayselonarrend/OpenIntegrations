        Опции.Вставить("-a", Количество)
        Опции.Вставить("-o", СмещениеОтНачала)
        Опции.Вставить("-p", ОтборПоТипу)
        Опции.Вставить("-d", СортироватьПоДате)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокФайлов", Опции)
        
    ;

