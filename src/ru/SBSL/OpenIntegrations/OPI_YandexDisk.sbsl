        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьОбъект", Опции)
        
    ;

    @Глобально
    метод УдалитьОбъект(Токен: Объект?, Путь: Объект?, ВКорзину: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        Опции.Вставить("-c", ВКорзину)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьОбъект", Опции)
        
    ;

    @Глобально
    метод СоздатьКопиюОбъекта(Токен: Объект?, Оригинал: Объект?, Путь: Объект?, Перезаписывать: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", Оригинал)
        Опции.Вставить("-o", Путь)
        Опции.Вставить("-r", Перезаписывать)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьКопиюОбъекта", Опции)
        
    ;

    @Глобально
