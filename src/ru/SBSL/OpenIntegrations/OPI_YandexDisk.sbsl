    @Глобально
    метод СкачатьФайл(Токен: Объект?, Путь: Объект?, ПутьСохранения: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        Опции.Вставить("", ПутьСохранения)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СкачатьФайл", Опции)
        
    ;

    @Глобально
    метод ПолучитьСписокФайлов(Токен: Объект?, Количество: Объект? = Неопределено, СмещениеОтНачала: Объект? = Неопределено, ОтборПоТипу: Объект? = Неопределено, СортироватьПоДате: Объект? = Неопределено): Объект?
        
