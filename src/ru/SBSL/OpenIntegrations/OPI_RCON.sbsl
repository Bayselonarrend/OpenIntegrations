#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_RCON
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_RCON(Исполнитель)
    
;

@Локально
структура OPI_RCON
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "rcon"
    
    @Глобально
    // Метод ВыполнитьКоманду
    // Выполняет команду на сервере
    //
    // Команда    - Строка: Текст команды
    // Соединение - Произвольный, Структура Из КлючИЗначение: Соединение или параметры соединения
    метод ВыполнитьКоманду(Команда: Объект?, Соединение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Команда)
        Опции.Вставить("-c", Соединение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВыполнитьКоманду", Опции)
        
    ;

    @Глобально
    // Метод СформироватьПараметрыСоединения
    // Формирует коллекцию параметров соединения
    //
    // URL           - Строка: URL сервера
    // Пароль        - Строка: Пароль для подключения
    // ТаймаутЧтения - Число: Таймаут ожидания ответа (в секундах) (необяз. по ум. - 30)
    // ТаймаутЗаписи - Число: Таймаут ожидания отправки запроса (в секундах) (необяз. по ум. - 30)
    метод СформироватьПараметрыСоединения(URL: Объект?, Пароль: Объект?, ТаймаутЧтения: Объект? = Неопределено, ТаймаутЗаписи: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-p", Пароль)
        Опции.Вставить("-r", ТаймаутЧтения)
        Опции.Вставить("-w", ТаймаутЗаписи)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СформироватьПараметрыСоединения", Опции)
        
    ;
    
;