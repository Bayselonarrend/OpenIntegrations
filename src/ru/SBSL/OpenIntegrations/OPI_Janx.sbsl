#требуется ./internal/OPI.sbsl

@Глобально
метод Инициализировать(Конфигурация: OPI.НастройкиИнтеграцииStdio | OPI.НастройкиИнтеграцииHttp? = Неопределено): OPI_Janx
    
    пер Исполнитель = OPI.АбстрактныйИсполнитель.Инициализировать(Конфигурация)
    возврат новый OPI_Janx(Исполнитель)
    
;

@Глобально
метод ЧерезStdio(ПутьOint: Строка): OPI_Janx

    пер Исполнитель = OPI.АбстрактныйИсполнитель.ЧерезStdio(ПутьOint)
    возврат новый OPI_Janx(Исполнитель)
    
;

@Глобально
метод ЧерезHttp(HttpКлиент: КлиентHttp): OPI_Janx

    пер Исполнитель = OPI.АбстрактныйИсполнитель.ЧерезHttp(HttpКлиент)
    возврат новый OPI_Janx(Исполнитель)

;

@Локально
структура OPI_Janx
    
    обз знч Исполнитель: OPI.АбстрактныйИсполнитель
    
    знч КомандаCLI: Строка = "janx"
    
    @Глобально
    метод СериализоватьДанные(Данные: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-v", Данные)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СериализоватьДанные", Опции)
        
    ;

    @Глобально
    метод ДесериализоватьДанные(Данные: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Данные)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ДесериализоватьДанные", Опции)
        
    ;
    
;