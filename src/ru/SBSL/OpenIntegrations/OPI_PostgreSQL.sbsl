#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_PostgreSQL
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_PostgreSQL(Исполнитель)
    
;

@Локально
структура OPI_PostgreSQL
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "postgres"
    
    @Глобально
    // Метод ВыполнитьЗапросSQL
    // Выполняет произвольный SQL запрос
    //
    // ТекстЗапроса         - Строка: Текст запроса к базе
    // Параметры            - Массив Из Произвольный: Массив позиционных параметров запроса (необяз. по ум. - Пустое значение)
    // ФорсироватьРезультат - Булево: Включает попытку получения результата, даже для не SELECT запросов (необяз. по ум. - false)
    // Соединение           - Строка, Произвольный: Соединение или строка подключения (необяз. по ум. - Пустое значение)
    // Tls                  - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    метод ВыполнитьЗапросSQL(ТекстЗапроса: Объект?, Параметры: Объект? = Неопределено, ФорсироватьРезультат: Объект? = Неопределено, Соединение: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", ТекстЗапроса)
        Опции.Вставить("-p", Параметры)
        Опции.Вставить("-f", ФорсироватьРезультат)
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-t", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВыполнитьЗапросSQL", Опции)
        
    ;

    @Глобально
    // Метод СформироватьСтрокуПодключения
    // Формирует строку подключения из переданных данных
    //
    // Адрес  - Строка: IP адрес или доменное имя сервера
    // База   - Строка: Имя базы данных для подключения
    // Логин  - Строка: Логин пользователя postgres
    // Пароль - Строка: Пароль пользователя postgres (необяз. по ум. - Пустое значение)
    // Порт   - Строка: Порт подключения (необяз. по ум. - 5432)
    метод СформироватьСтрокуПодключения(Адрес: Объект?, База: Объект?, Логин: Объект?, Пароль: Объект? = Неопределено, Порт: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Адрес)
        Опции.Вставить("-d", База)
        Опции.Вставить("-l", Логин)
        Опции.Вставить("-p", Пароль)
        Опции.Вставить("-r", Порт)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СформироватьСтрокуПодключения", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьНастройкиTls
    // Формирует настройки для использования TLS при выполнении запросов
    //
    // ОтключитьПроверкуСертификатов - Булево: Позволяет работать с некорректными сертификатами, в т.ч. самоподписанными
    // ПутьКСертификату              - Строка: Путь к корневому PEM файлу сертификата, если его нет в системном хранилище (необяз. по ум. - Пустое значение)
    метод ПолучитьНастройкиTls(ОтключитьПроверкуСертификатов: Объект?, ПутьКСертификату: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", ОтключитьПроверкуСертификатов)
        Опции.Вставить("-c", ПутьКСертификату)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиTls", Опции)
        
    ;

    @Глобально
    // Метод СоздатьБазуДанных
    // Создает базу данных с указанным именем
    //
    // База       - Строка: Имя базы
    // Соединение - Строка, Произвольный: Соединение или строка подключения (необяз. по ум. - Пустое значение)
    // Tls        - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    метод СоздатьБазуДанных(База: Объект?, Соединение: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-b", База)
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-t", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьБазуДанных", Опции)
        
    ;

    @Глобально
    // Метод УдалитьБазуДанных
    // Удаляет базу данных
    //
    // База       - Строка: Имя базы
    // Соединение - Строка, Произвольный: Соединение или строка подключения (необяз. по ум. - Пустое значение)
    // Tls        - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    метод УдалитьБазуДанных(База: Объект?, Соединение: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-b", База)
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-t", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьБазуДанных", Опции)
        
    ;

    @Глобально
    // Метод ОтключитьВсеСоединенияБазыДанных
    // Завершает все соединения к базе данных кроме текущего
    //
    // База       - Строка: Имя базы
    // Соединение - Строка, Произвольный: Соединение или строка подключения (необяз. по ум. - Пустое значение)
    // Tls        - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    метод ОтключитьВсеСоединенияБазыДанных(База: Объект?, Соединение: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-b", База)
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-t", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтключитьВсеСоединенияБазыДанных", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьИнформациюОТаблице
    // Получает информацию о таблице
    //
    // Таблица    - Строка: Имя таблицы
    // Соединение - Строка, Произвольный: Соединение или строка подключения (необяз. по ум. - Пустое значение)
    // Tls        - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    метод ПолучитьИнформациюОТаблице(Таблица: Объект?, Соединение: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Таблица)
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-l", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьИнформациюОТаблице", Опции)
        
    ;

    @Глобально
    // Метод СоздатьТаблицу
    // Создает пустую таблицу в базе
    //
    // Таблица          - Строка: Имя таблицы
    // СтруктураКолонок - Структура Из КлючИЗначение: Структура колонок: Ключ > имя, Значение > Тип данных
    // Соединение       - Строка, Произвольный: Соединение или строка подключения (необяз. по ум. - Пустое значение)
    // Tls              - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    метод СоздатьТаблицу(Таблица: Объект?, СтруктураКолонок: Объект?, Соединение: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Таблица)
        Опции.Вставить("-c", СтруктураКолонок)
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-l", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьТаблицу", Опции)
        
    ;

    @Глобально
    // Метод ДобавитьКолонкуТаблицы
    // Добавляет новую колонку в существующую таблицу
    //
    // Таблица    - Строка: Имя таблицы
    // Имя        - Строка: Имя колонки
    // ТипДанных  - Строка: Тип данных колонки
    // Соединение - Строка, Произвольный: Соединение или строка подключения (необяз. по ум. - Пустое значение)
    // Tls        - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    метод ДобавитьКолонкуТаблицы(Таблица: Объект?, Имя: Объект?, ТипДанных: Объект?, Соединение: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Таблица)
        Опции.Вставить("-n", Имя)
        Опции.Вставить("-p", ТипДанных)
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-l", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ДобавитьКолонкуТаблицы", Опции)
        
    ;

    @Глобально
    // Метод УдалитьКолонкуТаблицы
    // Удаляет колонку из таблицы
    //
    // Таблица    - Строка: Имя таблицы
    // Имя        - Строка: Имя колонки
    // Соединение - Строка, Произвольный: Соединение или строка подключения (необяз. по ум. - Пустое значение)
    // Tls        - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    метод УдалитьКолонкуТаблицы(Таблица: Объект?, Имя: Объект?, Соединение: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Таблица)
        Опции.Вставить("-n", Имя)
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-l", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьКолонкуТаблицы", Опции)
        
    ;

    @Глобально
    // Метод ГарантироватьТаблицу
    // Создает новую таблицу в случае отсутствия или обновляет состав колонок существующей таблицы
    //
    // Таблица          - Строка: Имя таблицы
    // СтруктураКолонок - Структура Из КлючИЗначение: Структура колонок: Ключ > имя, Значение > Тип данных
    // Соединение       - Строка, Произвольный: Существующее соединение или путь к базе (необяз. по ум. - Пустое значение)
    // Tls              - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    метод ГарантироватьТаблицу(Таблица: Объект?, СтруктураКолонок: Объект?, Соединение: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Таблица)
        Опции.Вставить("-c", СтруктураКолонок)
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-l", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ГарантироватьТаблицу", Опции)
        
    ;

    @Глобально
    // Метод ОчиститьТаблицу
    // Очищает таблицу базы
    //
    // Таблица    - Строка: Имя таблицы
    // Соединение - Строка, Произвольный: Соединение или строка подключения (необяз. по ум. - Пустое значение)
    // Tls        - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    метод ОчиститьТаблицу(Таблица: Объект?, Соединение: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Таблица)
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-l", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОчиститьТаблицу", Опции)
        
    ;

    @Глобально
    // Метод УдалитьТаблицу
    // Удаляет таблицу из базы
    //
    // Таблица    - Строка: Имя таблицы
    // Соединение - Строка, Произвольный: Соединение или строка подключения (необяз. по ум. - Пустое значение)
    // Tls        - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    метод УдалитьТаблицу(Таблица: Объект?, Соединение: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Таблица)
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-l", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьТаблицу", Опции)
        
    ;

    @Глобально
    // Метод ДобавитьЗаписи
    // Добавляет записи в таблицу
    //
    // Таблица      - Строка: Имя таблицы
    // МассивДанных - Массив Из Структура: Массив структур данных строк: Ключ > поле, Значение > значение поля
    // Транзакция   - Булево: Истина > добавление записей в транзакции с откатом при ошибке (необяз. по ум. - true)
    // Соединение   - Строка, Произвольный: Соединение или строка подключения (необяз. по ум. - Пустое значение)
    // Tls          - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    метод ДобавитьЗаписи(Таблица: Объект?, МассивДанных: Объект?, Транзакция: Объект? = Неопределено, Соединение: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Таблица)
        Опции.Вставить("-r", МассивДанных)
        Опции.Вставить("-n", Транзакция)
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-l", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ДобавитьЗаписи", Опции)
        
    ;

    @Глобально
    // Метод ОбновитьЗаписи
    // Обновляет значение записей по выбранным критериям
    //
    // Таблица           - Строка: Имя таблицы
    // СтруктураЗначений - Структура Из КлючИЗначение: Структура значений: Ключ > поле, Значение > значение поля
    // Фильтры           - Массив Из Структура: Массив фильтров. См. ПолучитьСтруктуруФильтраЗаписей (необяз. по ум. - Пустое значение)
    // Соединение        - Строка, Произвольный: Соединение или строка подключения (необяз. по ум. - Пустое значение)
    // Tls               - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    метод ОбновитьЗаписи(Таблица: Объект?, СтруктураЗначений: Объект?, Фильтры: Объект? = Неопределено, Соединение: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Таблица)
        Опции.Вставить("-v", СтруктураЗначений)
        Опции.Вставить("-f", Фильтры)
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-l", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОбновитьЗаписи", Опции)
        
    ;

    @Глобально
    // Метод ГарантироватьЗаписи
    // Добавляет записи или обновляет данные существующих при совпадении ключевых полей
    //
    // Таблица      - Строка: Имя таблицы
    // МассивДанных - Массив Из Структура: Массив структур данных строк: Ключ > поле, Значение > значение поля
    // КлючевыеПоля - Массив Из Строка: Имя или имена ключевых полей таблицы для проверки уникальности (необяз. по ум. - Пустое значение)
    // Транзакция   - Булево: Истина > добавление записей в транзакции с откатом при ошибке (необяз. по ум. - true)
    // Соединение   - Строка, Произвольный: Существующее соединение или путь к базе (необяз. по ум. - Пустое значение)
    // Tls          - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    метод ГарантироватьЗаписи(Таблица: Объект?, МассивДанных: Объект?, КлючевыеПоля: Объект? = Неопределено, Транзакция: Объект? = Неопределено, Соединение: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Таблица)
        Опции.Вставить("-r", МассивДанных)
        Опции.Вставить("-u", КлючевыеПоля)
        Опции.Вставить("-n", Транзакция)
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-l", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ГарантироватьЗаписи", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьЗаписи
    // Получает записи из выбранной таблицы
    //
    // Таблица    - Строка: Имя таблицы
    // Поля       - Массив Из Строка: Поля для выборки (необяз. по ум. - *)
    // Фильтры    - Массив Из Структура: Массив фильтров. См. ПолучитьСтруктуруФильтраЗаписей (необяз. по ум. - Пустое значение)
    // Сортировка - Структура Из КлючИЗначение: Сортировка: Ключ > поле, Значение > направление (ASC, DESC) (необяз. по ум. - Пустое значение)
    // Количество - Число: Ограничение количества получаемых строк (необяз. по ум. - Пустое значение)
    // Соединение - Строка, Произвольный: Соединение или строка подключения (необяз. по ум. - Пустое значение)
    // Tls        - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    метод ПолучитьЗаписи(Таблица: Объект?, Поля: Объект? = Неопределено, Фильтры: Объект? = Неопределено, Сортировка: Объект? = Неопределено, Количество: Объект? = Неопределено, Соединение: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Таблица)
        Опции.Вставить("-f", Поля)
        Опции.Вставить("-l", Фильтры)
        Опции.Вставить("-o", Сортировка)
        Опции.Вставить("-m", Количество)
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-s", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьЗаписи", Опции)
        
    ;

    @Глобально
    // Метод УдалитьЗаписи
    // Удаляет записи из таблицы
    //
    // Таблица    - Строка: Имя таблицы
    // Фильтры    - Массив Из Структура: Массив фильтров. См. ПолучитьСтруктуруФильтраЗаписей (необяз. по ум. - Пустое значение)
    // Соединение - Строка, Произвольный: Соединение или строка подключения (необяз. по ум. - Пустое значение)
    // Tls        - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    метод УдалитьЗаписи(Таблица: Объект?, Фильтры: Объект? = Неопределено, Соединение: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Таблица)
        Опции.Вставить("-f", Фильтры)
        Опции.Вставить("-d", Соединение)
        Опции.Вставить("-l", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьЗаписи", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтруктуруФильтраЗаписей
    // Получает структуру шаблон для фильтрации записей в запросах ORM
    //
    // Пустая - Булево: Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей (необяз. по ум. - false)
    метод ПолучитьСтруктуруФильтраЗаписей(Пустая: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруФильтраЗаписей", Опции)
        
    ;
    
;