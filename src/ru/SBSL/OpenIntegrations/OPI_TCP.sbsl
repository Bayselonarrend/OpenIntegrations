    ;

    @Глобально
    метод ПолучитьДанныеОчередногоСоединения(ОбъектСервера: Объект?, Таймаут: Объект? = Неопределено, МаксимальныйРазмер: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", ОбъектСервера)
        Опции.Вставить("-t", Таймаут)
        Опции.Вставить("-m", МаксимальныйРазмер)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьДанныеОчередногоСоединения", Опции)
        
    ;

    @Глобально
    метод ПолучитьДанныеСоединения(ОбъектСервера: Объект?, IDСоединения: Объект?, Таймаут: Объект? = Неопределено, МаксимальныйРазмер: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", ОбъектСервера)
        Опции.Вставить("-i", IDСоединения)
        Опции.Вставить("-t", Таймаут)
        Опции.Вставить("-m", МаксимальныйРазмер)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьДанныеСоединения", Опции)
        
    ;

    @Глобально
    метод ОтправитьДанные(ОбъектСервера: Объект?, IDСоединения: Объект?, Данные: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", ОбъектСервера)
        Опции.Вставить("-i", IDСоединения)
        Опции.Вставить("-d", Данные)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьДанные", Опции)
        
    ;

