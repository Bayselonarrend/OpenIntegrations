#совместимость 8.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Строка?|Executor.НастройкиИнтеграции): OPI_TCP
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(Конфигурация)
    возврат новый OPI_TCP(Исполнитель)
    
;

@Локально
структура OPI_TCP
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "tcp"
    
    @Глобально
    метод ПолучитьНастройкиЛогирования(ЗаписьВПамять: Объект? = Неопределено, МаксимумСобытий: Объект? = Неопределено, ПутьКФайлу: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-m", ЗаписьВПамять)
        Опции.Вставить("-c", МаксимумСобытий)
        Опции.Вставить("-p", ПутьКФайлу)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиЛогирования", Опции)
        
    ;

    @Глобально
    метод ПолучитьЛог(ОбъектКомпоненты: Объект?, КакСтрока: Объект? = Неопределено, ЧислоСобытий: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", ОбъектКомпоненты)
        Опции.Вставить("-s", КакСтрока)
        Опции.Вставить("-n", ЧислоСобытий)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьЛог", Опции)
        
    ;

    @Глобально
    метод ОткрытьСоединение(Адрес: Объект?, Tls: Объект? = Неопределено, Прокси: Объект? = Неопределено, Логирование: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Адрес)
        Опции.Вставить("-t", Tls)
        Опции.Вставить("-p", Прокси)
        Опции.Вставить("-l", Логирование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОткрытьСоединение", Опции)
        
    ;

    @Глобально
    метод ЗакрытьСоединение(Соединение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Соединение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗакрытьСоединение", Опции)
        
    ;

    @Глобально
    метод ПрочитатьДвоичныеДанные(Соединение: Объект?, МаксимальныйРазмер: Объект? = Неопределено, Маркер: Объект? = Неопределено, Таймаут: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Соединение)
        Опции.Вставить("-s", МаксимальныйРазмер)
        Опции.Вставить("-m", Маркер)
        Опции.Вставить("-i", Таймаут)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПрочитатьДвоичныеДанные", Опции)
        
    ;

    @Глобально
    метод ПрочитатьСтроку(Соединение: Объект?, Кодировка: Объект? = Неопределено, Маркер: Объект? = Неопределено, Таймаут: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Соединение)
        Опции.Вставить("-e", Кодировка)
        Опции.Вставить("-m", Маркер)
        Опции.Вставить("-i", Таймаут)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПрочитатьСтроку", Опции)
        
    ;

    @Глобально
    метод ОтправитьДвоичныеДанные(Соединение: Объект?, Данные: Объект?, Таймаут: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Соединение)
        Опции.Вставить("-d", Данные)
        Опции.Вставить("-m", Таймаут)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьДвоичныеДанные", Опции)
        
    ;

    @Глобально
    метод ОтправитьСтроку(Соединение: Объект?, Данные: Объект?, Кодировка: Объект? = Неопределено, Таймаут: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Соединение)
        Опции.Вставить("-d", Данные)
        Опции.Вставить("-e", Кодировка)
        Опции.Вставить("-m", Таймаут)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьСтроку", Опции)
        
    ;

    @Глобально
    метод ОбработатьЗапрос(Адрес: Объект?, Данные: Объект? = Неопределено, ОтветСтрокой: Объект? = Неопределено, Tls: Объект? = Неопределено, Прокси: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Адрес)
        Опции.Вставить("-d", Данные)
        Опции.Вставить("-s", ОтветСтрокой)
        Опции.Вставить("-t", Tls)
        Опции.Вставить("-p", Прокси)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОбработатьЗапрос", Опции)
        
    ;

    @Глобально
    метод ПолучитьПоследнююОшибку(Соединение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
