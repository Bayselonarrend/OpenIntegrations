#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_TCP
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_TCP(Исполнитель)
    
;

@Локально
структура OPI_TCP
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "tcp"
    
    @Глобально
    // Метод ОбработатьЗапрос
    // Отправляет одиночный запрос на указанный адрес и получает ответ, используя стандартные настройки
    //
    // Адрес        - Строка: Адрес и порт для подключения
    // Данные       - Строка, ДвоичныеДанные: Данные или текст для отправки (необяз. по ум. - Пустое значение)
    // ОтветСтрокой - Булево: Признак получения ответа как строки (необяз. по ум. - true)
    // Tls          - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    // Прокси       - Структура Из КлючИЗначение: Настройки прокси, если необходимо. См. ПолучитьНастройкиПрокси (необяз. по ум. - Пустое значение)
    метод ОбработатьЗапрос(Адрес: Объект?, Данные: Объект? = Неопределено, ОтветСтрокой: Объект? = Неопределено, Tls: Объект? = Неопределено, Прокси: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Адрес)
        Опции.Вставить("-d", Данные)
        Опции.Вставить("-s", ОтветСтрокой)
        Опции.Вставить("-t", Tls)
        Опции.Вставить("-p", Прокси)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОбработатьЗапрос", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьНастройкиПрокси
    // Формирует структуру настроек прокси-сервера для соединения
    //
    // Адрес  - Строка: Адрес прокси
    // Порт   - Число: Порт прокси
    // Вид    - Строка: Вид прокси: socks5, socks4, http (необяз. по ум. - socks5)
    // Логин  - Строка, Неопределено: Логин авторизации, если необходимо (необяз. по ум. - Пустое значение)
    // Пароль - Строка, Неопределено: Пароль для авторизации, если необходимо (необяз. по ум. - Пустое значение)
    метод ПолучитьНастройкиПрокси(Адрес: Объект?, Порт: Объект?, Вид: Объект? = Неопределено, Логин: Объект? = Неопределено, Пароль: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Адрес)
        Опции.Вставить("-p", Порт)
        Опции.Вставить("-t", Вид)
        Опции.Вставить("-l", Логин)
        Опции.Вставить("-s", Пароль)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиПрокси", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьНастройкиTls
    // Формирует настройки для использования TLS при выполнении запросов
    //
    // ОтключитьПроверкуСертификатов - Булево: Позволяет работать с некорректными сертификатами, в т.ч. самоподписанными
    // ПутьКСертификату              - Строка: Путь к корневому PEM файлу сертификата, если его нет в системном хранилище (необяз. по ум. - Пустое значение)
    метод ПолучитьНастройкиTls(ОтключитьПроверкуСертификатов: Объект?, ПутьКСертификату: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", ОтключитьПроверкуСертификатов)
        Опции.Вставить("-c", ПутьКСертификату)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиTls", Опции)
        
    ;
    
;