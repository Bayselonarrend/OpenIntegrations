#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_ClickHouse
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_ClickHouse(Исполнитель)
    
;

@Локально
структура OPI_ClickHouse
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "clickhouse"
    
    @Глобально
    // Метод ВыполнитьЗапрос
    // Выполняет запрос с указанными параметрами
    //
    // Соединение - Произвольный: Настройки или объект соединения (для gRPC)
    // Запрос     - Структура Из КлючИЗначение: Данные запроса. См. ПолучитьНастройкиЗапроса
    // Сессия     - Структура Из КлючИЗначение: Настройки сессии. См. ПолучитьНастройкиСессии (необяз. по ум. - Пустое значение)
    метод ВыполнитьЗапрос(Соединение: Объект?, Запрос: Объект?, Сессия: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-r", Запрос)
        Опции.Вставить("-s", Сессия)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВыполнитьЗапрос", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьНастройкиСоединенияHTTP
    // Получает структуру настроек для HTTP соединения
    //
    // Адрес        - Строка: Адрес подключения с протоколом и портом
    // Авторизация  - Строка, Структура Из КлючИЗначение: Авторизация: строка для JWT, структура для basic (необяз. по ум. - Пустое значение)
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Дополнительные заголовки запроса (необяз. по ум. - Пустое значение)
    метод ПолучитьНастройкиСоединенияHTTP(Адрес: Объект?, Авторизация: Объект? = Неопределено, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", Адрес)
        Опции.Вставить("-a", Авторизация)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиСоединенияHTTP", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьНастройкиЗапроса
    // Формирует структуру описания запроса
    //
    // Текст          - Строка: Текст запроса
    // БазаДанных     - Строка: База данных (необяз. по ум. - Пустое значение)
    // IDЗапроса      - Строка: Уникальный ID запроса, если необходимо (необяз. по ум. - Пустое значение)
    // Данные         - Произвольный: Строка, файл или двоичные данные запроса (необяз. по ум. - Пустое значение)
    // ФорматОтвета   - Строка: Формат получения ответа: JSON, CSV, TSV и пр. (необяз. по ум. - JSON)
    // ВнешниеТаблицы - Массив Из Структура: Информация о внешних таблицах. См. ПолучитьСтруктуруВнешнейТаблицы (необяз. по ум. - Пустое значение)
    // Настройки      - Соответствие Из КлючИЗначение: Дополнительные query параметры запроса (необяз. по ум. - Пустое значение)
    метод ПолучитьНастройкиЗапроса(Текст: Объект?, БазаДанных: Объект? = Неопределено, IDЗапроса: Объект? = Неопределено, Данные: Объект? = Неопределено, ФорматОтвета: Объект? = Неопределено, ВнешниеТаблицы: Объект? = Неопределено, Настройки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-q", Текст)
        Опции.Вставить("-d", БазаДанных)
        Опции.Вставить("-i", IDЗапроса)
        Опции.Вставить("-t", Данные)
        Опции.Вставить("-f", ФорматОтвета)
        Опции.Вставить("-e", ВнешниеТаблицы)
        Опции.Вставить("-s", Настройки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиЗапроса", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтруктуруВнешнейТаблицы
    // Получает структуру описания внешней таблицы запроса
    //
    // Имя              - Строка: Имя таблицы
    // СтруктураКолонок - Структура Из КлючИЗначение: Структура колонок таблицы: Ключ > имя, Значение > тип данных
    // Данные           - Произвольный: Строка, файл или двоичные данные таблицы (необяз. по ум. - Пустое значение)
    // ФорматДанных     - Строка: Формат данных: CVS, TVS, JSON и др. (необяз. по ум. - Пустое значение)
    метод ПолучитьСтруктуруВнешнейТаблицы(Имя: Объект?, СтруктураКолонок: Объект?, Данные: Объект? = Неопределено, ФорматДанных: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-n", Имя)
        Опции.Вставить("-c", СтруктураКолонок)
        Опции.Вставить("-d", Данные)
        Опции.Вставить("-f", ФорматДанных)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруВнешнейТаблицы", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьНастройкиСессии
    // Формирует структуру настроек сессии выполнения запроса
    //
    // IDСессии        - Строка: ID сессии. Новый уникальный идентификатор, если не указано (будет создана новая сессия) (необяз. по ум. - Пустое значение)
    // ПроверятьСессию - Булево: Проверять существование сессии. Истина, когда ID указан и ложь, когда нет, если не указано иное (необяз. по ум. - Пустое значение)
    // Таймаут         - Число: Время жизни сессии в секундах (необяз. по ум. - 60)
    метод ПолучитьНастройкиСессии(IDСессии: Объект? = Неопределено, ПроверятьСессию: Объект? = Неопределено, Таймаут: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-i", IDСессии)
        Опции.Вставить("-c", ПроверятьСессию)
        Опции.Вставить("-t", Таймаут)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиСессии", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьНастройкиСоединенияGRPC
    // Получает структуру настроек для gRPC соединения
    //
    // Адрес       - Строка: Адрес подключения с протоколом и портом
    // Авторизация - Строка, Структура Из КлючИЗначение: Авторизация: строка для JWT, структура для basic (необяз. по ум. - Пустое значение)
    // Meta        - Структура Из КлючИЗначение: Структура метаданных gRPC, если необходимо (необяз. по ум. - Пустое значение)
    // Tls         - Структура Из КлючИЗначение: Настройки TLS. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    метод ПолучитьНастройкиСоединенияGRPC(Адрес: Объект?, Авторизация: Объект? = Неопределено, Meta: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", Адрес)
        Опции.Вставить("-a", Авторизация)
        Опции.Вставить("-m", Meta)
        Опции.Вставить("-t", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиСоединенияGRPC", Опции)
        
    ;

    @Глобально
    // Метод ОбработатьОтправкуGRPC
    // Инициализирует поток, передает запрос и набор данных в указанном порядке с получением одного сообщения по окончании
    //
    // Соединение - Произвольный: Существующее соединение или параметры соединения
    // Запрос     - Структура Из КлючИЗначение: Данные запроса. См. ПолучитьНастройкиЗапроса
    // Данные     - Массив Из Произвольный: Массив строк, коллекций, двоичных данных или путей к файлам
    // Сессия     - Структура Из КлючИЗначение: Настройки сессии. См. ПолучитьНастройкиСессии (необяз. по ум. - Пустое значение)
    // Таймаут    - Число: Таймаут (в мс) (необяз. по ум. - 10000)
    метод ОбработатьОтправкуGRPC(Соединение: Объект?, Запрос: Объект?, Данные: Объект?, Сессия: Объект? = Неопределено, Таймаут: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-r", Запрос)
        Опции.Вставить("-d", Данные)
        Опции.Вставить("-s", Сессия)
        Опции.Вставить("-t", Таймаут)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОбработатьОтправкуGRPC", Опции)
        
    ;

    @Глобально
    // Метод ОбработатьПолучениеGRPC
    // Инициализирует поток, передает запрос и получает сообщения до закрытия или установленного лимита
    //
    // Соединение     - Произвольный: Существующее соединение или параметры соединения
    // Запрос         - Структура Из КлючИЗначение: Данные запроса. См. ПолучитьНастройкиЗапроса
    // ЧислоСообщений - Число: Максимально число сообщений для получения, если необходимо (необяз. по ум. - Пустое значение)
    // Сессия         - Структура Из КлючИЗначение: Настройки сессии. См. ПолучитьНастройкиСессии (необяз. по ум. - Пустое значение)
    // Таймаут        - Число: Таймаут (в мс) (необяз. по ум. - 10000)
    метод ОбработатьПолучениеGRPC(Соединение: Объект?, Запрос: Объект?, ЧислоСообщений: Объект? = Неопределено, Сессия: Объект? = Неопределено, Таймаут: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-r", Запрос)
        Опции.Вставить("-a", ЧислоСообщений)
        Опции.Вставить("-s", Сессия)
        Опции.Вставить("-t", Таймаут)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОбработатьПолучениеGRPC", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьНастройкиTls
    // Формирует настройки для использования TLS при выполнении запросов
    //
    // ОтключитьПроверкуСертификатов - Булево: Позволяет работать с некорректными сертификатами, в т.ч. самоподписанными
    // ПутьКСертификату              - Строка: Путь к корневому PEM файлу сертификата, если его нет в системном хранилище (необяз. по ум. - Пустое значение)
    метод ПолучитьНастройкиTls(ОтключитьПроверкуСертификатов: Объект?, ПутьКСертификату: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", ОтключитьПроверкуСертификатов)
        Опции.Вставить("-c", ПутьКСертификату)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиTls", Опции)
        
    ;
    
;