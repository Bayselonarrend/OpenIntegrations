#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Executor.НастройкиИнтеграции? = Неопределено): OPI_Ollama
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(Конфигурация)
    возврат новый OPI_Ollama(Исполнитель)
    
;

@Локально
структура OPI_Ollama
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "ollama"
    
    @Глобально
    метод ПолучитьВерсию(URL: Объект?, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьВерсию", Опции)
        
    ;

    @Глобально
    метод ПолучитьОтвет(URL: Объект?, Модель: Объект?, Вопрос: Объект?, ДопПараметры: Объект? = Неопределено, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-m", Модель)
        Опции.Вставить("-p", Вопрос)
        Опции.Вставить("-o", ДопПараметры)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьОтвет", Опции)
        
    ;

    @Глобально
    метод ПолучитьОтветВКонтексте(URL: Объект?, Модель: Объект?, Сообщения: Объект?, ДопПараметры: Объект? = Неопределено, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-m", Модель)
        Опции.Вставить("-s", Сообщения)
        Опции.Вставить("-o", ДопПараметры)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьОтветВКонтексте", Опции)
        
    ;

