        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-m", Модель)
        Опции.Вставить("-i", Небезопасно)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьМодель", Опции)
        
    ;

    @Глобально
    // Метод СкачатьМодель
    // Скачивает модель из библиотеки
    //
    // URL          - Строка: URL сервера Ollama
    // Модель       - Строка: Имя модели
    // Небезопасно  - Булево: Разрешает незащищенное соединение с библиотекой (необяз. по ум. - false)
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод СкачатьМодель(URL: Объект?, Модель: Объект?, Небезопасно: Объект? = Неопределено, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-m", Модель)
        Опции.Вставить("-i", Небезопасно)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СкачатьМодель", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтруктуруНастроекМодели
    // Получает структуру настроек для создания новой модели
    //
    // Пустая - Булево: Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей (необяз. по ум. - false)
    метод ПолучитьСтруктуруНастроекМодели(Пустая: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруНастроекМодели", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьBlob
    // Отправляет двоичные данные на сервер Ollama
    //
    // URL          - Строка: URL сервера Ollama
    // Данные       - Строка, ДвоичныеДанные: Данные или путь к файлу
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод ОтправитьBlob(URL: Объект?, Данные: Объект?, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-d", Данные)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьBlob", Опции)
        
    ;

    @Глобально
    // Метод ПроверитьBlob
    // Проверяет существование BLOB по его SHA256 дайджесту
    //
    // URL          - Строка: URL сервера Ollama
    // SHA256       - Строка: SHA256 дайджест нужного BLOB
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод ПроверитьBlob(URL: Объект?, SHA256: Объект?, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-d", SHA256)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПроверитьBlob", Опции)
        
    ;
    
;