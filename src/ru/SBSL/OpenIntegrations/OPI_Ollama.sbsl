#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_Ollama
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_Ollama(Исполнитель)
    
;

@Локально
структура OPI_Ollama
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "ollama"
    
    @Глобально
    // Метод ПолучитьВерсию
    // Получает версию Ollama
    //
    // URL          - Строка: URL сервера Ollama
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод ПолучитьВерсию(URL: Объект?, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьВерсию", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьОтвет
    // Генерирует ответ по заданному текстовому запросу
    //
    // URL          - Строка: URL сервера Ollama
    // Модель       - Строка: Имя модели
    // Вопрос       - Строка: Текст запроса
    // ДопПараметры - Структура Из КлючИЗначение: Доп. параметры. См. ПолучитьСтруктуруПараметровЗапроса (необяз. по ум. - Пустое значение)
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод ПолучитьОтвет(URL: Объект?, Модель: Объект?, Вопрос: Объект?, ДопПараметры: Объект? = Неопределено, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-m", Модель)
        Опции.Вставить("-p", Вопрос)
        Опции.Вставить("-o", ДопПараметры)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьОтвет", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьОтветВКонтексте
    // Получает очередной ответ от модели в соответствии с историей сообщений
    //
    // URL          - Строка: URL сервера Ollama
    // Модель       - Строка: Имя модели
    // Сообщения    - Массив Из Структура: История сообщений. См. ПолучитьСтруктуруСообщенияКонтекста
    // ДопПараметры - Структура Из КлючИЗначение: Доп. параметры. См. ПолучитьСтруктуруПараметровЗапроса (необяз. по ум. - Пустое значение)
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод ПолучитьОтветВКонтексте(URL: Объект?, Модель: Объект?, Сообщения: Объект?, ДопПараметры: Объект? = Неопределено, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-m", Модель)
        Опции.Вставить("-s", Сообщения)
        Опции.Вставить("-o", ДопПараметры)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьОтветВКонтексте", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьПредставления
    // Получает представления (embeddings) для заданных вводных
    //
    // URL          - Строка: URL сервера Ollama
    // Модель       - Строка: Имя модели
    // Вопрос       - Массив Из Строка: Строка или массив строк запросов
    // ДопПараметры - Структура Из КлючИЗначение: Доп. параметры. См. ПолучитьСтруктуруПараметровПредставлений (необяз. по ум. - Пустое значение)
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод ПолучитьПредставления(URL: Объект?, Модель: Объект?, Вопрос: Объект?, ДопПараметры: Объект? = Неопределено, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-m", Модель)
        Опции.Вставить("-i", Вопрос)
        Опции.Вставить("-o", ДопПараметры)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПредставления", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтруктуруПараметровЗапроса
    // Получает структуру дополнительных параметров для обработки запроса
    //
    // Пустая - Булево: Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей (необяз. по ум. - false)
    метод ПолучитьСтруктуруПараметровЗапроса(Пустая: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруПараметровЗапроса", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтруктуруПараметровПредставлений
    // Получает структуру дополнительных параметров для обработки запросов получения представлений
    //
    // Пустая - Булево: Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей (необяз. по ум. - false)
    метод ПолучитьСтруктуруПараметровПредставлений(Пустая: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруПараметровПредставлений", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтруктуруПараметровВКонтексте
    // Получает структуру дополнительных параметров для обработки запроса в контексте
    //
    // Пустая - Булево: Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей (необяз. по ум. - false)
    метод ПолучитьСтруктуруПараметровВКонтексте(Пустая: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруПараметровВКонтексте", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтруктуруСообщенияКонтекста
    // Получает структуру сообщения для списка сообщений запроса в контексте
    //
    // Роль        - Строка: Источник сообщения: system, user, assistant, tool
    // Текст       - Строка: Текст сообщения
    // Картинки    - Массив Из Строка: Список картинок в формате Base64 (для многомодальных моделей, вроде llava) (необяз. по ум. - Пустое значение)
    // Инструменты - Массив Из Строка: Список инструментов в формате JSON, которые модель должна использовать (необяз. по ум. - Пустое значение)
    метод ПолучитьСтруктуруСообщенияКонтекста(Роль: Объект?, Текст: Объект?, Картинки: Объект? = Неопределено, Инструменты: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-r", Роль)
        Опции.Вставить("-t", Текст)
        Опции.Вставить("-i", Картинки)
        Опции.Вставить("-l", Инструменты)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруСообщенияКонтекста", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокМоделей
    // Получает список локальных моделей
    //
    // URL          - Строка: URL сервера Ollama
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокМоделей(URL: Объект?, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокМоделей", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокЗапущенныхМоделей
    // Получает список запущенных моделей
    //
    // URL          - Строка: URL сервера Ollama
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокЗапущенныхМоделей(URL: Объект?, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокЗапущенныхМоделей", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьИнформациюОМодели
    // Получает информацию о выбранной модели
    //
    // URL          - Строка: URL сервера Ollama
    // Модель       - Строка: Имя модели
    // Подробно     - Булево: Возврат полной информации о модели (необяз. по ум. - true)
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод ПолучитьИнформациюОМодели(URL: Объект?, Модель: Объект?, Подробно: Объект? = Неопределено, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-m", Модель)
        Опции.Вставить("-v", Подробно)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьИнформациюОМодели", Опции)
        
    ;

    @Глобально
    // Метод СоздатьМодель
    // Создает новую модель с заданными настройками
    //
    // URL          - Строка: URL сервера Ollama
    // Модель       - Строка: Имя модели
    // Настройки    - Структура Из КлючИЗначение: Настройки модели. См. ПолучитьСтруктуруНастроекМодели
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод СоздатьМодель(URL: Объект?, Модель: Объект?, Настройки: Объект?, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-m", Модель)
        Опции.Вставить("-s", Настройки)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьМодель", Опции)
        
    ;

    @Глобально
    // Метод КопироватьМодель
    // Копирует существующую модель
    //
    // URL          - Строка: URL сервера Ollama
    // Модель       - Строка: Имя существующей модели
    // Имя          - Строка: Имя новой модели
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод КопироватьМодель(URL: Объект?, Модель: Объект?, Имя: Объект?, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-m", Модель)
        Опции.Вставить("-n", Имя)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "КопироватьМодель", Опции)
        
    ;

    @Глобально
    // Метод УдалитьМодель
    // Удаляет существующую модель
    //
    // URL          - Строка: URL сервера Ollama
    // Модель       - Строка: Имя модели
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод УдалитьМодель(URL: Объект?, Модель: Объект?, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-m", Модель)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьМодель", Опции)
        
    ;

    @Глобально
    // Метод ЗагрузитьМодельВПамять
    // Загружает выбранную модель в оперативную память
    //
    // URL          - Строка: URL сервера Ollama
    // Модель       - Строка: Имя модели
    // Период       - Число: Время удержания модели в памяти в секундах (необяз. по ум. - 300)
    // ДопЗаголовки - Соответствие Из КлючИЗначение: Доп заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод ЗагрузитьМодельВПамять(URL: Объект?, Модель: Объект?, Период: Объект? = Неопределено, ДопЗаголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-m", Модель)
        Опции.Вставить("-k", Период)
        Опции.Вставить("-h", ДопЗаголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗагрузитьМодельВПамять", Опции)
        
    ;

    @Глобально
    // Метод ВыгрузитьМодельИзПамяти
    // Выгружает выбранную модель из памяти
    //
