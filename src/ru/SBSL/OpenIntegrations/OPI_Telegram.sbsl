#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_Telegram
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_Telegram(Исполнитель)
    
;

@Локально
структура OPI_Telegram
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "telegram"
    
    @Глобально
    // Метод ПолучитьИнформациюБота
    // Выполняет запрос, возвращающий базовую информацию о боте: имя, id, возможность добавлять бота в группы и т.д.
    //
    // Токен - Строка: Токен бота
    метод ПолучитьИнформациюБота(Токен: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьИнформациюБота", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьОбновления
    // Выполняет запрос, возвращающий информацию о событиях бота. Используется при работе в polling режиме
    //
    // Токен    - Строка: Токен бота
    // Таймаут  - Число: Время ожидания новых событий (необяз. по ум. - Пустое значение)
    // Смещение - Число: Смещение в списке получаемых сообщений (необяз. по ум. - Пустое значение)
    метод ПолучитьОбновления(Токен: Объект?, Таймаут: Объект? = Неопределено, Смещение: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-m", Таймаут)
        Опции.Вставить("-o", Смещение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьОбновления", Опции)
        
    ;

    @Глобально
    // Метод УстановитьWebhook
    // Устанавливает URL обработчика событий бота для работы в режиме Webhook
    //
    // Токен - Строка: Токен бота
    // URL   - Строка: Адрес обработки запросов от Telegram (с https:)
    метод УстановитьWebhook(Токен: Объект?, URL: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-u", URL)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УстановитьWebhook", Опции)
        
    ;

    @Глобально
    // Метод УдалитьWebhook
    // Удаляет URL обработчика событий бота для работы в режиме Webhook
    //
    // Токен - Строка: Токен бота
    метод УдалитьWebhook(Токен: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьWebhook", Опции)
        
    ;

    @Глобально
    // Метод СкачатьФайл
    // Скачивает файл с серверов Telegram
    //
    // Токен   - Строка: Токен
    // IDФайла - Строка: ID файла для скачивания
    метод СкачатьФайл(Токен: Объект?, IDФайла: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", IDФайла)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СкачатьФайл", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьТекстовоеСообщение
    // Отправляет текстовое сообщение в чат или канал
    //
    // Токен       - Строка: Токен бота
    // IDЧата      - Строка, Число: ID целевого чата или IDЧата*IDТемы
    // Текст       - Строка: Текст сообщения
    // Клавиатура  - Строка, Структура Из КлючИЗначение: Клавиатура. См. СформироватьКлавиатуруПоМассивуКнопок (необяз. по ум. - Пустое значение)
    // Разметка    - Строка: Вид обработки текста (HTML, Markdown, MarkdownV2) (необяз. по ум. - Markdown)
    // IDВходящего - Строка, Число: ID сообщения на которое надо ответить (необяз. по ум. - Пустое значение)
    метод ОтправитьТекстовоеСообщение(Токен: Объект?, IDЧата: Объект?, Текст: Объект?, Клавиатура: Объект? = Неопределено, Разметка: Объект? = Неопределено, IDВходящего: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-x", Текст)
        Опции.Вставить("-k", Клавиатура)
        Опции.Вставить("-p", Разметка)
        Опции.Вставить("-r", IDВходящего)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьТекстовоеСообщение", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьКартинку
    // Отправляет картинку в чат или канал
    //
    // Токен      - Строка: Токен бота
    // IDЧата     - Строка, Число: ID целевого чата или IDЧата*IDТемы
    // Текст      - Строка: Текст сообщения
    // Картинка   - ДвоичныеДанные, Строка: Файл картинки
    // Клавиатура - Строка, Структура Из КлючИЗначение: Клавиатура. См. СформироватьКлавиатуруПоМассивуКнопок (необяз. по ум. - Пустое значение)
    // Разметка   - Строка: Вид обработки текста (HTML, Markdown, MarkdownV2) (необяз. по ум. - Markdown)
    метод ОтправитьКартинку(Токен: Объект?, IDЧата: Объект?, Текст: Объект?, Картинка: Объект?, Клавиатура: Объект? = Неопределено, Разметка: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-x", Текст)
        Опции.Вставить("-p", Картинка)
        Опции.Вставить("-k", Клавиатура)
        Опции.Вставить("-r", Разметка)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьКартинку", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьВидео
    // Отправляет видео в чат или канал
    //
    // Токен      - Строка: Токен бота
    // IDЧата     - Строка, Число: ID целевого чата или IDЧата*IDТемы
    // Текст      - Строка: Текст сообщения
    // Видео      - ДвоичныеДанные, Строка: Файл видео
    // Клавиатура - Строка, Структура Из КлючИЗначение: Клавиатура. См. СформироватьКлавиатуруПоМассивуКнопок (необяз. по ум. - Пустое значение)
    // Разметка   - Строка: Вид обработки текста (HTML, Markdown, MarkdownV2) (необяз. по ум. - Markdown)
    метод ОтправитьВидео(Токен: Объект?, IDЧата: Объект?, Текст: Объект?, Видео: Объект?, Клавиатура: Объект? = Неопределено, Разметка: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-x", Текст)
        Опции.Вставить("-v", Видео)
        Опции.Вставить("-k", Клавиатура)
        Опции.Вставить("-p", Разметка)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьВидео", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьАудио
    // Отправляет аудиофайл в чат или канал
    //
    // Токен      - Строка: Токен бота
    // IDЧата     - Строка, Число: ID целевого чата или IDЧата*IDТемы
    // Текст      - Строка: Текст сообщения
    // Аудио      - ДвоичныеДанные, Строка: Файл аудио
    // Клавиатура - Строка, Структура Из КлючИЗначение: Клавиатура. См. СформироватьКлавиатуруПоМассивуКнопок (необяз. по ум. - Пустое значение)
    // Разметка   - Строка: Вид обработки текста (HTML, Markdown, MarkdownV2) (необяз. по ум. - Markdown)
    метод ОтправитьАудио(Токен: Объект?, IDЧата: Объект?, Текст: Объект?, Аудио: Объект?, Клавиатура: Объект? = Неопределено, Разметка: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-x", Текст)
        Опции.Вставить("-a", Аудио)
        Опции.Вставить("-k", Клавиатура)
        Опции.Вставить("-p", Разметка)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьАудио", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьДокумент
    // Отправляет документ в чат или канал
    //
    // Токен      - Строка: Токен бота
    // IDЧата     - Строка, Число: ID целевого чата или IDЧата*IDТемы
    // Текст      - Строка: Текст сообщения
    // Документ   - ДвоичныеДанные, Строка: Файл документа
    // Клавиатура - Строка, Структура Из КлючИЗначение: Клавиатура. См. СформироватьКлавиатуруПоМассивуКнопок (необяз. по ум. - Пустое значение)
    // Разметка   - Строка: Вид обработки текста (HTML, Markdown, MarkdownV2) (необяз. по ум. - Markdown)
    // ИмяФайла   - Строка: Отображаемое имя файла c расширением, если необходимо (необяз. по ум. - Пустое значение)
    метод ОтправитьДокумент(Токен: Объект?, IDЧата: Объект?, Текст: Объект?, Документ: Объект?, Клавиатура: Объект? = Неопределено, Разметка: Объект? = Неопределено, ИмяФайла: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-x", Текст)
        Опции.Вставить("-d", Документ)
        Опции.Вставить("-k", Клавиатура)
        Опции.Вставить("-p", Разметка)
        Опции.Вставить("-f", ИмяФайла)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьДокумент", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьГифку
    // Отправляет гифку в чат или канал
    //
    // Токен      - Строка: Токен бота
    // IDЧата     - Строка, Число: ID целевого чата или IDЧата*IDТемы
    // Текст      - Строка: Текст сообщения
    // Гифка      - ДвоичныеДанные, Строка: Файл гифки
    // Клавиатура - Строка, Структура Из КлючИЗначение: Клавиатура. См. СформироватьКлавиатуруПоМассивуКнопок (необяз. по ум. - Пустое значение)
    // Разметка   - Строка: Вид обработки текста (HTML, Markdown, MarkdownV2) (необяз. по ум. - Markdown)
    метод ОтправитьГифку(Токен: Объект?, IDЧата: Объект?, Текст: Объект?, Гифка: Объект?, Клавиатура: Объект? = Неопределено, Разметка: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-x", Текст)
        Опции.Вставить("-g", Гифка)
        Опции.Вставить("-k", Клавиатура)
        Опции.Вставить("-p", Разметка)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьГифку", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьМедиагруппу
    // Отправляет набор файлов в чат или канал. Варианты типов медиа: audio, document, photo, video
    //
    // Токен              - Строка: Токен бота
    // IDЧата             - Строка, Число: ID целевого чата или IDЧата*IDТемы
    // Текст              - Строка: Текст сообщения
    // СоответствиеФайлов - Соответствие из КлючИЗначение: Коллекция файлов: Ключ > Файл, Значение > Тип медиа
    // Клавиатура         - Строка: Клавиатура. См. СформироватьКлавиатуруПоМассивуКнопок (необяз. по ум. - Пустое значение)
    // Разметка           - Строка: Вид обработки текста (HTML, Markdown, MarkdownV2) (необяз. по ум. - Markdown)
    метод ОтправитьМедиагруппу(Токен: Объект?, IDЧата: Объект?, Текст: Объект?, СоответствиеФайлов: Объект?, Клавиатура: Объект? = Неопределено, Разметка: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-x", Текст)
        Опции.Вставить("-m", СоответствиеФайлов)
        Опции.Вставить("-k", Клавиатура)
        Опции.Вставить("-p", Разметка)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьМедиагруппу", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьМестоположение
    // Отправляет местоположение по географической широте и долготе в чат или канал
    //
    // Токен      - Строка: Токен бота
    // IDЧата     - Строка, Число: ID целевого чата или IDЧата*IDТемы
    // Широта     - Строка, Число: Географическая широта
    // Долгота    - Строка, Число: Географическая долгота
    // Клавиатура - Строка, Структура Из КлючИЗначение: Клавиатура. См. СформироватьКлавиатуруПоМассивуКнопок (необяз. по ум. - Пустое значение)
    метод ОтправитьМестоположение(Токен: Объект?, IDЧата: Объект?, Широта: Объект?, Долгота: Объект?, Клавиатура: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-l", Широта)
        Опции.Вставить("-n", Долгота)
        Опции.Вставить("-k", Клавиатура)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьМестоположение", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьКонтакт
    // Отправляет контакт с именем и номером телефона
    //
    // Токен      - Строка: Токен бота
    // IDЧата     - Строка, Число: ID целевого чата или IDЧата*IDТемы
    // Имя        - Строка: Имя контакта
    // Фамилия    - Строка: Фамилия контакта
    // Телефон    - Строка: Телефон контакта
    // Клавиатура - Строка, Структура Из КлючИЗначение: Клавиатура. См. СформироватьКлавиатуруПоМассивуКнопок (необяз. по ум. - Пустое значение)
    метод ОтправитьКонтакт(Токен: Объект?, IDЧата: Объект?, Имя: Объект?, Фамилия: Объект?, Телефон: Объект?, Клавиатура: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-n", Имя)
        Опции.Вставить("-s", Фамилия)
        Опции.Вставить("-p", Телефон)
        Опции.Вставить("-k", Клавиатура)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьКонтакт", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьОпрос
    // Отправляет опрос с вариантами ответа
    //
    // Токен         - Строка: Токен бота
    // IDЧата        - Строка, Число: ID целевого чата или IDЧата*IDТемы
    // Вопрос        - Строка: Вопрос опроса
    // МассивОтветов - Массив из Строка: Массив вариантов ответа
    // Анонимный     - Булево: Флаг анонимности опроса (необяз. по ум. - true)
    метод ОтправитьОпрос(Токен: Объект?, IDЧата: Объект?, Вопрос: Объект?, МассивОтветов: Объект?, Анонимный: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-q", Вопрос)
        Опции.Вставить("-o", МассивОтветов)
        Опции.Вставить("-a", Анонимный)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьОпрос", Опции)
        
    ;

    @Глобально
    // Метод ПереслатьСообщение
    // Пересылает сообщение между чатами или в рамках одного чата
    //
    // Токен       - Строка: Токен бота
    // IDОригинала - Строка, Число: ID оригинального сообщения
    // ОткудаID    - Строка, Число: ID чата оригинального сообщения
    // КудаID      - Строка, Число: ID целевого чата или IDЧата*IDТемы
    метод ПереслатьСообщение(Токен: Объект?, IDОригинала: Объект?, ОткудаID: Объект?, КудаID: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-m", IDОригинала)
        Опции.Вставить("-f", ОткудаID)
        Опции.Вставить("-o", КудаID)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПереслатьСообщение", Опции)
        
    ;

    @Глобально
    // Метод УдалитьСообщение
    // Удаляет указанное сообщение из чата или канала
    //
    // Токен       - Строка: Токен
    // IDЧата      - Строка, Число: ID целевого чата
