    @Глобально
    // Метод СформироватьКлавиатуруПоМассивуКнопок
    // Формирует простую JSON клавиатуру из массив кнопок для сообщения или нижней панели
    //
    // МассивКнопок  - Массив из Строка: Массив кнопок
    // ПодСообщением - Булево: Клавиатура под сообщением или на нижней панели (необяз. по ум. - false)
    // ОднаПодОдной  - Булево: Истина > кнопки выводятся в столбик, Ложь > в строку (необяз. по ум. - true)
    метод СформироватьКлавиатуруПоМассивуКнопок(МассивКнопок: Объект?, ПодСообщением: Объект? = Неопределено, ОднаПодОдной: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-b", МассивКнопок)
        Опции.Вставить("-u", ПодСообщением)
        Опции.Вставить("-c", ОднаПодОдной)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СформироватьКлавиатуруПоМассивуКнопок", Опции)
        
    ;

