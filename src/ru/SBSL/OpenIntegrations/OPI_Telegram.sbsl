        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", IDЧата)
        Опции.Вставить("-p", IDТемы)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьТемуФорума", Опции)
        
    ;

