    метод ОткрытьТемуФорума(Токен: Объект?, IDЧата: Объект?, IDТемы: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", IDЧата)
        Опции.Вставить("-p", IDТемы)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОткрытьТемуФорума", Опции)
        
    ;

    @Глобально
    метод УдалитьТемуФорума(Токен: Объект?, IDЧата: Объект?, IDТемы: Объект?): Объект?
        
