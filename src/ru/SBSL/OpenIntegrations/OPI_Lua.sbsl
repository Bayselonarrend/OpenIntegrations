#совместимость 8.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Строка?|Executor.НастройкиИнтеграции): OPI_Lua
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(Конфигурация)
    возврат новый OPI_Lua(Исполнитель)
    
;

@Локально
структура OPI_Lua
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "lua"
    
    @Глобально
    метод СоздатьVM(Версия: Объект?, Логирование: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-v", Версия)
        Опции.Вставить("-l", Логирование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьVM", Опции)
        
    ;

    @Глобально
    метод Перезапустить(Lua: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "Перезапустить", Опции)
        
    ;

    @Глобально
    метод ВызватьФункцию(Lua: Объект?, ИмяФункции: Объект?, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-f", ИмяФункции)
        Опции.Вставить("-p", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВызватьФункцию", Опции)
        
    ;

    @Глобально
    метод ЭтоVM(Значение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-v", Значение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЭтоVM", Опции)
        
    ;

    @Глобально
    метод ПолучитьНастройкиЛогирования(ЗаписьВПамять: Объект? = Неопределено, МаксимумСобытий: Объект? = Неопределено, ПутьКФайлу: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-m", ЗаписьВПамять)
        Опции.Вставить("-c", МаксимумСобытий)
        Опции.Вставить("-p", ПутьКФайлу)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиЛогирования", Опции)
        
    ;

    @Глобально
    метод ПолучитьЛог(ОбъектКомпоненты: Объект?, КакСтрока: Объект? = Неопределено, ЧислоСобытий: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-v", ОбъектКомпоненты)
        Опции.Вставить("-s", КакСтрока)
        Опции.Вставить("-c", ЧислоСобытий)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьЛог", Опции)
        
    ;

    @Глобально
    метод ВыполнитьКодИзСтроки(Lua: Объект?, Код: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-c", Код)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВыполнитьКодИзСтроки", Опции)
        
    ;

    @Глобально
    метод ВыполнитьКодИзФайла(Lua: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВыполнитьКодИзФайла", Опции)
        
    ;

    @Глобально
    метод ВызватьФункциюСкрипта(Lua: Объект?, Скрипт: Объект?, ИмяФункции: Объект?, Параметры: Объект? = Неопределено, Пакеты: Объект? = Неопределено, Переменные: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-s", Скрипт)
        Опции.Вставить("-f", ИмяФункции)
        Опции.Вставить("-p", Параметры)
        Опции.Вставить("-c", Пакеты)
        Опции.Вставить("-g", Переменные)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВызватьФункциюСкрипта", Опции)
        
    ;

    @Глобально
    метод СкомпилироватьКодИзСтроки(Lua: Объект?, Код: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-c", Код)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СкомпилироватьКодИзСтроки", Опции)
        
    ;

    @Глобально
    метод СкомпилироватьКодИзФайла(Lua: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СкомпилироватьКодИзФайла", Опции)
        
    ;

    @Глобально
    метод ВыполнитьБайтКод(Lua: Объект?, БайтКод: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-c", БайтКод)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВыполнитьБайтКод", Опции)
        
    ;

    @Глобально
    метод ВыполнитьБайтКодФайла(Lua: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВыполнитьБайтКодФайла", Опции)
        
    ;

    @Глобально
    метод ВызватьФункциюБайтКода(Lua: Объект?, БайтКод: Объект?, ИмяФункции: Объект?, Параметры: Объект? = Неопределено, Пакеты: Объект? = Неопределено, Переменные: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-c", БайтКод)
        Опции.Вставить("-f", ИмяФункции)
        Опции.Вставить("-p", Параметры)
        Опции.Вставить("-k", Пакеты)
        Опции.Вставить("-g", Переменные)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВызватьФункциюБайтКода", Опции)
        
    ;

    @Глобально
    метод УстановитьГлобальнуюПеременную(Lua: Объект?, Имя: Объект?, Значение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-n", Имя)
        Опции.Вставить("-v", Значение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УстановитьГлобальнуюПеременную", Опции)
        
    ;

    @Глобально
    метод ПолучитьГлобальнуюПеременную(Lua: Объект?, Имя: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-n", Имя)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьГлобальнуюПеременную", Опции)
        
    ;

    @Глобально
    метод ДобавитьПакетИзСтроки(Lua: Объект?, ИмяПакета: Объект?, Код: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-n", ИмяПакета)
        Опции.Вставить("-c", Код)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ДобавитьПакетИзСтроки", Опции)
        
    ;

    @Глобально
    метод ДобавитьПакетИзФайла(Lua: Объект?, ИмяПакета: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-n", ИмяПакета)
        Опции.Вставить("-f", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ДобавитьПакетИзФайла", Опции)
        
    ;

    @Глобально
    метод ПолучитьСписокПакетов(Lua: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокПакетов", Опции)
        
    ;
    
;