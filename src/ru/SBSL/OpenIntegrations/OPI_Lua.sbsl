#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_Lua
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_Lua(Исполнитель)
    
;

@Локально
структура OPI_Lua
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "lua"
    
    @Глобально
    // Метод ВызватьФункциюСкрипта
    // Выполняет Lua код из строки или файла и вызывает указанную функцию
    //
    // Lua        - Произвольный: Компонента Lua или версия Lua для запуска
    // Скрипт     - Строка: Код Lua или путь к файлу
    // ИмяФункции - Строка: Имя функции или путь вида module.func
    // Параметры  - Соответствие Из КлючИЗначение: Параметры функции, если необходимо (необяз. по ум. - Пустое значение)
    // Пакеты     - Соответствие Из КлючИЗначение: Пакеты: ключ > имя, значение > код или путь к файлу (необяз. по ум. - Пустое значение)
    // Переменные - Соответствие Из КлючИЗначение: Глобальные переменные модуля, если необходимо (необяз. по ум. - Пустое значение)
    метод ВызватьФункциюСкрипта(Lua: Объект?, Скрипт: Объект?, ИмяФункции: Объект?, Параметры: Объект? = Неопределено, Пакеты: Объект? = Неопределено, Переменные: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-s", Скрипт)
        Опции.Вставить("-f", ИмяФункции)
        Опции.Вставить("-p", Параметры)
        Опции.Вставить("-c", Пакеты)
        Опции.Вставить("-g", Переменные)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВызватьФункциюСкрипта", Опции)
        
    ;

    @Глобально
    // Метод СкомпилироватьКодИзСтроки
    // Преобразует исходный код в байт-код Lua
    //
    // Lua - Произвольный: Компонента Lua или версия Lua для запуска
    // Код - Строка: Программный код для компиляции
    метод СкомпилироватьКодИзСтроки(Lua: Объект?, Код: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-c", Код)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СкомпилироватьКодИзСтроки", Опции)
        
    ;

    @Глобально
    // Метод СкомпилироватьКодИзФайла
    // Преобразует файл исходного кода в байт-код Lua
    //
    // Lua  - Произвольный: Компонента Lua или версия Lua для запуска
    // Путь - Строка: Путь к файлу скрипта
    метод СкомпилироватьКодИзФайла(Lua: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СкомпилироватьКодИзФайла", Опции)
        
    ;

    @Глобально
    // Метод ВызватьФункциюБайтКода
    // Выполняет байт-код и вызывает указанную функцию
    //
    // Lua        - Произвольный: Компонента Lua или версия Lua для запуска
    // БайтКод    - Строка, ДвоичныеДанные: Байт код или путь к файлу
    // ИмяФункции - Строка: Имя функции или путь вида module.func
    // Параметры  - Соответствие Из КлючИЗначение: Параметры функции, если необходимо (необяз. по ум. - Пустое значение)
    // Пакеты     - Соответствие Из КлючИЗначение: Пакеты: ключ > имя, значение > код или путь к файлу (необяз. по ум. - Пустое значение)
    // Переменные - Соответствие Из КлючИЗначение: Глобальные переменные модуля, если необходимо (необяз. по ум. - Пустое значение)
    метод ВызватьФункциюБайтКода(Lua: Объект?, БайтКод: Объект?, ИмяФункции: Объект?, Параметры: Объект? = Неопределено, Пакеты: Объект? = Неопределено, Переменные: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-c", БайтКод)
        Опции.Вставить("-f", ИмяФункции)
        Опции.Вставить("-p", Параметры)
        Опции.Вставить("-k", Пакеты)
        Опции.Вставить("-g", Переменные)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВызватьФункциюБайтКода", Опции)
        
    ;
    
;