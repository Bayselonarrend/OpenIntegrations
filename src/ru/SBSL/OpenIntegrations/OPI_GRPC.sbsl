    @Глобально
    метод ОтправитьСообщение(Соединение: Объект?, IDПотока: Объект?, Запрос: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-s", IDПотока)
        Опции.Вставить("-d", Запрос)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьСообщение", Опции)
        
    ;

