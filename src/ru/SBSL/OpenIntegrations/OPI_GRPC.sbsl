#требуется ./internal/OPI.sbsl

@Глобально
метод Инициализировать(Конфигурация: OPI.НастройкиИнтеграцииStdio | OPI.НастройкиИнтеграцииHttp? = Неопределено): OPI_GRPC
    
    пер Исполнитель = OPI.АбстрактныйИсполнитель.Инициализировать(Конфигурация)
    возврат новый OPI_GRPC(Исполнитель)
    
;

@Глобально
метод ЧерезStdio(ПутьOint: Строка): OPI_GRPC

    пер Исполнитель = OPI.АбстрактныйИсполнитель.ЧерезStdio(ПутьOint)
    возврат новый OPI_GRPC(Исполнитель)
    
;

@Глобально
метод ЧерезHttp(HttpКлиент: КлиентHttp): OPI_GRPC

    пер Исполнитель = OPI.АбстрактныйИсполнитель.ЧерезHttp(HttpКлиент)
    возврат новый OPI_GRPC(Исполнитель)

;

@Локально
структура OPI_GRPC
    
    обз знч Исполнитель: OPI.АбстрактныйИсполнитель
    
    знч КомандаCLI: Строка = "grpc"
    
    @Глобально
    метод ОткрытьСоединение(Параметры: Объект?, Tls: Объект? = Неопределено, Логирование: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-p", Параметры)
        Опции.Вставить("-t", Tls)
        Опции.Вставить("-l", Логирование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОткрытьСоединение", Опции)
        
    ;

    @Глобально
    метод ЗакрытьСоединение(Соединение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗакрытьСоединение", Опции)
        
    ;

    @Глобально
    метод УстановитьМетаданные(Соединение: Объект?, Метаданные: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-m", Метаданные)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УстановитьМетаданные", Опции)
        
    ;

    @Глобально
    метод ВызватьМетод(Соединение: Объект?, Сервис: Объект?, Метод: Объект?, Запрос: Объект? = Неопределено, Таймаут: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-s", Сервис)
        Опции.Вставить("-m", Метод)
        Опции.Вставить("-d", Запрос)
        Опции.Вставить("-t", Таймаут)
        Опции.Вставить("-l", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВызватьМетод", Опции)
        
    ;

    @Глобально
    метод ЭтоКоннектор(Значение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-v", Значение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЭтоКоннектор", Опции)
        
    ;

    @Глобально
    метод ПолучитьПараметрыСоединения(Адрес: Объект?, Proto: Объект? = Неопределено, Метаданные: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Адрес)
        Опции.Вставить("-p", Proto)
        Опции.Вставить("-m", Метаданные)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПараметрыСоединения", Опции)
        
    ;

    @Глобально
    метод ПолучитьНастройкиTls(ОтключитьПроверкуСертификатов: Объект?, ПутьКСертификату: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", ОтключитьПроверкуСертификатов)
        Опции.Вставить("-c", ПутьКСертификату)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиTls", Опции)
        
    ;

    @Глобально
    метод ПолучитьНастройкиЛогирования(ЗаписьВПамять: Объект? = Неопределено, МаксимумСобытий: Объект? = Неопределено, ПутьКФайлу: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-m", ЗаписьВПамять)
        Опции.Вставить("-c", МаксимумСобытий)
        Опции.Вставить("-p", ПутьКФайлу)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиЛогирования", Опции)
        
    ;

    @Глобально
    метод ПолучитьЛог(Соединение: Объект?, КакСтрока: Объект? = Неопределено, ЧислоСобытий: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-s", КакСтрока)
        Опции.Вставить("-n", ЧислоСобытий)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьЛог", Опции)
        
    ;

    @Глобально
    метод ПолучитьСписокСервисов(Соединение: Объект?, Tls: Объект? = Неопределено): Объект?
        
