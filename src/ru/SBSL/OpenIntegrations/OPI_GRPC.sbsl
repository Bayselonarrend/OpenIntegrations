#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_GRPC
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_GRPC(Исполнитель)
    
;

@Локально
структура OPI_GRPC
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "grpc"
    
    @Глобально
    // Метод ВызватьМетод
    // Выполняет унарный запрос к выбранному сервису
    //
    // Соединение - Произвольный: Существующее соединение или параметры соединения
    // Сервис     - Строка: Имя сервиса
    // Метод      - Строка: Имя метода
    // Запрос     - Структура Из КлючИЗначение: Данные запроса (необяз. по ум. - Пустое значение)
    // Таймаут    - Число: Таймаут (в мс) (необяз. по ум. - 10000)
    // Tls        - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    метод ВызватьМетод(Соединение: Объект?, Сервис: Объект?, Метод: Объект?, Запрос: Объект? = Неопределено, Таймаут: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-s", Сервис)
        Опции.Вставить("-m", Метод)
        Опции.Вставить("-d", Запрос)
        Опции.Вставить("-t", Таймаут)
        Опции.Вставить("-l", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВызватьМетод", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьПараметрыСоединения
    // Формирует структуру параметров для создания соединения
    //
    // Адрес      - Строка: Адрес для подключения (с протоколом)
    // Proto      - Произвольный: Схема или структура схем: Ключ > имя файла (для import), Значение > схема строкой или путь к файлу (необяз. по ум. - Пустое значение)
    // Метаданные - Структура Из КлючИЗначение: Структура метаданных, если необходимо (необяз. по ум. - Пустое значение)
    метод ПолучитьПараметрыСоединения(Адрес: Объект?, Proto: Объект? = Неопределено, Метаданные: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Адрес)
        Опции.Вставить("-p", Proto)
        Опции.Вставить("-m", Метаданные)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПараметрыСоединения", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьНастройкиTls
    // Формирует настройки для использования TLS при выполнении запросов
    //
    // ОтключитьПроверкуСертификатов - Булево: Позволяет работать с некорректными сертификатами, в т.ч. самоподписанными
    // ПутьКСертификату              - Строка: Путь к корневому PEM файлу сертификата, если его нет в системном хранилище (необяз. по ум. - Пустое значение)
    метод ПолучитьНастройкиTls(ОтключитьПроверкуСертификатов: Объект?, ПутьКСертификату: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", ОтключитьПроверкуСертификатов)
        Опции.Вставить("-c", ПутьКСертификату)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиTls", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокСервисов
    // Получает список доступных сервисов
    //
    // Соединение - Произвольный: Существующее соединение или параметры соединения
    // Tls        - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокСервисов(Соединение: Объект?, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-t", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокСервисов", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокМетодов
    // Получает список доступных методов указанного сервиса
    //
    // Соединение - Произвольный: Существующее соединение или параметры соединения
    // Сервис     - Строка: Имя сервиса
    // Tls        - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокМетодов(Соединение: Объект?, Сервис: Объект?, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-s", Сервис)
        Опции.Вставить("-t", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокМетодов", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьМетод
    // Получает информацию о методе
    //
    // Соединение - Произвольный: Существующее соединение или параметры соединения
    // Сервис     - Строка: Имя сервиса
    // Метод      - Строка: Имя метода
    // Tls        - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    метод ПолучитьМетод(Соединение: Объект?, Сервис: Объект?, Метод: Объект?, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-s", Сервис)
        Опции.Вставить("-m", Метод)
        Опции.Вставить("-t", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьМетод", Опции)
        
    ;

    @Глобально
    // Метод ОбработатьСерверныйПоток
    // Инициализирует серверный поток и возвращает массив полученных сообщений
    //
    // Соединение     - Произвольный: Существующее соединение или параметры соединения
    // Сервис         - Строка: Имя сервиса
    // Метод          - Строка: Имя метода
    // Запрос         - Структура Из КлючИЗначение: Данные первого запроса
    // Таймаут        - Число: Таймаут выполнения отдельной операции (в мс) (необяз. по ум. - 10000)
    // Tls            - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    // ЧислоСообщений - Число: Максимум сообщений для получения. Без ограничений по умолчанию (необяз. по ум. - Пустое значение)
    метод ОбработатьСерверныйПоток(Соединение: Объект?, Сервис: Объект?, Метод: Объект?, Запрос: Объект?, Таймаут: Объект? = Неопределено, Tls: Объект? = Неопределено, ЧислоСообщений: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-s", Сервис)
        Опции.Вставить("-m", Метод)
        Опции.Вставить("-d", Запрос)
        Опции.Вставить("-t", Таймаут)
        Опции.Вставить("-l", Tls)
        Опции.Вставить("-n", ЧислоСообщений)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОбработатьСерверныйПоток", Опции)
        
    ;

    @Глобально
    // Метод ОбработатьКлиентскийПоток
    // Инициализирует клиентский поток, передает массив сообщений и получает финальный ответ
    //
    // Соединение - Произвольный: Существующее соединение или параметры соединения
    // Сервис     - Строка: Имя сервиса
    // Метод      - Строка: Имя метода
    // Запросы    - Массив Из Структура: Массив запросов или одиночный запрос
    // Таймаут    - Число: Таймаут выполнения отдельной операции (в мс) (необяз. по ум. - 10000)
    // Tls        - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    метод ОбработатьКлиентскийПоток(Соединение: Объект?, Сервис: Объект?, Метод: Объект?, Запросы: Объект?, Таймаут: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-s", Сервис)
        Опции.Вставить("-m", Метод)
        Опции.Вставить("-d", Запросы)
        Опции.Вставить("-t", Таймаут)
        Опции.Вставить("-l", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОбработатьКлиентскийПоток", Опции)
        
    ;

    @Глобально
    // Метод ОбработатьДвунаправленныйПоток
    // Инициализирует двунаправленный поток, после чего передает и отправляет сообщения в указанном порядке
    //
    // Соединение          - Произвольный: Существующее соединение или параметры соединения
    // Сервис              - Строка: Имя сервиса
    // Метод               - Строка: Имя метода
    // ПорядокОбмена       - Массив Из Произвольный: Массив из данных запросов и Неопределено там, где необходимо получение
    // Таймаут             - Число: Таймаут выполнения отдельной операции (в мс) (необяз. по ум. - 10000)
    // Tls                 - Структура Из КлючИЗначение: Настройки TLS, если необходимо. См. ПолучитьНастройкиTls (необяз. по ум. - Пустое значение)
    // ПродолжатьПолучение - Булево: Продолжать получение после обработки порядка обмена (необяз. по ум. - true)
    метод ОбработатьДвунаправленныйПоток(Соединение: Объект?, Сервис: Объект?, Метод: Объект?, ПорядокОбмена: Объект?, Таймаут: Объект? = Неопределено, Tls: Объект? = Неопределено, ПродолжатьПолучение: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-s", Сервис)
        Опции.Вставить("-m", Метод)
        Опции.Вставить("-e", ПорядокОбмена)
        Опции.Вставить("-t", Таймаут)
        Опции.Вставить("-l", Tls)
        Опции.Вставить("-n", ПродолжатьПолучение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОбработатьДвунаправленныйПоток", Опции)
        
    ;
    
;