#требуется ./internal/OPI.sbsl

@Глобально
метод Инициализировать(Конфигурация: OPI.НастройкиИнтеграцииStdio | OPI.НастройкиИнтеграцииHttp? = Неопределено): OPI_YandexID
    
    пер Исполнитель = OPI.АбстрактныйИсполнитель.Инициализировать(Конфигурация)
    возврат новый OPI_YandexID(Исполнитель)
    
;

@Глобально
метод ЧерезStdio(ПутьOint: Строка): OPI_YandexID

    пер Исполнитель = OPI.АбстрактныйИсполнитель.ЧерезStdio(ПутьOint)
    возврат новый OPI_YandexID(Исполнитель)
    
;

@Глобально
метод ЧерезHttp(HttpКлиент: КлиентHttp): OPI_YandexID

    пер Исполнитель = OPI.АбстрактныйИсполнитель.ЧерезHttp(HttpКлиент)
    возврат новый OPI_YandexID(Исполнитель)

;

@Локально
структура OPI_YandexID
    
    обз знч Исполнитель: OPI.АбстрактныйИсполнитель
    
    знч КомандаCLI: Строка = "yandex"
    
    @Глобально
    метод ПолучитьКодПодтверждения(ClientId: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-i", ClientId)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьКодПодтверждения", Опции)
        
    ;

    @Глобально
    метод ПреобразоватьКодВТокен(ClientId: Объект?, ClientSecret: Объект?, КодУстройства: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-i", ClientId)
        Опции.Вставить("-s", ClientSecret)
        Опции.Вставить("-d", КодУстройства)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПреобразоватьКодВТокен", Опции)
        
    ;

    @Глобально
    метод ОбновитьТокен(ClientId: Объект?, ClientSecret: Объект?, RefreshToken: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-i", ClientId)
        Опции.Вставить("-s", ClientSecret)
        Опции.Вставить("-r", RefreshToken)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОбновитьТокен", Опции)
        
    ;
    
;