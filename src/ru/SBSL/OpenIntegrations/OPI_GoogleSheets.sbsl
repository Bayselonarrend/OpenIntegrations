#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_GoogleSheets
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_GoogleSheets(Исполнитель)
    
;

@Локально
структура OPI_GoogleSheets
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "gsheets"
    
    @Глобально
    // Метод СформироватьСсылкуПолученияКода
    // Возвращает URL для авторизации в браузере
    //
    // ClientID - Строка: Client ID
    // Calendar - Булево: разрешение на методы Calendar (необяз. по ум. - true)
    // Drive    - Булево: разрешение на методы Drive (необяз. по ум. - true)
    // Sheets   - Булево: разрешение на методы Sheets (необяз. по ум. - true)
    метод СформироватьСсылкуПолученияКода(ClientID: Объект?, Calendar: Объект? = Неопределено, Drive: Объект? = Неопределено, Sheets: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-i", ClientID)
        Опции.Вставить("-c", Calendar)
        Опции.Вставить("-d", Drive)
        Опции.Вставить("-s", Sheets)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СформироватьСсылкуПолученияКода", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьТокенПоКоду
    // Получает токен по коду из авторизации в браузере
    //
    // ClientID     - Строка: Client ID
    // ClientSecret - Строка: Client secret
    // Code         - Строка: Code из браузера
    метод ПолучитьТокенПоКоду(ClientID: Объект?, ClientSecret: Объект?, Code: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-i", ClientID)
        Опции.Вставить("-s", ClientSecret)
        Опции.Вставить("-c", Code)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьТокенПоКоду", Опции)
        
    ;

    @Глобально
    // Метод ОбновитьТокен
    // Обновляет токен по Refresh token
    //
    // ClientID     - Строка: Client ID
    // ClientSecret - Строка: Client secret
    // RefreshToken - Строка: Refresh token
    метод ОбновитьТокен(ClientID: Объект?, ClientSecret: Объект?, RefreshToken: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-i", ClientID)
        Опции.Вставить("-s", ClientSecret)
        Опции.Вставить("-r", RefreshToken)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОбновитьТокен", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьТокенServiceАккаунта
    // Получает токен авторизации по данным service аккаунта
    //
    // Данные          - Произвольный: JSON данные авторизации как файл, коллекция или двоичные данные
    // ОбластиДействия - Массив Из Строка: Область действия (scope) или массив областей
    // ВремяЖизни      - Число: Время жизни токена в секундах (необяз. по ум. - 3600)
    метод ПолучитьТокенServiceАккаунта(Данные: Объект?, ОбластиДействия: Объект?, ВремяЖизни: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Данные)
        Опции.Вставить("-s", ОбластиДействия)
        Опции.Вставить("-e", ВремяЖизни)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьТокенServiceАккаунта", Опции)
        
    ;

    @Глобально
    // Метод СоздатьКнигу
    // Создает новую книгу
    //
    // Токен            - Строка: Токен
    // Наименование     - Строка: Наименование
    // МассивИменЛистов - Массив из Строка: Массив имен для добавления новых листов в книгу
    метод СоздатьКнигу(Токен: Объект?, Наименование: Объект?, МассивИменЛистов: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-l", Наименование)
        Опции.Вставить("-s", МассивИменЛистов)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьКнигу", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьКнигу
    // Получает информацию о книге по ID
    //
    // Токен         - Строка: Токен
    // Идентификатор - Строка: Идентификатор книги
    метод ПолучитьКнигу(Токен: Объект?, Идентификатор: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-s", Идентификатор)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьКнигу", Опции)
        
    ;

    @Глобально
    // Метод ИзменитьНаименованиеКниги
    // Изменяет наименование существующей книги
    //
    // Токен        - Строка: Токен
    // Книга        - Строка: ID книги
    // Наименование - Строка: Новое наименование
    метод ИзменитьНаименованиеКниги(Токен: Объект?, Книга: Объект?, Наименование: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-s", Книга)
        Опции.Вставить("-l", Наименование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьНаименованиеКниги", Опции)
        
    ;

    @Глобально
    // Метод ДобавитьЛист
    // Добавляет новый лист в книгу
    //
    // Токен        - Строка: Токен
    // Книга        - Строка: Идентификатор книги
    // Наименование - Строка: Наименование нового листа
    метод ДобавитьЛист(Токен: Объект?, Книга: Объект?, Наименование: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-s", Книга)
        Опции.Вставить("-l", Наименование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ДобавитьЛист", Опции)
        
    ;

    @Глобально
    // Метод УдалитьЛист
    // Удаляет лист из книги
    //
    // Токен - Строка: Токен
    // Книга - Строка: Идентификатор книги
    // Лист  - Строка: Идентификатор удаляемого листа
    метод УдалитьЛист(Токен: Объект?, Книга: Объект?, Лист: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-s", Книга)
        Опции.Вставить("-h", Лист)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьЛист", Опции)
        
    ;

    @Глобально
    // Метод КопироватьЛист
    // Копирует лист из одной книги в другую
    //
    // Токен  - Строка: Токен
    // Откуда - Строка: ID книги источника
    // Куда   - Строка: ID книги приемника
    // Лист   - Строка: ID копируемого листа
    метод КопироватьЛист(Токен: Объект?, Откуда: Объект?, Куда: Объект?, Лист: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", Откуда)
        Опции.Вставить("-o", Куда)
        Опции.Вставить("-s", Лист)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "КопироватьЛист", Опции)
        
    ;

    @Глобально
    // Метод УстановитьЗначенияЯчеек
    // Устанавливает значения ячеек листа
    //
    // Токен                - Строка: Токен
    // Книга                - Строка: ID книги
    // СоответствиеЗначений - Соответствие Из КлючИЗначение: Данные заполнения, где ключ это имя ячейки вида A1
    // Лист                 - Строка: Имя листа (первый лист по умолчанию) (необяз. по ум. - Пустое значение)
    // ОсновноеИзмерение    - Строка: Основное измерение при заполнении диапазона массивом (необяз. по ум. - COLUMNS)
    метод УстановитьЗначенияЯчеек(Токен: Объект?, Книга: Объект?, СоответствиеЗначений: Объект?, Лист: Объект? = Неопределено, ОсновноеИзмерение: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-s", Книга)
        Опции.Вставить("-d", СоответствиеЗначений)
        Опции.Вставить("-h", Лист)
        Опции.Вставить("-m", ОсновноеИзмерение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УстановитьЗначенияЯчеек", Опции)
        
    ;

    @Глобально
    // Метод ОчиститьЯчейки
    // Очищает значение в ячейках
    //
    // Токен       - Строка: Токен
    // Книга       - Строка: ID книги
    // МассивЯчеек - Массив из Строка: Массив ячеек вида А1 для очистки
    // Лист        - Строка: Имя листа (первый лист по умолчанию) (необяз. по ум. - Пустое значение)
    метод ОчиститьЯчейки(Токен: Объект?, Книга: Объект?, МассивЯчеек: Объект?, Лист: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-s", Книга)
        Опции.Вставить("-c", МассивЯчеек)
        Опции.Вставить("-h", Лист)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОчиститьЯчейки", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьЗначенияЯчеек
    // Получает значения ячеек таблицы
    //
    // Токен       - Строка: Токен
    // Книга       - Строка: ID книги
    // МассивЯчеек - Массив из Строка: Массив ячеек вида А1 для получения (весь лист, если не заполнено) (необяз. по ум. - Пустое значение)
    // Лист        - Строка: Имя листа (первый лист по умолчанию) (необяз. по ум. - Пустое значение)
    метод ПолучитьЗначенияЯчеек(Токен: Объект?, Книга: Объект?, МассивЯчеек: Объект? = Неопределено, Лист: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-s", Книга)
        Опции.Вставить("-c", МассивЯчеек)
        Опции.Вставить("-h", Лист)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьЗначенияЯчеек", Опции)
        
    ;
    
;