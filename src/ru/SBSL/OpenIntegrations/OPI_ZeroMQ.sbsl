#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Строка?|Executor.НастройкиИнтеграции): OPI_ZeroMQ
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(Конфигурация)
    возврат новый OPI_ZeroMQ(Исполнитель)
    
;

@Локально
структура OPI_ZeroMQ
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "zeromq"
    
    @Глобально
    метод ПолучитьНастройкиЛогирования(ЗаписьВПамять: Объект? = Неопределено, МаксимумСобытий: Объект? = Неопределено, ПутьКФайлу: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-m", ЗаписьВПамять)
        Опции.Вставить("-c", МаксимумСобытий)
        Опции.Вставить("-p", ПутьКФайлу)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиЛогирования", Опции)
        
    ;

    @Глобально
    метод ПолучитьЛог(Соединение: Объект?, КакСтрока: Объект? = Неопределено, ЧислоСобытий: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-s", КакСтрока)
        Опции.Вставить("-n", ЧислоСобытий)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьЛог", Опции)
        
    ;

    @Глобально
    метод СоздатьСоединениеReq(Адрес: Объект?, Логирование: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Адрес)
        Опции.Вставить("-l", Логирование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьСоединениеReq", Опции)
        
    ;

    @Глобально
    метод СоздатьСоединениеSub(Адрес: Объект?, Логирование: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Адрес)
        Опции.Вставить("-l", Логирование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьСоединениеSub", Опции)
        
    ;

    @Глобально
    метод СоздатьСоединениеPush(Адрес: Объект?, Логирование: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Адрес)
        Опции.Вставить("-l", Логирование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьСоединениеPush", Опции)
        
    ;

    @Глобально
    метод СоздатьСоединениеPull(Адрес: Объект?, Логирование: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Адрес)
        Опции.Вставить("-l", Логирование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьСоединениеPull", Опции)
        
    ;

    @Глобально
    метод ОткрытьПортRep(Порт: Объект?, Логирование: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-p", Порт)
        Опции.Вставить("-l", Логирование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОткрытьПортRep", Опции)
        
    ;

    @Глобально
    метод ОткрытьПортPub(Порт: Объект?, Логирование: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-p", Порт)
        Опции.Вставить("-l", Логирование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОткрытьПортPub", Опции)
        
    ;

    @Глобально
    метод ОткрытьПортPush(Порт: Объект?, Логирование: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-p", Порт)
        Опции.Вставить("-l", Логирование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОткрытьПортPush", Опции)
        
    ;

    @Глобально
    метод ОткрытьПортPull(Порт: Объект?, Логирование: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-p", Порт)
        Опции.Вставить("-l", Логирование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОткрытьПортPull", Опции)
        
    ;

    @Глобально
    метод ОтправитьДанные(Соединение: Объект?, Данные: Объект?, Таймаут: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-d", Данные)
        Опции.Вставить("-t", Таймаут)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьДанные", Опции)
        
    ;

    @Глобально
    метод ПолучитьДанные(Соединение: Объект?, Таймаут: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-t", Таймаут)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьДанные", Опции)
        
    ;

    @Глобально
    метод ОбработатьЗапрос(Соединение: Объект?, Данные: Объект?, ТаймаутОтправки: Объект? = Неопределено, ТаймаутПолучения: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-d", Данные)
        Опции.Вставить("-t", ТаймаутОтправки)
        Опции.Вставить("-r", ТаймаутПолучения)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОбработатьЗапрос", Опции)
        
    ;

    @Глобально
    метод Подписаться(Соединение: Объект?, Префикс: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-p", Префикс)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "Подписаться", Опции)
        
    ;

    @Глобально
    метод ЗакрытьСоединение(Соединение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗакрытьСоединение", Опции)
        
    ;

    @Глобально
    метод ЭтоОбъектКоннектора(Значение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-v", Значение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЭтоОбъектКоннектора", Опции)
        
    ;
    
;