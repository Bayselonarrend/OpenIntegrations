#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_Neocities
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_Neocities(Исполнитель)
    
;

@Локально
структура OPI_Neocities
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "neocities"
    
    @Глобально
    // Метод ПолучитьДанныеОСайте
    // Получает информацию о сайте по его имени или токену
    //
    // Токен - Строка: Токен авторизации
    // Сайт  - Строка: Имя сайта (логин) для получения информации. Текущий, если не заполнено (необяз. по ум. - Пустое значение)
    метод ПолучитьДанныеОСайте(Токен: Объект?, Сайт: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-s", Сайт)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьДанныеОСайте", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьТокен
    // Получает токен авторизации по логину и паролю
    //
    // Логин  - Строка: Логин пользователя
    // Пароль - Строка: Пароль пользователя
    метод ПолучитьТокен(Логин: Объект?, Пароль: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Логин)
        Опции.Вставить("-p", Пароль)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьТокен", Опции)
        
    ;

    @Глобально
    // Метод ЗагрузитьФайл
    // Загружает одиночный файл на сервер Neocities
    //
    // Токен  - Строка: Токен авторизации
    // Путь   - Строка: Целевой путь файла на Neocities
    // Данные - Строка, ДвоичныеДанные: URL, путь или данные файла для загрузки
    метод ЗагрузитьФайл(Токен: Объект?, Путь: Объект?, Данные: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        Опции.Вставить("-f", Данные)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗагрузитьФайл", Опции)
        
    ;

    @Глобально
    // Метод ЗагрузитьФайлы
    // Загружает несколько файлов на сервер Neocities
    //
    // Токен              - Строка: Токен авторизации
    // СоответствиеФайлов - Соответствие Из КлючИЗначение: Файлы для загрузки: Ключ > путь на NC, Значение > Файл
    // ПоОдному           - Булево: Истина > отправляет файлы отдельными запросами (необяз. по ум. - false)
    метод ЗагрузитьФайлы(Токен: Объект?, СоответствиеФайлов: Объект?, ПоОдному: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", СоответствиеФайлов)
        Опции.Вставить("-s", ПоОдному)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗагрузитьФайлы", Опции)
        
    ;

    @Глобально
    // Метод УдалитьВыбранныеФайлы
    // Удаляет файл или несколько файлов с сервера Neocities
    //
    // Токен - Строка: Токен авторизации
    // Пути  - Строка, Массив Из Строка: Путь или несколько путей удаляемых файлов
    метод УдалитьВыбранныеФайлы(Токен: Объект?, Пути: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Пути)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьВыбранныеФайлы", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокФайлов
    // Получает список файлов с отбором каталога или без
    //
    // Токен - Строка: Токен авторизации
    // Путь  - Строка: Отбор файлов по каталогу. Все, если не заполнено (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокФайлов(Токен: Объект?, Путь: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокФайлов", Опции)
        
    ;

    @Глобально
    // Метод СинхронизироватьКаталоги
    // Создает копию локального каталога по выбранному пути на сервере
    //
    // Токен            - Строка: Токен авторизации
    // ЛокальныйКаталог - Строка: Локальный каталог источник
    // УдаленныйКаталог - Строка: Удаленный каталог приемника. Корень, если не заполнено (необяз. по ум. - Пустое значение)
    метод СинхронизироватьКаталоги(Токен: Объект?, ЛокальныйКаталог: Объект?, УдаленныйКаталог: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-l", ЛокальныйКаталог)
        Опции.Вставить("-r", УдаленныйКаталог)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СинхронизироватьКаталоги", Опции)
        
    ;
    
;