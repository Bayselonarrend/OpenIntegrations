#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_VKTeams
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_VKTeams(Исполнитель)
    
;

@Локально
структура OPI_VKTeams
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "vkteams"
    
    @Глобально
    // Метод ПроверитьТокен
    // Проверяет работоспособность токена бота
    //
    // Токен - Строка: Токен бота
    метод ПроверитьТокен(Токен: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПроверитьТокен", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСобытия
    // Получает события бота в Polling режиме
    //
    // Токен        - Строка: Токен бота
    // IDПоследнего - Строка, Число: ID последнего обработанного до этого события
    // Таймаут      - Строка, Число: Время удержания соединения для Long Polling (необяз. по ум. - Пустое значение)
    метод ПолучитьСобытия(Токен: Объект?, IDПоследнего: Объект?, Таймаут: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-l", IDПоследнего)
        Опции.Вставить("-m", Таймаут)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСобытия", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьИнформациюОФайле
    // Получает информацию о файле по его ID
    //
    // Токен   - Строка: Токен бота
    // IDФайла - Строка, Число: ID Файла
    метод ПолучитьИнформациюОФайле(Токен: Объект?, IDФайла: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-f", IDФайла)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьИнформациюОФайле", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьТекстовоеСообщение
    // Отправляет текстовое сообщение в чат
    //
    // Токен         - Строка: Токен бота
    // IDЧата        - Строка, Число: ID чата для отправки сообщения
    // Текст         - Строка: Текст сообщения
    // IDЦитируемого - Строка, Число: ID цитируемого сообщения, если необходимо (необяз. по ум. - Пустое значение)
    // Клавиатура    - Массив Из Строка: Кнопки к сообщению, если необходимо (необяз. по ум. - Пустое значение)
    // Разметка      - Строка: Вид разметки для текста сообщения: MarkdownV2 или HTML (необяз. по ум. - MarkdownV2)
    метод ОтправитьТекстовоеСообщение(Токен: Объект?, IDЧата: Объект?, Текст: Объект?, IDЦитируемого: Объект? = Неопределено, Клавиатура: Объект? = Неопределено, Разметка: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-x", Текст)
        Опции.Вставить("-r", IDЦитируемого)
        Опции.Вставить("-k", Клавиатура)
        Опции.Вставить("-p", Разметка)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьТекстовоеСообщение", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьФайл
    // Отправляет файл в чат
    //
    // Токен       - Строка: Токен бота
    // IDЧата      - Строка, Число: ID чата для отправки файла
    // Файл        - ДвоичныеДанные, Строка: Файл для отправки
    // Текст       - Строка: Подпись к файлу (необяз. по ум. - Пустое значение)
    // ИмяФайла    - Строка: Отображаемое имя файла (необяз. по ум. - Пустое значение)
    // Разметка    - Строка: Вид разметки для текста сообщения: MarkdownV2 или HTML (необяз. по ум. - MarkdownV2)
    // ТипКонтента - Строка: Тип файла для отправки (необяз. по ум. - image/jpeg)
    метод ОтправитьФайл(Токен: Объект?, IDЧата: Объект?, Файл: Объект?, Текст: Объект? = Неопределено, ИмяФайла: Объект? = Неопределено, Разметка: Объект? = Неопределено, ТипКонтента: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-f", Файл)
        Опции.Вставить("-x", Текст)
        Опции.Вставить("-l", ИмяФайла)
        Опции.Вставить("-p", Разметка)
        Опции.Вставить("-y", ТипКонтента)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьФайл", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьГолосовоеСообщение
    // Отправляет аудиофайл в качестве голосового сообщения
    //
    // Токен         - Строка: Токен бота
    // IDЧата        - Строка, Число: ID чата для отправки файла
    // Файл          - ДвоичныеДанные, Строка: Файл для отправки
    // ТипФайла      - Строка: Тип аудиофайла: aac, ogg или m4a (необяз. по ум. - m4a)
    // IDЦитируемого - Строка, Число: ID цитируемого сообщения, если необходимо (необяз. по ум. - Пустое значение)
    // Клавиатура    - Массив Из Строка: Кнопки к сообщению, если необходимо (необяз. по ум. - Пустое значение)
    метод ОтправитьГолосовоеСообщение(Токен: Объект?, IDЧата: Объект?, Файл: Объект?, ТипФайла: Объект? = Неопределено, IDЦитируемого: Объект? = Неопределено, Клавиатура: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-f", Файл)
        Опции.Вставить("-p", ТипФайла)
        Опции.Вставить("-r", IDЦитируемого)
        Опции.Вставить("-k", Клавиатура)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьГолосовоеСообщение", Опции)
        
    ;

    @Глобально
    // Метод ИзменитьТекстСообщения
    // Изменяет текст существующего сообщения
    //
    // Токен       - Строка: Токен бота
    // IDЧата      - Строка, Число: ID чата для отправки сообщения
    // IDСообщения - Строка, Число: ID сообщения для редактирования
    // Текст       - Строка: Новый текст сообщения
    // Разметка    - Строка: Вид разметки для текста сообщения: MarkdownV2 или HTML (необяз. по ум. - MarkdownV2)
    метод ИзменитьТекстСообщения(Токен: Объект?, IDЧата: Объект?, IDСообщения: Объект?, Текст: Объект?, Разметка: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-m", IDСообщения)
        Опции.Вставить("-x", Текст)
        Опции.Вставить("-p", Разметка)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьТекстСообщения", Опции)
        
    ;

    @Глобально
    // Метод УдалитьСообщение
    // Удаляет сообщение по ID
    //
    // Токен       - Строка: Токен бота
    // IDЧата      - Строка, Число: ID чата для отправки сообщения
    // IDСообщения - Строка, Число: ID сообщения для редактирования
    метод УдалитьСообщение(Токен: Объект?, IDЧата: Объект?, IDСообщения: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-m", IDСообщения)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьСообщение", Опции)
        
    ;

    @Глобально
    // Метод ПереслатьФайл
    // Отправляет ранее загруженный файл по его ID
    //
    // Токен    - Строка: Токен бота
    // IDЧата   - Строка, Число: ID чата для отправки файла
    // IDФайла  - Строка, Число: ID Файла для отправки
    // Текст    - Строка: Подпись к файлу (необяз. по ум. - Пустое значение)
    // Разметка - Строка: Вид разметки для текста сообщения: MarkdownV2 или HTML (необяз. по ум. - MarkdownV2)
    метод ПереслатьФайл(Токен: Объект?, IDЧата: Объект?, IDФайла: Объект?, Текст: Объект? = Неопределено, Разметка: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-f", IDФайла)
        Опции.Вставить("-x", Текст)
        Опции.Вставить("-p", Разметка)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПереслатьФайл", Опции)
        
    ;

    @Глобально
    // Метод ПереслатьГолосовоеСообщение
    // Отправляет ранее загруженное голосовое сообщение по ID
    //
    // Токен   - Строка: Токен бота
    // IDЧата  - Строка, Число: ID чата для отправки файла
    // IDФайла - Строка, Число: ID Файла голосового сообщения
    метод ПереслатьГолосовоеСообщение(Токен: Объект?, IDЧата: Объект?, IDФайла: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-f", IDФайла)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПереслатьГолосовоеСообщение", Опции)
        
    ;

    @Глобально
    // Метод ПереслатьСообщение
    // Пересылает существующее сообщение в текущий диалог
    //
    // Токен           - Строка: Токен бота
    // IDСообщения     - Строка, Число: ID оригинального сообщения
    // IDЧатаИсточника - Строка, Число: ID чата источника оригинального сообщения
    // IDЧата          - Строка, Число: ID чата для отправки сообщения
    // Текст           - Строка: Дополнительный текст сообщения (необяз. по ум. - Пустое значение)
    метод ПереслатьСообщение(Токен: Объект?, IDСообщения: Объект?, IDЧатаИсточника: Объект?, IDЧата: Объект?, Текст: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-m", IDСообщения)
        Опции.Вставить("-f", IDЧатаИсточника)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-x", Текст)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПереслатьСообщение", Опции)
        
    ;

    @Глобально
    // Метод ЗакрепитьСообщение
    // Закрепляет выбранное сообщение в чате
    //
    // Токен       - Строка: Токен бота
    // IDЧата      - Строка, Число: ID чата
    // IDСообщения - Строка, Число: ID сообщения для закрепления
    метод ЗакрепитьСообщение(Токен: Объект?, IDЧата: Объект?, IDСообщения: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-m", IDСообщения)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗакрепитьСообщение", Опции)
        
    ;

    @Глобально
    // Метод ОткрепитьСообщение
    // Открепляет ранее закрепленное сообщение в чате
    //
    // Токен       - Строка: Токен бота
    // IDЧата      - Строка, Число: ID чата
    // IDСообщения - Строка, Число: ID сообщения для открепления
    метод ОткрепитьСообщение(Токен: Объект?, IDЧата: Объект?, IDСообщения: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-m", IDСообщения)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОткрепитьСообщение", Опции)
        
    ;

    @Глобально
    // Метод ОтветитьНаСобытиеКлавиатуры
    // Возвращает ответ пользователю при нажатии на кнопку клавиатуры
    //
    // Токен             - Строка: Токен бота
    // IDСобытия         - Строка: Идентификатор callback query полученного ботом
    // Текст             - Строка: Текст ответа (необяз. по ум. - Пустое значение)
    // URL               - Строка: URL, который будет открыт клиентским приложением (необяз. по ум. - Пустое значение)
    // ЭтоПредупреждение - Булево: Отображать ответ как предупреждение (alert) (необяз. по ум. - false)
    метод ОтветитьНаСобытиеКлавиатуры(Токен: Объект?, IDСобытия: Объект?, Текст: Объект? = Неопределено, URL: Объект? = Неопределено, ЭтоПредупреждение: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-q", IDСобытия)
        Опции.Вставить("-x", Текст)
        Опции.Вставить("-u", URL)
        Опции.Вставить("-s", ЭтоПредупреждение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтветитьНаСобытиеКлавиатуры", Опции)
        
    ;

    @Глобально
    // Метод СформироватьКнопкуДействия
    // Формирует кнопку действия для клавиатуры сообщения
    //
    // Текст    - Строка: Текст кнопки
    // Значение - Строка: Значение, возвращаемое в событии нажатия. Только если не заполнено URL (необяз. по ум. - Пустое значение)
    // URL      - Строка: URL для создания кнопки открытия страницы. Только если не заполнено Значение (необяз. по ум. - Пустое значение)
    // Стиль    - Строка: Стиль кнопки: primary, attention или base (необяз. по ум. - base)
    метод СформироватьКнопкуДействия(Текст: Объект?, Значение: Объект? = Неопределено, URL: Объект? = Неопределено, Стиль: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Текст)
        Опции.Вставить("-d", Значение)
        Опции.Вставить("-u", URL)
        Опции.Вставить("-s", Стиль)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СформироватьКнопкуДействия", Опции)
        
    ;

    @Глобально
    // Метод ИсключитьПользователейЧата
    // Исключает пользователей из чата
    //
    // Токен        - Строка: Токен бота
    // IDЧата       - Строка, Число: ID чата
    // Пользователи - Строка, Число, Массив Из Строка, Число: Пользователь или пользователи чата для удаления
    метод ИсключитьПользователейЧата(Токен: Объект?, IDЧата: Объект?, Пользователи: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-m", Пользователи)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИсключитьПользователейЧата", Опции)
        
    ;

    @Глобально
    // Метод ИзменитьАватарЧата
    // Изменяет картинку аватар чата
    //
    // Токен  - Строка: Токен бота
    // IDЧата - Строка, Число: ID чата
    // Файл   - ДвоичныеДанные, Строка: Файл картинки
    метод ИзменитьАватарЧата(Токен: Объект?, IDЧата: Объект?, Файл: Объект?): Объект?
        
