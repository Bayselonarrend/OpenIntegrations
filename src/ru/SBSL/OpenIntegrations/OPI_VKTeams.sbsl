        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-f", Файл)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьАватарЧата", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьИнформациюОЧате
    // Получает основную информацию о чате
    //
    // Токен  - Строка: Токен бота
    // IDЧата - Строка, Число: ID чата
    метод ПолучитьИнформациюОЧате(Токен: Объект?, IDЧата: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьИнформациюОЧате", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьАдминистраторовЧата
    // Получает список администраторов чата
    //
    // Токен  - Строка: Токен бота
    // IDЧата - Строка, Число: ID чата
    метод ПолучитьАдминистраторовЧата(Токен: Объект?, IDЧата: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьАдминистраторовЧата", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьПользователейЧата
    // Получает список пользователей чата
    //
    // Токен  - Строка: Токен бота
    // IDЧата - Строка, Число: ID чата
    // Курсор - Строка: Маркер продолжения списка из предыдущего запроса (необяз. по ум. - Пустое значение)
    метод ПолучитьПользователейЧата(Токен: Объект?, IDЧата: Объект?, Курсор: Объект? = Неопределено): Объект?
        
