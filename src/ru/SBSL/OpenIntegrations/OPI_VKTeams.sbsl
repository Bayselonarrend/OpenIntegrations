        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-r", Курсор)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПользователейЧата", Опции)
        
    ;

