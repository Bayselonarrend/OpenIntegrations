    @Глобально
    // Метод ЗаблокироватьПользователяЧата
    // Блокирует выбранного пользователя в чате
    //
    // Токен                     - Строка: Токен бота
    // IDЧата                    - Строка, Число: ID чата
    // IDПользователя            - Строка, Число: ID пользователя для блокировки
    // УдалитьПоследниеСообщения - Булево: Удалить последние сообщения перед блокировкой (необяз. по ум. - false)
    метод ЗаблокироватьПользователяЧата(Токен: Объект?, IDЧата: Объект?, IDПользователя: Объект?, УдалитьПоследниеСообщения: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-c", IDЧата)
        Опции.Вставить("-u", IDПользователя)
        Опции.Вставить("-d", УдалитьПоследниеСообщения)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗаблокироватьПользователяЧата", Опции)
        
    ;

