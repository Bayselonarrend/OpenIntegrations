#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Строка?|Executor.НастройкиИнтеграции): OPI_WebSocket
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(Конфигурация)
    возврат новый OPI_WebSocket(Исполнитель)
    
;

@Локально
структура OPI_WebSocket
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "ws"
    
    @Глобально
    метод ПолучитьНастройкиЛогирования(ЗаписьВПамять: Объект? = Неопределено, МаксимумСобытий: Объект? = Неопределено, ПутьКФайлу: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-m", ЗаписьВПамять)
        Опции.Вставить("-c", МаксимумСобытий)
        Опции.Вставить("-p", ПутьКФайлу)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиЛогирования", Опции)
        
    ;

    @Глобально
    метод ПолучитьЛог(ОбъектКомпоненты: Объект?, КакСтрока: Объект? = Неопределено, ЧислоСобытий: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", ОбъектКомпоненты)
        Опции.Вставить("-t", КакСтрока)
        Опции.Вставить("-c", ЧислоСобытий)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьЛог", Опции)
        
    ;

    @Глобально
    метод ОткрытьСоединение(Адрес: Объект?, Tls: Объект? = Неопределено, Прокси: Объект? = Неопределено, Заголовки: Объект? = Неопределено, Логирование: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Адрес)
        Опции.Вставить("-t", Tls)
        Опции.Вставить("-p", Прокси)
        Опции.Вставить("-h", Заголовки)
        Опции.Вставить("-l", Логирование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОткрытьСоединение", Опции)
        
    ;

    @Глобально
    метод ЗакрытьСоединение(Соединение: Объект?, Код: Объект? = Неопределено, Причина: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-d", Код)
        Опции.Вставить("-r", Причина)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗакрытьСоединение", Опции)
        
    ;

    @Глобально
    метод ОтправитьПинг(Соединение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьПинг", Опции)
        
    ;

    @Глобально
    метод ОтправитьПонг(Соединение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьПонг", Опции)
        
    ;

    @Глобально
    метод ПолучитьСообщение(Соединение: Объект?, Таймаут: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-t", Таймаут)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСообщение", Опции)
        
    ;

    @Глобально
    метод ОтправитьТекстовоеСообщение(Соединение: Объект?, Текст: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-t", Текст)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьТекстовоеСообщение", Опции)
        
    ;

    @Глобально
    метод ОтправитьДвоичноеСообщение(Соединение: Объект?, Данные: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-d", Данные)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьДвоичноеСообщение", Опции)
        
    ;

    @Глобально
    метод ПолучитьНастройкиTls(ОтключитьПроверкуСертификатов: Объект?, ПутьКСертификату: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", ОтключитьПроверкуСертификатов)
        Опции.Вставить("-c", ПутьКСертификату)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиTls", Опции)
        
    ;

    @Глобально
    метод ПолучитьНастройкиПрокси(Адрес: Объект?, Порт: Объект?, Вид: Объект? = Неопределено, Логин: Объект? = Неопределено, Пароль: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Адрес)
        Опции.Вставить("-p", Порт)
        Опции.Вставить("-t", Вид)
        Опции.Вставить("-l", Логин)
        Опции.Вставить("-s", Пароль)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиПрокси", Опции)
        
    ;

    @Глобально
    метод ЭтоОбъектКлиента(Значение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-v", Значение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЭтоОбъектКлиента", Опции)
        
    ;

    @Глобально
    метод ЗапуститьСервер(Порт: Объект?, РазмерПула: Объект? = Неопределено, Логирование: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-p", Порт)
        Опции.Вставить("-s", РазмерПула)
        Опции.Вставить("-l", Логирование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗапуститьСервер", Опции)
        
    ;

    @Глобально
    метод ОстановитьСервер(ОбъектСервера: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", ОбъектСервера)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОстановитьСервер", Опции)
        
    ;

    @Глобально
    метод ПолучитьДанныеОчередногоСоединения(ОбъектСервера: Объект?, Таймаут: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", ОбъектСервера)
        Опции.Вставить("-t", Таймаут)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьДанныеОчередногоСоединения", Опции)
        
    ;

    @Глобально
    метод ПолучитьДанныеСоединения(ОбъектСервера: Объект?, IDСоединения: Объект?, Таймаут: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", ОбъектСервера)
        Опции.Вставить("-i", IDСоединения)
        Опции.Вставить("-t", Таймаут)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьДанныеСоединения", Опции)
        
    ;

    @Глобально
    метод ОтправитьДанные(ОбъектСервера: Объект?, IDСоединения: Объект?, Данные: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", ОбъектСервера)
        Опции.Вставить("-i", IDСоединения)
        Опции.Вставить("-d", Данные)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьДанные", Опции)
        
    ;

    @Глобально
    метод ЗакрытьВходящееСоединение(ОбъектСервера: Объект?, IDСоединения: Объект?, УдалятьСразу: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", ОбъектСервера)
        Опции.Вставить("-i", IDСоединения)
        Опции.Вставить("-r", УдалятьСразу)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗакрытьВходящееСоединение", Опции)
        
    ;

    @Глобально
    метод ПолучитьСписокСоединений(ОбъектСервера: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", ОбъектСервера)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокСоединений", Опции)
        
    ;

    @Глобально
    метод ЭтоОбъектСервера(Значение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-v", Значение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЭтоОбъектСервера", Опции)
        
    ;
    
;