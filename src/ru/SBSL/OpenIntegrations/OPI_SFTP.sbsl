#требуется ./internal/OPI.sbsl

@Глобально
метод Инициализировать(Конфигурация: OPI.НастройкиИнтеграцииStdio | OPI.НастройкиИнтеграцииHttp? = Неопределено): OPI_SFTP
    
    пер Исполнитель = OPI.АбстрактныйИсполнитель.Инициализировать(Конфигурация)
    возврат новый OPI_SFTP(Исполнитель)
    
;

@Глобально
метод ЧерезStdio(ПутьOint: Строка): OPI_SFTP

    пер Исполнитель = OPI.АбстрактныйИсполнитель.ЧерезStdio(ПутьOint)
    возврат новый OPI_SFTP(Исполнитель)
    
;

@Глобально
метод ЧерезHttp(HttpКлиент: КлиентHttp): OPI_SFTP

    пер Исполнитель = OPI.АбстрактныйИсполнитель.ЧерезHttp(HttpКлиент)
    возврат новый OPI_SFTP(Исполнитель)

;

@Локально
структура OPI_SFTP
    
    обз знч Исполнитель: OPI.АбстрактныйИсполнитель
    
    знч КомандаCLI: Строка = "sftp"
    
    @Глобально
    метод ОткрытьСоединение(НастройкиSSH: Объект?, Прокси: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", НастройкиSSH)
        Опции.Вставить("-p", Прокси)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОткрытьСоединение", Опции)
        
    ;

    @Глобально
    метод ПолучитьКонфигурациюСоединения(НастройкиSSH: Объект?, Прокси: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", НастройкиSSH)
        Опции.Вставить("-p", Прокси)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьКонфигурациюСоединения", Опции)
        
    ;

    @Глобально
    метод ЗакрытьСоединение(Соединение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗакрытьСоединение", Опции)
        
    ;

    @Глобально
    метод ИзменитьПуть(Соединение: Объект?, Путь: Объект?, НовыйПуть: Объект?, Перезаписывать: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-o", Путь)
        Опции.Вставить("-n", НовыйПуть)
        Опции.Вставить("-r", Перезаписывать)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьПуть", Опции)
        
    ;

    @Глобально
    метод ЭтоКоннектор(Значение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-v", Значение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЭтоКоннектор", Опции)
        
    ;

    @Глобально
    метод ПолучитьНастройкиЛогинПароль(Хост: Объект?, Порт: Объект?, Логин: Объект?, Пароль: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-h", Хост)
        Опции.Вставить("-p", Порт)
        Опции.Вставить("-u", Логин)
        Опции.Вставить("-s", Пароль)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиЛогинПароль", Опции)
        
    ;

    @Глобально
    метод ПолучитьНастройкиПриватныйКлюч(Хост: Объект?, Порт: Объект?, Логин: Объект?, Приватный: Объект?, Публичный: Объект? = Неопределено, Пароль: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-h", Хост)
        Опции.Вставить("-p", Порт)
        Опции.Вставить("-u", Логин)
        Опции.Вставить("-k", Приватный)
        Опции.Вставить("-b", Публичный)
        Опции.Вставить("-s", Пароль)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиПриватныйКлюч", Опции)
        
    ;

    @Глобально
    метод ПолучитьНастройкиЧерезАгента(Хост: Объект?, Порт: Объект?, Логин: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-h", Хост)
        Опции.Вставить("-p", Порт)
        Опции.Вставить("-u", Логин)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиЧерезАгента", Опции)
        
    ;

    @Глобально
    метод ПолучитьНастройкиKI(Хост: Объект?, Порт: Объект?, Логин: Объект?, ПорядокВвода: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-h", Хост)
        Опции.Вставить("-p", Порт)
        Опции.Вставить("-u", Логин)
        Опции.Вставить("-r", ПорядокВвода)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиKI", Опции)
        
    ;

    @Глобально
    метод ПолучитьНастройкиПрокси(Адрес: Объект?, Порт: Объект?, Вид: Объект? = Неопределено, Логин: Объект? = Неопределено, Пароль: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Адрес)
        Опции.Вставить("-p", Порт)
        Опции.Вставить("-t", Вид)
        Опции.Вставить("-l", Логин)
        Опции.Вставить("-s", Пароль)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиПрокси", Опции)
        
    ;

    @Глобально
    метод ПолучитьСписокОбъектов(Соединение: Объект?, Путь: Объект? = Неопределено, Рекурсивно: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-p", Путь)
        Опции.Вставить("-r", Рекурсивно)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокОбъектов", Опции)
        
    ;

    @Глобально
    метод СоздатьНовуюДиректорию(Соединение: Объект?, Путь: Объект?, Права: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-p", Путь)
        Опции.Вставить("-m", Права)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьНовуюДиректорию", Опции)
        
    ;

    @Глобально
    метод УдалитьДиректорию(Соединение: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьДиректорию", Опции)
        
    ;

    @Глобально
    метод ПолучитьТекущийКаталог(Соединение: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьТекущийКаталог", Опции)
        
    ;

    @Глобально
    метод ЗагрузитьФайл(Соединение: Объект?, Файл: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-f", Файл)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗагрузитьФайл", Опции)
        
    ;

    @Глобально
    метод УдалитьФайл(Соединение: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьФайл", Опции)
        
    ;

    @Глобально
    метод СохранитьФайл(Соединение: Объект?, Путь: Объект?, ИмяФайла: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-p", Путь)
        Опции.Вставить("-f", ИмяФайла)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СохранитьФайл", Опции)
        
    ;

    @Глобально
    метод ПолучитьДанныеФайла(Соединение: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьДанныеФайла", Опции)
        
    ;

    @Глобально
    метод ПолучитьИнформациюОФайле(Соединение: Объект?, Путь: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-p", Путь)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьИнформациюОФайле", Опции)
        
    ;
    
;