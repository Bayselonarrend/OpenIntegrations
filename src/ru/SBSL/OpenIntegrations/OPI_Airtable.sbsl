    @Глобально
    метод ПолучитьКомментарии(Токен: Объект?, База: Объект?, Таблица: Объект?, Запись: Объект?, Отступ: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", База)
        Опции.Вставить("-l", Таблица)
        Опции.Вставить("-r", Запись)
        Опции.Вставить("-o", Отступ)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьКомментарии", Опции)
        
    ;

    @Глобально
    метод СоздатьКомментарий(Токен: Объект?, База: Объект?, Таблица: Объект?, Запись: Объект?, Текст: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", База)
        Опции.Вставить("-l", Таблица)
        Опции.Вставить("-r", Запись)
        Опции.Вставить("-x", Текст)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьКомментарий", Опции)
        
    ;

    @Глобально
    метод ИзменитьКомментарий(Токен: Объект?, База: Объект?, Таблица: Объект?, Запись: Объект?, Комментарий: Объект?, Текст: Объект?): Объект?
        
