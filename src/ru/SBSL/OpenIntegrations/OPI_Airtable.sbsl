#требуется ./internal/OPI.sbsl

@Глобально
метод Инициализировать(Конфигурация: OPI.НастройкиИнтеграцииStdio | OPI.НастройкиИнтеграцииHttp? = Неопределено): OPI_Airtable
    
    пер Исполнитель = OPI.АбстрактныйИсполнитель.Инициализировать(Конфигурация)
    возврат новый OPI_Airtable(Исполнитель)
    
;

@Глобально
метод ЧерезStdio(ПутьOint: Строка): OPI_Airtable

    пер Исполнитель = OPI.АбстрактныйИсполнитель.ЧерезStdio(ПутьOint)
    возврат новый OPI_Airtable(Исполнитель)
    
;

@Глобально
метод ЧерезHttp(HttpКлиент: КлиентHttp): OPI_Airtable

    пер Исполнитель = OPI.АбстрактныйИсполнитель.ЧерезHttp(HttpКлиент)
    возврат новый OPI_Airtable(Исполнитель)

;

@Локально
структура OPI_Airtable
    
    обз знч Исполнитель: OPI.АбстрактныйИсполнитель
    
    знч КомандаCLI: Строка = "airtable"
    
    @Глобально
    метод ПолучитьСписокБаз(Токен: Объект?, Отступ: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-o", Отступ)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокБаз", Опции)
        
    ;

    @Глобально
    метод ПолучитьТаблицыБазы(Токен: Объект?, База: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", База)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьТаблицыБазы", Опции)
        
    ;

    @Глобально
    метод СоздатьБазу(Токен: Объект?, РабочееПространство: Объект?, Наименование: Объект?, КоллекцияТаблиц: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-w", РабочееПространство)
        Опции.Вставить("-l", Наименование)
        Опции.Вставить("-b", КоллекцияТаблиц)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьБазу", Опции)
        
    ;

    @Глобально
    метод СоздатьТаблицу(Токен: Объект?, База: Объект?, Наименование: Объект?, МассивПолей: Объект?, Описание: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", База)
        Опции.Вставить("-l", Наименование)
        Опции.Вставить("-f", МассивПолей)
        Опции.Вставить("-d", Описание)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьТаблицу", Опции)
        
    ;

    @Глобально
    метод ИзменитьТаблицу(Токен: Объект?, База: Объект?, Таблица: Объект?, Наименование: Объект? = Неопределено, Описание: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", База)
        Опции.Вставить("-l", Таблица)
        Опции.Вставить("-i", Наименование)
        Опции.Вставить("-d", Описание)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьТаблицу", Опции)
        
    ;

    @Глобально
    метод СоздатьПоле(Токен: Объект?, База: Объект?, Таблица: Объект?, СтруктураПоля: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", База)
        Опции.Вставить("-l", Таблица)
        Опции.Вставить("-f", СтруктураПоля)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьПоле", Опции)
        
    ;

    @Глобально
    метод ИзменитьПоле(Токен: Объект?, База: Объект?, Таблица: Объект?, Поле: Объект?, Наименование: Объект? = Неопределено, Описание: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", База)
        Опции.Вставить("-l", Таблица)
        Опции.Вставить("-f", Поле)
        Опции.Вставить("-i", Наименование)
        Опции.Вставить("-d", Описание)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьПоле", Опции)
        
    ;

