#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_Airtable
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_Airtable(Исполнитель)
    
;

@Локально
структура OPI_Airtable
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "airtable"
    
    @Глобально
    // Метод ПолучитьСписокБаз
    // Получает список доступных баз
    //
    // Токен  - Строка: Токен
    // Отступ - Строка: Идентификатор следующей страницы списка баз из предыдущего запроса (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокБаз(Токен: Объект?, Отступ: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-o", Отступ)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокБаз", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьТаблицыБазы
    // Получает схему таблиц базы
    //
    // Токен - Строка: Токен
    // База  - Строка: Идентификатор базы
    метод ПолучитьТаблицыБазы(Токен: Объект?, База: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", База)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьТаблицыБазы", Опции)
        
    ;

    @Глобально
    // Метод СоздатьБазу
    // Создает новую базу данных
    //
    // Токен               - Строка: Токен
    // РабочееПространство - Строка: Идентификатор рабочего пространства
    // Наименование        - Строка: Наименование новой базы
    // КоллекцияТаблиц     - Соответствие Из КлючИЗначение: Описание таблиц: Ключ > имя, Значение > массив полей
    метод СоздатьБазу(Токен: Объект?, РабочееПространство: Объект?, Наименование: Объект?, КоллекцияТаблиц: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-w", РабочееПространство)
        Опции.Вставить("-l", Наименование)
        Опции.Вставить("-b", КоллекцияТаблиц)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьБазу", Опции)
        
    ;

    @Глобально
    // Метод СоздатьТаблицу
    // Создает новую таблицу в базе
    //
    // Токен        - Строка: Токен
    // База         - Строка: Идентификатор базы
    // Наименование - Строка: Наименование новой таблицы
    // МассивПолей  - Массив Из Структура: Массив описаний полей
    // Описание     - Строка: Описание таблицы (необяз. по ум. - Пустое значение)
    метод СоздатьТаблицу(Токен: Объект?, База: Объект?, Наименование: Объект?, МассивПолей: Объект?, Описание: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", База)
        Опции.Вставить("-l", Наименование)
        Опции.Вставить("-f", МассивПолей)
        Опции.Вставить("-d", Описание)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьТаблицу", Опции)
        
    ;

    @Глобально
    // Метод ИзменитьТаблицу
    // Изменяет наименование и|или описание базы
    //
    // Токен        - Строка: Токен
    // База         - Строка: Идентификатор базы
    // Таблица      - Строка: Идентификатор таблицы
    // Наименование - Строка: Новое наименование (необяз. по ум. - Пустое значение)
    // Описание     - Строка: Новое описание (необяз. по ум. - Пустое значение)
    метод ИзменитьТаблицу(Токен: Объект?, База: Объект?, Таблица: Объект?, Наименование: Объект? = Неопределено, Описание: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", База)
        Опции.Вставить("-l", Таблица)
        Опции.Вставить("-i", Наименование)
        Опции.Вставить("-d", Описание)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьТаблицу", Опции)
        
    ;

    @Глобально
    // Метод СоздатьПоле
    // Создает новое поле в таблице
    //
    // Токен         - Строка: Токен
    // База          - Строка: Идентификатор базы
    // Таблица       - Строка: Идентификатор таблицы
    // СтруктураПоля - Структура Из КлючИЗначение: Описание нового поля
    метод СоздатьПоле(Токен: Объект?, База: Объект?, Таблица: Объект?, СтруктураПоля: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", База)
        Опции.Вставить("-l", Таблица)
        Опции.Вставить("-f", СтруктураПоля)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьПоле", Опции)
        
    ;

    @Глобально
    // Метод ИзменитьПоле
    // Изменяет имя и|или описание существующего поля таблицы
    //
    // Токен        - Строка: Токен
    // База         - Строка: Идентификатор базы База
    // Таблица      - Строка: Идентификатор таблицы
    // Поле         - Строка: Идентификатор поля
    // Наименование - Строка: Новое наименование (необяз. по ум. - Пустое значение)
    // Описание     - Строка: Новое описание (необяз. по ум. - Пустое значение)
    метод ИзменитьПоле(Токен: Объект?, База: Объект?, Таблица: Объект?, Поле: Объект?, Наименование: Объект? = Неопределено, Описание: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", База)
        Опции.Вставить("-l", Таблица)
        Опции.Вставить("-f", Поле)
        Опции.Вставить("-i", Наименование)
        Опции.Вставить("-d", Описание)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьПоле", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьПолеСтроковое
    // Получает описание поля строкового типа
    //
    // Наименование - Строка: Наименование нового поля
    метод ПолучитьПолеСтроковое(Наименование: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Наименование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПолеСтроковое", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьПолеНомера
    // Получает описание поля числового типа
    //
    // Наименование - Строка: Наименование нового поля
    // Точность     - Число, Строка: Число знаков после запятой (необяз. по ум. - Пустое значение)
    метод ПолучитьПолеНомера(Наименование: Объект?, Точность: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Наименование)
        Опции.Вставить("-p", Точность)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПолеНомера", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьПолеВложения
    // Получает описание поля файлового типа
    //
    // Наименование - Строка: Наименование поля
    метод ПолучитьПолеВложения(Наименование: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Наименование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПолеВложения", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьПолеФлажка
    // Получает описание поля типа булево
    //
    // Наименование - Строка: Наименование поля
    метод ПолучитьПолеФлажка(Наименование: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Наименование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПолеФлажка", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьПолеДаты
    // Получает описание поля типа дата
    //
    // Наименование - Строка: Наименование поля
    метод ПолучитьПолеДаты(Наименование: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Наименование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПолеДаты", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьПолеПочты
    // Получает описание поля с электронной почтой
    //
    // Наименование - Строка: Наименование поля
    метод ПолучитьПолеПочты(Наименование: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Наименование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПолеПочты", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьПолеТелефона
    // Получает описание поля с номером телефона
    //
    // Наименование - Строка: Наименование поля
    метод ПолучитьПолеТелефона(Наименование: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Наименование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПолеТелефона", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьПолеСсылки
    // Получает описание поля с URL
    //
    // Наименование - Строка: Наименование поля
    метод ПолучитьПолеСсылки(Наименование: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Наименование)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПолеСсылки", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСписокЗаписей
    // Получает список записей выбранной таблицы
    //
    // Токен   - Строка: Токен
    // База    - Строка: Идентификатор базы данных
    // Таблица - Строка: Идентификатор таблицы
    // Отступ  - Строка: Идентификатор следующей страницы данных из предыдущего запроса (необяз. по ум. - Пустое значение)
    метод ПолучитьСписокЗаписей(Токен: Объект?, База: Объект?, Таблица: Объект?, Отступ: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", База)
        Опции.Вставить("-l", Таблица)
        Опции.Вставить("-o", Отступ)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСписокЗаписей", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьЗапись
    // Получает данные строки таблицы по идентификатору
    //
    // Токен   - Строка: Токен
    // База    - Строка: Идентификатор базы данных
    // Таблица - Строка: Идентификатор таблицы
    // Запись  - Строка: Идентификатор записи в таблице
    метод ПолучитьЗапись(Токен: Объект?, База: Объект?, Таблица: Объект?, Запись: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", База)
        Опции.Вставить("-l", Таблица)
        Опции.Вставить("-r", Запись)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьЗапись", Опции)
        
    ;

    @Глобально
    // Метод СоздатьЗаписи
    // Создает одну или массив записей по описанию или массиву описаний значений полей
    //
    // Токен   - Строка: Токен
    // База    - Строка: Идентификатор базы данных
    // Таблица - Строка: Идентификатор таблицы
    // Данные  - Структура, Массив из Структура: Набор или массив наборов пар Ключ : Значение > Поле : Показатель
    метод СоздатьЗаписи(Токен: Объект?, База: Объект?, Таблица: Объект?, Данные: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", База)
        Опции.Вставить("-l", Таблица)
        Опции.Вставить("-d", Данные)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьЗаписи", Опции)
        
    ;

    @Глобально
    // Метод УдалитьЗаписи
    // Удаляет одну или массив записей по идентификаторам
    //
    // Токен   - Строка: Токен
    // База    - Строка: Идентификатор базы данных
    // Таблица - Строка: Идентификатор таблицы
    // Записи  - Строка, Массив из Строка: Идентификатор или массив идентификаторов записей
    метод УдалитьЗаписи(Токен: Объект?, База: Объект?, Таблица: Объект?, Записи: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", База)
        Опции.Вставить("-l", Таблица)
        Опции.Вставить("-r", Записи)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьЗаписи", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьКомментарии
    // Получает список комментариев к записи в таблице
    //
    // Токен   - Строка: Токен
    // База    - Строка: Идентификатор базы данных
    // Таблица - Строка: Идентификатор таблицы
    // Запись  - Строка: Идентификатор записи в таблице
    // Отступ  - Строка: Идентификатор следующей страницы данных из предыдущего запроса (необяз. по ум. - Пустое значение)
    метод ПолучитьКомментарии(Токен: Объект?, База: Объект?, Таблица: Объект?, Запись: Объект?, Отступ: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", База)
        Опции.Вставить("-l", Таблица)
        Опции.Вставить("-r", Запись)
        Опции.Вставить("-o", Отступ)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьКомментарии", Опции)
        
    ;

    @Глобально
    // Метод СоздатьКомментарий
    // Создает комментарий к записи в таблице
    //
    // Токен   - Строка: Токен
    // База    - Строка: Идентификатор базы данных
    // Таблица - Строка: Идентификатор таблицы
    // Запись  - Строка: Идентификатор записи в таблице
    // Текст   - Строка: Текст комментария
    метод СоздатьКомментарий(Токен: Объект?, База: Объект?, Таблица: Объект?, Запись: Объект?, Текст: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", База)
        Опции.Вставить("-l", Таблица)
        Опции.Вставить("-r", Запись)
        Опции.Вставить("-x", Текст)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьКомментарий", Опции)
        
    ;

    @Глобально
    // Метод ИзменитьКомментарий
    // Изменяет текст существующего комментария
    //
    // Токен       - Строка: Токен
    // База        - Строка: Идентификатор базы данных
    // Таблица     - Строка: Идентификатор таблицы
    // Запись      - Строка: Идентификатор записи в таблице
    // Комментарий - Строка: Идентификатор комментария
    // Текст       - Строка: Новый текст комментария
    метод ИзменитьКомментарий(Токен: Объект?, База: Объект?, Таблица: Объект?, Запись: Объект?, Комментарий: Объект?, Текст: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", База)
        Опции.Вставить("-l", Таблица)
        Опции.Вставить("-r", Запись)
        Опции.Вставить("-c", Комментарий)
        Опции.Вставить("-x", Текст)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьКомментарий", Опции)
        
    ;

    @Глобально
    // Метод УдалитьКомментарий
    // Удаляет комментарий к записи таблицы
    //
    // Токен       - Строка: Токен
    // База        - Строка: Идентификатор базы данных
    // Таблица     - Строка: Идентификатор таблицы
    // Запись      - Строка: Идентификатор записи в таблице
    // Комментарий - Строка: Идентификатор комментария
    метод УдалитьКомментарий(Токен: Объект?, База: Объект?, Таблица: Объект?, Запись: Объект?, Комментарий: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-b", База)
        Опции.Вставить("-l", Таблица)
        Опции.Вставить("-r", Запись)
        Опции.Вставить("-c", Комментарий)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьКомментарий", Опции)
        
    ;
    
;