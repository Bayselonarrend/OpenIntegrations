#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_ReportPortal
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_ReportPortal(Исполнитель)
    
;

@Локально
структура OPI_ReportPortal
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "rportal"
    
    @Глобально
    // Метод ПолучитьВременныйТокен
    // Получает временный токен на основе логина и пароля
    //
    // URL    - Строка: URL сервера ReportPortal
    // Логин  - Строка: Логин пользователя
    // Пароль - Строка: Пароль пользователя
    метод ПолучитьВременныйТокен(URL: Объект?, Логин: Объект?, Пароль: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-l", Логин)
        Опции.Вставить("-p", Пароль)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьВременныйТокен", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьПостоянныйТокен
    // Создает постоянный токен пользователя ReportPortal
    //
    // URL            - Строка: URL сервера ReportPortal
    // Токен          - Строка: Токен доступа
    // IDПользователя - Строка: ID пользователя
    // ИмяКлюча       - Строка: Имя токена
    метод ПолучитьПостоянныйТокен(URL: Объект?, Токен: Объект?, IDПользователя: Объект?, ИмяКлюча: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-s", IDПользователя)
        Опции.Вставить("-n", ИмяКлюча)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПостоянныйТокен", Опции)
        
    ;

    @Глобально
    // Метод УдалитьПостоянныйТокен
    // Удаляет ранее созданный токен пользователя
    //
    // URL            - Строка: URL сервера ReportPortal
    // Токен          - Строка: Токен доступа
    // IDПользователя - Строка: ID пользователя
    // IDКлюча        - Строка: ID токена
    метод УдалитьПостоянныйТокен(URL: Объект?, Токен: Объект?, IDПользователя: Объект?, IDКлюча: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-s", IDПользователя)
        Опции.Вставить("-i", IDКлюча)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьПостоянныйТокен", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьТокеныПользователя
    // Получает список токенов (API ключей) пользователя
    //
    // URL            - Строка: URL сервера ReportPortal
    // Токен          - Строка: Токен доступа
    // IDПользователя - Строка: ID пользователя
    метод ПолучитьТокеныПользователя(URL: Объект?, Токен: Объект?, IDПользователя: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-s", IDПользователя)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьТокеныПользователя", Опции)
        
    ;

    @Глобально
    // Метод СоздатьПользователя
    // Создает нового пользователя
    //
    // URL                   - Строка: URL сервера ReportPortal
    // Токен                 - Строка: Токен доступа
    // СтруктураПользователя - Структура Из КлючИЗначение: Данные пользователя. См. ПолучитьСтруктуруПользователя
    метод СоздатьПользователя(URL: Объект?, Токен: Объект?, СтруктураПользователя: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", СтруктураПользователя)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьПользователя", Опции)
        
    ;

    @Глобально
    // Метод УдалитьПользователя
    // Удаляет пользователя по логину
    //
    // URL            - Строка: URL сервера ReportPortal
    // Токен          - Строка: Токен доступа
    // IDПользователя - Строка: ID пользователя
    метод УдалитьПользователя(URL: Объект?, Токен: Объект?, IDПользователя: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-i", IDПользователя)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьПользователя", Опции)
        
    ;

    @Глобально
    // Метод ИзменитьПользователя
    // Изменяет данные выбранного пользователя
    //
    // URL                   - Строка: URL сервера ReportPortal
    // Токен                 - Строка: Токен доступа
    // Логин                 - Строка: Логин пользователя
    // СтруктураПользователя - Структура Из КлючИЗначение: Данные пользователя. См. ПолучитьСтруктуруПользователя
    метод ИзменитьПользователя(URL: Объект?, Токен: Объект?, Логин: Объект?, СтруктураПользователя: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-l", Логин)
        Опции.Вставить("-p", СтруктураПользователя)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьПользователя", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьТекущегоПользователя
    // Получает информацию о текущем пользователе
    //
    // URL   - Строка: URL сервера ReportPortal
    // Токен - Строка: Токен доступа
    метод ПолучитьТекущегоПользователя(URL: Объект?, Токен: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьТекущегоПользователя", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьПользователя
    // Получает информацию о пользователе по логину
    //
    // URL   - Строка: URL сервера ReportPortal
    // Токен - Строка: Токен доступа
    // Логин - Строка: Логин пользователя
    метод ПолучитьПользователя(URL: Объект?, Токен: Объект?, Логин: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-l", Логин)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПользователя", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьПользователей
    // Получает список существующих пользователей
    //
    // URL      - Строка: URL сервера ReportPortal
    // Токен    - Строка: Токен доступа
    // Страница - Число: Номер страницы списка (необяз. по ум. - 1)
    метод ПолучитьПользователей(URL: Объект?, Токен: Объект?, Страница: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Страница)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПользователей", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьПроектыПользователя
    // Получает список проектов пользователя
    //
    // URL   - Строка: URL сервера ReportPortal
    // Токен - Строка: Токен доступа
    // Логин - Строка: Логин пользователя
    метод ПолучитьПроектыПользователя(URL: Объект?, Токен: Объект?, Логин: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-l", Логин)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПроектыПользователя", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтруктуруПользователя
    // Получает структуру полей описания пользователя
    //
    // Пустая          - Булево: Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей (необяз. по ум. - false)
    // КакСоответствие - Булево: Истина > возвращает поля фильтра как соответствие (необяз. по ум. - false)
    метод ПолучитьСтруктуруПользователя(Пустая: Объект? = Неопределено, КакСоответствие: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        Опции.Вставить("-m", КакСоответствие)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруПользователя", Опции)
        
    ;

    @Глобально
    // Метод СоздатьПроект
    // Создает новый проект с указанным именем
    //
    // URL   - Строка: URL сервера ReportPortal
    // Токен - Строка: Токен доступа
    // Имя   - Строка: Имя проекта
    метод СоздатьПроект(URL: Объект?, Токен: Объект?, Имя: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-n", Имя)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьПроект", Опции)
        
    ;

    @Глобально
    // Метод УдалитьПроект
    // Удаляет проект по ID
    //
    // URL       - Строка: URL сервера ReportPortal
    // Токен     - Строка: Токен доступа
    // IDПроекта - Число: ID проекта
    метод УдалитьПроект(URL: Объект?, Токен: Объект?, IDПроекта: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-i", IDПроекта)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьПроект", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьПроект
    // Получает информацию о проекте по ID
    //
    // URL   - Строка: URL сервера ReportPortal
    // Токен - Строка: Токен доступа
    // Имя   - Строка: Имя проекта
    метод ПолучитьПроект(URL: Объект?, Токен: Объект?, Имя: Объект?): Объект?
        
