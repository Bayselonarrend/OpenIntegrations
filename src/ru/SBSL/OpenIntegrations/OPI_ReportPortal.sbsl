    @Глобально
    // Метод ПолучитьСтруктуруЗапуска
    // Получает структуру параметров запуска
    //
    // Пустая          - Булево: Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей (необяз. по ум. - false)
    // КакСоответствие - Булево: Истина > возвращает поля фильтра как соответствие (необяз. по ум. - false)
    метод ПолучитьСтруктуруЗапуска(Пустая: Объект? = Неопределено, КакСоответствие: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Пустая)
        Опции.Вставить("-m", КакСоответствие)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруЗапуска", Опции)
        
    ;

