        Опции.Вставить("-t", Токен)
        Опции.Вставить("-n", Имя)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПроект", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьПроекты
    // Получает список существующих проектов
    //
    // URL      - Строка: URL сервера ReportPortal
    // Токен    - Строка: Токен доступа
    // Страница - Число: Номер страницы списка (необяз. по ум. - 1)
    метод ПолучитьПроекты(URL: Объект?, Токен: Объект?, Страница: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Страница)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПроекты", Опции)
        
    ;

    @Глобально
    // Метод ДобавитьПользователейВПроект
    // Добавляет пользователей в указанный проект
    //
    // URL                 - Строка: URL сервера ReportPortal
    // Токен               - Строка: Токен доступа
    // ИмяПроекта          - Строка: Имя проекта
    // СписокПользователей - Соответствие Из КлючИЗначение: Пользователи: Ключ > имя, Значение > роль
    метод ДобавитьПользователейВПроект(URL: Объект?, Токен: Объект?, ИмяПроекта: Объект?, СписокПользователей: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", ИмяПроекта)
        Опции.Вставить("-s", СписокПользователей)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ДобавитьПользователейВПроект", Опции)
        
    ;

    @Глобально
    // Метод ИсключитьПользователейИзПроекта
    // Исключает пользователей из указанного проекта
    //
    // URL                 - Строка: URL сервера ReportPortal
    // Токен               - Строка: Токен доступа
    // ИмяПроекта          - Строка: Имя проекта
    // МассивПользователей - Массив Из Строка: Массив имен пользователей
    метод ИсключитьПользователейИзПроекта(URL: Объект?, Токен: Объект?, ИмяПроекта: Объект?, МассивПользователей: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", ИмяПроекта)
        Опции.Вставить("-s", МассивПользователей)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИсключитьПользователейИзПроекта", Опции)
        
    ;

    @Глобально
    // Метод СоздатьЗапуск
    // Запускает новый сеанс выполнения тестов
    //
    // URL              - Строка: URL сервера ReportPortal
    // Токен            - Строка: Токен доступа
    // Проект           - Строка: ID проекта
    // СтруктураЗапуска - Структура Из КлючИЗначение: Параметры запуска. См. ПолучитьСтруктуруЗапуска
    метод СоздатьЗапуск(URL: Объект?, Токен: Объект?, Проект: Объект?, СтруктураЗапуска: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Проект)
        Опции.Вставить("-r", СтруктураЗапуска)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьЗапуск", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьЗапуск
    // Получает информацию о запуске по UUID
    //
    // URL         - Строка: URL сервера ReportPortal
    // Токен       - Строка: Токен доступа
    // Проект      - Строка: ID проекта
    // UUIDЗапуска - Строка: UUID запуска
    метод ПолучитьЗапуск(URL: Объект?, Токен: Объект?, Проект: Объект?, UUIDЗапуска: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Проект)
        Опции.Вставить("-d", UUIDЗапуска)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьЗапуск", Опции)
        
    ;

    @Глобально
    // Метод ИзменитьЗапуск
    // Изменяет данные запуска сеанса тестирования
    //
    // URL              - Строка: URL сервера ReportPortal
    // Токен            - Строка: Токен доступа
    // Проект           - Строка: ID проекта
    // IDЗапуска        - Число: ID запуска
    // СтруктураЗапуска - Структура Из КлючИЗначение: Параметры запуска. См. ПолучитьСтруктуруЗапуска
    метод ИзменитьЗапуск(URL: Объект?, Токен: Объект?, Проект: Объект?, IDЗапуска: Объект?, СтруктураЗапуска: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Проект)
        Опции.Вставить("-i", IDЗапуска)
        Опции.Вставить("-r", СтруктураЗапуска)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьЗапуск", Опции)
        
    ;

    @Глобально
    // Метод ЗавершитьЗапуск
    // Завершает запущенный ранее сеанс выполнения тестов
    //
    // URL                 - Строка: URL сервера ReportPortal
    // Токен               - Строка: Токен доступа
    // Проект              - Строка: ID проекта
    // UUIDЗапуска         - Строка: UUID запуска
    // СтруктураЗавершения - Структура Из КлючИЗначение: Параметры завершения. См. ПолучитьСтруктуруЗавершенияЗапуска
    метод ЗавершитьЗапуск(URL: Объект?, Токен: Объект?, Проект: Объект?, UUIDЗапуска: Объект?, СтруктураЗавершения: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Проект)
        Опции.Вставить("-d", UUIDЗапуска)
        Опции.Вставить("-r", СтруктураЗавершения)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗавершитьЗапуск", Опции)
        
    ;

    @Глобально
    // Метод УдалитьЗапуск
    // Удаляет сессию тестирования по ID
    //
    // URL       - Строка: URL сервера ReportPortal
    // Токен     - Строка: Токен доступа
    // Проект    - Строка: ID проекта
    // IDЗапуска - Число: ID запуска
    метод УдалитьЗапуск(URL: Объект?, Токен: Объект?, Проект: Объект?, IDЗапуска: Объект?): Объект?
        
