    @Глобально
    // Метод УдалитьЛог
    // Удаляет элемент лога по ID
    //
    // URL    - Строка: URL сервера ReportPortal
    // Токен  - Строка: Токен доступа
    // Проект - Строка: ID проекта
    // IDЛога - Число: ID лога
    метод УдалитьЛог(URL: Объект?, Токен: Объект?, Проект: Объект?, IDЛога: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Токен)
        Опции.Вставить("-p", Проект)
        Опции.Вставить("-i", IDЛога)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьЛог", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтруктуруЛога
    // Получает структуру параметров для записи лога
    //
    // IDЗапуска  - Строка: ID запуска, к которому принадлежит тестовый элемент
    // IDЭлемента - Строка: ID тестового элемента
    // Время      - Дата: Дата и время записи лога
    // Текст      - Строка: Текстовая информация лога (необяз. по ум. - Пустое значение)
    // Уровень    - Строка: Уровень информации: error, warn, info, debug, trace, fatal, unknown (необяз. по ум. - info)
    метод ПолучитьСтруктуруЛога(IDЗапуска: Объект?, IDЭлемента: Объект?, Время: Объект?, Текст: Объект? = Неопределено, Уровень: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", IDЗапуска)
        Опции.Вставить("-i", IDЭлемента)
        Опции.Вставить("-t", Время)
        Опции.Вставить("-x", Текст)
        Опции.Вставить("-v", Уровень)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруЛога", Опции)
        
    ;
    
;