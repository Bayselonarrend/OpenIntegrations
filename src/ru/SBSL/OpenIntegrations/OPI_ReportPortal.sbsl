    @Глобально
    // Метод ПолучитьСтруктуруЗавершенияЗапуска
    // Получает структуру параметров завершения тестового сеанса
    //
    // Время    - Дата: Дата и время завершения запуска
    // Статус   - Строка: Статус завершения: passed, failed, stopped, skipped, interrupted, cancelled (необяз. по ум. - Пустое значение)
    // Описание - Строка: Описание запуска. Перезаписывает указанное при создании (необяз. по ум. - Пустое значение)
    // Атрибуты - Строка: Атрибуты запуска. Перезаписывает указанное при создании (необяз. по ум. - Пустое значение)
    метод ПолучитьСтруктуруЗавершенияЗапуска(Время: Объект?, Статус: Объект? = Неопределено, Описание: Объект? = Неопределено, Атрибуты: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Время)
        Опции.Вставить("-s", Статус)
        Опции.Вставить("-d", Описание)
        Опции.Вставить("-a", Атрибуты)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруЗавершенияЗапуска", Опции)
        
    ;

