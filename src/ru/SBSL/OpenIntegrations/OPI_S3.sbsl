#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_S3
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_S3(Исполнитель)
    
;

@Локально
структура OPI_S3
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "s3"
    
    @Глобально
    // Метод ПолучитьСтруктуруДанных
    // Возвращает основные данные запроса в структурированном виде
    //
    // URL       - Строка: URL: домен для обычных методов или полный URL с параметрами для прямой отправки запросов
    // AccessKey - Строка: Access key для авторизации
    // SecretKey - Строка: Secret key для авторизации
    // Region    - Строка: Регион сервиса
    // Service   - Строка: Вид сервиса, если отличен от s3 (необяз. по ум. - s3)
    метод ПолучитьСтруктуруДанных(URL: Объект?, AccessKey: Объект?, SecretKey: Объект?, Region: Объект?, Service: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-a", AccessKey)
        Опции.Вставить("-s", SecretKey)
        Опции.Вставить("-r", Region)
        Опции.Вставить("-v", Service)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруДанных", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьЗапросБезТела
    // Отправляет простой http запрос без тела
    //
    // Метод             - Строка: HTTP метод
    // ОсновныеДанные    - Структура Из КлючИЗначение: Основные данные запроса (c полным URL). См. ПолучитьСтруктуруДанных
    // ОжидаютсяДвоичные - Булево: Отключает попытку преобразования ответа в JSON (необяз. по ум. - false)
    // Заголовки         - Соответствие Из КлючИЗначение: Дополнительные заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод ОтправитьЗапросБезТела(Метод: Объект?, ОсновныеДанные: Объект?, ОжидаютсяДвоичные: Объект? = Неопределено, Заголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-m", Метод)
        Опции.Вставить("-b", ОсновныеДанные)
        Опции.Вставить("-n", ОжидаютсяДвоичные)
        Опции.Вставить("-h", Заголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьЗапросБезТела", Опции)
        
    ;

    @Глобально
    // Метод ОтправитьЗапросСТелом
    // Отправляет http запрос с телом
    //
    // Метод             - Строка: HTTP метод
    // ОсновныеДанные    - Структура Из КлючИЗначение: Основные данные запроса (c полным URL). См. ПолучитьСтруктуруДанных
    // Тело              - Строка, ДвоичныеДанные: Двоичное тело запроса или путь к файлу
    // ОжидаютсяДвоичные - Булево: Отключает попытку преобразования ответа в JSON (необяз. по ум. - false)
    // Заголовки         - Соответствие Из КлючИЗначение: Дополнительные заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод ОтправитьЗапросСТелом(Метод: Объект?, ОсновныеДанные: Объект?, Тело: Объект?, ОжидаютсяДвоичные: Объект? = Неопределено, Заголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-m", Метод)
        Опции.Вставить("-b", ОсновныеДанные)
        Опции.Вставить("-d", Тело)
        Опции.Вставить("-n", ОжидаютсяДвоичные)
        Опции.Вставить("-h", Заголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьЗапросСТелом", Опции)
        
    ;

    @Глобально
    // Метод СоздатьБакет
    // Создает новый бакет с выбранным именем
    //
    // Наименование   - Строка: Наименование бакета
    // ОсновныеДанные - Структура Из КлючИЗначение: Основные данные запроса. См. ПолучитьСтруктуруДанных
    // Каталог        - Булево: Истина > Path style URL, Ложь > Virtual hosted style URL (необяз. по ум. - false)
    // Заголовки      - Соответствие Из КлючИЗначение: Дополнительные заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод СоздатьБакет(Наименование: Объект?, ОсновныеДанные: Объект?, Каталог: Объект? = Неопределено, Заголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-n", Наименование)
        Опции.Вставить("-b", ОсновныеДанные)
        Опции.Вставить("-d", Каталог)
        Опции.Вставить("-h", Заголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьБакет", Опции)
        
    ;

    @Глобально
    // Метод УдалитьБакет
    // Удаляет бакет с выбранным именем
    //
    // Наименование   - Строка: Наименование бакета
    // ОсновныеДанные - Структура Из КлючИЗначение: Основные данные запроса. См. ПолучитьСтруктуруДанных
    // Каталог        - Булево: Истина > Path style URL, Ложь > Virtual hosted style URL (необяз. по ум. - false)
    // Заголовки      - Соответствие Из КлючИЗначение: Дополнительные заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод УдалитьБакет(Наименование: Объект?, ОсновныеДанные: Объект?, Каталог: Объект? = Неопределено, Заголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-n", Наименование)
        Опции.Вставить("-b", ОсновныеДанные)
        Опции.Вставить("-d", Каталог)
        Опции.Вставить("-h", Заголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьБакет", Опции)
        
    ;

    @Глобально
    // Метод ПроверитьДоступностьБакета
    // Проверяет доступность бакета для текущего аккаунта или аккаунта по ID
    //
    // Наименование   - Строка: Наименование бакета
    // ОсновныеДанные - Структура Из КлючИЗначение: Основные данные запроса. См. ПолучитьСтруктуруДанных
    // Каталог        - Булево: Истина > Path style URL, Ложь > Virtual hosted style URL (необяз. по ум. - false)
    // IDАккаунта     - Строка: ID аккаунта для проверки, что бакет принадлежит ему (необяз. по ум. - Пустое значение)
    // Заголовки      - Соответствие Из КлючИЗначение: Дополнительные заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод ПроверитьДоступностьБакета(Наименование: Объект?, ОсновныеДанные: Объект?, Каталог: Объект? = Неопределено, IDАккаунта: Объект? = Неопределено, Заголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-n", Наименование)
        Опции.Вставить("-b", ОсновныеДанные)
        Опции.Вставить("-d", Каталог)
        Опции.Вставить("-a", IDАккаунта)
        Опции.Вставить("-h", Заголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПроверитьДоступностьБакета", Опции)
        
    ;

    @Глобально
    // Метод УстановитьШифрованиеБакета
    // Устанавливает шифрование бакета по XML конфигурации
    //
    // Наименование    - Строка: Наименование бакета
    // ОсновныеДанные  - Структура Из КлючИЗначение: Основные данные запроса. См. ПолучитьСтруктуруДанных
    // XMLКонфигурация - Строка: XML строка или файл конфигурации шифрования
    // Каталог         - Булево: Истина > Path style URL, Ложь > Virtual hosted style URL (необяз. по ум. - false)
    // Заголовки       - Соответствие Из КлючИЗначение: Дополнительные заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод УстановитьШифрованиеБакета(Наименование: Объект?, ОсновныеДанные: Объект?, XMLКонфигурация: Объект?, Каталог: Объект? = Неопределено, Заголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-n", Наименование)
        Опции.Вставить("-b", ОсновныеДанные)
        Опции.Вставить("-c", XMLКонфигурация)
        Опции.Вставить("-d", Каталог)
        Опции.Вставить("-h", Заголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УстановитьШифрованиеБакета", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьШифрованиеБакета
    // Получает установленную ранее конфигурацию шифрования бакета
    //
    // Наименование   - Строка: Наименование бакета
    // ОсновныеДанные - Структура Из КлючИЗначение: Основные данные запроса. См. ПолучитьСтруктуруДанных
    // Каталог        - Булево: Истина > Path style URL, Ложь > Virtual hosted style URL (необяз. по ум. - false)
    // Заголовки      - Соответствие Из КлючИЗначение: Дополнительные заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод ПолучитьШифрованиеБакета(Наименование: Объект?, ОсновныеДанные: Объект?, Каталог: Объект? = Неопределено, Заголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-n", Наименование)
        Опции.Вставить("-b", ОсновныеДанные)
        Опции.Вставить("-d", Каталог)
        Опции.Вставить("-h", Заголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьШифрованиеБакета", Опции)
        
    ;

    @Глобально
    // Метод УдалитьШифрованиеБакета
    // Удаляет конфигурацию шифрования бакета
    //
    // Наименование   - Строка: Наименование бакета
    // ОсновныеДанные - Структура Из КлючИЗначение: Основные данные запроса. См. ПолучитьСтруктуруДанных
    // Каталог        - Булево: Истина > Path style URL, Ложь > Virtual hosted style URL (необяз. по ум. - false)
    // Заголовки      - Соответствие Из КлючИЗначение: Дополнительные заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод УдалитьШифрованиеБакета(Наименование: Объект?, ОсновныеДанные: Объект?, Каталог: Объект? = Неопределено, Заголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
