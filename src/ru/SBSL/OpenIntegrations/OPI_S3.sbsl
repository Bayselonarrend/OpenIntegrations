#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Строка?|Executor.НастройкиИнтеграции): OPI_S3
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_S3(Исполнитель)
    
;

@Локально
структура OPI_S3
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "s3"
    
    @Глобально
    метод ПолучитьСтруктуруДанных(URL: Объект?, AccessKey: Объект?, SecretKey: Объект?, Region: Объект?, Service: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-a", AccessKey)
        Опции.Вставить("-s", SecretKey)
        Опции.Вставить("-r", Region)
        Опции.Вставить("-v", Service)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьСтруктуруДанных", Опции)
        
    ;

    @Глобально
    метод ОтправитьЗапросБезТела(Метод: Объект?, ОсновныеДанные: Объект?, ОжидаютсяДвоичные: Объект? = Неопределено, Заголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-m", Метод)
        Опции.Вставить("-b", ОсновныеДанные)
        Опции.Вставить("-n", ОжидаютсяДвоичные)
        Опции.Вставить("-h", Заголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ОтправитьЗапросБезТела", Опции)
        
    ;

