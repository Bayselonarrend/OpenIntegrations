        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьШифрованиеБакета", Опции)
        
    ;

    @Глобально
    // Метод УстановитьТегиБакета
    // Устанавливает набор тегов для бакета
    //
    // Наименование   - Строка: Наименование бакета
    // ОсновныеДанные - Структура Из КлючИЗначение: Основные данные запроса. См. ПолучитьСтруктуруДанных
    // Теги           - Структура Из КлючИЗначение: Набор тегов (ключ и значение) для установки
    // Каталог        - Булево: Истина > Path style URL, Ложь > Virtual hosted style URL (необяз. по ум. - false)
    // Заголовки      - Соответствие Из КлючИЗначение: Дополнительные заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод УстановитьТегиБакета(Наименование: Объект?, ОсновныеДанные: Объект?, Теги: Объект?, Каталог: Объект? = Неопределено, Заголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-n", Наименование)
        Опции.Вставить("-b", ОсновныеДанные)
        Опции.Вставить("-t", Теги)
        Опции.Вставить("-d", Каталог)
        Опции.Вставить("-h", Заголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УстановитьТегиБакета", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьТегиБакета
    // Получает набор тегов бакета
    //
    // Наименование   - Строка: Наименование бакета
    // ОсновныеДанные - Структура Из КлючИЗначение: Основные данные запроса. См. ПолучитьСтруктуруДанных
