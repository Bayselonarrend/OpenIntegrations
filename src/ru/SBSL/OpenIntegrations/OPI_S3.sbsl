    ;

    @Глобально
    // Метод УстановитьНастройкиВерсионированияБакета
    // Устанавливает настройки версионирования объектов бакета
    //
    // Наименование   - Строка: Наименование бакета
    // ОсновныеДанные - Структура Из КлючИЗначение: Основные данные запроса. См. ПолучитьСтруктуруДанных
    // Статус         - Булево: Включение и отключение версионирования, если необходимо (необяз. по ум. - Пустое значение)
    // УдалениеMFA    - Булево: Включение и отключение удаления MFA, если необходимо (необяз. по ум. - Пустое значение)
    // Каталог        - Булево: Истина > Path style URL, Ложь > Virtual hosted style URL (необяз. по ум. - false)
    // Заголовки      - Соответствие Из КлючИЗначение: Дополнительные заголовки запроса, если необходимо (необяз. по ум. - Пустое значение)
    метод УстановитьНастройкиВерсионированияБакета(Наименование: Объект?, ОсновныеДанные: Объект?, Статус: Объект? = Неопределено, УдалениеMFA: Объект? = Неопределено, Каталог: Объект? = Неопределено, Заголовки: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-n", Наименование)
        Опции.Вставить("-b", ОсновныеДанные)
        Опции.Вставить("-s", Статус)
        Опции.Вставить("-m", УдалениеMFA)
        Опции.Вставить("-d", Каталог)
        Опции.Вставить("-h", Заголовки)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УстановитьНастройкиВерсионированияБакета", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьНастройкиВерсионированияБакета
    // Получает значения настроек версионирования объектов в бакете
    //
    // Наименование   - Строка: Наименование бакета
    // ОсновныеДанные - Структура Из КлючИЗначение: Основные данные запроса. См. ПолучитьСтруктуруДанных
