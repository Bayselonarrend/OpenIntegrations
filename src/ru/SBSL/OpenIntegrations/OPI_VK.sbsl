#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_VK
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_VK(Исполнитель)
    
;

@Локально
структура OPI_VK
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "vk"
    
    @Глобально
    // Метод СоздатьСсылкуПолученияТокена
    // Получение ссылки для интерактивного получения токена (access_token), который необходим
    //
    // app_id - Строка, Число: app_id из настроек приложения
    метод СоздатьСсылкуПолученияТокена(app_id: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", app_id)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьСсылкуПолученияТокена", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьПараметрыАвторизации
    // Получает структуру параметров авторизации
    //
    // IDГруппы         - Строка, Число: ID целевой группы
    // IDПриложения     - Строка, Число: ID приложения
    // ТокенАвторизации - Строка: Токен авторизации
    метод ПолучитьПараметрыАвторизации(IDГруппы: Объект?, IDПриложения: Объект?, ТокенАвторизации: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-g", IDГруппы)
        Опции.Вставить("-a", IDПриложения)
        Опции.Вставить("-t", ТокенАвторизации)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПараметрыАвторизации", Опции)
        
    ;

    @Глобально
    // Метод СоздатьПост
    // Создает пост с картинками
    //
    // Текст            - Строка: Текст поста
    // МассивКартинок   - Массив из Строка, ДвоичныеДанные: Массив картинок
    // Реклама          - Булево: Признак ""Это реклама"" (необяз. по ум. - false)
    // СсылкаПодЗаписью - Строка: Ссылка (URL) под записью (необяз. по ум. - Пустое значение)
    // Параметры        - Структура из Строка: Параметры авторизации. См. ПолучитьПараметрыАвторизации (необяз. по ум. - Пустое значение)
    метод СоздатьПост(Текст: Объект?, МассивКартинок: Объект?, Реклама: Объект? = Неопределено, СсылкаПодЗаписью: Объект? = Неопределено, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Текст)
        Опции.Вставить("-p", МассивКартинок)
        Опции.Вставить("-a", Реклама)
        Опции.Вставить("-u", СсылкаПодЗаписью)
        Опции.Вставить("-h", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьПост", Опции)
        
    ;

    @Глобально
    // Метод СоздатьСоставнойПост
    // Создает пост на основе массива идентификаторов объектов (картинок, видео и др.)
    //
    // Текст            - Строка: Текст поста
    // Объекты          - Массив из Строка: Массив идентификаторов вида photo123_123
    // Реклама          - Булево: Признак ""Это реклама"" (необяз. по ум. - false)
    // СсылкаПодЗаписью - Строка: Ссылка (URL) под записью (необяз. по ум. - Пустое значение)
    // Параметры        - Структура из Строка: Параметры авторизации. См. ПолучитьПараметрыАвторизации (необяз. по ум. - Пустое значение)
    метод СоздатьСоставнойПост(Текст: Объект?, Объекты: Объект?, Реклама: Объект? = Неопределено, СсылкаПодЗаписью: Объект? = Неопределено, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Текст)
        Опции.Вставить("-o", Объекты)
        Опции.Вставить("-a", Реклама)
        Опции.Вставить("-u", СсылкаПодЗаписью)
        Опции.Вставить("-h", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьСоставнойПост", Опции)
        
    ;

    @Глобально
    // Метод УдалитьПост
    // Удаляет пост по id
    //
    // IDПоста   - Строка, Число: ID поста
    // Параметры - Структура из Строка: Параметры авторизации. См. ПолучитьПараметрыАвторизации (необяз. по ум. - Пустое значение)
    метод УдалитьПост(IDПоста: Объект?, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-p", IDПоста)
        Опции.Вставить("-a", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьПост", Опции)
        
    ;

    @Глобально
    // Метод СоздатьОпрос
    // Создает опрос с вариантами ответа
    //
    // Вопрос        - Строка: Вопрос опроса
    // МассивОтветов - Массив из Строка: Массив вариантов ответа
    // Картинка      - Строка, ДвоичныеДанные: Картинка опроса. Обязательна, если нет текста (необяз. по ум. - Пустое значение)
    // Текст         - Строка: Текст поста. Обязателен, если нет картинки (необяз. по ум. - Пустое значение)
    // Параметры     - Структура из Строка: Параметры авторизации. См. ПолучитьПараметрыАвторизации (необяз. по ум. - Пустое значение)
    метод СоздатьОпрос(Вопрос: Объект?, МассивОтветов: Объект?, Картинка: Объект? = Неопределено, Текст: Объект? = Неопределено, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-q", Вопрос)
        Опции.Вставить("-o", МассивОтветов)
        Опции.Вставить("-p", Картинка)
        Опции.Вставить("-t", Текст)
        Опции.Вставить("-a", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьОпрос", Опции)
        
    ;

    @Глобально
    // Метод СоздатьАльбом
    // Создает альбом для хранения картинок
    //
    // Наименование - Строка: Наименование альбома
    // Описание     - Строка: Описание альбома (необяз. по ум. - Пустое значение)
    // Параметры    - Структура из Строка: Параметры авторизации. См. ПолучитьПараметрыАвторизации (необяз. по ум. - Пустое значение)
    метод СоздатьАльбом(Наименование: Объект?, Описание: Объект? = Неопределено, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Наименование)
        Опции.Вставить("-d", Описание)
        Опции.Вставить("-a", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьАльбом", Опции)
        
    ;

    @Глобально
    // Метод УдалитьАльбом
    // Удаляет ранее созданный альбом
    //
    // IDАльбома - Строка, Число: ID альбома
    // Параметры - Структура из Строка: Параметры авторизации. См. ПолучитьПараметрыАвторизации (необяз. по ум. - Пустое значение)
    метод УдалитьАльбом(IDАльбома: Объект?, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", IDАльбома)
        Опции.Вставить("-t", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьАльбом", Опции)
        
    ;

    @Глобально
    // Метод СоздатьИсторию
    // Создает историю из картинки
    //
    // Картинка  - Строка, ДвоичныеДанные: Фон истории
    // URL       - Строка: URL для кнопки под историей (необяз. по ум. - Пустое значение)
    // Параметры - Структура из Строка: Параметры авторизации. См. ПолучитьПараметрыАвторизации (необяз. по ум. - Пустое значение)
    метод СоздатьИсторию(Картинка: Объект?, URL: Объект? = Неопределено, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-p", Картинка)
        Опции.Вставить("-u", URL)
        Опции.Вставить("-a", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьИсторию", Опции)
        
    ;

    @Глобально
    // Метод СохранитьКартинкуВАльбом
    // Сохраняет картинку в альбом сообщества
    //
    // IDАльбома - Строка, Число: ID альбома
    // Картинка  - ДвоичныеДанные, Строка: Файл картинки
    // Описание  - Строка: Описание картинки (необяз. по ум. - Пустое значение)
    // Параметры - Структура из Строка: Параметры авторизации. См. ПолучитьПараметрыАвторизации (необяз. по ум. - Пустое значение)
    метод СохранитьКартинкуВАльбом(IDАльбома: Объект?, Картинка: Объект?, Описание: Объект? = Неопределено, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", IDАльбома)
        Опции.Вставить("-p", Картинка)
        Опции.Вставить("-d", Описание)
        Опции.Вставить("-t", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СохранитьКартинкуВАльбом", Опции)
        
    ;

    @Глобально
    // Метод УдалитьКартинку
    // Удалить картинку из альбома
    //
    // IDКартинки - Строка, Число: ID картинки
    // Параметры  - Структура из Строка: Параметры авторизации. См. ПолучитьПараметрыАвторизации (необяз. по ум. - Пустое значение)
    метод УдалитьКартинку(IDКартинки: Объект?, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-p", IDКартинки)
        Опции.Вставить("-a", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьКартинку", Опции)
        
    ;

    @Глобально
    // Метод ЗагрузитьВидеоНаСервер
    // Загружает видео в группу с возможностью его дальнейшего использования
    //
    // Видео        - Строка, ДвоичныеДанные: Файл видео
    // Наименование - Строка: Наименование видео
    // Описание     - Строка: Описание видео (необяз. по ум. - Пустое значение)
    // Альбом       - Строка: ID альбома, если необходимо (необяз. по ум. - Пустое значение)
    // Параметры    - Структура из Строка: Параметры авторизации. См. ПолучитьПараметрыАвторизации (необяз. по ум. - Пустое значение)
    метод ЗагрузитьВидеоНаСервер(Видео: Объект?, Наименование: Объект?, Описание: Объект? = Неопределено, Альбом: Объект? = Неопределено, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-f", Видео)
        Опции.Вставить("-t", Наименование)
        Опции.Вставить("-d", Описание)
        Опции.Вставить("-a", Альбом)
        Опции.Вставить("-h", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗагрузитьВидеоНаСервер", Опции)
        
    ;

    @Глобально
    // Метод ЗагрузитьФотоНаСервер
    // Загружает фото на сервер для его дальнейшего использования
    //
    // Картинка  - Строка, ДвоичныеДанные: Файл картинки
    // Параметры - Структура из Строка: Параметры авторизации. См. ПолучитьПараметрыАвторизации (необяз. по ум. - Пустое значение)
    // Вид       - Строка: Вид загрузки (Пост, Товар, История, Опрос, Прочее) (необяз. по ум. - Пост)
    метод ЗагрузитьФотоНаСервер(Картинка: Объект?, Параметры: Объект? = Неопределено, Вид: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-f", Картинка)
        Опции.Вставить("-a", Параметры)
        Опции.Вставить("-t", Вид)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ЗагрузитьФотоНаСервер", Опции)
        
    ;

    @Глобально
    // Метод СделатьРепост
    // Делает репост записи
    //
    // IDПоста      - Строка, Число: ID поста
    // IDСтены      - Строка, Число: ID стены расположения поста (необяз. по ум. - Пустое значение)
    // ЦелеваяСтена - Строка, Число: ID целевой стены или группы (необяз. по ум. - Пустое значение)
    // Рекламный    - Булево: Признак рекламного поста (необяз. по ум. - false)
    // Параметры    - Структура из Строка: Параметры авторизации. См. ПолучитьПараметрыАвторизации (необяз. по ум. - Пустое значение)
    метод СделатьРепост(IDПоста: Объект?, IDСтены: Объект? = Неопределено, ЦелеваяСтена: Объект? = Неопределено, Рекламный: Объект? = Неопределено, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-p", IDПоста)
        Опции.Вставить("-f", IDСтены)
        Опции.Вставить("-t", ЦелеваяСтена)
        Опции.Вставить("-a", Рекламный)
        Опции.Вставить("-h", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СделатьРепост", Опции)
        
    ;

    @Глобально
    // Метод НаписатьСообщение
    // Написать сообщение пользователю в диалоге сообщества
    //
    // Текст          - Строка: Текст сообщения
    // IDПользователя - Строка: ID пользователя адресата
    // Communitytoken - Строка: Токен бота чата сообщества, который можно получить в настройках
    // Клавиатура     - Строка: JSON клавиатуры. См. СформироватьКлавиатуру (необяз. по ум. - Пустое значение)
    // Параметры      - Структура из Строка: Параметры авторизации. См. ПолучитьПараметрыАвторизации (необяз. по ум. - Пустое значение)
    метод НаписатьСообщение(Текст: Объект?, IDПользователя: Объект?, Communitytoken: Объект?, Клавиатура: Объект? = Неопределено, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Текст)
        Опции.Вставить("-u", IDПользователя)
        Опции.Вставить("-c", Communitytoken)
        Опции.Вставить("-k", Клавиатура)
        Опции.Вставить("-a", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "НаписатьСообщение", Опции)
        
    ;

    @Глобально
    // Метод НаписатьКомментарий
    // Создает комментарий под выбранной записью
    //
    // IDПоста   - Строка, Число: ID целевого поста
    // IDСтены   - Строка, Число: ID стены расположения поста
    // Текст     - Строка: Текст комментария
    // Параметры - Структура из Строка: Параметры авторизации. См. ПолучитьПараметрыАвторизации (необяз. по ум. - Пустое значение)
    метод НаписатьКомментарий(IDПоста: Объект?, IDСтены: Объект?, Текст: Объект?, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-p", IDПоста)
        Опции.Вставить("-w", IDСтены)
        Опции.Вставить("-t", Текст)
        Опции.Вставить("-a", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "НаписатьКомментарий", Опции)
        
    ;

    @Глобально
    // Метод СократитьСсылку
    // Создает сокращенный URL из обычного
    //
    // URL       - Строка: URL для сокращения
    // Параметры - Структура из Строка: Параметры авторизации. См. ПолучитьПараметрыАвторизации (необяз. по ум. - Пустое значение)
    метод СократитьСсылку(URL: Объект?, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-a", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СократитьСсылку", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьСтатистику
    // Получает общую статистику сообщества за период
    //
    // ДатаНачала    - Дата: Дата начала периода
    // ДатаОкончания - Дата: Дата окончания периода
    // Параметры     - Структура из Строка: Параметры авторизации. См. ПолучитьПараметрыАвторизации (необяз. по ум. - Пустое значение)
    метод ПолучитьСтатистику(ДатаНачала: Объект?, ДатаОкончания: Объект?, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", ДатаНачала)
