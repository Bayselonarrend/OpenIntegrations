#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Строка?|Executor.НастройкиИнтеграции): OPI_VK
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(Конфигурация)
    возврат новый OPI_VK(Исполнитель)
    
;

@Локально
структура OPI_VK
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "vk"
    
    @Глобально
    метод СоздатьСсылкуПолученияТокена(app_id: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", app_id)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьСсылкуПолученияТокена", Опции)
        
    ;

    @Глобально
    метод ПолучитьПараметрыАвторизации(IDГруппы: Объект?, IDПриложения: Объект?, ТокенАвторизации: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-g", IDГруппы)
        Опции.Вставить("-a", IDПриложения)
        Опции.Вставить("-t", ТокенАвторизации)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьПараметрыАвторизации", Опции)
        
    ;

    @Глобально
    метод СоздатьПост(Текст: Объект?, МассивКартинок: Объект?, Реклама: Объект? = Неопределено, СсылкаПодЗаписью: Объект? = Неопределено, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Текст)
        Опции.Вставить("-p", МассивКартинок)
        Опции.Вставить("-a", Реклама)
        Опции.Вставить("-u", СсылкаПодЗаписью)
        Опции.Вставить("-h", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "СоздатьПост", Опции)
        
    ;

