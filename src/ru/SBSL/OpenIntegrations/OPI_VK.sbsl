        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-v", Значение)
        Опции.Вставить("-p", Свойство)
        Опции.Вставить("-a", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ДобавитьВариантСвойстваТовара", Опции)
        
    ;

    @Глобально
    // Метод ИзменитьВариантСвойстваТовара
    // Изменяет значение варианта существующего свойства товара
    //
    // Значение  - Строка: Новое значение свойства
    // Свойство  - Строка, Число: ID свойства
    // Вариант   - Строка, Число: ID варианта
    // Параметры - Структура из Строка: Параметры авторизации. См. ПолучитьПараметрыАвторизации (необяз. по ум. - Пустое значение)
    метод ИзменитьВариантСвойстваТовара(Значение: Объект?, Свойство: Объект?, Вариант: Объект?, Параметры: Объект? = Неопределено): Объект?
        
