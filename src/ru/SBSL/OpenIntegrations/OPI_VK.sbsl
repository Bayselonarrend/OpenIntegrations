    // Изменяет существующее свойство товара
    //
    // Название  - Строка: Новое название
    // Свойство  - Строка, Число: ID свойства
    // Параметры - Структура из Строка: Параметры авторизации. См. ПолучитьПараметрыАвторизации (необяз. по ум. - Пустое значение)
    метод ИзменитьСвойствоТовара(Название: Объект?, Свойство: Объект?, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Название)
        Опции.Вставить("-p", Свойство)
        Опции.Вставить("-a", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьСвойствоТовара", Опции)
        
    ;

    @Глобально
