    метод УдалитьПодборку(Подборка: Объект?, Параметры: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Подборка)
        Опции.Вставить("-a", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "УдалитьПодборку", Опции)
        
    ;

    @Глобально
