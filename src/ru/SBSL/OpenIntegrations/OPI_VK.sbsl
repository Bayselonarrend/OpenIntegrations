        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Название)
        Опции.Вставить("-s", Подборка)
        Опции.Вставить("-p", Картинка)
        Опции.Вставить("-m", Основная)
        Опции.Вставить("-h", Скрытая)
        Опции.Вставить("-a", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьПодборкуТоваров", Опции)
        
    ;

