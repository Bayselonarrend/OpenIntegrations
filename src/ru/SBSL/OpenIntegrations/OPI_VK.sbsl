        Опции.Вставить("-v", Значение)
        Опции.Вставить("-p", Свойство)
        Опции.Вставить("-o", Вариант)
        Опции.Вставить("-a", Параметры)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ИзменитьВариантСвойстваТовара", Опции)
        
