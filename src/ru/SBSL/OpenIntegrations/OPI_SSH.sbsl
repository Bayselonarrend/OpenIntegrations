#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_SSH
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_SSH(Исполнитель)
    
;

@Локально
структура OPI_SSH
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "ssh"
    
    @Глобально
    // Метод ПолучитьКонфигурациюСоединения
    // Формирует полную структуру настроек соединения, которая может быть использована вместо самого соединения при вызове других функций
    //
    // НастройкиSSH - Структура Из КлючИЗначение: Настройки SSH
    // Прокси       - Структура Из КлючИЗначение: Настройки прокси, если необходимо. См. ПолучитьНастройкиПрокси (необяз. по ум. - Пустое значение)
    метод ПолучитьКонфигурациюСоединения(НастройкиSSH: Объект?, Прокси: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", НастройкиSSH)
        Опции.Вставить("-p", Прокси)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьКонфигурациюСоединения", Опции)
        
    ;

    @Глобально
    // Метод ВыполнитьКоманду
    // Выполняет указанную команду
    //
    // Соединение - Произвольный: Существующее соединение или конфигурация соединения
    // Команда    - Строка: Текст команды
    метод ВыполнитьКоманду(Соединение: Объект?, Команда: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Соединение)
        Опции.Вставить("-m", Команда)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ВыполнитьКоманду", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьНастройкиЛогинПароль
    // пароль)
    //
    // Хост   - Строка: Хост SSH
    // Порт   - Число: Порт SSH
    // Логин  - Строка: Имя пользователя SSH
    // Пароль - Строка: Пароль пользователя SSH (необяз. по ум. - Пустое значение)
    метод ПолучитьНастройкиЛогинПароль(Хост: Объект?, Порт: Объект?, Логин: Объект?, Пароль: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-h", Хост)
        Опции.Вставить("-p", Порт)
        Опции.Вставить("-u", Логин)
        Опции.Вставить("-s", Пароль)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиЛогинПароль", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьНастройкиПриватныйКлюч
    // Получает настройки соединения с авторизацией через приватный ключ
    //
    // Хост      - Строка: Хост SSH
    // Порт      - Число: Порт SSH
    // Логин     - Строка: Имя пользователя SSH
    // Приватный - Строка: Путь к файлу приватного ключа
    // Публичный - Строка: Путь к файлу публичного ключ (необяз. по ум. - Пустое значение)
    // Пароль    - Строка: Пароль (passphrase) приватного ключа (необяз. по ум. - Пустое значение)
    метод ПолучитьНастройкиПриватныйКлюч(Хост: Объект?, Порт: Объект?, Логин: Объект?, Приватный: Объект?, Публичный: Объект? = Неопределено, Пароль: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-h", Хост)
        Опции.Вставить("-p", Порт)
        Опции.Вставить("-u", Логин)
        Опции.Вставить("-k", Приватный)
        Опции.Вставить("-b", Публичный)
        Опции.Вставить("-s", Пароль)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиПриватныйКлюч", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьНастройкиЧерезАгента
    // Получает настройки соединения с авторизацией через SSH Agent
    //
    // Хост  - Строка: Хост SSH
    // Порт  - Число: Порт SSH
    // Логин - Строка: Имя пользователя SSH
    метод ПолучитьНастройкиЧерезАгента(Хост: Объект?, Порт: Объект?, Логин: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-h", Хост)
        Опции.Вставить("-p", Порт)
        Опции.Вставить("-u", Логин)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиЧерезАгента", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьНастройкиKI
    // Получает настройки соединения с keyboard-interactive авторизацией
    //
    // Хост         - Строка: Хост SSH
    // Порт         - Число: Порт SSH
    // Логин        - Строка: Имя пользователя SSH
    // ПорядокВвода - Массив Из Строка: Массив ответов на вопросы сервера
    метод ПолучитьНастройкиKI(Хост: Объект?, Порт: Объект?, Логин: Объект?, ПорядокВвода: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-h", Хост)
        Опции.Вставить("-p", Порт)
        Опции.Вставить("-u", Логин)
        Опции.Вставить("-r", ПорядокВвода)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиKI", Опции)
        
    ;

    @Глобально
    // Метод ПолучитьНастройкиПрокси
    // Формирует структуру настроек прокси-сервера для соединения
    //
    // Адрес  - Строка: Адрес прокси
    // Порт   - Число: Порт прокси
    // Вид    - Строка: Вид прокси: socks5, socks4, http (необяз. по ум. - socks5)
    // Логин  - Строка, Неопределено: Логин авторизации, если необходимо (необяз. по ум. - Пустое значение)
    // Пароль - Строка, Неопределено: Пароль для авторизации, если необходимо (необяз. по ум. - Пустое значение)
    метод ПолучитьНастройкиПрокси(Адрес: Объект?, Порт: Объект?, Вид: Объект? = Неопределено, Логин: Объект? = Неопределено, Пароль: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Адрес)
        Опции.Вставить("-p", Порт)
        Опции.Вставить("-t", Вид)
        Опции.Вставить("-l", Логин)
        Опции.Вставить("-s", Пароль)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ПолучитьНастройкиПрокси", Опции)
        
    ;
    
;