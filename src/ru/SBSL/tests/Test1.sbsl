#требуется ../OpenIntegrations

метод Тест1()

    пер Telegram = OPI_Telegram.Инициализировать()    
    пер Результат = Telegram.ОтправитьТекстовоеСообщение("1", "2", "Yo")
    
    Консоль.Записать(Результат)
;

метод Тест2()

    пер СтрокаЗапуска = "oint server http -p 1122 -j true"
    пер ИмяИсполняемогоФайла = "cmd.exe"

    пер Процесс = новый ПроцессОс(ИмяИсполняемогоФайла, ["/c", СтрокаЗапуска], Истина)
    Процесс.Запустить()                 
    
    Пауза(Длительность.ИзСекунд(3))
    
    Консоль.Записать(Процесс.ПолучитьПотокВывода().ПрочитатьКакСтроку())
    
    пер HttpКлиент = КлиентHttp.СБазовымUrl("http://localhost:1122")
    пер Telegram = OPI_Telegram.ЧерезHttp(HttpКлиент)
    
    пер Результат = Telegram.ОтправитьТекстовоеСообщение("1", "2", "Yo")
    
    Консоль.Записать(Результат)
    
    Процесс.Остановить()
            
;