#требуется ../OpenIntegrations

метод Тест1()

    пер Telegram = OPI_Telegram.Инициализировать()    
    пер Результат = Telegram.ОтправитьТекстовоеСообщение("1", "2", "Yo")
    
    Консоль.Записать(Результат)
;

метод Тест2()

    пер СтрокаЗапуска = "oint server http --enc UTF-8 -s %РазделительСообщений -b true"
    пер ИмяИсполняемогоФайла = "cmd.exe"

    пер Процесс = новый ПроцессОс(ИмяИсполняемогоФайла, ["/c", СтрокаЗапуска], Истина)
    Процесс.Запустить()
            
;