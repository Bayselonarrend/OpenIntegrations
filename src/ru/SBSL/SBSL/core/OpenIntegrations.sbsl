#совместимость 9.0

#требуется ./internal/Executor.sbsl 


структура OpenIntegrations
    
    обз пер Исполнитель: Executor.ИсполнительОПИ
    
    статический метод Модуль(ИмяМодуля: Строка, КонфигурационныйФайл: Строка?)
    
        пер ПутьКФайлу: Строка
        
        если КонфигурационныйФайл.Пусто() 
            ПутьКФайлу = "./config.json"
        иначе
            ПутьКФайлу = КонфигурационныйФайл
        ;
        
        
            
    ;
    
;