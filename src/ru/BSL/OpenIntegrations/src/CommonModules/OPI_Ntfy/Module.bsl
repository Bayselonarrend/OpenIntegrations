// Получить структуру параметров сообщения
// Получает структуру дополнительных параметров для отправки уведомления
//
// Примечание:
// Документация ntfy API: [docs.ntfy.sh/publish](@docs.ntfy.sh/publish)
//
// Параметры:
//  Пустая - Булево - Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей - empty
//
// Возвращаемое значение:
//  Структура Из КлючИЗначение - Структура полей
Функция ПолучитьСтруктуруПараметровСообщения(Знач Пустая = Ложь) Экспорт

    OPI_ПреобразованиеТипов.ПолучитьБулево(Пустая);

    СтруктураПолей = Новый Структура;
    СтруктураПолей.Вставить("Title"   , "<заголовок уведомления>");
    СтруктураПолей.Вставить("Priority", "<приоритет: min, low, default, high, max или число 1-5>");
    СтруктураПолей.Вставить("Tags"    , "<теги или эмодзи: строка или массив строк>");
    СтруктураПолей.Вставить("Click"   , "<URL, открываемый при нажатии на уведомление>");
    СтруктураПолей.Вставить("Attach"  , "<URL вложения>");
    СтруктураПолей.Вставить("Actions" , "<кнопки действий в формате ntfy>");
    СтруктураПолей.Вставить("Delay"   , "<отложенная отправка, например 10m или unix timestamp>");
    СтруктураПолей.Вставить("Email"   , "<email для пересылки уведомления>");
    СтруктураПолей.Вставить("Icon"    , "<URL иконки уведомления>");
    СтруктураПолей.Вставить("Markdown", "<истина > форматировать текст как Markdown>");

    Если Пустая Тогда
        СтруктураПолей = OPI_Инструменты.ОчиститьКоллекциюРекурсивно(СтруктураПолей);
    КонецЕсли;

    //@skip-check constructor-function-return-section
    Возврат СтруктураПолей;

КонецФункции

// Отправить сообщение
// Публикует уведомление в указанный топик
//
// Примечание:
// Документация ntfy API: [docs.ntfy.sh/publish](@docs.ntfy.sh/publish)
//
// Параметры:
//  URL        - Строка                        - URL сервера Ntfy. `ntfy.sh`, если не заполнено               - url
//  Топик      - Строка                        - Имя топика                                                   - topic
//  Сообщение  - Строка                        - Текст уведомления                                            - message
//  Токен      - Строка                        - Токен доступа к топику, если требуется                       - token
//  Параметры  - Структура Из КлючИЗначение    - Доп. параметры. См. ПолучитьСтруктуруПараметровСообщения     - options
//
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение - сериализованный JSON ответа от ntfy
Функция ОтправитьСообщение(Знач URL, Знач Топик, Знач Сообщение, Знач Токен = "", Знач Параметры = "") Экспорт

    OPI_ПреобразованиеТипов.ПолучитьСтроку(Топик);
    OPI_ПреобразованиеТипов.ПолучитьСтроку(Сообщение);

    URL = ПолучитьURL(URL);
    ДополнитьURL(URL, Топик);

    Заголовки = СформироватьЗаголовки(Токен, Параметры);

    Ответ = OPI_ЗапросыHTTP.PostСТелом(URL, Сообщение, Заголовки, Ложь);

    Возврат Ответ;

КонецФункции

#КонецОбласти

#Область Получение

// Получить структуру параметров фильтра
// Получает структуру параметров для получения сообщений из топика
//
// Примечание:
// Документация ntfy API: [docs.ntfy.sh/subscribe/api](@docs.ntfy.sh/subscribe/api)
//
// Параметры:
//  Пустая - Булево - Истина > структура с пустыми значениями, Ложь > в значениях будут описания полей - empty
//
// Возвращаемое значение:
//  Структура Из КлючИЗначение - Структура полей
Функция ПолучитьСтруктуруПараметровФильтра(Знач Пустая = Ложь) Экспорт

    OPI_ПреобразованиеТипов.ПолучитьБулево(Пустая);

    СтруктураПолей = Новый Структура;
    СтруктураПолей.Вставить("since", "<ID сообщения, начиная с которого нужно получить историю>");
    СтруктураПолей.Вставить("poll" , "<истина > long polling до появления нового сообщения>");
    СтруктураПолей.Вставить("limit", "<максимальное количество возвращаемых сообщений>");

    Если Пустая Тогда
        СтруктураПолей = OPI_Инструменты.ОчиститьКоллекциюРекурсивно(СтруктураПолей);
    КонецЕсли;

    //@skip-check constructor-function-return-section
    Возврат СтруктураПолей;

КонецФункции

// Получить сообщения
// Получает сообщения из топика в формате JSON
//
// Примечание:
// Документация ntfy API: [docs.ntfy.sh/subscribe/api](@docs.ntfy.sh/subscribe/api)
//
// Параметры:
//  URL     - Строка                     - URL сервера Ntfy. `ntfy.sh`, если не заполнено               - url
//  Топик   - Строка                     - Имя топика                                                   - topic
//  Токен   - Строка                     - Токен доступа к топику, если требуется                       - token
//  Фильтр  - Структура Из КлючИЗначение - Параметры отбора. См. ПолучитьСтруктуруПараметровФильтра     - filter
//
// Возвращаемое значение:
//  Массив - список сообщений топика
Функция ПолучитьСообщения(Знач URL, Знач Топик, Знач Токен = "", Знач Фильтр = "") Экспорт

    OPI_ПреобразованиеТипов.ПолучитьСтроку(Топик);

    URL = ПолучитьURL(URL);
    ДополнитьURL(URL, Топик + "/json");

    ПараметрыЗапроса = СформироватьПараметрыФильтра(Фильтр);
    Заголовки        = СформироватьЗаголовки(Токен);

    Ответ = OPI_ЗапросыHTTP.Get(URL, ПараметрыЗапроса, Заголовки);

    Возврат Ответ;

КонецФункции

#КонецОбласти

#Область Управление

// Удалить сообщение
// Удаляет сообщение из топика по ID
//
// Примечание:
// Документация ntfy API: [docs.ntfy.sh/subscribe/api](@docs.ntfy.sh/subscribe/api)
// Для удаления топик должен быть защищён и доступен по токену
//
// Параметры:
//  URL          - Строка - URL сервера Ntfy. `ntfy.sh`, если не заполнено               - url
//  Топик        - Строка - Имя топика                                                   - topic
//  IDСообщения  - Строка - ID удаляемого сообщения                                      - id
//  Токен        - Строка - Токен доступа к топику                                       - token
//
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение - сериализованный JSON ответа от ntfy
Функция УдалитьСообщение(Знач URL, Знач Топик, Знач IDСообщения, Знач Токен = "") Экспорт

    OPI_ПреобразованиеТипов.ПолучитьСтроку(Топик);
    OPI_ПреобразованиеТипов.ПолучитьСтроку(IDСообщения);

    URL = ПолучитьURL(URL);
    ДополнитьURL(URL, Топик + "/" + IDСообщения);

    Заголовки = СформироватьЗаголовки(Токен);

    Ответ = OPI_ЗапросыHTTP.Delete(URL, , Заголовки);

    Возврат Ответ;

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьURL(Знач URL)

    Если Не ЗначениеЗаполнено(URL) Тогда
        URL = "https://ntfy.sh";
    Иначе
        OPI_ПреобразованиеТипов.ПолучитьСтроку(URL);
    КонецЕсли;

    Возврат URL;

КонецФункции

Процедура ДополнитьURL(URL, Знач Путь)

    OPI_ПреобразованиеТипов.ПолучитьСтроку(Путь);

    URL = ?(СтрЗаканчиваетсяНа(URL, "/"), URL, URL + "/");
    URL = URL + Путь;

КонецПроцедуры

Функция СформироватьЗаголовки(Знач Токен, Знач Параметры = "")

    Заголовки = Новый Соответствие;

    Если ЗначениеЗаполнено(Токен) Тогда
        OPI_ПреобразованиеТипов.ПолучитьСтроку(Токен);
        Заголовки.Вставить("Authorization", "Bearer " + Токен);
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Параметры) Тогда
        Возврат Заголовки;
    КонецЕсли;

    ТекстОшибки = "Передана некорректная коллекция доп. параметров!";
    OPI_ПреобразованиеТипов.ПолучитьКоллекциюКлючИЗначение(Параметры, ТекстОшибки);

    СоответствиеЗаголовков = Новый Соответствие;
    СоответствиеЗаголовков.Вставить("Title"   , "Title");
    СоответствиеЗаголовков.Вставить("Priority", "Priority");
    СоответствиеЗаголовков.Вставить("Tags"    , "Tags");
    СоответствиеЗаголовков.Вставить("Click"   , "Click");
    СоответствиеЗаголовков.Вставить("Attach"  , "Attach");
    СоответствиеЗаголовков.Вставить("Actions" , "Actions");
    СоответствиеЗаголовков.Вставить("Delay"   , "Delay");
    СоответствиеЗаголовков.Вставить("Email"   , "Email");
    СоответствиеЗаголовков.Вставить("Icon"    , "Icon");
    СоответствиеЗаголовков.Вставить("Markdown", "Markdown");

    Для Каждого Параметр Из Параметры Цикл

        ИмяЗаголовка = СоответствиеЗаголовков[Параметр.Ключ];

        Если ИмяЗаголовка = Неопределено Тогда
            Продолжить;
        КонецЕсли;

        ЗначениеЗаголовка = Параметр.Значение;

        Если Параметр.Ключ = "Tags" Тогда
            ЗначениеЗаголовка = ПолучитьСтрокуТегов(ЗначениеЗаголовка);
        ИначеЕсли Параметр.Ключ = "Markdown" Тогда
            OPI_ПреобразованиеТипов.ПолучитьБулево(ЗначениеЗаголовка);
            ЗначениеЗаголовка = ?(ЗначениеЗаголовка, "yes", "no");
        КонецЕсли;

        OPI_Инструменты.ДобавитьПоле(ИмяЗаголовка, ЗначениеЗаголовка, "Строка", Заголовки);

    КонецЦикла;

    Возврат Заголовки;

КонецФункции

Функция ПолучитьСтрокуТегов(Знач Теги)

    Если ТипЗнч(Теги) = Тип("Массив") Тогда
        OPI_ПреобразованиеТипов.ПолучитьМассив(Теги);
        Возврат СтрСоединить(Теги, ",");
    КонецЕсли;

    OPI_ПреобразованиеТипов.ПолучитьСтроку(Теги);
    Возврат Теги;

КонецФункции

Функция СформироватьПараметрыФильтра(Знач Фильтр)

    ПараметрыЗапроса = Новый Структура;

    Если Не ЗначениеЗаполнено(Фильтр) Тогда
        Возврат ПараметрыЗапроса;
    КонецЕсли;

    ТекстОшибки = "Передана некорректная коллекция параметров фильтра!";
    OPI_ПреобразованиеТипов.ПолучитьКоллекциюКлючИЗначение(Фильтр, ТекстОшибки);

    OPI_Инструменты.ДобавитьПоле("since", Фильтр["since"], "Строка", ПараметрыЗапроса);
    OPI_Инструменты.ДобавитьПоле("limit", Фильтр["limit"], "Строка", ПараметрыЗапроса);

    Если Фильтр.Свойство("poll") Тогда
        ЗначениеPoll = Фильтр["poll"];
        OPI_ПреобразованиеТипов.ПолучитьБулево(ЗначениеPoll);
        OPI_Инструменты.ДобавитьПоле("poll", ?(ЗначениеPoll, "1", "0"), "Строка", ПараметрыЗапроса);
    КонецЕсли;

    Возврат ПараметрыЗапроса;

КонецФункции

#КонецОбласти

#КонецЕсли // !OPI
