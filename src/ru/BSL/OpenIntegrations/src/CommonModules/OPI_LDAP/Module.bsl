// Получить лог !NOCLI
// Получает данные лога соединения (при включенном логировании в память)
//
// Параметры:
//  Соединение   - Произвольный - Объект компоненты с открытым соединением                   - conn
//  КакСтрока    - Булево       - Истина > возвращает лог одной строкой, Ложь > как массив   - str
//  ЧислоСобытий - Число        - Число последних событий для получения. 0 > без ограничений - count
//
// Возвращаемое значение:
//  Строка, Соответствие Из КлючИЗначение - Лог как строка или соответствие с полным результатом выполнения
Функция ПолучитьЛог(Знач Соединение, Знач КакСтрока = Ложь, Знач ЧислоСобытий = 100) Экспорт

    Возврат OPI_Компоненты.ПолучитьЛог(Соединение
        , КакСтрока
        , ЧислоСобытий);

КонецФункции

#КонецОбласти

#Область РаботаСКаталогом

// ВыполнитьПоиск
// Выполняет LDAP-поиск
//
// Примечание:
// При передаче параметров соединения новое соединение будет создано и закрыто в рамках одного вызова
//
// Параметры:
//  Соединение - Произвольный, Структура Из КлючИЗначение - Соединение или параметры соединения - conn
//  База       - Строка                                   - Базовый DN поиска                   - base
//  Фильтр     - Строка                                   - LDAP-фильтр                         - filter
//  Атрибуты   - Массив Из Строка, Неопределено           - Список атрибутов для выборки        - attrs
//  Область    - Строка                                   - Область: base, one, subtree         - scope
//
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение - Результат поиска
Функция ВыполнитьПоиск(Знач Соединение
    , Знач База
    , Знач Фильтр = "(objectClass=*)"
    , Знач Атрибуты = Неопределено
    , Знач Область = "subtree") Экспорт

    ЗакрыватьСоединение = Ложь;

    Если ЭтоКоннектор(Соединение) Тогда
        Коннектор = Соединение;
    Иначе
        Коннектор          = ОткрытьСоединение(Соединение);
        ЗакрыватьСоединение = Истина;
    КонецЕсли;

    Если Не ЭтоКоннектор(Коннектор) Тогда
        Возврат Коннектор;
    КонецЕсли;

    OPI_ПреобразованиеТипов.ПолучитьСтроку(База);
    OPI_ПреобразованиеТипов.ПолучитьСтроку(Фильтр);
    OPI_ПреобразованиеТипов.ПолучитьСтроку(Область);

    Если ЗначениеЗаполнено(Атрибуты) Тогда
        OPI_ПреобразованиеТипов.ПолучитьМассив(Атрибуты);
    КонецЕсли;

    ПараметрыПоиска = Новый Структура;
    OPI_Инструменты.ДобавитьПоле("base"      , База     , "Строка", ПараметрыПоиска, Истина);
    OPI_Инструменты.ДобавитьПоле("filter"    , Фильтр   , "Строка", ПараметрыПоиска);
    OPI_Инструменты.ДобавитьПоле("scope"     , Область  , "Строка", ПараметрыПоиска);
    OPI_Инструменты.ДобавитьПоле("attributes", Атрибуты , "Массив", ПараметрыПоиска);

    СтрокаПараметров = OPI_Компоненты.СериализоватьJanx(ПараметрыПоиска);
    Результат        = Коннектор.Search(СтрокаПараметров);
    Результат        = OPI_Компоненты.ДесериализоватьJanx(Результат);

    Если ЗакрыватьСоединение Тогда
        ЗакрытьСоединение(Коннектор);
    КонецЕсли;

    Возврат Результат;

КонецФункции

// Добавить
// Добавляет запись в каталог LDAP
//
// Параметры:
//  Соединение - Произвольный, Структура Из КлючИЗначение - Соединение или параметры соединения - conn
//  DN         - Строка                                   - DN добавляемой записи               - dn
//  Атрибуты   - Структура Из КлючИЗначение               - Атрибуты записи                     - attrs
//
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение - Результат операции
Функция Добавить(Знач Соединение, Знач DN, Знач Атрибуты) Экспорт

    ЗакрыватьСоединение = Ложь;

    Если ЭтоКоннектор(Соединение) Тогда
        Коннектор = Соединение;
    Иначе
        Коннектор          = ОткрытьСоединение(Соединение);
        ЗакрыватьСоединение = Истина;
    КонецЕсли;

    Если Не ЭтоКоннектор(Коннектор) Тогда
        Возврат Коннектор;
    КонецЕсли;

    OPI_ПреобразованиеТипов.ПолучитьСтроку(DN);
    OPI_ПреобразованиеТипов.ПолучитьКоллекциюКлючИЗначение(Атрибуты);

    ПараметрыДобавления = Новый Структура;
    OPI_Инструменты.ДобавитьПоле("dn"        , DN      , "Строка", ПараметрыДобавления);
    OPI_Инструменты.ДобавитьПоле("attributes", Атрибуты, "КлючИЗначение", ПараметрыДобавления);

    СтрокаПараметров = OPI_Компоненты.СериализоватьJanx(ПараметрыДобавления);
    
    //@skip-check bsl-legacy-check-dynamic-feature-access
    Результат        = Коннектор.Add(СтрокаПараметров);
    Результат        = OPI_Компоненты.ДесериализоватьJanx(Результат);

    Если ЗакрыватьСоединение Тогда
        ЗакрытьСоединение(Коннектор);
    КонецЕсли;

    Возврат Результат;

КонецФункции

// Изменить
// Изменяет запись в каталоге LDAP
//
// Параметры:
//  Соединение - Произвольный, Структура Из КлючИЗначение - Соединение или параметры соединения - conn
//  DN         - Строка                                   - DN изменяемой записи                 - dn
//  Изменения  - Массив Из Структура                      - Список изменений атрибутов           - changes
//
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение - Результат операции
Функция Изменить(Знач Соединение, Знач DN, Знач Изменения) Экспорт

    ЗакрыватьСоединение = Ложь;

    Если ЭтоКоннектор(Соединение) Тогда
        Коннектор = Соединение;
    Иначе
        Коннектор          = ОткрытьСоединение(Соединение);
        ЗакрыватьСоединение = Истина;
    КонецЕсли;

    Если Не ЭтоКоннектор(Коннектор) Тогда
        Возврат Коннектор;
    КонецЕсли;

    OPI_ПреобразованиеТипов.ПолучитьСтроку(DN);
    OPI_ПреобразованиеТипов.ПолучитьМассив(Изменения);

    ПараметрыИзменения = Новый Структура;
    OPI_Инструменты.ДобавитьПоле("dn"     , DN        , "Строка", ПараметрыИзменения);
    OPI_Инструменты.ДобавитьПоле("changes", Изменения , "Массив", ПараметрыИзменения);

    СтрокаПараметров = OPI_Компоненты.СериализоватьJanx(ПараметрыИзменения);
    Результат        = Коннектор.Modify(СтрокаПараметров);
    Результат        = OPI_Компоненты.ДесериализоватьJanx(Результат);

    Если ЗакрыватьСоединение Тогда
        ЗакрытьСоединение(Коннектор);
    КонецЕсли;

    Возврат Результат;

КонецФункции

// Удалить
// Удаляет запись из каталога LDAP
//
// Параметры:
//  Соединение - Произвольный, Структура Из КлючИЗначение - Соединение или параметры соединения - conn
//  DN         - Строка                                   - DN удаляемой записи                 - dn
//
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение - Результат операции
Функция Удалить(Знач Соединение, Знач DN) Экспорт

    ЗакрыватьСоединение = Ложь;

    Если ЭтоКоннектор(Соединение) Тогда
        Коннектор = Соединение;
    Иначе
        Коннектор          = ОткрытьСоединение(Соединение);
        ЗакрыватьСоединение = Истина;
    КонецЕсли;

    Если Не ЭтоКоннектор(Коннектор) Тогда
        Возврат Коннектор;
    КонецЕсли;

    OPI_ПреобразованиеТипов.ПолучитьСтроку(DN);

    //@skip-check bsl-legacy-check-dynamic-feature-access
    Результат = Коннектор.Delete(DN);
    Результат = OPI_Компоненты.ДесериализоватьJanx(Результат);

    Если ЗакрыватьСоединение Тогда
        ЗакрытьСоединение(Коннектор);
    КонецЕсли;

    Возврат Результат;

КонецФункции

// Сравнить
// Сравнивает значение атрибута записи LDAP
//
// Параметры:
//  Соединение - Произвольный, Структура Из КлючИЗначение - Соединение или параметры соединения - conn
//  DN         - Строка                                   - DN записи                           - dn
//  Атрибут    - Строка                                   - Имя атрибута                        - attr
//  Значение   - Строка                                   - Ожидаемое значение                  - value
//
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение - Результат сравнения
Функция Сравнить(Знач Соединение, Знач DN, Знач Атрибут, Знач Значение) Экспорт

    ЗакрыватьСоединение = Ложь;

    Если ЭтоКоннектор(Соединение) Тогда
        Коннектор = Соединение;
    Иначе
        Коннектор          = ОткрытьСоединение(Соединение);
        ЗакрыватьСоединение = Истина;
    КонецЕсли;

    Если Не ЭтоКоннектор(Коннектор) Тогда
        Возврат Коннектор;
    КонецЕсли;

    OPI_ПреобразованиеТипов.ПолучитьСтроку(DN);
    OPI_ПреобразованиеТипов.ПолучитьСтроку(Атрибут);
    OPI_ПреобразованиеТипов.ПолучитьСтроку(Значение);

    ПараметрыСравнения = Новый Структура;
    OPI_Инструменты.ДобавитьПоле("dn"       , DN      , "Строка", ПараметрыСравнения);
    OPI_Инструменты.ДобавитьПоле("attribute", Атрибут , "Строка", ПараметрыСравнения);
    OPI_Инструменты.ДобавитьПоле("value"    , Значение, "Строка", ПараметрыСравнения);

    СтрокаПараметров = OPI_Компоненты.СериализоватьJanx(ПараметрыСравнения);
    Результат        = Коннектор.Compare(СтрокаПараметров);
    Результат        = OPI_Компоненты.ДесериализоватьJanx(Результат);

    Если ЗакрыватьСоединение Тогда
        ЗакрытьСоединение(Коннектор);
    КонецЕсли;

    Возврат Результат;

КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли // !OPI
