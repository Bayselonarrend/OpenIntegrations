// Открыть соединение !NOCLI
// Открывает LDAP-соединение и выполняет bind
//
// Параметры:
//  ПараметрыСоединения - Структура Из КлючИЗначение - Параметры соединения. См. СформироватьПараметрыСоединения - params
//  Tls                 - Структура Из КлючИЗначение - Настройки TLS, если необходимо. См. ПолучитьНастройкиTls  - tls
//  Логирование         - Структура Из КлючИЗначение - Настройки логирования. См. ПолучитьНастройкиЛогирования   - log
//
// Возвращаемое значение:
//  Произвольный - Объект коннектора или структура с информацией об ошибке
Функция ОткрытьСоединение(Знач ПараметрыСоединения, Знач Tls = Неопределено, Знач Логирование = Неопределено) Экспорт

    Result_ = "result";

    Если ЭтоКоннектор(ПараметрыСоединения) Тогда
        Возврат ПараметрыСоединения;
    КонецЕсли;

    OPI_ПреобразованиеТипов.ПолучитьКоллекциюКлючИЗначение(ПараметрыСоединения);

    МассивОбязательных = СтрРазделить("url,bind_dn,password,timeout", ",");
    МассивНедостающих  = OPI_Инструменты.НайтиОтсутствующиеПоляКоллекции(ПараметрыСоединения, МассивОбязательных);

    Если ЗначениеЗаполнено(МассивНедостающих) Тогда
        ВызватьИсключение СтрШаблон("Отсутствуют параметры подключения: %1", СтрСоединить(МассивНедостающих, ", "));
    КонецЕсли;

    Коннектор = OPI_Компоненты.ПолучитьКомпоненту("LDAP");

    Tls = OPI_Компоненты.УстановитьTls(Коннектор, Tls);

    Если Не OPI_Инструменты.ПолучитьИли(Tls, Result_, Ложь) Тогда
        Возврат Tls;
    КонецЕсли;

    Если Логирование = Неопределено Тогда

        СтрокаНастроек = "";

    Иначе

        ТекстОшибки    = "Некорректные настройки логирования";
        OPI_ПреобразованиеТипов.ПолучитьКоллекциюКлючИЗначение(Логирование, ТекстОшибки);
        СтрокаНастроек = OPI_Компоненты.СериализоватьJanx(Логирование);

    КонецЕсли;

    Если ЗначениеЗаполнено(СтрокаНастроек) Тогда

        РезультатЛога = Коннектор.SetLogger(СтрокаНастроек);
        РезультатЛога = OPI_Компоненты.ДесериализоватьJanx(РезультатЛога);

        Если Не РезультатЛога[Result_] Тогда
            Возврат РезультатЛога;
        КонецЕсли;

    КонецЕсли;

    URL     = ПараметрыСоединения["url"];
    BindDN  = ПараметрыСоединения["bind_dn"];
    Пароль  = ПараметрыСоединения["password"];
    Таймаут = ПараметрыСоединения["timeout"];

    OPI_ПреобразованиеТипов.ПолучитьСтроку(URL);
    OPI_ПреобразованиеТипов.ПолучитьСтроку(BindDN);
    OPI_ПреобразованиеТипов.ПолучитьСтроку(Пароль);
    OPI_ПреобразованиеТипов.ПолучитьЧисло(Таймаут);

    Результат = Коннектор.Connect(URL, BindDN, Пароль, Таймаут);
    Результат = OPI_Компоненты.ДесериализоватьJanx(Результат);

    Возврат ?(Результат[Result_], Коннектор, Результат);

КонецФункции

// Закрыть соединение !NOCLI
// Явно закрывает переданное соединение
//
// Параметры:
//  Соединение - Произвольный - Объект компоненты с открытым соединением - conn
//
// Возвращаемое значение:
//  Структура Из КлючИЗначение - Результат закрытия соединения
Функция ЗакрытьСоединение(Знач Соединение) Экспорт

    Если ЭтоКоннектор(Соединение) Тогда

        Результат = Соединение.Disconnect();
        Результат = OPI_Компоненты.ДесериализоватьJanx(Результат);

    Иначе

        Результат = Новый Структура("result,error", Ложь, "It's not a connection");

    КонецЕсли;

    //@skip-check constructor-function-return-section
    Возврат Результат;

КонецФункции

// Сформировать параметры соединения
// Формирует коллекцию параметров LDAP-соединения
//
// Параметры:
//  URL     - Строка - URL сервера (ldap: или ldaps:)     - url
//  BindDN  - Строка - DN для bind                        - bind
//  Пароль  - Строка - Пароль для bind                    - pass
//  Таймаут - Число  - Таймаут операций в секундах        - tout
//
// Возвращаемое значение:
//  Структура Из КлючИЗначение - Структура параметров соединения
Функция СформироватьПараметрыСоединения(Знач URL, Знач BindDN = "", Знач Пароль = "", Знач Таймаут = 30) Экспорт

    ПараметрыСоединения = Новый Структура;
    OPI_Инструменты.ДобавитьПоле("url"     , URL    , "Строка", ПараметрыСоединения);
    OPI_Инструменты.ДобавитьПоле("bind_dn" , BindDN , "Строка", ПараметрыСоединения);
    OPI_Инструменты.ДобавитьПоле("password", Пароль , "Строка", ПараметрыСоединения);
    OPI_Инструменты.ДобавитьПоле("timeout" , Таймаут, "Число" , ПараметрыСоединения);

    Возврат ПараметрыСоединения;

КонецФункции

// Получить конфигурацию соединения
// Возвращает текущие настройки открытого соединения
//
// Параметры:
//  Соединение - Произвольный - Объект компоненты с открытым соединением - conn
//
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение - Конфигурация соединения
Функция ПолучитьКонфигурациюСоединения(Знач Соединение) Экспорт

    Если Не ЭтоКоннектор(Соединение) Тогда
        Возврат Новый Структура("result,error", Ложь, "It's not a connection");
    КонецЕсли;

    Результат = Соединение.GetConfiguration();
    Результат = OPI_Компоненты.ДесериализоватьJanx(Результат);

    Возврат Результат;

КонецФункции

// Это коннектор !NOCLI
// Проверяет, что значение является объектом внешней компоненты LDAP
//
// Параметры:
//  Значение - Произвольный - Значение для проверки - value
//
// Возвращаемое значение:
//  Булево -  Это коннектор
Функция ЭтоКоннектор(Знач Значение) Экспорт

    Возврат Строка(ТипЗнч(Значение)) = "AddIn.OPI_LDAP.Main";

КонецФункции

