#совместимость 8.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Строка?|Executor.НастройкиИнтеграции): OPI_Ntfy
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(Конфигурация)
    возврат новый OPI_Ntfy(Исполнитель)
    
;

@Локально
структура OPI_Ntfy
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "ntfy"
    
    @Глобально
    метод GetMessageParametersStructure(Clear: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Clear)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetMessageParametersStructure", Опции)
        
    ;

    @Глобально
    метод SendMessage(URL: Объект?, Topic: Объект?, Message: Объект?, Token: Объект? = Неопределено, Parameters: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Topic)
        Опции.Вставить("-m", Message)
        Опции.Вставить("-k", Token)
        Опции.Вставить("-o", Parameters)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "SendMessage", Опции)
        
    ;

    @Глобально
    метод GetFilterParametersStructure(Clear: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Clear)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetFilterParametersStructure", Опции)
        
    ;

    @Глобально
    метод GetMessages(URL: Объект?, Topic: Объект?, Token: Объект? = Неопределено, Filter: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Topic)
        Опции.Вставить("-k", Token)
        Опции.Вставить("-f", Filter)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetMessages", Опции)
        
    ;

    @Глобально
    метод DeleteMessage(URL: Объект?, Topic: Объект?, MessageID: Объект?, Token: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Topic)
        Опции.Вставить("-i", MessageID)
        Опции.Вставить("-k", Token)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "DeleteMessage", Опции)
        
    ;
    
;