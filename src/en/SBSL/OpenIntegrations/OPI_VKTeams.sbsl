#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_VKTeams
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_VKTeams(Исполнитель)
    
;

@Локально
структура OPI_VKTeams
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "vkteams"
    
    @Глобально
    // Метод CheckToken
    // Checks if the bot token is functional
    //
    // Token - String: Bot token
    метод CheckToken(Token: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CheckToken", Опции)
        
    ;

    @Глобально
    // Метод GetEvents
    // Receives bot events in Polling mode
    //
    // Token   - String: Bot token
    // LastID  - String, Number: ID of the last event processed before this event
    // Timeout - String, Number: Connection hold time for Long Polling (необяз. по ум. - Empty value)
    метод GetEvents(Token: Объект?, LastID: Объект?, Timeout: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-l", LastID)
        Опции.Вставить("-m", Timeout)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetEvents", Опции)
        
    ;

    @Глобально
    // Метод GetFileInformation
    // Gets information about a file by ID
    //
    // Token  - String: Bot token
    // FileID - String, Number: File ID
    метод GetFileInformation(Token: Объект?, FileID: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-f", FileID)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetFileInformation", Опции)
        
    ;

    @Глобально
    // Метод SendTextMessage
    // Sends a text message to a chat
    //
    // Token    - String: Bot token
    // ChatID   - String, Number: Chat ID for message sending
    // Text     - String: Message text
    // ReplyID  - String, Number: Replying message id if necessary (необяз. по ум. - Empty value)
    // Keyboard - Array Of String: Buttons to the message if necessary (необяз. по ум. - Empty value)
    // Markup   - String: Markup type for message text: MarkdownV2 or HTML (необяз. по ум. - MarkdownV2)
    метод SendTextMessage(Token: Объект?, ChatID: Объект?, Text: Объект?, ReplyID: Объект? = Неопределено, Keyboard: Объект? = Неопределено, Markup: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-c", ChatID)
        Опции.Вставить("-x", Text)
        Опции.Вставить("-r", ReplyID)
        Опции.Вставить("-k", Keyboard)
        Опции.Вставить("-p", Markup)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "SendTextMessage", Опции)
        
    ;

    @Глобально
    // Метод SendFile
    // Sends the file to the chat
    //
    // Token       - String: Bot token
    // ChatID      - String, Number: Chat ID for sending
    // File        - BinaryData, String: File for sending
    // Text        - String: File caption (необяз. по ум. - Empty value)
    // FileName    - String: Displayed file name (необяз. по ум. - Empty value)
    // Markup      - String: Markup type for message text: MarkdownV2 or HTML (необяз. по ум. - MarkdownV2)
    // ContentType - String: Content type for sending (необяз. по ум. - image/jpeg)
    метод SendFile(Token: Объект?, ChatID: Объект?, File: Объект?, Text: Объект? = Неопределено, FileName: Объект? = Неопределено, Markup: Объект? = Неопределено, ContentType: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-c", ChatID)
        Опции.Вставить("-f", File)
        Опции.Вставить("-x", Text)
        Опции.Вставить("-l", FileName)
        Опции.Вставить("-p", Markup)
        Опции.Вставить("-y", ContentType)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "SendFile", Опции)
        
    ;

