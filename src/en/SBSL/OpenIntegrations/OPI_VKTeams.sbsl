    @Глобально
    // Метод SetChatRules
    // Sets new chat rules
    //
    // Token  - String: Bot token
    // ChatID - String, Number: Chat ID
    // Text   - String: Rules Text
    метод SetChatRules(Token: Объект?, ChatID: Объект?, Text: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-c", ChatID)
        Опции.Вставить("-x", Text)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "SetChatRules", Опции)
        
    ;
    
;