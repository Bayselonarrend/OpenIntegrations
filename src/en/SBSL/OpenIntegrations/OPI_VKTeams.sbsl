    // Text       - String: Additional message text (необяз. по ум. - Empty value)
    метод ForwardMessage(Token: Объект?, MessageID: Объект?, FromChatID: Объект?, ChatID: Объект?, Text: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-m", MessageID)
        Опции.Вставить("-f", FromChatID)
        Опции.Вставить("-c", ChatID)
        Опции.Вставить("-x", Text)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ForwardMessage", Опции)
        
    ;

