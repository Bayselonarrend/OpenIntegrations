    @Глобально
    // Метод AnswerButtonEvent
    // Returns a response to the user when a keyboard button is pressed
    //
    // Token   - String: Bot token
    // EventID - String: Identifier of the callback query received by the bot
    // Text    - String: Answer text (необяз. по ум. - Empty value)
    // URL     - String: URL to be opened by the client application (необяз. по ум. - Empty value)
    // AsAlert - Boolean: Display the answer as an alert) (необяз. по ум. - false)
    метод AnswerButtonEvent(Token: Объект?, EventID: Объект?, Text: Объект? = Неопределено, URL: Объект? = Неопределено, AsAlert: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-q", EventID)
        Опции.Вставить("-x", Text)
        Опции.Вставить("-u", URL)
        Опции.Вставить("-s", AsAlert)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "AnswerButtonEvent", Опции)
        
    ;

