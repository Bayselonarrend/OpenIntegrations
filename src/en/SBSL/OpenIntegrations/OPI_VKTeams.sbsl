#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Строка?|Executor.НастройкиИнтеграции): OPI_VKTeams
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_VKTeams(Исполнитель)
    
;

@Локально
структура OPI_VKTeams
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "vkteams"
    
    @Глобально
    метод CheckToken(Token: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CheckToken", Опции)
        
    ;

    @Глобально
    метод GetEvents(Token: Объект?, LastID: Объект?, Timeout: Объект? = Неопределено): Объект?
        
