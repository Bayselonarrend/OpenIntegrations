#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_Bitrix24
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_Bitrix24(Исполнитель)
    
;

@Локально
структура OPI_Bitrix24
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "bitrix24"
    
    @Глобально
    // Метод GetAppAuthLink
    // Forms a link for authorization via the browser
    //
    // Domain   - String: Current Bitrix URL (like 'portal.bitrix24.com')
    // ClientID - String: Client ID from app settings
    метод GetAppAuthLink(Domain: Объект?, ClientID: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Domain)
        Опции.Вставить("-c", ClientID)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetAppAuthLink", Опции)
        
    ;

    @Глобально
    // Метод GetToken
    // Get token by auth code
    //
    // ClientID     - String: Client ID from app settings
    // ClientSecret - String: Client secret from app settings
    // Code         - String: Code from browser auth page
    метод GetToken(ClientID: Объект?, ClientSecret: Объект?, Code: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", ClientID)
        Опции.Вставить("-l", ClientSecret)
        Опции.Вставить("-d", Code)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetToken", Опции)
        
    ;

    @Глобально
    // Метод RefreshToken
    // Update token by refresh token
    //
    // ClientID     - String: Client ID from app settings
    // ClientSecret - String: Client secret from app settings
    // Refresh      - String: Refresh token
    метод RefreshToken(ClientID: Объект?, ClientSecret: Объект?, Refresh: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", ClientID)
        Опции.Вставить("-l", ClientSecret)
        Опции.Вставить("-r", Refresh)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "RefreshToken", Опции)
        
    ;

    @Глобально
    // Метод ServerTime
    // Get current server time
    //
    // URL   - String: URL of webhook or a Bitrix24 domain, when token used
    // Token - String: Access token, when app auth method used (необяз. по ум. - Empty value)
    метод ServerTime(URL: Объект?, Token: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Token)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ServerTime", Опции)
        
    ;

    @Глобально
    // Метод CreatePost
    // Create a new post at news feed
    //
    // URL        - String: URL of webhook or a Bitrix24 domain, when token used
    // Text       - String: Text of post
    // Visibility - String: Array or 1 recipient: UA all, SGn w. group, Un user, DRn department, Gn group (необяз. по ум. - UA)
    // Files      - Map Of KeyAndValue: Key > file name, value > path or binary data (необяз. по ум. - Empty value)
    // Title      - String: Post title (необяз. по ум. - Empty value)
    // Important  - Boolean: Mark post as important (необяз. по ум. - false)
    // Token      - String: Access token, when app auth method used (необяз. по ум. - Empty value)
    метод CreatePost(URL: Объект?, Text: Объект?, Visibility: Объект? = Неопределено, Files: Объект? = Неопределено, Title: Объект? = Неопределено, Important: Объект? = Неопределено, Token: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Text)
        Опции.Вставить("-v", Visibility)
        Опции.Вставить("-f", Files)
        Опции.Вставить("-l", Title)
        Опции.Вставить("-i", Important)
        Опции.Вставить("-k", Token)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CreatePost", Опции)
        
    ;

    @Глобально
    // Метод UpdatePost
    // Change post data
    //
    // URL        - String: URL of webhook or a Bitrix24 domain, when token used
    // PostID     - String, Number: Post ID
    // Text       - String: Text of post
    // Visibility - String: Array or 1 recipient: UA all, SGn w. group, Un user, DRn department, Gn group (необяз. по ум. - UA)
    // Files      - Map Of KeyAndValue: Key > file name, value > path or binary data (необяз. по ум. - Empty value)
    // Title      - String: Post title (необяз. по ум. - Empty value)
    // Token      - String: Access token, when app auth method used (необяз. по ум. - Empty value)
    метод UpdatePost(URL: Объект?, PostID: Объект?, Text: Объект?, Visibility: Объект? = Неопределено, Files: Объект? = Неопределено, Title: Объект? = Неопределено, Token: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-p", PostID)
        Опции.Вставить("-t", Text)
        Опции.Вставить("-v", Visibility)
        Опции.Вставить("-f", Files)
        Опции.Вставить("-l", Title)
        Опции.Вставить("-k", Token)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "UpdatePost", Опции)
        
    ;

