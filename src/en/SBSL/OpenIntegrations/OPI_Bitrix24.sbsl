    @Глобально
    // Метод GetTasksList
    // Get tasks list (50 at one response max) with or without filtering
    //
    // URL    - String: URL of webhook or a Bitrix24 domain, when token used
    // Filter - Structure of KeyAndValue: Lead filter structure. See GetLeadFilterStructure (необяз. по ум. - Empty value)
    // Indent - Number, String: Offset of tasks list (необяз. по ум. - Empty value)
    // Token  - String: Access token, when app auth method used (необяз. по ум. - Empty value)
    // Fields - String, Array of String: A list of task fields in the response. All non calculable by default (необяз. по ум. - Empty value)
    метод GetTasksList(URL: Объект?, Filter: Объект? = Неопределено, Indent: Объект? = Неопределено, Token: Объект? = Неопределено, Fields: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-f", Filter)
        Опции.Вставить("-o", Indent)
        Опции.Вставить("-t", Token)
        Опции.Вставить("-s", Fields)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetTasksList", Опции)
        
    ;

