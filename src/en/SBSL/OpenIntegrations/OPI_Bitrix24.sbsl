#требуется ./internal/OPI.sbsl

@Глобально
метод Инициализировать(Конфигурация: OPI.НастройкиИнтеграцииStdio | OPI.НастройкиИнтеграцииHttp? = Неопределено): OPI_Bitrix24
    
    пер Исполнитель = OPI.АбстрактныйИсполнитель.Инициализировать(Конфигурация)
    возврат новый OPI_Bitrix24(Исполнитель)
    
;

@Глобально
метод ЧерезStdio(ПутьOint: Строка): OPI_Bitrix24

    пер Исполнитель = OPI.АбстрактныйИсполнитель.ЧерезStdio(ПутьOint)
    возврат новый OPI_Bitrix24(Исполнитель)
    
;

@Глобально
метод ЧерезHttp(HttpКлиент: КлиентHttp): OPI_Bitrix24

    пер Исполнитель = OPI.АбстрактныйИсполнитель.ЧерезHttp(HttpКлиент)
    возврат новый OPI_Bitrix24(Исполнитель)

;

@Локально
структура OPI_Bitrix24
    
    обз знч Исполнитель: OPI.АбстрактныйИсполнитель
    
    знч КомандаCLI: Строка = "bitrix24"
    
    @Глобально
    метод GetAppAuthLink(Domain: Объект?, ClientID: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Domain)
        Опции.Вставить("-c", ClientID)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetAppAuthLink", Опции)
        
    ;

