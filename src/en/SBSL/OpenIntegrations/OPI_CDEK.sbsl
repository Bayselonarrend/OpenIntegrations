        Опции.Вставить("-t", Token)
        Опции.Вставить("-d", ReceivingDate)
        Опции.Вставить("-s", TestAPI)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetCashboxChecksByDate", Опции)
        
    ;

