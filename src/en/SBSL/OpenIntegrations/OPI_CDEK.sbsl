#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_CDEK
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_CDEK(Исполнитель)
    
;

@Локально
структура OPI_CDEK
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "cdek"
    
    @Глобально
    // Метод GetToken
    // Gets a token based on account ID and password
    //
    // Account  - String: Client identifier (Account)
    // Password - String: Secret key (Password)
    // TestAPI  - Boolean: Flag to use test API for requests (необяз. по ум. - false)
    метод GetToken(Account: Объект?, Password: Объект?, TestAPI: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Account)
        Опции.Вставить("-p", Password)
        Опции.Вставить("-t", TestAPI)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetToken", Опции)
        
    ;

    @Глобально
    // Метод GetCashboxChecksByDate
    // Gets information about checks for a specified date
