    @Глобально
    // Метод GetUserFieldsStructure
    // Gets the structure of user description fields
    //
    // Clear - Boolean: True > structure with empty valuse, False > field descriptions at values (необяз. по ум. - false)
    // AsMap - Boolean: True > returns the filter fields as a map (необяз. по ум. - false)
    метод GetUserFieldsStructure(Clear: Объект? = Неопределено, AsMap: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Clear)
        Опции.Вставить("-m", AsMap)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetUserFieldsStructure", Опции)
        
    ;

