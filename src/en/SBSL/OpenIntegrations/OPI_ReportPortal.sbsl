#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_ReportPortal
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_ReportPortal(Исполнитель)
    
;

@Локально
структура OPI_ReportPortal
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "rportal"
    
    @Глобально
    // Метод GetTemporaryToken
    // Gets a temporary token based on login and password
    //
    // URL      - String: ReportPortal server URL
    // Login    - String: Users login
    // Password - String: Users password
    метод GetTemporaryToken(URL: Объект?, Login: Объект?, Password: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-l", Login)
        Опции.Вставить("-p", Password)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetTemporaryToken", Опции)
        
    ;

    @Глобально
    // Метод GetPermanentToken
    // Creates a permanent ReportPortal user token
    //
    // URL     - String: ReportPortal server URL
    // Token   - String: Access token
    // UserID  - String: User ID
    // KeyName - String: Token name
    метод GetPermanentToken(URL: Объект?, Token: Объект?, UserID: Объект?, KeyName: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Token)
        Опции.Вставить("-s", UserID)
        Опции.Вставить("-n", KeyName)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetPermanentToken", Опции)
        
    ;

    @Глобально
    // Метод DeletePermanentToken
    // Deletes a previously created user token
    //
    // URL    - String: ReportPortal server URL
    // Token  - String: Access token
    // UserID - String: User ID
    // KeyID  - String: Token ID
    метод DeletePermanentToken(URL: Объект?, Token: Объект?, UserID: Объект?, KeyID: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Token)
        Опции.Вставить("-s", UserID)
        Опции.Вставить("-i", KeyID)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "DeletePermanentToken", Опции)
        
    ;

