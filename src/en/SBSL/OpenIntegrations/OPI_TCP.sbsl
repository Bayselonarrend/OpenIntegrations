#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Строка?|Executor.НастройкиИнтеграции): OPI_TCP
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_TCP(Исполнитель)
    
;

@Локально
структура OPI_TCP
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "tcp"
    
    @Глобально
    метод GetLoggingSettings(WriteToMemory: Объект? = Неопределено, MaxEvents: Объект? = Неопределено, FilePath: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-m", WriteToMemory)
        Опции.Вставить("-c", MaxEvents)
        Опции.Вставить("-p", FilePath)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetLoggingSettings", Опции)
        
    ;

    @Глобально
    метод GetLog(AddInObject: Объект?, AsString: Объект? = Неопределено, EventCount: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", AddInObject)
        Опции.Вставить("-s", AsString)
        Опции.Вставить("-n", EventCount)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetLog", Опции)
        
    ;

    @Глобально
    метод CreateConnection(Address: Объект?, Tls: Объект? = Неопределено, Proxy: Объект? = Неопределено, Logging: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Address)
        Опции.Вставить("-t", Tls)
        Опции.Вставить("-p", Proxy)
        Опции.Вставить("-l", Logging)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CreateConnection", Опции)
        
    ;

    @Глобально
    метод CloseConnection(Connection: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CloseConnection", Опции)
        
    ;

    @Глобально
    метод ReadBinaryData(Connection: Объект?, MaxSize: Объект? = Неопределено, Marker: Объект? = Неопределено, Timeout: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Connection)
        Опции.Вставить("-s", MaxSize)
        Опции.Вставить("-m", Marker)
        Опции.Вставить("-i", Timeout)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ReadBinaryData", Опции)
        
    ;

    @Глобально
    метод ReadLine(Connection: Объект?, Encoding: Объект? = Неопределено, Marker: Объект? = Неопределено, Timeout: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Connection)
        Опции.Вставить("-e", Encoding)
        Опции.Вставить("-m", Marker)
        Опции.Вставить("-i", Timeout)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ReadLine", Опции)
        
    ;

    @Глобально
    метод SendBinaryData(Connection: Объект?, Data: Объект?, Timeout: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Connection)
        Опции.Вставить("-d", Data)
        Опции.Вставить("-m", Timeout)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "SendBinaryData", Опции)
        
    ;

    @Глобально
    метод SendLine(Connection: Объект?, Data: Объект?, Encoding: Объект? = Неопределено, Timeout: Объект? = Неопределено): Объект?
        
