#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_VK
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_VK(Исполнитель)
    
;

@Локально
структура OPI_VK
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "vk"
    
    @Глобально
    // Метод CreateTokenRetrievalLink
    // Getting a link for interactive token retrieval (access_token), which is necessary
    //
    // app_id - String, Number: app_id from application settings
    метод CreateTokenRetrievalLink(app_id: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", app_id)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CreateTokenRetrievalLink", Опции)
        
    ;

    @Глобально
    // Метод GetAuthParameters
    // Gets the structure of authorization parameters
    //
    // GroupID   - String, Number: Group ID
    // AppID     - String, Number: App ID
    // AuthToken - String: Auth token
    метод GetAuthParameters(GroupID: Объект?, AppID: Объект?, AuthToken: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-g", GroupID)
        Опции.Вставить("-a", AppID)
        Опции.Вставить("-t", AuthToken)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetAuthParameters", Опции)
        
    ;

    @Глобально
    // Метод CreatePost
    // Creates a post with images
    //
    // Text          - String: Post text
    // ImageArray    - Array of String, BinaryData: Array of images
    // Advertisement - Boolean: Sign ""This is an ad"" (необяз. по ум. - false)
    // LinkUnderPost - String: Link (URL) under the post (необяз. по ум. - Empty value)
    // Parameters    - Structure Of String: Authorization parameters. See GetAuthParameters (необяз. по ум. - Empty value)
    метод CreatePost(Text: Объект?, ImageArray: Объект?, Advertisement: Объект? = Неопределено, LinkUnderPost: Объект? = Неопределено, Parameters: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Text)
        Опции.Вставить("-p", ImageArray)
        Опции.Вставить("-a", Advertisement)
        Опции.Вставить("-u", LinkUnderPost)
        Опции.Вставить("-h", Parameters)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CreatePost", Опции)
        
    ;

    @Глобально
    // Метод CreateCompositePost
    // Creates a post based on an array of object identifiers (images, videos, etc..)
    //
    // Text          - String: Post text
    // Objects       - Array of String: Array of identifiers like photo123_123
    // Advertisement - Boolean: Sign ""This is an ad"" (необяз. по ум. - false)
    // LinkUnderPost - String: Link (URL) under the post (необяз. по ум. - Empty value)
    // Parameters    - Structure Of String: Authorization parameters. See GetAuthParameters (необяз. по ум. - Empty value)
    метод CreateCompositePost(Text: Объект?, Objects: Объект?, Advertisement: Объект? = Неопределено, LinkUnderPost: Объект? = Неопределено, Parameters: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Text)
        Опции.Вставить("-o", Objects)
        Опции.Вставить("-a", Advertisement)
        Опции.Вставить("-u", LinkUnderPost)
        Опции.Вставить("-h", Parameters)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CreateCompositePost", Опции)
        
    ;

