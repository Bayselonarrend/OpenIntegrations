    метод DeletePost(PostID: Объект?, Parameters: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-p", PostID)
        Опции.Вставить("-a", Parameters)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "DeletePost", Опции)
        
    ;

    @Глобально
    // Метод CreatePoll
    // Creates a poll with answer options
    //
    // Question     - String: Poll question
    // AnswersArray - Array of String: Array of answer options
    // Image        - String, BinaryData: Poll image. Required if there is no text (необяз. по ум. - Empty value)
    // Text         - String: Post text. Required if there is no picture (необяз. по ум. - Empty value)
    // Parameters   - Structure Of String: Authorization parameters. See GetAuthParameters (необяз. по ум. - Empty value)
    метод CreatePoll(Question: Объект?, AnswersArray: Объект?, Image: Объект? = Неопределено, Text: Объект? = Неопределено, Parameters: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-q", Question)
        Опции.Вставить("-o", AnswersArray)
        Опции.Вставить("-p", Image)
        Опции.Вставить("-t", Text)
        Опции.Вставить("-a", Parameters)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CreatePoll", Опции)
        
    ;

