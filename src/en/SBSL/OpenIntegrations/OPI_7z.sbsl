#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_7z
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_7z(Исполнитель)
    
;

@Локально
структура OPI_7z
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "7z"
    
    @Глобально
    // Метод ArchiveDirectory
    // Packs files from the specified directory into an archive
    //
    // Directory   - String, Map Of KeyAndValue: Path to directory or description. See GetArchiveDescriptionStructure
    // ArchivePath - String: Path to save the archive. To binary data if not filled (необяз. по ум. - Empty value)
    // Settings    - Map Of KeyAndValue: Additional settings. See GetArchivingSettingsStructure (необяз. по ум. - Empty value)
    метод ArchiveDirectory(Directory: Объект?, ArchivePath: Объект? = Неопределено, Settings: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Directory)
        Опции.Вставить("-d", ArchivePath)
        Опции.Вставить("-t", Settings)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ArchiveDirectory", Опции)
        
    ;

    @Глобально
    // Метод UnarchiveDirectory
    // Unpacks 7z archive to the specified directory
    //
    // Archive              - String, BinaryData: Path to the archive on disk or binary data
    // DestinationDirectory - String: Directory path for unpacking. To binary data if not filled (необяз. по ум. - Empty value)
    // Password             - String: archive password, if required (необяз. по ум. - Empty value)
    метод UnarchiveDirectory(Archive: Объект?, DestinationDirectory: Объект? = Неопределено, Password: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Archive)
        Опции.Вставить("-d", DestinationDirectory)
        Опции.Вставить("-p", Password)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "UnarchiveDirectory", Опции)
        
    ;

    @Глобально
    // Метод UnpackFiles
    // Unpacks selected files from a 7z archive by a list of paths
    //
    // Archive              - String, BinaryData: Path to the archive on disk or binary data
    // Paths                - Array Of String: Full paths of files inside the archive
    // DestinationDirectory - String: Directory path for unpacking. To binary data if not filled (необяз. по ум. - Empty value)
    // Password             - String: archive password, if required (необяз. по ум. - Empty value)
    метод UnpackFiles(Archive: Объект?, Paths: Объект?, DestinationDirectory: Объект? = Неопределено, Password: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Archive)
        Опции.Вставить("-p", Paths)
        Опции.Вставить("-d", DestinationDirectory)
        Опции.Вставить("-w", Password)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "UnpackFiles", Опции)
        
    ;

    @Глобально
    // Метод ModifyArchive
    // Adds, replaces and deletes files in an existing 7z archive
    //
    // Archive        - String, BinaryData: Path to the archive on disk or binary data
    // AddableFiles   - Map Of KeyAndValue: Key: archive path; value: file path or binary data (необяз. по ум. - Empty value)
    // DeletablePaths - Array Of String: Paths of files in the archive for deletion (необяз. по ум. - Empty value)
    // Settings       - Map Of KeyAndValue: Modification settings. See GetArchiveModificationStructure (необяз. по ум. - Empty value)
    метод ModifyArchive(Archive: Объект?, AddableFiles: Объект? = Неопределено, DeletablePaths: Объект? = Неопределено, Settings: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Archive)
        Опции.Вставить("-a", AddableFiles)
        Опции.Вставить("-d", DeletablePaths)
        Опции.Вставить("-t", Settings)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ModifyArchive", Опции)
        
    ;

    @Глобально
    // Метод GetArchiveModificationStructure
    // Gets the structure of archive modification settings: unpacking and packing passwords and compression parameters
    //
    // Clear - Boolean: True > structure with empty valuse, False > field descriptions at values (необяз. по ум. - false)
    // AsMap - Boolean: True > returns fields as map (необяз. по ум. - false)
    метод GetArchiveModificationStructure(Clear: Объект? = Неопределено, AsMap: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Clear)
        Опции.Вставить("-m", AsMap)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetArchiveModificationStructure", Опции)
        
    ;

    @Глобально
    // Метод GetArchivingSettingsStructure
    // Gets a structure with additional data archiving settings
    //
    // Clear - Boolean: True > structure with empty valuse, False > field descriptions at values (необяз. по ум. - false)
    // AsMap - Boolean: True > returns the filter fields as a map (необяз. по ум. - false)
    метод GetArchivingSettingsStructure(Clear: Объект? = Неопределено, AsMap: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Clear)
        Опции.Вставить("-m", AsMap)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetArchivingSettingsStructure", Опции)
        
    ;

    @Глобально
    // Метод GetArchiveDescriptionStructure
    // Get example structure of data description for packing without a directory on disk
    //
    // Clear - Boolean: True > structure with empty valuse, False > field descriptions at values (необяз. по ум. - false)
    // AsMap - Boolean: True > returns fields as map (необяз. по ум. - false)
    метод GetArchiveDescriptionStructure(Clear: Объект? = Неопределено, AsMap: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Clear)
        Опции.Вставить("-m", AsMap)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetArchiveDescriptionStructure", Опции)
        
    ;

    @Глобально
    // Метод GetFilesList
    // Gets a hierarchical list of files and directories in the archive
    //
    // Archive  - String, BinaryData: Path to the archive on disk or binary data
    // Password - String: archive password, if required (необяз. по ум. - Empty value)
    метод GetFilesList(Archive: Объект?, Password: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Archive)
        Опции.Вставить("-p", Password)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetFilesList", Опции)
        
    ;

    @Глобально
    // Метод GetMetadata
    // Gets metadata and a flat list of archive files
    //
    // Archive  - String, BinaryData: Path to the archive on disk or binary data
    // Password - String: archive password, if required (необяз. по ум. - Empty value)
    метод GetMetadata(Archive: Объект?, Password: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Archive)
        Опции.Вставить("-p", Password)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetMetadata", Опции)
        
    ;
    
;