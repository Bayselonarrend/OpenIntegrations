#совместимость 8.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Строка?|Executor.НастройкиИнтеграции): OPI_7z
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(Конфигурация)
    возврат новый OPI_7z(Исполнитель)
    
;

@Локально
структура OPI_7z
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "7z"
    
    @Глобально
    метод ArchiveDirectory(Directory: Объект?, ArchivePath: Объект? = Неопределено, Settings: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Directory)
        Опции.Вставить("-d", ArchivePath)
        Опции.Вставить("-t", Settings)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ArchiveDirectory", Опции)
        
    ;

    @Глобально
    метод UnarchiveDirectory(Archive: Объект?, DestinationDirectory: Объект? = Неопределено, Password: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Archive)
        Опции.Вставить("-d", DestinationDirectory)
        Опции.Вставить("-p", Password)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "UnarchiveDirectory", Опции)
        
    ;

    @Глобально
    метод UnpackFiles(Archive: Объект?, Paths: Объект?, DestinationDirectory: Объект? = Неопределено, Password: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Archive)
        Опции.Вставить("-p", Paths)
        Опции.Вставить("-d", DestinationDirectory)
        Опции.Вставить("-w", Password)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "UnpackFiles", Опции)
        
    ;

    @Глобально
    метод ModifyArchive(Archive: Объект?, AddableFiles: Объект? = Неопределено, DeletablePaths: Объект? = Неопределено, Settings: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Archive)
        Опции.Вставить("-a", AddableFiles)
        Опции.Вставить("-d", DeletablePaths)
        Опции.Вставить("-t", Settings)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ModifyArchive", Опции)
        
    ;

    @Глобально
    метод GetArchiveModificationStructure(Clear: Объект? = Неопределено, AsMap: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Clear)
        Опции.Вставить("-m", AsMap)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetArchiveModificationStructure", Опции)
        
    ;

    @Глобально
    метод GetArchivingSettingsStructure(Clear: Объект? = Неопределено, AsMap: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Clear)
        Опции.Вставить("-m", AsMap)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetArchivingSettingsStructure", Опции)
        
    ;

    @Глобально
    метод GetArchiveDescriptionStructure(Clear: Объект? = Неопределено, AsMap: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Clear)
        Опции.Вставить("-m", AsMap)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetArchiveDescriptionStructure", Опции)
        
    ;

    @Глобально
    метод GetFilesList(Archive: Объект?, Password: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Archive)
        Опции.Вставить("-p", Password)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetFilesList", Опции)
        
    ;

    @Глобально
    метод GetMetadata(Archive: Объект?, Password: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", Archive)
        Опции.Вставить("-p", Password)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetMetadata", Опции)
        
    ;
    
;