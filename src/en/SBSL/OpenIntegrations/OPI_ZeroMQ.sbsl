        возврат Исполнитель.Выполнить(КомандаCLI, "CreateConnectionPull", Опции)
        
    ;

    @Глобально
    метод BindPortRep(Port: Объект?, Logging: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
