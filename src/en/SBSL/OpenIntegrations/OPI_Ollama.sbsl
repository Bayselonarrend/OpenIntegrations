        Опции.Вставить("-e", Clear)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetModelSettingsStructure", Опции)
        
    ;

    @Глобально
    // Метод PushBlob
    // Sends binary data to the Ollama server
    //
    // URL               - String: Ollama server URL
    // Data              - String, BinaryData: File data or filepath
    // AdditionalHeaders - Map Of KeyAndValue: Additional request headers, if necessary (необяз. по ум. - Empty value)
    метод PushBlob(URL: Объект?, Data: Объект?, AdditionalHeaders: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-d", Data)
        Опции.Вставить("-h", AdditionalHeaders)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "PushBlob", Опции)
        
    ;

    @Глобально
    // Метод CheckBlob
    // Checks the existence of a BLOB by its SHA256 digest
    //
    // URL               - String: Ollama server URL
    // SHA256            - String: SHA256 BLOB digest
    // AdditionalHeaders - Map Of KeyAndValue: Additional request headers, if necessary (необяз. по ум. - Empty value)
    метод CheckBlob(URL: Объект?, SHA256: Объект?, AdditionalHeaders: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-d", SHA256)
        Опции.Вставить("-h", AdditionalHeaders)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CheckBlob", Опции)
        
    ;
    
;