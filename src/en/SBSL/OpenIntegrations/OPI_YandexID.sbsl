#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_YandexID
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_YandexID(Исполнитель)
    
;

@Локально
структура OPI_YandexID
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "yandex"
    
    @Глобально
    // Метод GetConfirmationCode
    // Gets the confirmation code and the address of the page where it needs to be entered
    //
    // ClientId - String: Client id
    метод GetConfirmationCode(ClientId: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-i", ClientId)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetConfirmationCode", Опции)
        
    ;

    @Глобально
    // Метод ConvertCodeToToken
    // Converts the code to a token after entering the code when executing GetConfirmationCode
    //
    // ClientId     - String: Client id
    // ClientSecret - String: Client secret
    // DeviceCode   - String: device_code from GetConfirmationCode()
    метод ConvertCodeToToken(ClientId: Объект?, ClientSecret: Объект?, DeviceCode: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-i", ClientId)
        Опции.Вставить("-s", ClientSecret)
        Опции.Вставить("-d", DeviceCode)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ConvertCodeToToken", Опции)
        
    ;

    @Глобально
    // Метод RefreshToken
    // Updates token by Refresh token
    //
    // ClientId     - String: Client id
    // ClientSecret - String: Client secret
    // RefreshToken - String: Refresh token
    метод RefreshToken(ClientId: Объект?, ClientSecret: Объект?, RefreshToken: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-i", ClientId)
        Опции.Вставить("-s", ClientSecret)
        Опции.Вставить("-r", RefreshToken)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "RefreshToken", Опции)
        
    ;
    
;