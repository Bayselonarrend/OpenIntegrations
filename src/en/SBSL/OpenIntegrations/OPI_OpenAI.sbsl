        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Token)
        Опции.Вставить("-n", FileName)
        Опции.Вставить("-d", Data)
        Опции.Вставить("-p", Destination)
        Опции.Вставить("-h", AdditionalHeaders)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "UploadFile", Опции)
        
    ;

