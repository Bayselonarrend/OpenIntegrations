    @Глобально
    // Метод GetImageMessageStructure
    // Gets the message structure based on the image for the request message list
    //
    // Role   - String: Message source: system, user, developer
    // FileID - String: Image file ID. See UploadFile
    // Text   - String: Input text query for image processing (необяз. по ум. - Empty value)
    метод GetImageMessageStructure(Role: Объект?, FileID: Объект?, Text: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-r", Role)
        Опции.Вставить("-f", FileID)
        Опции.Вставить("-p", Text)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetImageMessageStructure", Опции)
        
    ;

    @Глобально
    // Метод GetImageDescriptionStructure
    // Get image description structure for generation
    //
    // Prompt               - String: Text description of the image for generation
    // Count                - Number: Number of images to generate
    // Background           - String: Generation background option: transparent, opaque, auto (необяз. по ум. - Empty value)
    // Size                 - String: Size option for generated images (необяз. по ум. - Empty value)
    // AdditionalParameters - Structure Of KeyAndValue: Additional request parameters, if necessary (необяз. по ум. - Empty value)
    метод GetImageDescriptionStructure(Prompt: Объект?, Count: Объект?, Background: Объект? = Неопределено, Size: Объект? = Неопределено, AdditionalParameters: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-p", Prompt)
        Опции.Вставить("-a", Count)
        Опции.Вставить("-b", Background)
        Опции.Вставить("-s", Size)
        Опции.Вставить("-o", AdditionalParameters)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetImageDescriptionStructure", Опции)
        
    ;

