#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_OpenAI
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_OpenAI(Исполнитель)
    
;

@Локально
структура OPI_OpenAI
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "openai"
    
    @Глобально
    // Метод GetResponse
    // Generates a response for a given text query
    //
    // URL                  - String: OpenAI server URL
    // Token                - String: OpenAI authorization token
    // Model                - String: Models name
    // Messages             - Structure, Array of Structure: Conversation messages. See GetMessageStructure
    // AdditionalParameters - Structure Of KeyAndValue: Additional request parameters, if necessary (необяз. по ум. - Empty value)
    // AdditionalHeaders    - Map Of KeyAndValue: Additional request headers, if necessary (необяз. по ум. - Empty value)
    метод GetResponse(URL: Объект?, Token: Объект?, Model: Объект?, Messages: Объект?, AdditionalParameters: Объект? = Неопределено, AdditionalHeaders: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Token)
        Опции.Вставить("-m", Model)
        Опции.Вставить("-s", Messages)
        Опции.Вставить("-o", AdditionalParameters)
        Опции.Вставить("-h", AdditionalHeaders)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetResponse", Опции)
        
    ;

    @Глобально
    // Метод GetImages
    // Generates images based on the specified description
    //
    // URL               - String: OpenAI server URL
    // Token             - String: OpenAI authorization token
    // Model             - String: Models name
    // Description       - Structure Of KeyAndValue: Generation parameters. See GetImageDescriptionStructure
    // AdditionalHeaders - Map Of KeyAndValue: Additional request headers, if necessary (необяз. по ум. - Empty value)
    метод GetImages(URL: Объект?, Token: Объект?, Model: Объект?, Description: Объект?, AdditionalHeaders: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Token)
        Опции.Вставить("-m", Model)
        Опции.Вставить("-d", Description)
        Опции.Вставить("-h", AdditionalHeaders)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetImages", Опции)
        
    ;

    @Глобально
    // Метод GetEmbeddings
    // Gets the embeddings for the given entries
    //
    // URL                  - String: OpenAI server URL
    // Token                - String: OpenAI authorization token
    // Model                - String: Models name
    // Text                 - Array Of String: String or array of request strings
    // AdditionalParameters - Structure Of KeyAndValue: Additional request parameters, if necessary (необяз. по ум. - Empty value)
    // AdditionalHeaders    - Map Of KeyAndValue: Additional request headers, if necessary (необяз. по ум. - Empty value)
    метод GetEmbeddings(URL: Объект?, Token: Объект?, Model: Объект?, Text: Объект?, AdditionalParameters: Объект? = Неопределено, AdditionalHeaders: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Token)
        Опции.Вставить("-m", Model)
        Опции.Вставить("-i", Text)
        Опции.Вставить("-o", AdditionalParameters)
        Опции.Вставить("-h", AdditionalHeaders)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetEmbeddings", Опции)
        
    ;

    @Глобально
    // Метод GetMessageStructure
    // Gets the structure of an arbitrary message for the request message list
    //
    // Role - String: Source of the message: system, user, assistant, etc..
    // Text - String: Message text
    // Name - String: Name of participant in conversation (необяз. по ум. - Empty value)
    метод GetMessageStructure(Role: Объект?, Text: Объект?, Name: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-r", Role)
        Опции.Вставить("-t", Text)
        Опции.Вставить("-n", Name)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetMessageStructure", Опции)
        
    ;

    @Глобально
    // Метод GetUserMessage
    // Gets the structure of a message from the user for use in a request
    //
    // Text - String: Message text
    // Name - String: Name of participant in conversation (необяз. по ум. - Empty value)
    метод GetUserMessage(Text: Объект?, Name: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Text)
        Опции.Вставить("-n", Name)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetUserMessage", Опции)
        
    ;

