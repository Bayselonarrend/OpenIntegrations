    @Глобально
    // Метод UploadFile
    // Uploads a file for further use in other requests
    //
    // URL               - String: OpenAI server URL
    // Token             - String: OpenAI authorization token
    // FileName          - String: File name with extension
    // Data              - String, BinaryData: Path to file or data
    // Destination       - String: File purpose: assistants, batch, vision, user_data, evals
    // AdditionalHeaders - Map Of KeyAndValue: Additional request headers, if necessary (необяз. по ум. - Empty value)
    метод UploadFile(URL: Объект?, Token: Объект?, FileName: Объект?, Data: Объект?, Destination: Объект?, AdditionalHeaders: Объект? = Неопределено): Объект?
        
