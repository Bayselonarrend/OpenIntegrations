#совместимость 8.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Строка?|Executor.НастройкиИнтеграции): OPI_OpenAI
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(Конфигурация)
    возврат новый OPI_OpenAI(Исполнитель)
    
;

@Локально
структура OPI_OpenAI
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "openai"
    
    @Глобально
    метод GetResponse(URL: Объект?, Token: Объект?, Model: Объект?, Messages: Объект?, AdditionalParameters: Объект? = Неопределено, AdditionalHeaders: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Token)
        Опции.Вставить("-m", Model)
        Опции.Вставить("-s", Messages)
        Опции.Вставить("-o", AdditionalParameters)
        Опции.Вставить("-h", AdditionalHeaders)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetResponse", Опции)
        
    ;

    @Глобально
    метод GetImages(URL: Объект?, Token: Объект?, Model: Объект?, Description: Объект?, AdditionalHeaders: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-t", Token)
        Опции.Вставить("-m", Model)
        Опции.Вставить("-d", Description)
        Опции.Вставить("-h", AdditionalHeaders)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetImages", Опции)
        
    ;

