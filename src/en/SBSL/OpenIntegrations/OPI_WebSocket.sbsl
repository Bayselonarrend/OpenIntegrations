#требуется ./internal/OPI.sbsl

@Глобально
метод Инициализировать(Конфигурация: OPI.НастройкиИнтеграцииStdio | OPI.НастройкиИнтеграцииHttp? = Неопределено): OPI_WebSocket
    
    пер Исполнитель = OPI.АбстрактныйИсполнитель.Инициализировать(Конфигурация)
    возврат новый OPI_WebSocket(Исполнитель)
    
;

@Глобально
метод ЧерезStdio(ПутьOint: Строка): OPI_WebSocket

    пер Исполнитель = OPI.АбстрактныйИсполнитель.ЧерезStdio(ПутьOint)
    возврат новый OPI_WebSocket(Исполнитель)
    
;

@Глобально
метод ЧерезHttp(HttpКлиент: КлиентHttp): OPI_WebSocket

    пер Исполнитель = OPI.АбстрактныйИсполнитель.ЧерезHttp(HttpКлиент)
    возврат новый OPI_WebSocket(Исполнитель)

;

@Локально
структура OPI_WebSocket
    
    обз знч Исполнитель: OPI.АбстрактныйИсполнитель
    
    знч КомандаCLI: Строка = "ws"
    
    @Глобально
    метод GetLoggingSettings(WriteToMemory: Объект? = Неопределено, MaxEvents: Объект? = Неопределено, FilePath: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-m", WriteToMemory)
        Опции.Вставить("-c", MaxEvents)
        Опции.Вставить("-p", FilePath)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetLoggingSettings", Опции)
        
    ;

    @Глобально
    метод GetLog(AddInObject: Объект?, AsString: Объект? = Неопределено, EventCount: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", AddInObject)
        Опции.Вставить("-t", AsString)
        Опции.Вставить("-c", EventCount)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetLog", Опции)
        
    ;

    @Глобально
    метод CreateConnection(Address: Объект?, Tls: Объект? = Неопределено, Proxy: Объект? = Неопределено, Headers: Объект? = Неопределено, Logging: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Address)
        Опции.Вставить("-t", Tls)
        Опции.Вставить("-p", Proxy)
        Опции.Вставить("-h", Headers)
        Опции.Вставить("-l", Logging)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CreateConnection", Опции)
        
    ;

    @Глобально
    метод CloseConnection(Connection: Объект?, Code: Объект? = Неопределено, Reason: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        Опции.Вставить("-d", Code)
        Опции.Вставить("-r", Reason)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CloseConnection", Опции)
        
    ;

    @Глобально
    метод SendPing(Connection: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "SendPing", Опции)
        
    ;

    @Глобально
    метод SendPong(Connection: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "SendPong", Опции)
        
    ;

    @Глобально
    метод GetMessage(Connection: Объект?, Timeout: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        Опции.Вставить("-t", Timeout)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetMessage", Опции)
        
    ;

    @Глобально
    метод SendTextMessage(Connection: Объект?, Text: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        Опции.Вставить("-t", Text)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "SendTextMessage", Опции)
        
    ;

    @Глобально
    метод SendBinaryMessage(Connection: Объект?, Data: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        Опции.Вставить("-d", Data)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "SendBinaryMessage", Опции)
        
    ;

    @Глобально
    метод GetTlsSettings(DisableCertVerification: Объект?, CertFilepath: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", DisableCertVerification)
        Опции.Вставить("-c", CertFilepath)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetTlsSettings", Опции)
        
    ;

    @Глобально
    метод GetProxySettings(Address: Объект?, Port: Объект?, View: Объект? = Неопределено, Login: Объект? = Неопределено, Password: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Address)
        Опции.Вставить("-p", Port)
        Опции.Вставить("-t", View)
        Опции.Вставить("-l", Login)
        Опции.Вставить("-s", Password)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetProxySettings", Опции)
        
    ;

    @Глобально
    метод IsClientObject(Value: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-v", Value)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "IsClientObject", Опции)
        
    ;

    @Глобально
    метод StartServer(Port: Объект?, PoolSize: Объект? = Неопределено, Logging: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-p", Port)
        Опции.Вставить("-s", PoolSize)
        Опции.Вставить("-l", Logging)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "StartServer", Опции)
        
    ;

    @Глобально
    метод StopServer(ServerObject: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", ServerObject)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "StopServer", Опции)
        
    ;

    @Глобально
    метод GetNextConnectionData(ServerObject: Объект?, Timeout: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", ServerObject)
        Опции.Вставить("-t", Timeout)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetNextConnectionData", Опции)
        
    ;

    @Глобально
    метод GetConnectionData(ServerObject: Объект?, ConnectionID: Объект?, Timeout: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", ServerObject)
        Опции.Вставить("-i", ConnectionID)
        Опции.Вставить("-t", Timeout)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetConnectionData", Опции)
        
    ;

    @Глобально
    метод SendData(ServerObject: Объект?, ConnectionID: Объект?, Data: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", ServerObject)
        Опции.Вставить("-i", ConnectionID)
        Опции.Вставить("-d", Data)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "SendData", Опции)
        
    ;

    @Глобально
    метод CloseIncomingConnection(ServerObject: Объект?, ConnectionID: Объект?, RemoveImmediately: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", ServerObject)
        Опции.Вставить("-i", ConnectionID)
        Опции.Вставить("-r", RemoveImmediately)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CloseIncomingConnection", Опции)
        
    ;

    @Глобально
    метод GetConnectionList(ServerObject: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", ServerObject)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetConnectionList", Опции)
        
    ;

    @Глобально
    метод IsServerObject(Value: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-v", Value)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "IsServerObject", Опции)
        
    ;
    
;