#требуется ./internal/OPI.sbsl

@Глобально
метод Инициализировать(Конфигурация: OPI.НастройкиИнтеграцииStdio | OPI.НастройкиИнтеграцииHttp? = Неопределено): OPI_SQLite
    
    пер Исполнитель = OPI.АбстрактныйИсполнитель.Инициализировать(Конфигурация)
    возврат новый OPI_SQLite(Исполнитель)
    
;

@Глобально
метод ЧерезStdio(ПутьOint: Строка): OPI_SQLite

    пер Исполнитель = OPI.АбстрактныйИсполнитель.ЧерезStdio(ПутьOint)
    возврат новый OPI_SQLite(Исполнитель)
    
;

@Глобально
метод ЧерезHttp(HttpКлиент: КлиентHttp): OPI_SQLite

    пер Исполнитель = OPI.АбстрактныйИсполнитель.ЧерезHttp(HttpКлиент)
    возврат новый OPI_SQLite(Исполнитель)

;

@Локально
структура OPI_SQLite
    
    обз знч Исполнитель: OPI.АбстрактныйИсполнитель
    
    знч КомандаCLI: Строка = "sqlite"
    
    @Глобально
    метод CreateConnection(Base: Объект? = Неопределено, Logging: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Base)
        Опции.Вставить("-l", Logging)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CreateConnection", Опции)
        
    ;

    @Глобально
    метод CloseConnection(Connection: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CloseConnection", Опции)
        
    ;

    @Глобально
    метод IsConnector(Value: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-v", Value)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "IsConnector", Опции)
        
    ;

    @Глобально
    метод ExecuteSQLQuery(QueryText: Объект?, Parameters: Объект? = Неопределено, ForceResult: Объект? = Неопределено, Connection: Объект? = Неопределено, Extensions: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", QueryText)
        Опции.Вставить("-p", Parameters)
        Опции.Вставить("-f", ForceResult)
        Опции.Вставить("-d", Connection)
        Опции.Вставить("-e", Extensions)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ExecuteSQLQuery", Опции)
        
    ;

    @Глобально
    метод ConnectExtension(Extension: Объект?, EntryPoint: Объект? = Неопределено, Connection: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Extension)
        Опции.Вставить("-p", EntryPoint)
        Опции.Вставить("-d", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ConnectExtension", Опции)
        
    ;

    @Глобально
    метод GetLoggingSettings(WriteToMemory: Объект? = Неопределено, MaxEvents: Объект? = Неопределено, FilePath: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-m", WriteToMemory)
        Опции.Вставить("-c", MaxEvents)
        Опции.Вставить("-p", FilePath)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetLoggingSettings", Опции)
        
    ;

    @Глобально
    метод GetLog(Connection: Объект?, AsString: Объект? = Неопределено, EventCount: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        Опции.Вставить("-s", AsString)
        Опции.Вставить("-n", EventCount)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetLog", Опции)
        
    ;

    @Глобально
    метод GetTableInformation(Table: Объект?, Connection: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Table)
        Опции.Вставить("-d", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetTableInformation", Опции)
        
    ;

    @Глобально
    метод CreateTable(Table: Объект?, ColoumnsStruct: Объект?, Connection: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
