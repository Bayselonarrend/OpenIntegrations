#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_SQLite
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_SQLite(Исполнитель)
    
;

@Локально
структура OPI_SQLite
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "sqlite"
    
    @Глобально
    // Метод ExecuteSQLQuery
    // Executes an arbitrary SQL query
    //
    // QueryText   - String: Database query text
    // Parameters  - Array Of Arbitrary: Array of positional parameters of the request (необяз. по ум. - Empty value)
    // ForceResult - Boolean: Includes an attempt to retrieve the result, even for nonSELECT queries (необяз. по ум. - false)
    // Connection  - String, Arbitrary: Existing connection or path to the base. In memory, if not filled (необяз. по ум. - Empty value)
    // Extensions  - Map Of KeyAndValue: Extensions: Key > filepath or extension data, Value > entry point (необяз. по ум. - Empty value)
    метод ExecuteSQLQuery(QueryText: Объект?, Parameters: Объект? = Неопределено, ForceResult: Объект? = Неопределено, Connection: Объект? = Неопределено, Extensions: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", QueryText)
        Опции.Вставить("-p", Parameters)
        Опции.Вставить("-f", ForceResult)
        Опции.Вставить("-d", Connection)
        Опции.Вставить("-e", Extensions)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ExecuteSQLQuery", Опции)
        
    ;

    @Глобально
    // Метод GetTableInformation
    // Gets information about the table
    //
    // Table      - String: Table name
    // Connection - String, Arbitrary: Existing connection or database path (необяз. по ум. - Empty value)
    метод GetTableInformation(Table: Объект?, Connection: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Table)
        Опции.Вставить("-d", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetTableInformation", Опции)
        
    ;

    @Глобально
    // Метод CreateTable
    // Creates an empty table in the database
    //
    // Table          - String: Table name
    // ColoumnsStruct - Structure Of KeyAndValue: Column structure: Key > Name, Value > Data type
    // Connection     - String, Arbitrary: Existing connection or database path (необяз. по ум. - Empty value)
    метод CreateTable(Table: Объект?, ColoumnsStruct: Объект?, Connection: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Table)
        Опции.Вставить("-c", ColoumnsStruct)
        Опции.Вставить("-d", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CreateTable", Опции)
        
    ;

    @Глобально
    // Метод AddTableColumn
    // Adds a new column to an existing table
    //
    // Table      - String: Table name
    // Name       - String: Column name
    // DataType   - String: Column data type
    // Connection - String, Arbitrary: Existing connection or database path (необяз. по ум. - Empty value)
    метод AddTableColumn(Table: Объект?, Name: Объект?, DataType: Объект?, Connection: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Table)
        Опции.Вставить("-n", Name)
        Опции.Вставить("-p", DataType)
        Опции.Вставить("-d", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "AddTableColumn", Опции)
        
    ;

    @Глобально
    // Метод DeleteTableColumn
    // Deletes a column from the table
    //
    // Table      - String: Table name
    // Name       - String: Column name
    // Connection - String, Arbitrary: Existing connection or database path (необяз. по ум. - Empty value)
    метод DeleteTableColumn(Table: Объект?, Name: Объект?, Connection: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Table)
        Опции.Вставить("-n", Name)
        Опции.Вставить("-d", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "DeleteTableColumn", Опции)
        
    ;

    @Глобально
    // Метод EnsureTable
    // Creates a new table if it does not exist or updates the composition of columns in an existing table
    //
    // Table          - String: Table name
    // ColoumnsStruct - Structure Of KeyAndValue: Column structure: Key > Name, Value > Data type
    // Connection     - String, Arbitrary: Existing connection or database path (необяз. по ум. - Empty value)
    метод EnsureTable(Table: Объект?, ColoumnsStruct: Объект?, Connection: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Table)
        Опции.Вставить("-c", ColoumnsStruct)
        Опции.Вставить("-d", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "EnsureTable", Опции)
        
    ;

    @Глобально
    // Метод DeleteTable
    // Deletes a table from the database
    //
    // Table      - String: Table name
    // Connection - String, Arbitrary: Existing connection or database path (необяз. по ум. - Empty value)
    метод DeleteTable(Table: Объект?, Connection: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Table)
        Опции.Вставить("-d", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "DeleteTable", Опции)
        
    ;

    @Глобально
    // Метод ClearTable
    // Clears the database table
    //
    // Table      - String: Table name
    // Connection - String, Arbitrary: Existing connection or database path (необяз. по ум. - Empty value)
    метод ClearTable(Table: Объект?, Connection: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Table)
        Опции.Вставить("-d", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ClearTable", Опции)
        
    ;

    @Глобально
    // Метод AddRecords
    // Adds new rows to the table
    //
    // Table       - String: Table name
    // DataArray   - Array of Structure: An array of string data structures: Key > field, Value > field value
    // Transaction - Boolean: True > adding records to transactions with rollback on error (необяз. по ум. - true)
    // Connection  - String, Arbitrary: Existing connection or database path (необяз. по ум. - Empty value)
    метод AddRecords(Table: Объект?, DataArray: Объект?, Transaction: Объект? = Неопределено, Connection: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Table)
        Опции.Вставить("-r", DataArray)
        Опции.Вставить("-n", Transaction)
        Опции.Вставить("-d", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "AddRecords", Опции)
        
    ;

    @Глобально
    // Метод UpdateRecords
    // Updates the value of records by selected criteria
    //
    // Table          - String: Table name
    // ValueStructure - Structure Of KeyAndValue: Values structure: Key > field, Value > field value
    // Filters        - Array of Structure: Filters array. See GetRecordsFilterStructure (необяз. по ум. - Empty value)
    // Connection     - String, Arbitrary: Existing connection or database path (необяз. по ум. - Empty value)
    метод UpdateRecords(Table: Объект?, ValueStructure: Объект?, Filters: Объект? = Неопределено, Connection: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Table)
        Опции.Вставить("-v", ValueStructure)
        Опции.Вставить("-f", Filters)
        Опции.Вставить("-d", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "UpdateRecords", Опции)
        
    ;

    @Глобально
    // Метод EnsureRecords
    // Adds records or updates data of existing ones when key fields match
    //
    // Table       - String: Table name
    // DataArray   - Array of Structure: An array of string data structures: Key > field, Value > field value
    // KeyFields   - Array Of String: Name or names of key table fields for uniqueness validation (необяз. по ум. - Empty value)
    // Transaction - Boolean: True > adding records to transactions with rollback on error (необяз. по ум. - true)
    // Connection  - String, Arbitrary: Existing connection or database path (необяз. по ум. - Empty value)
    метод EnsureRecords(Table: Объект?, DataArray: Объект?, KeyFields: Объект? = Неопределено, Transaction: Объект? = Неопределено, Connection: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Table)
        Опции.Вставить("-r", DataArray)
        Опции.Вставить("-u", KeyFields)
        Опции.Вставить("-n", Transaction)
        Опции.Вставить("-d", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "EnsureRecords", Опции)
        
    ;

    @Глобально
    // Метод GetRecords
    // Gets records from the selected table
    //
    // Table      - String: Table name
    // Fields     - Array Of String: Fields for selection (необяз. по ум. - *)
    // Filters    - Array of Structure: Filters array. See GetRecordsFilterStructure (необяз. по ум. - Empty value)
    // Sort       - Structure Of KeyAndValue: Sorting: Key > field name, Value > direction (ASC, DESC) (необяз. по ум. - Empty value)
    // Count      - Number: Limiting the number of received strings (необяз. по ум. - Empty value)
    // Connection - String, Arbitrary: Existing connection or database path (необяз. по ум. - Empty value)
    метод GetRecords(Table: Объект?, Fields: Объект? = Неопределено, Filters: Объект? = Неопределено, Sort: Объект? = Неопределено, Count: Объект? = Неопределено, Connection: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Table)
        Опции.Вставить("-f", Fields)
        Опции.Вставить("-l", Filters)
        Опции.Вставить("-o", Sort)
        Опции.Вставить("-m", Count)
        Опции.Вставить("-d", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetRecords", Опции)
        
    ;

    @Глобально
    // Метод DeleteRecords
    // Deletes records from the table
    //
    // Table      - String: Table name
    // Filters    - Array of Structure: Filters array. See GetRecordsFilterStructure (необяз. по ум. - Empty value)
    // Connection - String, Arbitrary: Existing connection or database path (необяз. по ум. - Empty value)
    метод DeleteRecords(Table: Объект?, Filters: Объект? = Неопределено, Connection: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Table)
        Опции.Вставить("-f", Filters)
        Опции.Вставить("-d", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "DeleteRecords", Опции)
        
    ;

    @Глобально
    // Метод GetRecordsFilterStructure
    // Gets the template structure for filtering records in ORM queries
    //
    // Clear - Boolean: True > structure with empty valuse, False > field descriptions at values (необяз. по ум. - false)
    метод GetRecordsFilterStructure(Clear: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-e", Clear)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetRecordsFilterStructure", Опции)
        
    ;
    
;