    @Глобально
    метод DeleteTableColumn(Table: Объект?, Name: Объект?, Connection: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Table)
        Опции.Вставить("-n", Name)
        Опции.Вставить("-d", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "DeleteTableColumn", Опции)
        
    ;

    @Глобально
    метод EnsureTable(Table: Объект?, ColoumnsStruct: Объект?, Connection: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Table)
        Опции.Вставить("-c", ColoumnsStruct)
        Опции.Вставить("-d", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "EnsureTable", Опции)
        
    ;

    @Глобально
    метод DeleteTable(Table: Объект?, Connection: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
