        Опции.Вставить("-d", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ClearTable", Опции)
        
    ;

    @Глобально
    метод AddRecords(Table: Объект?, DataArray: Объект?, Transaction: Объект? = Неопределено, Connection: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Table)
        Опции.Вставить("-r", DataArray)
        Опции.Вставить("-n", Transaction)
        Опции.Вставить("-d", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "AddRecords", Опции)
        
    ;

    @Глобально
    метод UpdateRecords(Table: Объект?, ValueStructure: Объект?, Filters: Объект? = Неопределено, Connection: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Table)
        Опции.Вставить("-v", ValueStructure)
        Опции.Вставить("-f", Filters)
        Опции.Вставить("-d", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "UpdateRecords", Опции)
        
    ;

    @Глобально
    метод EnsureRecords(Table: Объект?, DataArray: Объект?, KeyFields: Объект? = Неопределено, Transaction: Объект? = Неопределено, Connection: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Table)
        Опции.Вставить("-r", DataArray)
        Опции.Вставить("-u", KeyFields)
        Опции.Вставить("-n", Transaction)
