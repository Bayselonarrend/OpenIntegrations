    @Глобально
    метод SendGRPCMessage(Connection: Объект?, StreamID: Объект?, Request: Объект?, Session: Объект? = Неопределено, WaitNext: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        Опции.Вставить("-s", StreamID)
        Опции.Вставить("-r", Request)
        Опции.Вставить("-n", Session)
        Опции.Вставить("-x", WaitNext)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "SendGRPCMessage", Опции)
        
    ;

    @Глобально
    метод SendGRPCData(Connection: Объект?, StreamID: Объект?, Data: Объект?, WaitNext: Объект? = Неопределено): Объект?
        
