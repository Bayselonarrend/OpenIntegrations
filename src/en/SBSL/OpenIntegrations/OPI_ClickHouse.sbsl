    ;

    @Глобально
    метод GetGRPCMessage(Connection: Объект?, StreamID: Объект?, DefaultFormat: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
