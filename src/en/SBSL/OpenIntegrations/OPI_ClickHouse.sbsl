#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_ClickHouse
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_ClickHouse(Исполнитель)
    
;

@Локально
структура OPI_ClickHouse
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "clickhouse"
    
    @Глобально
    // Метод ExecuteRequest
    // Executes a request with the specified parameters
    //
    // Connection - Arbitrary: Connection settings or object (for gRPC)
    // Request    - Structure Of KeyAndValue: Request data. See GetRequestSettings
    // Session    - Structure Of KeyAndValue: Session settings. See GetSessionSettings (необяз. по ум. - Empty value)
    метод ExecuteRequest(Connection: Объект?, Request: Объект?, Session: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        Опции.Вставить("-r", Request)
        Опции.Вставить("-s", Session)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ExecuteRequest", Опции)
        
    ;

    @Глобально
    // Метод GetHTTPConnectionSettings
    // Gets the settings structure for HTTP connection
    //
    // Address           - String: Connection address with protocol and port
    // Authorization     - String, Structure Of KeyAndValue: Authorization: string for JWT, structure for basic (необяз. по ум. - Empty value)
    // AdditionalHeaders - Map Of KeyAndValue: Additional request headers (необяз. по ум. - Empty value)
    метод GetHTTPConnectionSettings(Address: Объект?, Authorization: Объект? = Неопределено, AdditionalHeaders: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", Address)
        Опции.Вставить("-a", Authorization)
        Опции.Вставить("-h", AdditionalHeaders)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetHTTPConnectionSettings", Опции)
        
    ;

    @Глобально
    // Метод GetRequestSettings
    // Forms the request description structure
    //
    // Text           - String: Request text
    // Database       - String: Database (необяз. по ум. - Empty value)
    // RequestID      - String: Unique request ID, if necessary (необяз. по ум. - Empty value)
    // Data           - Arbitrary: String, file, or binary data of the request (необяз. по ум. - Empty value)
    // ResponseFormat - String: Response format: JSON, CSV, TSV, etc.. (необяз. по ум. - JSON)
    // ExternalTables - Array of Structure: External tables data. See GetExternalTableStructure (необяз. по ум. - Empty value)
    // Settings       - Map Of KeyAndValue: Additional query parameters of the request (необяз. по ум. - Empty value)
    метод GetRequestSettings(Text: Объект?, Database: Объект? = Неопределено, RequestID: Объект? = Неопределено, Data: Объект? = Неопределено, ResponseFormat: Объект? = Неопределено, ExternalTables: Объект? = Неопределено, Settings: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-q", Text)
        Опции.Вставить("-d", Database)
        Опции.Вставить("-i", RequestID)
        Опции.Вставить("-t", Data)
        Опции.Вставить("-f", ResponseFormat)
        Опции.Вставить("-e", ExternalTables)
        Опции.Вставить("-s", Settings)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetRequestSettings", Опции)
        
    ;

    @Глобально
    // Метод GetExternalTableStructure
    // Gets the description structure of the external table of the request
    //
    // Name           - String: Table name
    // ColoumnsStruct - Structure Of KeyAndValue: Table column structure: Key > name, Value > data type
    // Data           - Arbitrary: String, file, or binary data of the table (необяз. по ум. - Empty value)
    // DataFormat     - String: Data format: CVS, TVS, JSON, etc.. (необяз. по ум. - Empty value)
    метод GetExternalTableStructure(Name: Объект?, ColoumnsStruct: Объект?, Data: Объект? = Неопределено, DataFormat: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-n", Name)
        Опции.Вставить("-c", ColoumnsStruct)
        Опции.Вставить("-d", Data)
        Опции.Вставить("-f", DataFormat)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetExternalTableStructure", Опции)
        
    ;

    @Глобально
    // Метод GetSessionSettings
    // Forms the session settings structure for executing the request
    //
    // SessionID    - String: Session ID. A new unique identifier if not specified (a new session will be created) (необяз. по ум. - Empty value)
    // CheckSession - Boolean: Check for session existence. True when ID is specified and false when not, unless otherwise specified (необяз. по ум. - Empty value)
    // Timeout      - Number: Session lifetime in seconds (необяз. по ум. - 60)
    метод GetSessionSettings(SessionID: Объект? = Неопределено, CheckSession: Объект? = Неопределено, Timeout: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-i", SessionID)
        Опции.Вставить("-c", CheckSession)
        Опции.Вставить("-t", Timeout)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetSessionSettings", Опции)
        
    ;

    @Глобально
    // Метод GetGRPCConnectionSettings
    // Gets the settings structure for gRPC connection
    //
    // Address       - String: Connection address with protocol and port
    // Authorization - String, Structure Of KeyAndValue: Authorization: string for JWT, structure for basic (необяз. по ум. - Empty value)
    // Meta          - Structure Of KeyAndValue: gRPC metadata structure, if necessary (необяз. по ум. - Empty value)
    // Tls           - Structure Of KeyAndValue: TLS settings. See GetTlsSettings (необяз. по ум. - Empty value)
    метод GetGRPCConnectionSettings(Address: Объект?, Authorization: Объект? = Неопределено, Meta: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", Address)
        Опции.Вставить("-a", Authorization)
        Опции.Вставить("-m", Meta)
        Опции.Вставить("-t", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetGRPCConnectionSettings", Опции)
        
    ;

    @Глобально
    // Метод ProcessGRPCSending
    // Initializes the stream, sends the request and a set of data in a specified order, receiving one message upon completion
    //
    // Connection - Arbitrary: Existing connection or connection parameters
    // Request    - Structure Of KeyAndValue: Request data. See GetRequestSettings
    // Data       - Array Of Arbitrary: An array of strings, collections, binary data, or file paths
    // Session    - Structure Of KeyAndValue: Session settings. See GetSessionSettings (необяз. по ум. - Empty value)
    // Timeout    - Number: Timeout (in ms) (необяз. по ум. - 10000)
    метод ProcessGRPCSending(Connection: Объект?, Request: Объект?, Data: Объект?, Session: Объект? = Неопределено, Timeout: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        Опции.Вставить("-r", Request)
        Опции.Вставить("-d", Data)
        Опции.Вставить("-s", Session)
        Опции.Вставить("-t", Timeout)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ProcessGRPCSending", Опции)
        
    ;

    @Глобально
    // Метод ProcessGRPCReceiving
    // Initializes the stream, sends the request, and receives messages until closure or a set limit is reached
    //
    // Connection   - Arbitrary: Existing connection or connection parameters
    // Request      - Structure Of KeyAndValue: Request data. See GetRequestSettings
    // MessageCount - Number: Maximum number of messages to receive, if necessary (необяз. по ум. - Empty value)
    // Session      - Structure Of KeyAndValue: Session settings. See GetSessionSettings (необяз. по ум. - Empty value)
    // Timeout      - Number: Timeout (in ms) (необяз. по ум. - 10000)
    метод ProcessGRPCReceiving(Connection: Объект?, Request: Объект?, MessageCount: Объект? = Неопределено, Session: Объект? = Неопределено, Timeout: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        Опции.Вставить("-r", Request)
        Опции.Вставить("-a", MessageCount)
        Опции.Вставить("-s", Session)
        Опции.Вставить("-t", Timeout)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ProcessGRPCReceiving", Опции)
        
    ;

    @Глобально
    // Метод GetTlsSettings
    // Forms settings for using TLS
    //
    // DisableCertVerification - Boolean: Allows to work with invalid certificates, including self signed
    // CertFilepath            - String: Path to the root PEM file of the certificate if it is not in the system repository (необяз. по ум. - Empty value)
    метод GetTlsSettings(DisableCertVerification: Объект?, CertFilepath: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", DisableCertVerification)
        Опции.Вставить("-c", CertFilepath)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetTlsSettings", Опции)
        
    ;
    
;