    @Глобально
    // Метод CreateTable
    // Creates an empty table in the database
    //
    // Table          - String: Table name
    // ColoumnsStruct - Structure Of KeyAndValue: Column structure: Key > Name, Value > Data type
    // Connection     - String, Arbitrary: Connection or connection string (необяз. по ум. - Empty value)
    // Tls            - Structure Of KeyAndValue: TLS settings, if necessary. See GetTlsSettings (необяз. по ум. - Empty value)
    метод CreateTable(Table: Объект?, ColoumnsStruct: Объект?, Connection: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
