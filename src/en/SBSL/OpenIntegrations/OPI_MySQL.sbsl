#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Executor.НастройкиИнтеграции? = Неопределено): OPI_MySQL
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(Конфигурация)
    возврат новый OPI_MySQL(Исполнитель)
    
;

@Локально
структура OPI_MySQL
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "mysql"
    
    @Глобально
    метод CreateConnection(ConnectionString: Объект? = Неопределено, Tls: Объект? = Неопределено, Logging: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", ConnectionString)
        Опции.Вставить("-t", Tls)
        Опции.Вставить("-l", Logging)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CreateConnection", Опции)
        
    ;

    @Глобально
    метод CloseConnection(Connection: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CloseConnection", Опции)
        
    ;

    @Глобально
    метод IsConnector(Value: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-v", Value)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "IsConnector", Опции)
        
    ;

    @Глобально
    метод ExecuteSQLQuery(QueryText: Объект?, Parameters: Объект? = Неопределено, ForceResult: Объект? = Неопределено, Connection: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", QueryText)
        Опции.Вставить("-p", Parameters)
        Опции.Вставить("-f", ForceResult)
        Опции.Вставить("-d", Connection)
        Опции.Вставить("-t", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ExecuteSQLQuery", Опции)
        
    ;

    @Глобально
    метод GenerateConnectionString(Address: Объект?, Base: Объект? = Неопределено, Login: Объект? = Неопределено, Password: Объект? = Неопределено, Port: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Address)
        Опции.Вставить("-d", Base)
        Опции.Вставить("-l", Login)
        Опции.Вставить("-p", Password)
        Опции.Вставить("-r", Port)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GenerateConnectionString", Опции)
        
    ;

