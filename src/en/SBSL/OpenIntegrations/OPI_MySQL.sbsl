#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_MySQL
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_MySQL(Исполнитель)
    
;

@Локально
структура OPI_MySQL
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "mysql"
    
    @Глобально
    // Метод ExecuteSQLQuery
    // Executes an arbitrary SQL query
    //
    // QueryText   - String: Database query text
    // Parameters  - Array Of Arbitrary: Array of positional parameters of the request (необяз. по ум. - Empty value)
    // ForceResult - Boolean: Includes an attempt to retrieve the result, even for nonSELECT queries (необяз. по ум. - false)
    // Connection  - String, Arbitrary: Connection or connection string (необяз. по ум. - Empty value)
    // Tls         - Structure Of KeyAndValue: TLS settings, if necessary. See GetTlsSettings (необяз. по ум. - Empty value)
    метод ExecuteSQLQuery(QueryText: Объект?, Parameters: Объект? = Неопределено, ForceResult: Объект? = Неопределено, Connection: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", QueryText)
        Опции.Вставить("-p", Parameters)
        Опции.Вставить("-f", ForceResult)
        Опции.Вставить("-d", Connection)
        Опции.Вставить("-t", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ExecuteSQLQuery", Опции)
        
    ;

    @Глобально
    // Метод GenerateConnectionString
    // Forms a connection string from the passed data
    //
    // Address  - String: IP address or domain name of the server
    // Base     - String: Name of the database to connect (необяз. по ум. - Empty value)
    // Login    - String: MySQL user (необяз. по ум. - Empty value)
    // Password - String: MySQL password (необяз. по ум. - Empty value)
    // Port     - String: Connection port (необяз. по ум. - 3306)
    метод GenerateConnectionString(Address: Объект?, Base: Объект? = Неопределено, Login: Объект? = Неопределено, Password: Объект? = Неопределено, Port: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Address)
        Опции.Вставить("-d", Base)
        Опции.Вставить("-l", Login)
        Опции.Вставить("-p", Password)
        Опции.Вставить("-r", Port)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GenerateConnectionString", Опции)
        
    ;

    @Глобально
    // Метод GetTlsSettings
    // Forms settings for using TLS
    //
    // DisableCertVerification - Boolean: Allows to work with invalid certificates, including self signed
    // CertFilepath            - String: Path to the root PEM file of the certificate if it is not in the system repository (необяз. по ум. - Empty value)
    метод GetTlsSettings(DisableCertVerification: Объект?, CertFilepath: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", DisableCertVerification)
        Опции.Вставить("-c", CertFilepath)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetTlsSettings", Опции)
        
    ;

    @Глобально
    // Метод CreateDatabase
    // Creates a database with the specified name
    //
    // Base       - String: Database name
    // Connection - String, Arbitrary: Connection or connection string (необяз. по ум. - Empty value)
    // Tls        - Structure Of KeyAndValue: TLS settings, if necessary. See GetTlsSettings (необяз. по ум. - Empty value)
    метод CreateDatabase(Base: Объект?, Connection: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-b", Base)
        Опции.Вставить("-d", Connection)
        Опции.Вставить("-t", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CreateDatabase", Опции)
        
    ;

    @Глобально
