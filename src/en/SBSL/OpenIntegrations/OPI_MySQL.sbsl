        Опции.Вставить("-c", ColoumnsStruct)
        Опции.Вставить("-d", Connection)
        Опции.Вставить("-l", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CreateTable", Опции)
        
    ;

