#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_MongoDB
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_MongoDB(Исполнитель)
    
;

@Локально
структура OPI_MongoDB
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "mongodb"
    
    @Глобально
    // Метод GenerateConnectionString
    // Forms a MongoDB connection string
    //
    // Address    - String: Host IP address with port or URL
    // Base       - String: Database, if necessary (необяз. по ум. - Empty value)
    // Login      - String: Username for authorization (необяз. по ум. - Empty value)
    // Password   - String: Password for authorization (необяз. по ум. - Empty value)
    // Parameters - Structure Of KeyAndValue, Undefined: Additional connection parameters (необяз. по ум. - Empty value)
    метод GenerateConnectionString(Address: Объект?, Base: Объект? = Неопределено, Login: Объект? = Неопределено, Password: Объект? = Неопределено, Parameters: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Address)
        Опции.Вставить("-d", Base)
        Опции.Вставить("-u", Login)
        Опции.Вставить("-p", Password)
        Опции.Вставить("-r", Parameters)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GenerateConnectionString", Опции)
        
    ;

    @Глобально
    // Метод ExecuteCommand
    // Executes the command according to its description
    //
    // Connection - String, Arbitrary: Connection or connection string
    // Command    - String: Command name to execute
    // Argument   - Arbitrary: Command argument (необяз. по ум. - 1)
    // Base       - String: Database in which the operation needs to be performed (необяз. по ум. - Empty value)
    // Data       - Structure Of KeyAndValue: Main data fields for performing the operation (необяз. по ум. - Empty value)
    метод ExecuteCommand(Connection: Объект?, Command: Объект?, Argument: Объект? = Неопределено, Base: Объект? = Неопределено, Data: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Connection)
        Опции.Вставить("-c", Command)
        Опции.Вставить("-a", Argument)
        Опции.Вставить("-b", Base)
        Опции.Вставить("-t", Data)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ExecuteCommand", Опции)
        
    ;

