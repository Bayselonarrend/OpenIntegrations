        Опции.Вставить("-p", Parameters)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "DeleteRole", Опции)
        
    ;

    @Глобально
    // Метод GrantRoles
    // Grants selected roles to a user
    //
    // Connection - String, Arbitrary: Connection or connection string
    // User       - String: Users name
    // RoleArray  - Array Of Arbitrary: Role or role array
    // Base       - String: Database name. Current database if not specified (необяз. по ум. - Empty value)
    // Parameters - Structure Of KeyAndValue: Additional deletion parameters (необяз. по ум. - Empty value)
    метод GrantRoles(Connection: Объект?, User: Объект?, RoleArray: Объект?, Base: Объект? = Неопределено, Parameters: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Connection)
        Опции.Вставить("-u", User)
        Опции.Вставить("-r", RoleArray)
        Опции.Вставить("-b", Base)
        Опции.Вставить("-p", Parameters)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GrantRoles", Опции)
        
    ;

    @Глобально
    // Метод RevokeRoles
    // Revokes selected roles from a user
    //
    // Connection - String, Arbitrary: Connection or connection string
    // User       - String: Users name
    // RoleArray  - Array Of Arbitrary: Role or role array
    // Base       - String: Database name. Current database if not specified (необяз. по ум. - Empty value)
    // Parameters - Structure Of KeyAndValue: Additional deletion parameters (необяз. по ум. - Empty value)
    метод RevokeRoles(Connection: Объект?, User: Объект?, RoleArray: Объект?, Base: Объект? = Неопределено, Parameters: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-d", Connection)
        Опции.Вставить("-u", User)
        Опции.Вставить("-r", RoleArray)
        Опции.Вставить("-b", Base)
        Опции.Вставить("-p", Parameters)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "RevokeRoles", Опции)
        
    ;

    @Глобально
    // Метод GetRolePrivilegeStructure
    // Forms the privilege information structure for use when working with roles
    //
    // Resource     - Structure Of KeyAndValue: Privilege resource
    // ActionsArray - Array Of String: Array of available privilege actions
    метод GetRolePrivilegeStructure(Resource: Объект?, ActionsArray: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-r", Resource)
        Опции.Вставить("-a", ActionsArray)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetRolePrivilegeStructure", Опции)
        
    ;
    
;