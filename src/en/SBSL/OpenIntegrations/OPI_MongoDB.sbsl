        Опции.Вставить("-d", Data)
        Опции.Вставить("-m", UpdateAll)
        Опции.Вставить("-u", Insert)
        Опции.Вставить("-c", Collation)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetDocumentUpdateStructure", Опции)
        
    ;

