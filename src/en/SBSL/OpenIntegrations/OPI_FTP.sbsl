#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_FTP
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_FTP(Исполнитель)
    
;

@Локально
структура OPI_FTP
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "ftp"
    
    @Глобально
    // Метод GetConnectionConfiguration
    // Forms a complete structure of connection settings that can be used instead of the actual connection when calling other functions
    //
    // FTPSettings - Structure Of KeyAndValue: FTP settings. See GetConnectionSettings
    // Proxy       - Structure Of KeyAndValue: Proxy settings, if required. See GetProxySettings (необяз. по ум. - Empty value)
    // Tls         - Structure Of KeyAndValue: TLS settings, if necessary. See GetTlsSettings (необяз. по ум. - Empty value)
    метод GetConnectionConfiguration(FTPSettings: Объект?, Proxy: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", FTPSettings)
        Опции.Вставить("-p", Proxy)
        Опции.Вставить("-t", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetConnectionConfiguration", Опции)
        
    ;

    @Глобально
    // Метод GetWelcomeMessage
    // Receives the FTP servers welcome message
    //
    // Connection - Arbitrary: Existing connection or connection configuration
    метод GetWelcomeMessage(Connection: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetWelcomeMessage", Опции)
        
    ;

    @Глобально
    // Метод GetProtocolFeatureList
    // Gets a list of FTP protocol features supported by the server
    //
    // Connection - Arbitrary: Existing connection or connection configuration
    метод GetProtocolFeatureList(Connection: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetProtocolFeatureList", Опции)
        
    ;

    @Глобально
    // Метод Ping
    // Checks the connection activity and resets the timeout until its automatic closure
    //
    // Connection - Arbitrary: Existing connection or connection configuration
    метод Ping(Connection: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "Ping", Опции)
        
    ;

    @Глобально
    // Метод ExecuteCustomCommand
    // Executes a specific (SITE) server command and returns the response
    //
    // Connection  - Arbitrary: Existing connection or connection configuration
    // CommandText - String: Text of the executed command
    метод ExecuteCustomCommand(Connection: Объект?, CommandText: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        Опции.Вставить("-m", CommandText)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ExecuteCustomCommand", Опции)
        
    ;

    @Глобально
    // Метод ExecuteArbitraryCommand
    // Sends an arbitrary text request to the server for processing
    //
    // Connection  - Arbitrary: Existing connection or connection configuration
    // CommandText - String: Text of the executed command
    метод ExecuteArbitraryCommand(Connection: Объект?, CommandText: Объект?): Объект?
        
