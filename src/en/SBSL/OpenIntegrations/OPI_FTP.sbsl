        Опции.Вставить("-m", CommandText)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ExecuteArbitraryCommand", Опции)
        
    ;

    @Глобально
    // Метод GetObjectSize
    // Get the size of a file or directory if it exists
    //
    // Connection - Arbitrary: Existing connection or connection configuration
    // Path       - String: Path to the object
    метод GetObjectSize(Connection: Объект?, Path: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        Опции.Вставить("-p", Path)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetObjectSize", Опции)
        
    ;

    @Глобально
    // Метод UpdatePath
    // Changes the object's path to the specified one
    //
    // Connection - Arbitrary: Existing connection or connection configuration
    // Path       - String: Current path to object
    // NewPath    - String: New path to object
    метод UpdatePath(Connection: Объект?, Path: Объект?, NewPath: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        Опции.Вставить("-o", Path)
        Опции.Вставить("-n", NewPath)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "UpdatePath", Опции)
        
    ;

    @Глобально
    // Метод GetConnectionSettings
    // Creates a structure of FTP connection settings
    //
    // Host         - String: Host address
    // Port         - Number: Server port (необяз. по ум. - 21)
    // Login        - String, Undefined: Username for authorization, if required (необяз. по ум. - Empty value)
    // Password     - String, Undefined: User password for authorization, if required (необяз. по ум. - Empty value)
    // Passive      - Boolean: Passive connection mode (необяз. по ум. - true)
    // ReadTimeout  - Number: Read timeout (необяз. по ум. - 120)
    // WriteTimeout - Number: Write timeout (необяз. по ум. - 120)
    // IPResolve    - Boolean: Advanced passive mode address resolution (необяз. по ум. - true)
    метод GetConnectionSettings(Host: Объект?, Port: Объект? = Неопределено, Login: Объект? = Неопределено, Password: Объект? = Неопределено, Passive: Объект? = Неопределено, ReadTimeout: Объект? = Неопределено, WriteTimeout: Объект? = Неопределено, IPResolve: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-h", Host)
        Опции.Вставить("-p", Port)
        Опции.Вставить("-l", Login)
        Опции.Вставить("-s", Password)
        Опции.Вставить("-v", Passive)
        Опции.Вставить("-r", ReadTimeout)
        Опции.Вставить("-w", WriteTimeout)
        Опции.Вставить("-i", IPResolve)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetConnectionSettings", Опции)
        
    ;

    @Глобально
    // Метод GetProxySettings
    // Creates a structure of proxy server settings for the connection
    //
    // Address  - String: Proxy address
    // Port     - Number: Proxy port
    // View     - String: Proxy type: socks5, socks4, http (необяз. по ум. - socks5)
    // Login    - String, Undefined: Authorization login, if required (необяз. по ум. - Empty value)
    // Password - String, Undefined: Authorization password, if required (необяз. по ум. - Empty value)
    метод GetProxySettings(Address: Объект?, Port: Объект?, View: Объект? = Неопределено, Login: Объект? = Неопределено, Password: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Address)
        Опции.Вставить("-p", Port)
        Опции.Вставить("-t", View)
        Опции.Вставить("-l", Login)
        Опции.Вставить("-s", Password)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetProxySettings", Опции)
        
    ;

    @Глобально
    // Метод GetTlsSettings
    // Forms settings for using TLS
    //
    // DisableCertVerification - Boolean: Allows to work with invalid certificates, including self signed
    // CertFilepath            - String: Path to the root PEM file of the certificate if it is not in the system repository (необяз. по ум. - Empty value)
    метод GetTlsSettings(DisableCertVerification: Объект?, CertFilepath: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", DisableCertVerification)
        Опции.Вставить("-c", CertFilepath)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetTlsSettings", Опции)
        
    ;

    @Глобально
    // Метод ListObjects
    // Gets information about the contents of a directory at the specified path
    //
    // Connection  - Arbitrary: Existing connection or connection configuration
    // Path        - String: Path to search directory (необяз. по ум. - Empty value)
    // Recursively - Boolean: Get information about objects in nested directories (необяз. по ум. - false)
    метод ListObjects(Connection: Объект?, Path: Объект? = Неопределено, Recursively: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        Опции.Вставить("-p", Path)
        Опции.Вставить("-r", Recursively)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ListObjects", Опции)
        
    ;

