    // Permissions - String: Access mode to the directory in POSIX numeric format (as in chmod) (необяз. по ум. - 700)
    метод CreateNewDirectory(Connection: Объект?, Path: Объект?, Permissions: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        Опции.Вставить("-p", Path)
        Опции.Вставить("-m", Permissions)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CreateNewDirectory", Опции)
        
    ;

