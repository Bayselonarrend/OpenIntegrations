    // Headers   - Map Of KeyAndValue: Additional request headers, if necessary (необяз. по ум. - Empty value)
    метод CreateBucket(Name: Объект?, BasicData: Объект?, Directory: Объект? = Неопределено, Headers: Объект? = Неопределено): Объект?
        
