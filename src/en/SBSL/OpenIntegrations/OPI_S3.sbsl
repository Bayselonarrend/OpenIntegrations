#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_S3
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_S3(Исполнитель)
    
;

@Локально
структура OPI_S3
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "s3"
    
    @Глобально
    // Метод GetBasicDataStructure
    // Returns the basic data for request in structured form
    //
    // URL       - String: URL: domain for common methods or full URL with parameters for direct request sending
    // AccessKey - String: Access key for authorization
    // SecretKey - String: Secret key for authorization
    // Region    - String: Service region
    // Service   - String: Type of service, if different from s3 (необяз. по ум. - s3)
    метод GetBasicDataStructure(URL: Объект?, AccessKey: Объект?, SecretKey: Объект?, Region: Объект?, Service: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-u", URL)
        Опции.Вставить("-a", AccessKey)
        Опции.Вставить("-s", SecretKey)
        Опции.Вставить("-r", Region)
        Опции.Вставить("-v", Service)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetBasicDataStructure", Опции)
        
    ;

    @Глобально
    // Метод SendRequestWithoutBody
    // Sends a simple http request without a body
    //
    // Method         - String: HTTP method
    // BasicData      - Structure Of KeyAndValue: Basic request data (with full URL). See GetBasicDataStructure
    // ExpectedBinary - Boolean: Disables an attempt to convert the response to JSON (необяз. по ум. - false)
    // Headers        - Map Of KeyAndValue: Additional request headers, if necessary (необяз. по ум. - Empty value)
    метод SendRequestWithoutBody(Method: Объект?, BasicData: Объект?, ExpectedBinary: Объект? = Неопределено, Headers: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-m", Method)
        Опции.Вставить("-b", BasicData)
        Опции.Вставить("-n", ExpectedBinary)
        Опции.Вставить("-h", Headers)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "SendRequestWithoutBody", Опции)
        
    ;

    @Глобально
    // Метод SendRequestWithBody
    // Send http request with body
    //
    // Method         - String: HTTP method
    // BasicData      - Structure Of KeyAndValue: Basic request data (with full URL). See GetBasicDataStructure
    // Body           - String, BinaryData: Binary data or file of request body data
    // ExpectedBinary - Boolean: Disables an attempt to convert the response to JSON (необяз. по ум. - false)
    // Headers        - Map Of KeyAndValue: Additional request headers, if necessary (необяз. по ум. - Empty value)
    метод SendRequestWithBody(Method: Объект?, BasicData: Объект?, Body: Объект?, ExpectedBinary: Объект? = Неопределено, Headers: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-m", Method)
        Опции.Вставить("-b", BasicData)
        Опции.Вставить("-d", Body)
        Опции.Вставить("-n", ExpectedBinary)
        Опции.Вставить("-h", Headers)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "SendRequestWithBody", Опции)
        
    ;

    @Глобально
    // Метод CreateBucket
    // Creates a new bucket with the specified name
