    метод GetObjectUploadLink(Name: Объект?, Bucket: Объект?, BasicData: Объект?, Expire: Объект? = Неопределено, Headers: Объект? = Неопределено, Directory: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-n", Name)
        Опции.Вставить("-b", Bucket)
        Опции.Вставить("-s", BasicData)
        Опции.Вставить("-e", Expire)
        Опции.Вставить("-h", Headers)
        Опции.Вставить("-d", Directory)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetObjectUploadLink", Опции)
        
    ;
    
;