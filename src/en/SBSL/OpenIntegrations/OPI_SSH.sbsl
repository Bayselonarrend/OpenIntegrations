#совместимость 8.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Строка?|Executor.НастройкиИнтеграции): OPI_SSH
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(Конфигурация)
    возврат новый OPI_SSH(Исполнитель)
    
;

@Локально
структура OPI_SSH
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "ssh"
    
    @Глобально
    метод CreateConnection(SSHSettings: Объект?, Proxy: Объект? = Неопределено, Logging: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", SSHSettings)
        Опции.Вставить("-p", Proxy)
        Опции.Вставить("-l", Logging)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CreateConnection", Опции)
        
    ;

    @Глобально
    метод GetConnectionConfiguration(SSHSettings: Объект?, Proxy: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-s", SSHSettings)
        Опции.Вставить("-p", Proxy)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetConnectionConfiguration", Опции)
        
    ;

    @Глобально
    метод ExecuteCommand(Connection: Объект?, Command: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        Опции.Вставить("-m", Command)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ExecuteCommand", Опции)
        
    ;

    @Глобально
    метод CloseConnection(Connection: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CloseConnection", Опции)
        
    ;

    @Глобально
    метод IsConnector(Value: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-v", Value)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "IsConnector", Опции)
        
    ;

    @Глобально
    метод GetSettingsLoginPassword(Host: Объект?, Port: Объект?, Login: Объект?, Password: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-h", Host)
        Опции.Вставить("-p", Port)
        Опции.Вставить("-u", Login)
        Опции.Вставить("-s", Password)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetSettingsLoginPassword", Опции)
        
    ;

    @Глобально
    метод GetSettingsPrivateKey(Host: Объект?, Port: Объект?, Login: Объект?, Private: Объект?, Public: Объект? = Неопределено, Password: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-h", Host)
        Опции.Вставить("-p", Port)
        Опции.Вставить("-u", Login)
        Опции.Вставить("-k", Private)
        Опции.Вставить("-b", Public)
        Опции.Вставить("-s", Password)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetSettingsPrivateKey", Опции)
        
    ;

    @Глобально
    метод GetSettingsViaAgent(Host: Объект?, Port: Объект?, Login: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-h", Host)
        Опции.Вставить("-p", Port)
        Опции.Вставить("-u", Login)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetSettingsViaAgent", Опции)
        
    ;

    @Глобально
    метод GetSettingsKI(Host: Объект?, Port: Объект?, Login: Объект?, InputOrder: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-h", Host)
        Опции.Вставить("-p", Port)
        Опции.Вставить("-u", Login)
        Опции.Вставить("-r", InputOrder)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetSettingsKI", Опции)
        
    ;

    @Глобально
    метод GetProxySettings(Address: Объект?, Port: Объект?, View: Объект? = Неопределено, Login: Объект? = Неопределено, Password: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", Address)
        Опции.Вставить("-p", Port)
        Опции.Вставить("-t", View)
        Опции.Вставить("-l", Login)
        Опции.Вставить("-s", Password)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetProxySettings", Опции)
        
    ;

    @Глобально
    метод GetLoggingSettings(WriteToMemory: Объект? = Неопределено, MaxEvents: Объект? = Неопределено, FilePath: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-m", WriteToMemory)
        Опции.Вставить("-c", MaxEvents)
        Опции.Вставить("-p", FilePath)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetLoggingSettings", Опции)
        
    ;

    @Глобально
    метод GetLog(Connection: Объект?, AsString: Объект? = Неопределено, EventCount: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        Опции.Вставить("-s", AsString)
        Опции.Вставить("-n", EventCount)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetLog", Опции)
        
    ;
    
;