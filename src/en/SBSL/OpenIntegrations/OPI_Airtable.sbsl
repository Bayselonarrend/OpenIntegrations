#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_Airtable
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_Airtable(Исполнитель)
    
;

@Локально
структура OPI_Airtable
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "airtable"
    
    @Глобально
    // Метод GetListOfBases
    // Gets the list of available bases
    //
    // Token  - String: Token
    // Indent - String: Next page identifier of the base list from the previous request (необяз. по ум. - Empty value)
    метод GetListOfBases(Token: Объект?, Indent: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-o", Indent)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetListOfBases", Опции)
        
    ;

    @Глобально
    // Метод GetDatabaseTables
    // Gets the schema of base tables
    //
    // Token - String: Token
    // Base  - String: Base identifier
    метод GetDatabaseTables(Token: Объект?, Base: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-b", Base)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetDatabaseTables", Опции)
        
    ;

    @Глобально
    // Метод CreateDatabase
    // Creates a new database
    //
    // Token           - String: Token
    // Workspace       - String: Workspace identifier
    // Name            - String: New base name
    // TableCollection - Map Of KeyAndValue: Table description: Key > name, Value > array of fields
    метод CreateDatabase(Token: Объект?, Workspace: Объект?, Name: Объект?, TableCollection: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-w", Workspace)
        Опции.Вставить("-l", Name)
        Опции.Вставить("-b", TableCollection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CreateDatabase", Опции)
        
    ;

    @Глобально
    // Метод CreateTable
    // Creates a new table in the base
    //
    // Token       - String: Token
    // Base        - String: Base identifier
    // Name        - String: New table name
    // FieldArray  - Array of Structure: Array of field descriptions
    // Description - String: Table description (необяз. по ум. - Empty value)
    метод CreateTable(Token: Объект?, Base: Объект?, Name: Объект?, FieldArray: Объект?, Description: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-b", Base)
        Опции.Вставить("-l", Name)
        Опции.Вставить("-f", FieldArray)
        Опции.Вставить("-d", Description)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CreateTable", Опции)
        
    ;

    @Глобально
    // Метод ModifyTable
    // Changes the name and
    //
    // Token       - String: Token
    // Base        - String: Base identifier
    // Table       - String: Table identifier
    // Name        - String: New name (необяз. по ум. - Empty value)
    // Description - String: New description (необяз. по ум. - Empty value)
    метод ModifyTable(Token: Объект?, Base: Объект?, Table: Объект?, Name: Объект? = Неопределено, Description: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-b", Base)
        Опции.Вставить("-l", Table)
        Опции.Вставить("-i", Name)
        Опции.Вставить("-d", Description)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ModifyTable", Опции)
        
    ;

    @Глобально
    // Метод CreateField
    // Creates a new field in the table
