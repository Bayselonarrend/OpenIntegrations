    @Глобально
    метод ExecuteBytecodeFromFile(Lua: Объект?, Path: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-p", Path)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ExecuteBytecodeFromFile", Опции)
        
    ;

    @Глобально
    метод CallByteCodeFunction(Lua: Объект?, Bytecode: Объект?, FunctionName: Объект?, Parameters: Объект? = Неопределено, Packages: Объект? = Неопределено, Variables: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-c", Bytecode)
        Опции.Вставить("-f", FunctionName)
        Опции.Вставить("-p", Parameters)
        Опции.Вставить("-k", Packages)
        Опции.Вставить("-g", Variables)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CallByteCodeFunction", Опции)
        
    ;

    @Глобально
    метод SetGlobalVariable(Lua: Объект?, Name: Объект?, Value: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-n", Name)
        Опции.Вставить("-v", Value)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "SetGlobalVariable", Опции)
        
    ;

    @Глобально
    метод GetGlobalVariable(Lua: Объект?, Name: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-n", Name)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetGlobalVariable", Опции)
        
    ;

    @Глобально
    метод AttachPackageFromString(Lua: Объект?, PackageName: Объект?, Code: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-n", PackageName)
        Опции.Вставить("-c", Code)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "AttachPackageFromString", Опции)
        
    ;

    @Глобально
    метод AttachPackageFromFile(Lua: Объект?, PackageName: Объект?, Path: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-n", PackageName)
        Опции.Вставить("-f", Path)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "AttachPackageFromFile", Опции)
        
    ;

    @Глобально
    метод GetPackagesList(Lua: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetPackagesList", Опции)
        
    ;
    
;