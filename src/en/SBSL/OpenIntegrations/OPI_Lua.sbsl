#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Строка?|Executor.НастройкиИнтеграции): OPI_Lua
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(Конфигурация)
    возврат новый OPI_Lua(Исполнитель)
    
;

@Локально
структура OPI_Lua
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "lua"
    
    @Глобально
    метод CreateVM(Version: Объект?, Logging: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-v", Version)
        Опции.Вставить("-l", Logging)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CreateVM", Опции)
        
    ;

    @Глобально
    метод Restart(Lua: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "Restart", Опции)
        
    ;

    @Глобально
    метод CallFunction(Lua: Объект?, FunctionName: Объект?, Parameters: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-f", FunctionName)
        Опции.Вставить("-p", Parameters)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CallFunction", Опции)
        
    ;

    @Глобально
    метод IsVM(Value: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-v", Value)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "IsVM", Опции)
        
    ;

    @Глобально
    метод GetLoggingSettings(WriteToMemory: Объект? = Неопределено, MaxEvents: Объект? = Неопределено, FilePath: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-m", WriteToMemory)
        Опции.Вставить("-c", MaxEvents)
        Опции.Вставить("-p", FilePath)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetLoggingSettings", Опции)
        
    ;

    @Глобально
    метод GetLog(AddInObject: Объект?, AsString: Объект? = Неопределено, EventCount: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-v", AddInObject)
        Опции.Вставить("-s", AsString)
        Опции.Вставить("-c", EventCount)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetLog", Опции)
        
    ;

    @Глобально
    метод ExecuteCodeFromString(Lua: Объект?, Code: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-c", Code)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ExecuteCodeFromString", Опции)
        
    ;

    @Глобально
    метод ExecuteCodeFromFile(Lua: Объект?, Path: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-p", Path)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ExecuteCodeFromFile", Опции)
        
    ;

    @Глобально
    метод CallScriptFunction(Lua: Объект?, Script: Объект?, FunctionName: Объект?, Parameters: Объект? = Неопределено, Packages: Объект? = Неопределено, Variables: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-s", Script)
        Опции.Вставить("-f", FunctionName)
        Опции.Вставить("-p", Parameters)
        Опции.Вставить("-c", Packages)
        Опции.Вставить("-g", Variables)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CallScriptFunction", Опции)
        
    ;

    @Глобально
    метод CompileCodeFromString(Lua: Объект?, Code: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-c", Code)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CompileCodeFromString", Опции)
        
    ;

    @Глобально
    метод CompileCodeFromFile(Lua: Объект?, Path: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-p", Path)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CompileCodeFromFile", Опции)
        
    ;

    @Глобально
    метод ExecuteBytecode(Lua: Объект?, Bytecode: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-l", Lua)
        Опции.Вставить("-c", Bytecode)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ExecuteBytecode", Опции)
        
