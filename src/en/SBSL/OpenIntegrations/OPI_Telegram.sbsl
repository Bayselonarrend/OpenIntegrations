    @Глобально
    // Метод FormKeyboardFromButtonArray
    // Generates a simple JSON keyboard from an array of buttons for a message or bottom panel
    //
    // ButtonArray  - Array of String: Array of buttons
    // UnderMessage - Boolean: Keyboard under the message or on the bottom panel (необяз. по ум. - false)
    // OneByOne     - Boolean: True > buttons are displayed in a column, False > in a row (необяз. по ум. - true)
    метод FormKeyboardFromButtonArray(ButtonArray: Объект?, UnderMessage: Объект? = Неопределено, OneByOne: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-b", ButtonArray)
        Опции.Вставить("-u", UnderMessage)
        Опции.Вставить("-c", OneByOne)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "FormKeyboardFromButtonArray", Опции)
        
    ;

    @Глобально
    // Метод Ban
    // Bans a user in the selected chat
    //
    // Token  - String: Bot token
    // ChatID - String, Number: Target chat ID or ChatID*TopicID
    // UserID - String, Number: Target user ID
    метод Ban(Token: Объект?, ChatID: Объект?, UserID: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-c", ChatID)
        Опции.Вставить("-u", UserID)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "Ban", Опции)
        
    ;

