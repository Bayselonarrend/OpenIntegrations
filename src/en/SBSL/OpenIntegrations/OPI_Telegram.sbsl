    // ExpirationDate - Date: Link expiration date (permanent if not specified) (необяз. по ум. - Empty value)
    // UserLimit      - Number: User limit (infinite if not specified) (необяз. по ум. - Empty value)
    метод CreateInvitationLink(Token: Объект?, ChatID: Объект?, Title: Объект? = Неопределено, ExpirationDate: Объект? = Неопределено, UserLimit: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-c", ChatID)
        Опции.Вставить("-l", Title)
        Опции.Вставить("-e", ExpirationDate)
        Опции.Вставить("-m", UserLimit)
        
