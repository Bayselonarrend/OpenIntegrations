    @Глобально
    // Метод SendPoll
    // Sends a poll with answer options
    //
    // Token        - String: Bot token
    // ChatID       - String, Number: Target chat ID or ChatID*TopicID
    // Question     - String: Poll question
    // AnswersArray - Array of String: Array of answer options
    // Anonymous    - Boolean: Survey anonymity flag (необяз. по ум. - true)
    метод SendPoll(Token: Объект?, ChatID: Объект?, Question: Объект?, AnswersArray: Объект?, Anonymous: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-c", ChatID)
        Опции.Вставить("-q", Question)
        Опции.Вставить("-o", AnswersArray)
        Опции.Вставить("-a", Anonymous)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "SendPoll", Опции)
        
    ;

    @Глобально
    // Метод ForwardMessage
    // Forwards a message between chats or within a chat
    //
    // Token      - String: Bot token
    // OriginalID - String, Number: Original message ID
    // FromID     - String, Number: Chat ID of the original message
    // ToID       - String, Number: Target chat ID or ChatID*TopicID
    метод ForwardMessage(Token: Объект?, OriginalID: Объект?, FromID: Объект?, ToID: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-m", OriginalID)
        Опции.Вставить("-f", FromID)
        Опции.Вставить("-o", ToID)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ForwardMessage", Опции)
        
    ;

