#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_Telegram
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_Telegram(Исполнитель)
    
;

@Локально
структура OPI_Telegram
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "telegram"
    
    @Глобально
    // Метод GetBotInformation
    // Executes the request, returning basic bot information: name, id, ability to add the bot to groups, etc..
    //
    // Token - String: Bot token
    метод GetBotInformation(Token: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetBotInformation", Опции)
        
    ;

    @Глобально
    // Метод GetUpdates
    // Executes a request, returning information about bot events. Used in polling mode
    //
    // Token   - String: Bot token
    // Timeout - Number: Waiting time for new events (необяз. по ум. - Empty value)
    // Offset  - Number: Offset in the list of received messages (необяз. по ум. - Empty value)
    метод GetUpdates(Token: Объект?, Timeout: Объект? = Неопределено, Offset: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-m", Timeout)
        Опции.Вставить("-o", Offset)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetUpdates", Опции)
        
    ;

    @Глобально
    // Метод SetWebhook
    // Set webhook URL for bot event handling in webhook mode
    //
    // Token - String: Bot token
    // URL   - String: Request handling address from Telegram (with https:)
    метод SetWebhook(Token: Объект?, URL: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-u", URL)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "SetWebhook", Опции)
        
    ;

    @Глобально
    // Метод DeleteWebhook
    // Deletes the bot event handler URL for webhook operation
    //
    // Token - String: Bot token
    метод DeleteWebhook(Token: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "DeleteWebhook", Опции)
        
    ;

    @Глобально
    // Метод DownloadFile
    // Download file from Telegram servers
    //
    // Token  - String: Token
    // FileID - String: File ID for downloading
    метод DownloadFile(Token: Объект?, FileID: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-f", FileID)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "DownloadFile", Опции)
        
    ;

    @Глобально
    // Метод SendTextMessage
    // Sends a text message to a chat or channel
    //
    // Token     - String: Bot token
    // ChatID    - String, Number: Target chat ID or ChatID*TopicID
    // Text      - String: Message text
    // Keyboard  - String, Structure Of KeyAndValue: Keyboard. See FormKeyboardFromButtonArray (необяз. по ум. - Empty value)
    // Markup    - String: Text processing type (HTML, Markdown, MarkdownV2) (необяз. по ум. - Markdown)
    // RepliedID - String, Number: Reply to message ID (необяз. по ум. - Empty value)
    метод SendTextMessage(Token: Объект?, ChatID: Объект?, Text: Объект?, Keyboard: Объект? = Неопределено, Markup: Объект? = Неопределено, RepliedID: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-c", ChatID)
        Опции.Вставить("-x", Text)
        Опции.Вставить("-k", Keyboard)
        Опции.Вставить("-p", Markup)
        Опции.Вставить("-r", RepliedID)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "SendTextMessage", Опции)
        
    ;

