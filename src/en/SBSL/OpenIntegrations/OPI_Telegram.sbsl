#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Строка?|Executor.НастройкиИнтеграции): OPI_Telegram
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(Конфигурация)
    возврат новый OPI_Telegram(Исполнитель)
    
;

@Локально
структура OPI_Telegram
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "telegram"
    
    @Глобально
    метод GetBotInformation(Token: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetBotInformation", Опции)
        
    ;

    @Глобально
    метод GetUpdates(Token: Объект?, Timeout: Объект? = Неопределено, Offset: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-m", Timeout)
        Опции.Вставить("-o", Offset)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetUpdates", Опции)
        
    ;

