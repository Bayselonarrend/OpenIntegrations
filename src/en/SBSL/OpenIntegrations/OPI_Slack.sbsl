        Опции.Вставить("-t", Token)
        Опции.Вставить("-c", Channel)
        Опции.Вставить("-s", Timestamp)
        Опции.Вставить("-i", IsDelayed)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "DeleteMessage", Опции)
        
    ;

