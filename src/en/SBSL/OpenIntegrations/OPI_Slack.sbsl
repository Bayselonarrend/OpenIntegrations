#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_Slack
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_Slack(Исполнитель)
    
;

@Локально
структура OPI_Slack
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "slack"
    
    @Глобально
    // Метод GetBotInformation
    // Gets basic information about the bot
    //
    // Token - String: Bot token
    метод GetBotInformation(Token: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetBotInformation", Опции)
        
    ;

    @Глобально
    // Метод GetWorkspaceList
    // Gets a list of workspaces where the bot is connected
    //
    // Token  - String: Bot token
    // Cursor - String: Pointer from the previous request, if the result rows > 100 (необяз. по ум. - Empty value)
    метод GetWorkspaceList(Token: Объект?, Cursor: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-c", Cursor)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetWorkspaceList", Опции)
        
    ;

    @Глобально
    // Метод GetUserList
    // Gets a list of users in the workspace
    //
    // Token  - String: Bot token
    // Cursor - String: Pointer from the previous request, if the result rows > 100 (необяз. по ум. - Empty value)
    метод GetUserList(Token: Объект?, Cursor: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-c", Cursor)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetUserList", Опции)
        
    ;

    @Глобально
    // Метод SendMessage
    // Sends a message at a selected hour
    //
    // Token       - String: Bot token
    // Channel     - String: Channel ID
    // Text        - String: Message text (необяз. по ум. - Empty value)
    // SendingDate - Date: Sending date for delayed message (необяз. по ум. - Empty value)
    // Blocks      - Array of Structure: Array of block descriptions (необяз. по ум. - Empty value)
    метод SendMessage(Token: Объект?, Channel: Объект?, Text: Объект? = Неопределено, SendingDate: Объект? = Неопределено, Blocks: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-c", Channel)
        Опции.Вставить("-x", Text)
        Опции.Вставить("-d", SendingDate)
        Опции.Вставить("-b", Blocks)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "SendMessage", Опции)
        
    ;

    @Глобально
    // Метод SendEphemeralMessage
    // Sends a message that arrives in the channel but is visible
    //
    // Token   - String: Bot token
    // Channel - String: Channel ID
    // Text    - String: Message text (необяз. по ум. - Empty value)
    // User    - String: User ID (необяз. по ум. - Empty value)
    // Blocks  - Array of Structure: Array of block descriptions (необяз. по ум. - Empty value)
    метод SendEphemeralMessage(Token: Объект?, Channel: Объект?, Text: Объект? = Неопределено, User: Объект? = Неопределено, Blocks: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-c", Channel)
        Опции.Вставить("-x", Text)
        Опции.Вставить("-u", User)
        Опции.Вставить("-b", Blocks)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "SendEphemeralMessage", Опции)
        
    ;

    @Глобально
    // Метод EditMessage
    // Edits the content of an existing message
    //
    // Token      - String: Bot token
    // Channel    - String: Channel ID
    // Timestamp  - String: Message timestamp
    // Text       - String: New message text (необяз. по ум. - Empty value)
    // BlockArray - Array of Structure: Array of block descriptions (необяз. по ум. - Empty value)
    метод EditMessage(Token: Объект?, Channel: Объект?, Timestamp: Объект?, Text: Объект? = Неопределено, BlockArray: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-c", Channel)
        Опции.Вставить("-s", Timestamp)
        Опции.Вставить("-x", Text)
        Опции.Вставить("-b", BlockArray)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "EditMessage", Опции)
        
    ;

    @Глобально
    // Метод DeleteMessage
