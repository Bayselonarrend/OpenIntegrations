    // Token  - String: Bot token
    // FileID - String: File identifier
    метод GetExternalFile(Token: Объект?, FileID: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-f", FileID)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetExternalFile", Опции)
        
    ;

    @Глобально
    // Метод AddExternalFile
    // Adds a new external file
    //
    // Token - String: Bot token
    // URL   - String: URL to external file
    // Title - String: File title for Slack
    метод AddExternalFile(Token: Объект?, URL: Объект?, Title: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-u", URL)
        Опции.Вставить("-l", Title)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "AddExternalFile", Опции)
        
    ;

    @Глобально
    // Метод SendExternalFile
    // Sends an external file to a list of channels
    //
    // Token        - String: Bot token
    // FileID       - String: File identifier
    // ChannelArray - Array Of String: Array of channels for sending
    метод SendExternalFile(Token: Объект?, FileID: Объект?, ChannelArray: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-f", FileID)
        Опции.Вставить("-c", ChannelArray)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "SendExternalFile", Опции)
        
    ;

    @Глобально
    // Метод DeleteExternalFile
    // Deletes an external file from Slack
    //
    // Token  - String: Bot token
    // FileID - String: File identifier
    метод DeleteExternalFile(Token: Объект?, FileID: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-f", FileID)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "DeleteExternalFile", Опции)
        
    ;

    @Глобально
    // Метод GenerateImageBlock
    // Generates a block with an image to add to the message block array
    //
    // URL           - String: Image URL
    // AlternateText - String: Alternate text of the image (необяз. по ум. - Empty value)
    метод GenerateImageBlock(URL: Объект?, AlternateText: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-p", URL)
        Опции.Вставить("-a", AlternateText)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GenerateImageBlock", Опции)
        
    ;
    
;