#совместимость 8.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Строка?|Executor.НастройкиИнтеграции): OPI_Dropbox
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(Конфигурация)
    возврат новый OPI_Dropbox(Исполнитель)
    
;

@Локально
структура OPI_Dropbox
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "dropbox"
    
    @Глобально
    метод GetAuthorizationLink(AppKey: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", AppKey)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetAuthorizationLink", Опции)
        
    ;

    @Глобально
    метод GetToken(AppKey: Объект?, AppSecret: Объект?, Code: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", AppKey)
        Опции.Вставить("-p", AppSecret)
        Опции.Вставить("-c", Code)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetToken", Опции)
        
    ;

    @Глобально
    метод RefreshToken(AppKey: Объект?, AppSecret: Объект?, RefreshToken: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", AppKey)
        Опции.Вставить("-p", AppSecret)
        Опции.Вставить("-r", RefreshToken)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "RefreshToken", Опции)
        
    ;

