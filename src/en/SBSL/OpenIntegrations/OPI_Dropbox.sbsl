    @Глобально
    // Метод AddUsersToFile
    // Defines access to the file for third-party users
    //
    // Token          - String: Token
    // FileID         - String: ID of the file to be accessed
    // EmailAddresses - String, Array of String: List of email addresses of users being added
    // ViewOnly       - Boolean: Prohibits file editing for the external user (необяз. по ум. - true)
    метод AddUsersToFile(Token: Объект?, FileID: Объект?, EmailAddresses: Объект?, ViewOnly: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-f", FileID)
        Опции.Вставить("-e", EmailAddresses)
        Опции.Вставить("-r", ViewOnly)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "AddUsersToFile", Опции)
        
    ;

