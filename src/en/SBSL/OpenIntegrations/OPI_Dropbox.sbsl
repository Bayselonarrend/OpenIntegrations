        Опции.Вставить("-p", Path)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetPreview", Опции)
        
    ;

    @Глобально
    // Метод UploadFile
    // Uploads a file to the cloud drive
    //
    // Token     - String: Token
    // File      - String, BinaryData: Data file for upload
    // Path      - String: Save path on Dropbox
    // Overwrite - Boolean: Overwrite file in case of path conflicts (необяз. по ум. - false)
    метод UploadFile(Token: Объект?, File: Объект?, Path: Объект?, Overwrite: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-f", File)
        Опции.Вставить("-p", Path)
        Опции.Вставить("-o", Overwrite)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "UploadFile", Опции)
        
    ;

    @Глобально
    // Метод UploadFileByURL
    // Uploads a file to the cloud drive by fetching it from the specified URL
    //
    // Token   - String: Token
    // FileURL - String: URL source of the file
    // Path    - String: Save path on Dropbox
    метод UploadFileByURL(Token: Объект?, FileURL: Объект?, Path: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-u", FileURL)
        Опции.Вставить("-p", Path)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "UploadFileByURL", Опции)
        
    ;

    @Глобально
    // Метод GetUploadStatusByURL
    // Gets the upload status of the file by URL
    //
    // Token - String: Token
    // JobID - String: ID of async jsob from UploadFileByURL response
    метод GetUploadStatusByURL(Token: Объект?, JobID: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-j", JobID)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetUploadStatusByURL", Опции)
        
    ;

    @Глобально
    // Метод DeleteObject
    // Deletes an object from the cloud drive
    //
    // Token         - String: Token
    // Path          - String: Path to the object to delete
    // Irrecoverable - String: Delete object without the possibility of recovery (необяз. по ум. - false)
    метод DeleteObject(Token: Объект?, Path: Объект?, Irrecoverable: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-p", Path)
        Опции.Вставить("-r", Irrecoverable)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "DeleteObject", Опции)
        
    ;

    @Глобально
    // Метод CopyObject
    // Copies a file or directory to the selected path
    //
    // Token  - String: Token
    // From   - String: Path to the original object
    // Target - String: Target path for the new object
    метод CopyObject(Token: Объект?, From: Объект?, Target: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-f", From)
        Опции.Вставить("-o", Target)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CopyObject", Опции)
        
    ;

    @Глобально
