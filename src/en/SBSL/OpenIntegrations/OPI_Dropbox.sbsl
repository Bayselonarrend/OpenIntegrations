#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_Dropbox
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_Dropbox(Исполнитель)
    
;

@Локально
структура OPI_Dropbox
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "dropbox"
    
    @Глобально
    // Метод GetAuthorizationLink
    // Generates an authorization link for browser transition
    //
    // AppKey - String: Application key
    метод GetAuthorizationLink(AppKey: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", AppKey)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetAuthorizationLink", Опции)
        
    ;

    @Глобально
    // Метод GetToken
    // Gets token based on the code from the GetAuthorizationLink page
    //
    // AppKey    - String: Application key
    // AppSecret - String: Application secret
    // Code      - String: Code from the authorization page
    метод GetToken(AppKey: Объект?, AppSecret: Объект?, Code: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", AppKey)
        Опции.Вставить("-p", AppSecret)
        Опции.Вставить("-c", Code)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetToken", Опции)
        
    ;

    @Глобально
    // Метод RefreshToken
    // Gets a new token based on the refresh token
    //
    // AppKey       - String: Application key
    // AppSecret    - String: Application secret
    // RefreshToken - String: Refresh token
    метод RefreshToken(AppKey: Объект?, AppSecret: Объект?, RefreshToken: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", AppKey)
        Опции.Вставить("-p", AppSecret)
        Опции.Вставить("-r", RefreshToken)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "RefreshToken", Опции)
        
    ;

    @Глобально
    // Метод GetAccountInformation
    // Gets account information
    //
    // Token   - String: Token
    // Account - String: Account ID. Current token account if not filled (необяз. по ум. - Empty value)
    метод GetAccountInformation(Token: Объект?, Account: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-a", Account)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetAccountInformation", Опции)
        
    ;

    @Глобально
    // Метод GetSpaceUsageData
    // Gets information on the amount of used disk space
    //
    // Token - String: Token
    метод GetSpaceUsageData(Token: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetSpaceUsageData", Опции)
        
    ;

    @Глобально
    // Метод GetObjectInformation
    // Gets information about a file or directory
    //
    // Token    - String: Token
    // Path     - String: Path to the object
    // Detailed - Boolean: Add information fields for mediafiles (необяз. по ум. - false)
    метод GetObjectInformation(Token: Объект?, Path: Объект?, Detailed: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-p", Path)
        Опции.Вставить("-d", Detailed)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetObjectInformation", Опции)
        
    ;

    @Глобально
    // Метод GetListOfFolderFiles
    // Gets the list of the first files in the directory or continues getting the next ones when the cursor is specified
    //
    // Token    - String: Token
    // Path     - String: Path to the directory. Optional if the cursor is specified (необяз. по ум. - Empty value)
    // Detailed - Boolean: Add information fields for mediafiles (необяз. по ум. - false)
    // Cursor   - String: Cursor from the previous request to get the next set of files (необяз. по ум. - Empty value)
    метод GetListOfFolderFiles(Token: Объект?, Path: Объект? = Неопределено, Detailed: Объект? = Неопределено, Cursor: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-p", Path)
        Опции.Вставить("-d", Detailed)
        Опции.Вставить("-c", Cursor)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetListOfFolderFiles", Опции)
        
    ;

    @Глобально
    // Метод GetPreview
    // Gets PDF or HTML preview of the object (for documents only)
    //
