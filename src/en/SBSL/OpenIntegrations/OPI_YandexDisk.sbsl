    @Глобально
    // Метод CreateObjectCopy
    // Creates a copy of the object at the specified path and path to the original
    //
    // Token     - String: Token
    // Original  - String: Path to the original file or directory
    // Path      - String: Destination path for the copy
    // Overwrite - Boolean: Overwrite if a file with the same name already exists (необяз. по ум. - false)
    метод CreateObjectCopy(Token: Объект?, Original: Объект?, Path: Объект?, Overwrite: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-f", Original)
        Опции.Вставить("-o", Path)
        Опции.Вставить("-r", Overwrite)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CreateObjectCopy", Опции)
        
    ;

