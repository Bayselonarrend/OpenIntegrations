    @Глобально
    // Метод DownloadFile
    // Downloads a file at the specified path
    //
    // Token    - String: Token
    // Path     - String: Path to the file for downloading
    // SavePath - String: File save path (необяз. по ум. - Empty value)
    метод DownloadFile(Token: Объект?, Path: Объект?, SavePath: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-p", Path)
        Опции.Вставить("", SavePath)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "DownloadFile", Опции)
        
    ;

    @Глобально
    // Метод GetFilesList
    // Gets a list of files with or without filtering by type
    //
    // Token           - String: Token
    // Count           - Number, String: Number of returned objects (необяз. по ум. - Empty value)
    // OffsetFromStart - Number: Offset for getting objects not from the beginning of the list (необяз. по ум. - Empty value)
    // FilterByType    - String: Filter by file type (необяз. по ум. - Empty value)
    // SortByDate      - Boolean: True > sort by date, False > alphabetically (необяз. по ум. - false)
    метод GetFilesList(Token: Объект?, Count: Объект? = Неопределено, OffsetFromStart: Объект? = Неопределено, FilterByType: Объект? = Неопределено, SortByDate: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-t", Token)
        Опции.Вставить("-a", Count)
        Опции.Вставить("-o", OffsetFromStart)
        Опции.Вставить("-p", FilterByType)
        Опции.Вставить("-d", SortByDate)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetFilesList", Опции)
        
    ;

    @Глобально
    // Метод MoveObject
