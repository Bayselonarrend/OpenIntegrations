        Опции.Вставить("-t", Token)
        Опции.Вставить("-p", Path)
        Опции.Вставить("-f", File)
        Опции.Вставить("-s", ChunkSize)
        Опции.Вставить("-r", Overwrite)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "UploadFileInParts", Опции)
        
    ;

