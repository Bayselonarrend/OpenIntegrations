        Опции.Вставить("-r", Overwrite)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "UploadFile", Опции)
        
    ;

    @Глобально
    // Метод UploadFileInParts
    // Uploads a file to disk at the specified path in parts
    //
    // Token     - String: Token
    // Path      - String: Path for saving the file to disk
    // File      - String, BinaryData: File for upload
    // ChunkSize - Number: Part size when uploading (необяз. по ум. - 33554432)
    // Overwrite - Boolean: Overwrite if a file with the same name already exists (необяз. по ум. - false)
    метод UploadFileInParts(Token: Объект?, Path: Объект?, File: Объект?, ChunkSize: Объект? = Неопределено, Overwrite: Объект? = Неопределено): Объект?
        
