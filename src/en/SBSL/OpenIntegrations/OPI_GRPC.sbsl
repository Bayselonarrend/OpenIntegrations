#совместимость 8.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Строка?|Executor.НастройкиИнтеграции): OPI_GRPC
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(Конфигурация)
    возврат новый OPI_GRPC(Исполнитель)
    
;

@Локально
структура OPI_GRPC
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "grpc"
    
    @Глобально
    метод CreateConnection(Parameters: Объект?, Tls: Объект? = Неопределено, Logging: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-p", Parameters)
        Опции.Вставить("-t", Tls)
        Опции.Вставить("-l", Logging)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CreateConnection", Опции)
        
    ;

    @Глобально
    метод CloseConnection(Connection: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "CloseConnection", Опции)
        
    ;

    @Глобально
    метод SetMetadata(Connection: Объект?, Metadata: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        Опции.Вставить("-m", Metadata)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "SetMetadata", Опции)
        
    ;

    @Глобально
    метод ExecuteMethod(Connection: Объект?, Service: Объект?, Method: Объект?, Request: Объект? = Неопределено, Timeout: Объект? = Неопределено, Tls: Объект? = Неопределено): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-c", Connection)
        Опции.Вставить("-s", Service)
        Опции.Вставить("-m", Method)
        Опции.Вставить("-d", Request)
        Опции.Вставить("-t", Timeout)
        Опции.Вставить("-l", Tls)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ExecuteMethod", Опции)
        
    ;

