        Опции.Вставить("-m", Method)
        Опции.Вставить("-e", ExchangeOrder)
        Опции.Вставить("-t", Timeout)
        Опции.Вставить("-l", Tls)
        Опции.Вставить("-n", ContinueReceiving)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "ProcessBidirectionalStream", Опции)
        
    ;
    
;