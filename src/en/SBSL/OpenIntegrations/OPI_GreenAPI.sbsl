#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(ФайлКонфигурации: Строка): OPI_GreenAPI
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(ФайлКонфигурации)
    возврат новый OPI_GreenAPI(Исполнитель)
    
;

@Локально
структура OPI_GreenAPI
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "greenapi"
    
    @Глобально
    // Метод FormAccessParameters
    // Forms the structure of basic authorization data
    //
    // ApiUrl           - String: API host link
    // MediaUrl         - String: Link to host API for sending files
    // IdInstance       - String: Unique instance number
    // ApiTokenInstance - String: Instance access key
    метод FormAccessParameters(ApiUrl: Объект?, MediaUrl: Объект?, IdInstance: Объект?, ApiTokenInstance: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ApiUrl)
        Опции.Вставить("-m", MediaUrl)
        Опции.Вставить("-i", IdInstance)
        Опции.Вставить("-t", ApiTokenInstance)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "FormAccessParameters", Опции)
        
    ;

    @Глобально
    // Метод GetAccountInformation
    // Gets account information
    //
    // AccessParameters - Structure Of KeyAndValue: Access parameters. See FormAccessParameters
    метод GetAccountInformation(AccessParameters: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", AccessParameters)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "GetAccountInformation", Опции)
        
    ;

