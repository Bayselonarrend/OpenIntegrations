#совместимость 9.0

#требуется ./internal/Executor.sbsl

@Глобально
метод Инициализировать(Конфигурация: Строка?|Executor.НастройкиИнтеграции): OPI_GreenAPI
    
    пер Исполнитель = Executor.ИсполнительОПИ.Инициализировать(Конфигурация)
    возврат новый OPI_GreenAPI(Исполнитель)
    
;

@Локально
структура OPI_GreenAPI
    
    обз знч Исполнитель: Executor.ИсполнительОПИ
    
    знч КомандаCLI: Строка = "greenapi"
    
    @Глобально
    метод FormAccessParameters(ApiUrl: Объект?, MediaUrl: Объект?, IdInstance: Объект?, ApiTokenInstance: Объект?): Объект?
        
        пер Опции = новый Соответствие<Строка, Объект?>() 
        Опции.Вставить("-a", ApiUrl)
        Опции.Вставить("-m", MediaUrl)
        Опции.Вставить("-i", IdInstance)
        Опции.Вставить("-t", ApiTokenInstance)
        
        возврат Исполнитель.Выполнить(КомандаCLI, "FormAccessParameters", Опции)
        
    ;

